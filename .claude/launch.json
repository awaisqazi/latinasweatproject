{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "astro-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npx astro dev --port ${PORT:-4321}"
      ],
      "port": 4321,
      "autoPort": true
    },
    {
      "name": "astro-dev-ipv4",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npx astro dev --host 127.0.0.1 --port 4323"
      ],
      "port": 4323,
      "url": "http://127.0.0.1:4323"
    },
    {
      "name": "mqpena",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd /Users/fezqazi/Documents/MQPena && npx astro dev --port 4322"
      ],
      "port": 4322
    },
    {
      "name": "astro-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npx astro preview --port 4330"
      ],
      "port": 4330
    }
  ]
}
