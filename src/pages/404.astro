---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
---

<Layout title="Page Not Found | The Latina Sweat Project">
    <Header />
    <main
        class="min-h-[80vh] bg-white relative flex flex-col items-center justify-center p-6 overflow-hidden"
    >
        <!-- Giant Watermark 404 -->
        <div
            class="absolute inset-0 flex items-center justify-center pointer-events-none select-none z-0"
        >
            <span
                class="text-[30vw] font-bold text-gray-50 opacity-80 font-rubik leading-none"
            >
            </span>
        </div>

        <div class="relative z-10 text-center max-w-3xl mx-auto space-y-8">
            <!-- Badge -->
            <div
                class="inline-block px-4 py-1.5 rounded-full bg-red-50 border border-red-100 mb-4"
            >
                <span
                    class="text-sm font-bold tracking-wide uppercase text-vibrant-pink"
                    >Error 404</span
                >
            </div>

            <!-- Headline -->
            <h1
                class="font-rubik text-5xl md:text-7xl font-bold text-off-black leading-tight tracking-tight"
            >
                You've drifted <br class="hidden md:block" />
                <span class="text-vibrant-pink">off your mat.</span>
            </h1>

            <!-- Description -->
            <p
                class="font-body text-xl text-gray-500 max-w-2xl mx-auto leading-relaxed"
            >
                It looks like this page is in deep <em>savasana</em> or doesn't exist
                anymore. Take a deep breath, recenter, and let's flow back to the
                homepage.
            </p>

            <!-- Action Button -->
            <div class="pt-4">
                <a
                    href="/"
                    class="group relative inline-flex items-center justify-center px-8 py-4 text-lg font-bold text-white transition-all duration-300 bg-off-black rounded-full hover:bg-vibrant-pink hover:shadow-xl hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-vibrant-pink"
                >
                    <span>Return to Home</span>
                    <svg
                        class="w-5 h-5 ml-2 transition-transform group-hover:translate-x-1"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                    </svg>
                </a>
            </div>
        </div>
    </main>
</Layout>

<script>
    // Instructors with a static page /give/<slug>/ (src/pages/give/[slug].astro).
    import givingInstructors from "../data/givingInstructors.json";
    // Case-insensitive redirects
    const path = window.location.pathname.toLowerCase();
    // The Collective Finish Line (marathon week, Oct 2026): flyer and
    // spoken variants all land on /finishline. Exact matches only, and
    // never when already on /finishline (no redirect loop).
    const finishLineAliases = [
        "/finishline",
        "/collectivefinishline",
        "/finish-line",
        "/marathon",
    ];
    const bare = path.replace(/\/+$/, "");
    // LSP Giving Tuesday instructor short links: /give/<slug> (any case, with
    // or without a trailing slash). A slug with a static page (in
    // givingInstructors.json; only reaches here in another case) goes to
    // /give/<slug>/; any other to /give/?i=<slug>. Any query is kept.
    const giveMatch = bare.match(/^\/give\/([a-z0-9][a-z0-9-]{0,80})$/);
    const keepQuery = window.location.search.replace(/^\?/, "");
    if (
        giveMatch &&
        givingInstructors.some((g) => g.slug === giveMatch[1]) &&
        window.location.pathname !== "/give/" + giveMatch[1] + "/" // no loop if that page is missing
    ) {
        window.location.replace("/give/" + giveMatch[1] + "/" + window.location.search);
    } else if (giveMatch) {
        window.location.replace(
            "/give/?i=" + giveMatch[1] + (keepQuery ? "&" + keepQuery : ""),
        );
    } else if (
        ["/givingtuesday/kit", "/giving-tuesday/kit"].includes(bare) &&
        window.location.pathname.replace(/\/+$/, "") !== "/givingtuesday/kit"
    ) {
        // Share kit: any case, keeping ?i=<slug>.
        window.location.replace(
            "/givingtuesday/kit/" + window.location.search,
        );
    } else if (
        finishLineAliases.includes(bare) &&
        window.location.pathname.replace(/\/+$/, "") !== "/finishline"
    ) {
        window.location.replace("/finishline");
    } else if (
        // LSP Giving Tuesday 2026: any-case and hyphenated variants.
        ["/givingtuesday", "/giving-tuesday", "/lspgivingtuesday"].includes(bare) &&
        window.location.pathname.replace(/\/+$/, "") !== "/givingtuesday"
    ) {
        window.location.replace("/givingtuesday");
    } else if (
        ["/givingtuesday/join", "/giving-tuesday/join"].includes(bare) &&
        window.location.pathname.replace(/\/+$/, "") !== "/givingtuesday/join"
    ) {
        window.location.replace("/givingtuesday/join");
    } else if (
        // LSP Posadas + Posada Craft Days (Dec 2026): any case, plus flyer
        // and spoken variants. /posadas and /craftdays (lowercase) are also
        // redirects in astro.config.mjs. Exact matches only, never on /posada.
        [
            "/posada",
            "/posadas",
            "/lspposada",
            "/lspposadas",
            "/craftdays",
            "/craft-days",
            "/posadacraftdays",
            "/posada-craft-days",
        ].includes(bare) &&
        window.location.pathname.replace(/\/+$/, "") !== "/posada"
    ) {
        window.location.replace("/posada" + window.location.hash);
    } else if (path === "/water" || path === "/water/") {
        window.location.replace(
            "https://www.zeffy.com/en-US/ticketing/lsp-cooler-water-bottles",
        );
    } else if (path.includes("gala/live")) {
        // Any-case /gala/live, keeping the projector's #k= fragment.
        window.location.replace("/gala/live" + window.location.hash);
    } else if (path.includes("lspgala")) {
        window.location.replace("/lspgala");
    } else if (path.includes("silentauction")) {
        window.location.replace("/silentauction");
    } else if (path.includes("galaraffle")) {
        window.location.href =
            "https://www.zeffy.com/en-US/ticketing/latina-sweat-project-gala-raffle";
    } else if (path.includes("marketing")) {
        window.location.href =
            "https://sites.google.com/gosuperdope.com/brandhq/home";
    } else if (path.includes("intake")) {
        window.location.href =
            "https://docs.google.com/forms/d/e/1FAIpQLSeEo9jrperGs9nWfNrWQpgDNXdPRsXHZ5E8TVhaubtdzzzA4g/viewform";
    } else if (path.includes("reimburse")) {
        window.location.href = "/reimbursement";
    } else if (path.includes("forms")) {
        window.location.href = "/forms";
    } else if (path.includes("feedback")) {
        window.location.href = "/feedback";
    }
</script>
