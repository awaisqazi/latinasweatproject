---
// /gala/live — the 2026 Annual Gala big screen.
//
// Concept "Constelacion": every gift is a gold comet that flies into the
// glowing X and becomes permanent stars. The X fills bottom to top, so it is
// the thermometer. Ported from docs/gala-2026/prototypes/live-3d-proto.html.
//
// Specs: 05-live-3d-concept.md (canvas and choreography),
//        04-theme-design-spec.md sections 2 and 3 (tokens, projector rules),
//        10-display-rpc-contract.md (data).
//
// The projector opens this as  /gala/live#k=<display key>
// Guests opening the plain URL get totals only, no names.
//
// No fonts are fetched from the network: venue Wi-Fi is not on the critical
// path, and Didot and Avenir Next are system faces on the projector Mac.
//
// Last year's components (Thermometer, TopDonors, DonationTicker,
// DonationPopup) and src/lib/galaUtils.js still exist on disk. This page no
// longer imports them.
import LiveStage from "../../components/gala/live/LiveStage.svelte";
---

<html lang="en" class="g26-root">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#0B1320" />
        <link rel="icon" href="/favicon.ico" />
        <title>Annual Gala · Live</title>
        <style is:global>
            /* Design tokens, scoped to this page. Nothing leaks into the site
               and global.css is untouched. Source: 04 section 2.6. */
            .g26 {
                --g26-ink: #05070c;
                --g26-night: #0b1320;
                --g26-navy: #111a27;
                --g26-navy-2: #16212f;
                --g26-navy-3: #1b2a40;
                --g26-bg-top: #080b11;
                --g26-bg-mid: #121c2a;
                --g26-bg-bot: #03050a;
                --g26-cream: #fff8ef;
                --g26-warm: #f2e4d2;
                --g26-text: #f3ece1;
                --g26-muted: #c3ccd8;
                --g26-dim: #a9b4c2;
                --g26-taupe: #b5a18d;
                --g26-gold: #ffbd59;
                --g26-gold-strong: #f4a833;
                --g26-gold-deep: #b9842f;
                --g26-gold-soft: #e4c98a;
                --g26-gold-hi: #fff1be;
                --g26-ok: #5fd4b8;
                --g26-alert: #ff8a7a;
                --g26-info: #8cc4ec;
                --g26-serif:
                    "Didot", "Bodoni 72", "Bodoni Moda", "Playfair Display",
                    Georgia, serif;
                --g26-sans:
                    "Avenir Next", "Avenir", "Helvetica Neue", Helvetica, Arial,
                    sans-serif;
                --g26-ease: cubic-bezier(0.25, 0.8, 0.25, 1);
                --g26-ease-pop: cubic-bezier(0.34, 1.56, 0.64, 1);
                --g26-glow-sm: 0 0 14px rgba(255, 189, 89, 0.6);
                --g26-glow-md: 0 0 50px rgba(255, 189, 89, 0.35);
                --g26-glow-lg: 0 0 140px rgba(255, 189, 89, 0.35);
                color: var(--g26-text);
                font-family: var(--g26-sans);
            }
            /* The 1920 x 1080 stage unit (04 section 3.1). At 1080p 1u = 1px,
               at 4K 1u = 2px, and any non 16:9 output letterboxes on black. */
            .g26-live {
                --u: min(calc(100vw / 1920), calc(100vh / 1080));
                --g26-halo-gain: 1;
            }
            /* Boost mode (Shift+B or ?boost=1): decided at sound check. */
            .g26-live.boost {
                --g26-bg-mid: #1b2a40;
                --g26-bg-top: #0e1522;
                --g26-halo-gain: 1.45;
            }

            html,
            body {
                margin: 0;
                padding: 0;
                height: 100%;
                background: #03050a;
                color: #f3ece1;
                -webkit-font-smoothing: antialiased;
            }
            html.g26-root,
            body.g26-body {
                overflow: hidden;
            }
            @media (max-width: 899px), (orientation: portrait) {
                /* Phones: a normal scrolling document, not a fitted stage. */
                html.g26-root,
                body.g26-body {
                    overflow: auto;
                    height: auto;
                    min-height: 100%;
                }
            }
            *,
            *::before,
            *::after {
                box-sizing: border-box;
            }
            /* The canvas is a plain block. No backdrop-filter anywhere on this
               page: it would force a full-screen readback blur every frame. */
            canvas.g26-fx {
                position: fixed;
                inset: 0;
                width: 100vw;
                height: 100vh;
                display: block;
            }
            /* Before the island hydrates, the page is already the right colour. */
            .g26-preboot {
                position: fixed;
                inset: 0;
                z-index: -2;
                background:
                    radial-gradient(
                        60vw 60vh at 28% 46%,
                        rgba(255, 189, 89, 0.15),
                        transparent 70%
                    ),
                    linear-gradient(180deg, #080b11 0%, #121c2a 45%, #03050a 100%);
            }
        </style>
    </head>
    <body class="g26-body">
        <div class="g26-preboot"></div>
        <LiveStage client:only="svelte" />
        <noscript>
            <p
                style="color:#FFF8EF;font-family:Georgia,serif;padding:40px;text-align:center"
            >
                The live gala display needs JavaScript.
            </p>
        </noscript>
    </body>
</html>
