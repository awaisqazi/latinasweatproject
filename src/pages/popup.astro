---
// /popup: the LSP Pop Up weeks (Week 1 Oct 5 to 11, Week 2 Oct 12 to 18,
// 2026), pop-up classes across Pilsen while programming at the 949 W 16th
// St studio is paused (LSP is in the process of being displaced). Every
// fact comes from src/data/popUpWeeks.js (popUpWeek1.js, popUpWeek2.js).
//
// Multi-week: every active week (live + upcoming) is listed in order, each
// with its own eyebrow and the full PopUpWeekSchedule. While Week 1 is live,
// Week 2 sits below it under "Next week"; after Oct 11 Week 2 leads (at
// build time, or in the browser via the PopUpWeekClient flip attributes);
// after the last week the page shows the wrapped line and keeps the last
// week's schedule as the record. Title / OG describe the current week.
//
// Identity: the campaign's own cream / terracotta / ink look from the IG
// graphics (NOT gala navy/gold): cream ground, a big terracotta sun, bold
// uppercase Rubik display, terracotta day labels, ink times/classes, muted
// instructors. Chicago Art Dept = white card, Sanctuary Health = ink card.
// Venue names are text lockups only (no venue logos in the repo; never
// fabricate one).
//
// Phase: while upcoming/live the page sells both Zeffy forms and flags the
// next class per location (PopUpWeekClient). Once past (build time or in
// the browser after Oct 11) every CTA hides and a "This week has wrapped"
// note shows; the schedule stays as a record.
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import PopUpWeekClient from "@/components/PopUpWeekClient.astro";
import PopUpWeekSchedule from "@/components/PopUpWeekSchedule.astro";
import { activePopUpWeeks, lastPopUpWeek, popUpWeekWindow } from "@/data/popUpWeeks";
import FinishLineClient from "@/components/FinishLineClient.astro";

const base = import.meta.env.BASE_URL;
const activeWeeks = activePopUpWeeks();
const isPast = activeWeeks.length === 0;
// Weeks on the page: the active ones, or the last week as the record.
const weeks = isPast ? [lastPopUpWeek] : activeWeeks;
const lead = weeks[0];
// Hero / ink-band parts that name a week flip in the browser (kept for the
// last week as the record).
const heroWindow = (i) => popUpWeekWindow(weeks, i, { keepLast: true });
// Card anchors: the leading week gets #chicago-art-department /
// #sanctuary-health, later weeks a "-week-N" suffix.
const anchorSuffix = (i) => (i === 0 ? "" : `-${weeks[i].id}`);
// Headline renders as two lines: "LSP Pop Up" / "Pilsen" (split on the middle dot).
const headlineParts = lead.headline.split(" · ");
const pageTitle = `${lead.title} · ${lead.dateRangeShort} | The Latina Sweat Project`;
const pageDescription =
  `LSP Pop Up · Pilsen, ${lead.dateRangeShort}: 45-minute classes at Chicago Art Department (pay what you can) and Sanctuary Health ($10 per mat, 12 mats). Reserve your spot.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  socialImage={lead.ogImage}
  socialImageAlt={lead.ogImageAlt}
  socialImageWidth={1200}
  socialImageHeight={630}
  socialImageType="image/jpeg"
  twitterCard="summary_large_image"
>
  <Header />
  <main class="pu-page">
    {/* ============================ HERO ============================ */}
    <section class="pu-hero relative overflow-hidden">
      <div class="pu-sun pointer-events-none absolute" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-6xl px-4 pb-12 pt-10 sm:px-6 sm:pb-16 sm:pt-16 lg:px-8 lg:pb-20 lg:pt-20">
        <div class="pu-mark-wrap pointer-events-none absolute flex items-center justify-center rounded-full bg-white" aria-hidden="true">
          <img src={`${base}images/popup/lsp-x-mark.png`} alt="" class="w-[58%]" width="240" height="204" />
        </div>

        {weeks.map((week, w) => (
          <p class="pu-eyebrow text-xs font-extrabold uppercase tracking-[0.22em] sm:text-sm" {...heroWindow(w)}>
            {week.eyebrow.split(" · ").map((part, i) => (
              <span class="block sm:inline">{i > 0 && <span class="hidden sm:inline"> · </span>}{part}</span>
            ))}
          </p>
        ))}
        <h1 class="pu-display mt-4 max-w-[11ch] text-[2.9rem] sm:text-7xl lg:text-8xl">
          <span class="whitespace-nowrap">{headlineParts[0]}</span>{headlineParts[1] && <><br /><span>{headlineParts[1]}</span></>}
        </h1>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-[color:var(--pu-ink-soft)] sm:text-lg">
          {lead.body}
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-2">
          {weeks.map((week, w) => (
            <span class="pu-pill-ink rounded-full px-4 py-2 text-[11px] font-extrabold uppercase tracking-[0.16em]" {...heroWindow(w)}>{week.datePill}</span>
          ))}
          <span class="pu-pill-line rounded-full px-4 py-2 text-[11px] font-extrabold uppercase tracking-[0.16em]">Two locations · Pilsen</span>
          <span class="pu-pill-line rounded-full px-4 py-2 text-[11px] font-extrabold uppercase tracking-[0.16em]">{lead.classLengthLabel} classes</span>
        </div>

        {/* Wrapped note: shown at build time once past, or by the client
            script in the browser after Oct 11. */}
        <div
          class="pu-wrapped mt-8 max-w-xl rounded-2xl px-5 py-4"
          data-popup-show-when-past
          hidden={!isPast}
        >
          <p class="text-sm font-extrabold uppercase tracking-[0.14em]">{lastPopUpWeek.wrappedLine}</p>
        </div>

        {!isPast && weeks.map((week, w) => (
          <div data-popup-hide-when-past {...popUpWeekWindow(weeks, w)}>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            {week.locations.map((loc) => (
              <a
                href={`#${loc.id}${anchorSuffix(w)}`}
                class:list={[
                  "pu-jump inline-flex items-center justify-between gap-3 rounded-full px-5 py-3.5 text-sm font-extrabold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2",
                  loc.theme === "dark" ? "pu-jump--ink" : "pu-jump--paper",
                ]}
              >
                <span>{loc.shortName} <span class="font-semibold opacity-70">· {loc.priceLine}</span></span>
                <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                </svg>
              </a>
            ))}
          </div>
          </div>
        ))}
      </div>
    </section>

    {/* ========================== LOCATIONS ========================== */}
    <section class="pu-locations">
      <div class="mx-auto max-w-6xl px-4 pb-14 sm:px-6 sm:pb-20 lg:px-8">
        {/* The two location cards with the full day-by-day schedule live in
            PopUpWeekSchedule (shared with /schedule and /classes), once per
            week. A week's block hides in the browser after that week ends
            (except the last, kept as the record); a later week carries a
            "Next week" tag until the week before it ends. */}
        <div class="flex flex-col gap-14 sm:gap-20">
        {weeks.map((week, w) => (
          <div
            class="pu-week"
            data-popup-week={week.id}
            data-popup-hide-after={w < weeks.length - 1 ? week.endsAtISO : undefined}
          >
            {weeks.length > 1 && (
              <div class="pu-week-head mb-5 flex flex-wrap items-center gap-x-3 gap-y-2">
                {w > 0 && (
                  <span
                    class="pu-next-week rounded-full px-3 py-1 text-[10px] font-extrabold uppercase tracking-[0.18em]"
                    data-popup-hide-after={weeks[w - 1].endsAtISO}
                  >Next week</span>
                )}
                <h2 class="pu-week-title font-sans text-2xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-3xl">
                  {week.title} <span class="pu-week-dates">· {week.dateRangeShort}</span>
                </h2>
              </div>
            )}
            <PopUpWeekSchedule
              context="popup_page"
              finishLineContext="popup_finishline_crosslink"
              week={week}
              anchorSuffix={anchorSuffix(w)}
              nextAfter={w > 0 ? weeks[w - 1].endsAtISO : undefined}
            />
          </div>
        ))}
        </div>
      </div>
    </section>

    {/* ============================ BLURB ============================ */}
    <section class="pu-ink-band relative overflow-hidden">
      <div class="pu-sun pu-sun--low pointer-events-none absolute" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
        {weeks.map((week, w) => (
          <p class="pu-eyebrow-dark text-[11px] font-extrabold uppercase tracking-[0.22em]" {...heroWindow(w)}>{week.title}</p>
        ))}
        <p class="mt-4 text-xl font-semibold leading-relaxed text-[color:var(--pu-cream)] sm:text-2xl">
          {lead.blurb}
        </p>
        <p class="mt-6 text-base leading-relaxed text-[color:var(--pu-cream)]/75">
          {lead.supportLine}
        </p>
        <p class="mt-4 text-base leading-relaxed text-[color:var(--pu-cream)]/75">
          If your plans change, email
          <a
            href={`mailto:${lead.changeOfPlansEmail}`}
            class="pu-mail font-bold underline underline-offset-4 break-all"
          >{lead.changeOfPlansEmail}</a>
          so another community member can take your spot.
        </p>
        <p class="mt-8 text-sm text-[color:var(--pu-cream)]/55">
          Programming at our 16th Street studio is paused while we are in the
          process of being displaced. This fall LSP is popping up across Pilsen
          while we build our permanent home, opening early 2027.
          <a href={`${base}donate`} class="pu-mail font-bold underline underline-offset-4" data-conversion-event="donation_click" data-conversion-context="popup_page">Support the next studio.</a>
        </p>
      </div>
    </section>

    <PopUpWeekClient />
    <FinishLineClient />
  </main>
</Layout>

<style>
  .pu-page {
    --pu-cream: #f3ede4;
    --pu-paper: #fdfbf7;
    --pu-terracotta: #c4573a;
    --pu-ink: #1e1a17;
    --pu-ink-soft: rgba(30, 26, 23, 0.78);
    --pu-mustard: #e0a83a;
    --pu-muted: #6f6760;
    background: var(--pu-cream);
    color: var(--pu-ink);
    overflow-x: clip;
  }
  .pu-hero {
    background: var(--pu-cream);
  }
  .pu-sun {
    width: 17rem;
    height: 17rem;
    right: -8rem;
    top: -6rem;
    border-radius: 9999px;
    background: var(--pu-terracotta);
  }
  @media (min-width: 640px) {
    .pu-sun {
      width: 30rem;
      height: 30rem;
      right: -8rem;
      top: -8rem;
    }
  }
  @media (min-width: 1024px) {
    .pu-sun {
      width: 36rem;
      height: 36rem;
      right: -6rem;
      top: -10rem;
    }
  }
  .pu-sun--low {
    top: auto;
    bottom: -14rem;
    right: -12rem;
    opacity: 0.35;
  }
  .pu-mark-wrap {
    width: 5.5rem;
    height: 5.5rem;
    right: 1rem;
    top: 6rem;
    box-shadow: 0 10px 30px -12px rgba(30, 26, 23, 0.45);
  }
  @media (min-width: 640px) {
    .pu-mark-wrap {
      width: 8rem;
      height: 8rem;
      right: 12rem;
      top: 12rem;
    }
  }
  @media (min-width: 1024px) {
    .pu-mark-wrap {
      width: 10rem;
      height: 10rem;
      right: 16rem;
      top: 14rem;
    }
  }
  .pu-eyebrow {
    color: var(--pu-terracotta);
  }
  .pu-eyebrow {
    /* keep the eyebrow off the sun on phones */
    max-width: calc(100% - 8rem);
  }
  @media (min-width: 640px) {
    .pu-eyebrow {
      max-width: none;
    }
  }
  .pu-display {
    font-family: var(--font-sans);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    line-height: 0.9;
    color: var(--pu-ink);
    text-wrap: balance;
  }
  @media (max-width: 639px) {
    .pu-display {
      max-width: 8.5ch;
    }
  }
  .pu-pill-ink {
    background: var(--pu-ink);
    color: var(--pu-cream);
  }
  .pu-pill-line {
    border: 1.5px solid rgba(30, 26, 23, 0.8);
    color: var(--pu-ink);
    background: rgba(243, 237, 228, 0.7);
  }
  .pu-wrapped {
    background: var(--pu-ink);
    color: var(--pu-mustard);
  }
  .pu-jump--paper {
    background: var(--pu-paper);
    color: var(--pu-ink);
    box-shadow: 0 10px 24px -16px rgba(30, 26, 23, 0.5);
  }
  .pu-jump--ink {
    background: var(--pu-ink);
    color: var(--pu-cream);
  }
  /* Week blocks (multi-week) */
  .pu-week-title {
    color: var(--pu-ink);
  }
  .pu-week-dates {
    color: var(--pu-terracotta);
  }
  .pu-next-week {
    background: var(--pu-terracotta);
    color: #fff;
  }
  .pu-jump:hover {
    transform: translateY(-1px);
  }

  .pu-jump:focus-visible {
    --tw-ring-color: var(--pu-terracotta);
  }

  /* Ink band */
  .pu-ink-band {
    background: var(--pu-ink);
  }
  .pu-eyebrow-dark {
    color: var(--pu-mustard);
  }
  .pu-mail {
    color: var(--pu-mustard);
  }
</style>
