---
import Layout from "@/layouts/Layout.astro";
import GalaSeatingApp from "@/components/galaseating/GalaSeatingApp.svelte";

// Unlisted planning tool for the Annual Gala dinner seating at the Museum of
// Contemporary Art Chicago. Not in the nav, noindex, excluded from the sitemap
// in astro.config.mjs and disallowed in public/robots.txt.
//
// PRIVACY: this repo is public and this page ships empty. Guest data is seeded
// into LSP's passcode-protected database by the maintainer and cached in the
// planner's browser. Nothing about a guest is ever committed here, and guest
// data never goes in a URL.
//
// No site Header or Footer: the tool needs the full viewport, and the app
// renders its own slim header.
---

<Layout
  title="Gala Seating | The Latina Sweat Project"
  description="Internal seating planner for the Annual Gala dinner."
  robots="noindex, nofollow"
  hideFooter
  viewport="width=device-width, initial-scale=1, viewport-fit=cover"
>
  <Fragment slot="head">
    <meta name="theme-color" content="#0B1320" />
    <meta name="referrer" content="same-origin" />
    <!-- iPhone and iPad only: stop Safari magnifying the page every time a field is focused.
         iOS ignores maximum-scale for a planner's own pinch gesture, so manual zoom (an
         accessibility feature) still works; it only switches off the automatic focus zoom.
         Not applied on Android or desktop, where it WOULD block pinch zoom. Runs before paint. -->
    <script is:inline>
      (function () {
        var ua = navigator.userAgent || "";
        var ios = /iPad|iPhone|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
        if (!ios) return;
        var m = document.querySelector('meta[name="viewport"]');
        if (m) m.setAttribute("content", "width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover");
      })();
    </script>
    <style is:inline>
      /* The planner owns the viewport: no page scroll, no rubber banding. */
      html,
      body {
        height: 100%;
        overscroll-behavior: none;
      }
      body {
        background: #0b1320;
        margin: 0;
      }
      /* Phones and tablets: the app is fixed to the viewport so nothing
         rubber-bands, nothing scrolls behind an open sheet, and the page can
         never scroll sideways past a tab bar. */
      @media (max-width: 1023px), (pointer: coarse) and (max-height: 599px) {
        html,
        body {
          position: fixed;
          inset: 0;
          width: 100%;
          overflow: hidden;
          overscroll-behavior: none;
          -webkit-text-size-adjust: 100%;
        }
      }
    </style>
  </Fragment>

  <GalaSeatingApp client:only="svelte" />

  <noscript>
    <p style="color:#fff8ef;font-family:Arial,sans-serif;padding:24px;">
      The seating planner needs JavaScript. Turn it on and reload this page.
    </p>
  </noscript>
</Layout>
