    @media (min-width: 1024px) {
        .ddlm-flyers:not(:has(> .ddlm-flyer-sat:not([hidden]))) > figure {
            width: calc(50% - 0.75rem);
        }
    }
    /* Volunteer <details>: no native marker; the chevron turns when open and
