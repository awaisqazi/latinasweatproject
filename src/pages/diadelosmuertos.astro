---
// /diadelosmuertos (alias /ddlm): the RECAP of record for LSP's Día de los
// Muertos weekend at La Villita Park, Sat Oct 31 (Halloween at La Villita
// Park) and Sun Nov 1, 2026. Built the night of Nov 1 from the weekend page;
// the ticket buttons, sticky bar, waiver asks, volunteer form, flyers and
// directions are gone (git history has them, including the volunteer form's
// Google Form entry map). Nothing here sells and nothing is time-gated.
//
// Order: hero (photo, thank-you line, link to the photos) -> #gracias ->
// #photos (DdlmRecapAlbum: chapters in date order, then the shared lightbox
// outside <main>) -> #supporters -> #program (the published program as a
// record, on black, candles lighting at the bottom edge).
//
// Data: copy, program and lead picks in src/data/ddlmRecap2026.js; the album
// in src/data/ddlmGallery2026.js, whose header explains how to add the Sunday
// album by adding data only. Facts come from src/data/fallEvents.js only.
// No attendance, dollars, quotes or outcomes, never the meal count, and never
// caption who is pictured: class leaders are named in the text, never over a
// photo.
//
// Identity: black + white grounds, one accent (cempasúchil #FF7A1A; flat
// magenta only on the papel picado flags), Rubik only, the animated marigolds,
// picado and veladoras. Plain text on plain grounds: no gradients, tracked
// labels, chips or dividers. Hero text sits under the photo at every width so
// nothing covers a face.
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import DdlmPicado from "@/components/DdlmPicado.astro";
import DdlmMarigolds from "@/components/DdlmMarigolds.astro";
import DdlmVeladoras from "@/components/DdlmVeladoras.astro";
import DdlmPetalLine from "@/components/DdlmPetalLine.astro";
import DdlmReveal from "@/components/DdlmReveal.astro";
import DdlmRecapAlbum from "@/components/DdlmRecapAlbum.astro";
import DdlmRecapLightbox from "@/components/DdlmRecapLightbox.astro";
import { ddlmWeekend } from "@/data/fallEvents";
import {
  ddlmAlbums,
  ddlmHasSundayPhotos,
  ddlmSaturdayPhotos,
  ddlmSundayPhotos,
} from "@/data/ddlmGallery2026";
import { ddlmRecap, ddlmRecapPhotos, ddlmRecapProgram } from "@/data/ddlmRecap2026";

const base = import.meta.env.BASE_URL;
const CONTACT_EMAIL = "collab@latinasweatproject.com";
const HERO = `${base}images/ddlm/recap/hero`;
const heroPhotographer = ddlmAlbums.saturday.photographer;
const linkClass =
    "font-bold text-white underline decoration-[#FF7A1A] decoration-2 underline-offset-4 hover:text-[#FF7A1A] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF7A1A] focus-visible:ring-offset-2 focus-visible:ring-offset-black";

// Credit lines: one per album that has photos.
const credits = [
    { day: "Saturday", album: ddlmAlbums.saturday, count: ddlmSaturdayPhotos.length },
    ...(ddlmHasSundayPhotos
        ? [{ day: "Sunday", album: ddlmAlbums.sunday, count: ddlmSundayPhotos.length }]
        : []),
];
---

<Layout
    title="Día de los Muertos 2026 Recap | The Latina Sweat Project"
    description={ddlmRecap.metaDescription}
    socialImage="images/ddlm/recap/og-ddlm-recap.jpg"
    socialImageAlt={ddlmRecapPhotos.heroAlt}
    socialImageWidth={1200}
    socialImageHeight={630}
    socialImageType="image/jpeg"
    twitterCard="summary_large_image"
>
    <Header />
    <main class="font-rubik bg-white text-off-black">
        {/* ============================ HERO ============================ */}
        {/* The picado's cut-outs are punched in the tent's cream so the flags
            read as paper hanging under the real ceiling. Phones show the whole
            3:2 frame; lg+ caps the height so the h1 stays above the fold. */}
        <DdlmReveal />
        <section class="ddlm-hero relative bg-black text-white" data-ddlm-reveal="0.2">
            <div class="ddlm-hero-media relative aspect-[3/2] w-full overflow-hidden lg:aspect-auto">
                <img
                    src={`${HERO}-1600.webp`}
                    srcset={`${HERO}-900.webp 900w, ${HERO}-1600.webp 1600w, ${HERO}-2400.webp 2400w`}
                    sizes="100vw"
                    alt={ddlmRecapPhotos.heroAlt}
                    width="2400"
                    height="1600"
                    fetchpriority="high"
                    decoding="async"
                    class="absolute inset-0 h-full w-full object-cover object-[50%_62%]"
                />
                <DdlmPicado ground="#E9DCBF" cord="rgb(0 0 0 / 0.3)" sway class="z-10" />
            </div>

            <div class="mx-auto max-w-6xl px-4 pb-8 pt-5 sm:px-6 sm:pb-10 sm:pt-7 lg:grid lg:grid-cols-[minmax(0,1fr)_28rem] lg:items-start lg:gap-10 lg:px-8">
                <div>
                    <h1
                        class="ddlm-rise text-[2.6rem] font-extrabold leading-[0.95] tracking-tight sm:text-6xl"
                        style="--i: 0;"
                    >
                        {ddlmRecap.heading}
                    </h1>
                    <DdlmPetalLine self class="mt-3 w-full max-w-xl" />
                </div>
                <div class="mt-4 lg:mt-0">
                    <p class="ddlm-rise text-balance text-xl font-semibold leading-snug sm:text-2xl" style="--i: 1;">
                        {ddlmRecap.tagline}
                    </p>
                    <p class="ddlm-rise mt-2 text-[15px] leading-snug text-white/80 sm:text-base" style="--i: 2;">
                        {ddlmRecap.dateLine}
                    </p>
                    <p class="ddlm-rise mt-2 flex flex-wrap items-center gap-x-6 text-[15px] sm:text-base" style="--i: 3;">
                        <a href="#photos" class:list={[linkClass, "inline-flex min-h-[44px] items-center"]}>
                            See the photos
                        </a>
                        <span class="text-white/70">
                            Saturday photo by{" "}
                            <a
                                href={ddlmAlbums.saturday.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="underline decoration-[#FF7A1A] underline-offset-4 hover:text-white"
                                >{heroPhotographer.name}</a
                            >
                        </span>
                    </p>
                </div>
            </div>
        </section>

        {/* ========================== THANK YOU ========================== */}
        <section id="gracias" class="scroll-mt-32 bg-white px-4 py-12 sm:px-6 sm:py-20">
            <div class="relative mx-auto max-w-2xl">
                <DdlmMarigolds
                    layout="corner"
                    position="top-right"
                    size={44}
                    count={2}
                    ground="#FFFFFF"
                    id="ddlm-mg-thanks"
                    class="-top-3 right-0"
                />
                <h2 class="pr-16 text-3xl font-extrabold sm:text-4xl">{ddlmRecap.thankYouHeading}</h2>
                <p class="mt-5 text-xl font-semibold leading-snug sm:text-2xl">{ddlmRecap.thankYouLead}</p>
                <div class="mt-5 space-y-4 text-lg leading-relaxed text-medium-gray">
                    {ddlmRecap.thankYou.map((para) => <p>{para}</p>)}
                </div>
                <p class="mt-4 text-lg leading-relaxed text-medium-gray">
                    {ddlmRecap.supportLine}{" "}
                    <a
                        href="#supporters"
                        class="font-bold text-off-black underline decoration-[#FF7A1A] decoration-2 underline-offset-4 hover:text-black"
                        >See everyone who supported the weekend</a
                    >.
                </p>
                <p class="mt-6 text-lg font-semibold">{ddlmRecap.signoff}</p>
            </div>
        </section>

        {/* ============================ PHOTOS ============================ */}
        {/* Every pro frame so far is Saturday's. The Sunday slot is data only
            (src/data/ddlmGallery2026.js), and this block picks it up when it
            fills: credit line, photo count and the intro's two-day wording. */}
        <section id="photos" class="relative scroll-mt-28 bg-black px-4 pb-16 pt-16 text-white sm:px-6 sm:pb-24 sm:pt-24">
            <DdlmPicado ground="#000000" sway />
            <div class="mx-auto max-w-6xl">
                <h2 class="text-3xl font-extrabold sm:text-4xl">{ddlmRecap.photosHeading}</h2>
                <p class="mt-3 max-w-2xl text-lg leading-relaxed text-white/80">{ddlmRecap.photosIntro}</p>
                {credits.map(({ day, album, count }) => (
                    <p class="mt-2 max-w-2xl text-base leading-relaxed text-white/80">
                        {day} photos by <a href={album.url} target="_blank" rel="noopener noreferrer" class={linkClass}>{album.photographer?.name}</a>{album.photographer?.instagram && <> (<a href={album.photographer.instagramUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>{album.photographer.instagram}</a>)</>}. <a href={album.url} target="_blank" rel="noopener noreferrer" class={linkClass}>See all {count} on Flickr</a>
                    </p>
                ))}
                <div class="mt-10 sm:mt-14">
                    <DdlmRecapAlbum />
                </div>
            </div>
        </section>

        {/* ========================== SUPPORTERS ========================== */}
        {/* The text credit (ddlmWeekend.supportersLine) and three logo rows
            from ddlmWeekend.supporters (marketing/ddlm-supporters/BRIEF.md).
            Plain on white: no cards, borders, tints, filters or hover effects.
            Entries with an href open in a new tab; href null renders a span;
            logo null renders the name as text. One-time rise-in via
            DdlmReveal (.ddlm-in). */}
        <section
            id="supporters"
            class="ddlm-supporters scroll-mt-32 bg-white px-4 py-12 sm:px-6 sm:py-20"
            data-ddlm-reveal="0.15"
        >
            <div class="mx-auto max-w-3xl">
                <div class="ddlm-rise" style="--i: 0;">
                    <h2 class="text-3xl font-extrabold sm:text-4xl">Supported by</h2>
                    <p class="mt-4 max-w-2xl text-base leading-relaxed text-medium-gray">
                        {ddlmWeekend.supportersLine}
                    </p>
                </div>
                <div class="mt-10 space-y-10 sm:mt-12 sm:space-y-12">
                    {ddlmWeekend.supporters.map((group, gi) => (
                        <div class="ddlm-rise" style={`--i: ${gi + 1};`}>
                            <p class="text-sm font-medium text-medium-gray">
                                {group.label} <span class="text-medium-gray/70">· {group.labelEs}</span>
                            </p>
                            <ul class="mt-5 grid grid-cols-2 gap-x-6 gap-y-7 sm:grid-cols-3 sm:gap-x-10 md:grid-cols-4">
                                {group.items.map((s) => (
                                    <li class="flex h-16 items-center justify-start sm:h-20">
                                        {!s.logo ? (
                                            <span class="text-[18px] font-bold leading-tight text-off-black">{s.name}</span>
                                        ) : s.href ? (
                                            <a
                                                href={s.href}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                aria-label={s.name}
                                                class="block h-full w-full rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF7A1A] focus-visible:ring-offset-4"
                                            >
                                                <img
                                                    src={`${base}${s.logo}`}
                                                    alt={s.alt}
                                                    width={s.width}
                                                    height={s.height}
                                                    loading="lazy"
                                                    decoding="async"
                                                    class="block h-full w-full object-contain object-left"
                                                />
                                            </a>
                                        ) : (
                                            <span class="block h-full w-full">
                                                <img
                                                    src={`${base}${s.logo}`}
                                                    alt={s.alt}
                                                    width={s.width}
                                                    height={s.height}
                                                    loading="lazy"
                                                    decoding="async"
                                                    class="block h-full w-full object-contain object-left"
                                                />
                                            </span>
                                        )}
                                    </li>
                                ))}
                            </ul>
                            {group.caption && (
                                <p class="mt-3 text-xs text-medium-gray">{group.caption}</p>
                            )}
                        </div>
                    ))}
                </div>
            </div>
        </section>

        {/* ============================ PROGRAM ============================ */}
        {/* The published program as a record, Saturday then Sunday, ending on
            the run of show's own last line. The veladoras light one by one
            along the bottom edge (the bottom padding keeps them clear of the
            copy). */}
        <section
            id="program"
            class="relative scroll-mt-28 overflow-hidden bg-black px-4 pb-32 pt-12 text-white sm:px-6 sm:pb-36 sm:pt-20"
        >
            <div class="mx-auto max-w-5xl">
                <h2 class="text-3xl font-extrabold sm:text-4xl">{ddlmRecap.programHeading}</h2>
                <div class="mt-8 grid gap-10 md:grid-cols-2 md:gap-12">
                    {ddlmRecapProgram.map((day) => (
                        <div id={day.id} class="scroll-mt-32">
                            <h3 class="text-xl font-extrabold sm:text-2xl">{day.day}</h3>
                            <p class="mt-1 text-base text-white/70">{day.label}</p>
                            <ul class="mt-5 space-y-4">
                                {day.rows.map((row) => (
                                    <li>
                                        <p class="text-sm font-bold">{row.time}</p>
                                        <p class="text-lg font-semibold leading-snug">{row.title}</p>
                                        <p class="text-sm leading-relaxed text-white/70">{row.detail}</p>
                                    </li>
                                ))}
                            </ul>
                            {day.note && <p class="mt-5 text-sm leading-relaxed text-white/70">{day.note}</p>}
                        </div>
                    ))}
                </div>
                <p class="mt-10 text-2xl font-extrabold sm:mt-14 sm:text-3xl">{ddlmRecap.programClose}</p>
                <p class="mt-3 text-sm text-white/70">
                    Questions? Email <a href={`mailto:${CONTACT_EMAIL}`} class:list={[linkClass, "break-all"]}>{CONTACT_EMAIL}</a>.
                </p>
            </div>
            <DdlmVeladoras ground="#000000" phone="full" />
        </section>
    </main>
    <DdlmRecapLightbox />
</Layout>

<style>
    /* Hero copy + #supporters rise-in: the section gets .ddlm-in once
       (DdlmReveal.astro); the blocks rise 12px and fade in 80ms apart (--i).
       Waiting state only with JS and motion allowed; transform/opacity only. */
    @media (prefers-reduced-motion: no-preference) {
        :global(html.js) .ddlm-hero:not(.ddlm-in) .ddlm-rise,
        :global(html.js) .ddlm-supporters:not(.ddlm-in) .ddlm-rise {
            opacity: 0;
            transform: translateY(12px);
        }
        .ddlm-hero.ddlm-in .ddlm-rise,
        .ddlm-supporters.ddlm-in .ddlm-rise {
            animation: ddlm-hero-rise 700ms cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i, 0) * 80ms) both;
        }
    }
    @keyframes ddlm-hero-rise {
        from {
            opacity: 0;
            transform: translateY(12px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    /* lg+: the photo is capped so the h1 and the thank-you line stay above the
       fold; object-position keeps the faces and the papel picado in frame. */
    @media (min-width: 1024px) {
        .ddlm-hero-media {
            height: min(calc(100svh - 15rem), 56.25vw);
            min-height: 30rem;
        }
    }
</style>
