<style>
    /* Program rows: a short price tag and, where there is a Zeffy form, an
       inline pill. Black, white and the one accent only. */
    .ddlm-tag {
        display: inline-block;
        border-radius: 9999px;
        border: 1px solid rgb(0 0 0 / 0.15);
