</style>

<script>
    // Mobile refinement (marketing/fall-events/ads-ddlm-final-push/
    // MOBILE-BRIEF.md). Event-driven only (IntersectionObserver, focus,
    // hashchange, media query); nothing runs per frame.

    // --- Sticky ticket bar (phones, below md) ---------------------------
    (function () {
        const bar = document.getElementById("ddlm-sticky");
        if (!bar || !("IntersectionObserver" in window)) return;
        const pill = bar.querySelector<HTMLElement>("[data-ddlm-sticky-pill]");
        const heroCtas = Array.from(
            document.querySelectorAll<HTMLElement>("[data-ddlm-hero-cta]"),
        );
        // Zones that hide the bar while in view: every other ticket button
        // on the page (facts band, end of the Sunday program) and the site
        // footer, so two ticket buttons never stack and the footer is
        // never covered.
        const zones: Element[] = Array.from(
            document.querySelectorAll(
                '[data-conversion-event="ddlm_ticket_click"]:not([data-ddlm-hero-cta]):not([data-ddlm-sticky-pill])',
            ),
        );
        const footer = document.querySelector("footer");
        if (footer) zones.push(footer);
        const volForm = document.getElementById("vol-form");
        const overlay = document.getElementById("mobile-menu-overlay");
        const inView = new Set<Element>();
        let beaten = false;

        const isTextField = (el: Element | null) =>
            !!el &&
            !!volForm &&
            volForm.contains(el) &&
            (el.matches("textarea") ||
                el.matches('input[type="text"], input[type="email"], input[type="tel"]'));

        function update() {
            const hero = heroCtas.find((el) => el.getClientRects().length > 0);
            const passed = !!hero && hero.getBoundingClientRect().bottom <= 0;
            const menuOpen = !!overlay && !overlay.classList.contains("translate-x-full");
            const show =
                passed &&
                inView.size === 0 &&
                !isTextField(document.activeElement) &&
                !menuOpen;
            bar!.classList.toggle("is-shown", show);
            if (show) bar!.removeAttribute("inert");
            else bar!.setAttribute("inert", "");
            if (show && !beaten && pill) {
                beaten = true;
                pill.classList.add("ddlm-beat");
            }
        }

        const heroIo = new IntersectionObserver(update);
        heroCtas.forEach((el) => heroIo.observe(el));
        const zoneIo = new IntersectionObserver((entries) => {
            entries.forEach((e) => {
                if (e.isIntersecting) inView.add(e.target);
                else inView.delete(e.target);
            });
            update();
        });
        zones.forEach((el) => zoneIo.observe(el));
        if (volForm) {
            // Defer so moving between fields (focusout then focusin) never
            // flashes the bar.
            volForm.addEventListener("focusin", () => setTimeout(update, 0));
            volForm.addEventListener("focusout", () => setTimeout(update, 0));
        }
        if (overlay) {
            new MutationObserver(update).observe(overlay, {
                attributes: true,
                attributeFilter: ["class"],
            });
        }
        update();
    })();

    // --- Volunteer <details> --------------------------------------------
    // Phones: collapsed unless the hash is #volunteer (an in-page link to
    // #volunteer opens it too); opening it by tap focuses the first field.
    // sm and up: always open and the summary does nothing.
    (function () {
        const d = document.getElementById("vol-details") as HTMLDetailsElement | null;
        const summary = d?.querySelector("summary");
        if (!d || !summary) return;
        const wide = window.matchMedia("(min-width: 640px)");
        let tapped = false;
        function sync() {
            if (wide.matches) {
                d!.open = true;
                summary!.tabIndex = -1;
            } else {
                summary!.removeAttribute("tabindex");
            }
        }
        summary.addEventListener("click", (e) => {
            if (wide.matches) {
                e.preventDefault();
                return;
            }
            tapped = true;
        });
        d.addEventListener("toggle", () => {
            if (d.open && tapped) {
                document.getElementById("vol-name")?.focus();
            }
            tapped = false;
        });
        const openFromHash = () => {
            if (location.hash === "#volunteer") d.open = true;
        };
        window.addEventListener("hashchange", openFromHash);
        document.querySelectorAll('a[href="#volunteer"]').forEach((a) =>
            a.addEventListener("click", () => {
                d.open = true;
            }),
        );
        wide.addEventListener("change", sync);
        openFromHash();
        sync();
    })();
</script>

<script>
    // ============================================================
    // GOOGLE FORM CONFIG: replace these placeholders with the real
    // form ID and entry IDs once the Google Form is created.
    // Checkbox questions (roles, availability) send one repeated
    // entry.N param per checked option.
    // ============================================================
    const FORM_ACTION_URL =
        "https://docs.google.com/forms/d/e/1FAIpQLSfhqTlMlI2BqoXsBAHhzUj1Tb82q0pgqHqZS3ci4dKd9bfy3w/formResponse";
    const ENTRY_IDS = {
        fullName: "entry.1659067104", // Full name (text)
        email: "entry.642143810", // Email (text)
        phone: "entry.548405429", // Phone (text, optional)
        roles: "entry.1563299113", // How would you like to help? (checkboxes)
        availability: "entry.2022023304", // When are you available? (checkboxes)
        languages: "entry.893498704", // Languages you're comfortable volunteering in (radio)
        before: "entry.1702278511", // Have you volunteered with LSP before? (radio)
        notes: "entry.401444812", // Anything else we should know? (paragraph, optional)
    };
    // ============================================================

    const NAME_STORAGE_KEY = "lsp_ddlm_vol_name";
    const EMAIL_STORAGE_KEY = "lsp_ddlm_vol_email";
    // Spam guard (no server, so no Turnstile): a honeypot field plus a
    // minimum time-to-submit. Trips show the success state without posting.
    const HONEYPOT_FIELD = "website";
    const MIN_SUBMIT_MS = 3000;
    const loadedAt = Date.now();

    const form = document.getElementById("vol-form") as HTMLFormElement;
    const card = document.getElementById("vol-card") as HTMLElement;
    const success = document.getElementById("vol-success") as HTMLElement;
    const errorEl = document.getElementById("vol-error") as HTMLElement;
    const submitBtn = document.getElementById(
        "vol-submit",
    ) as HTMLButtonElement;
    const nameInput = document.getElementById("vol-name") as HTMLInputElement;
    const emailInput = document.getElementById("vol-email") as HTMLInputElement;

    // Prefill from a previous sign-up on this device.
    try {
        nameInput.value = window.localStorage.getItem(NAME_STORAGE_KEY) || "";
        emailInput.value = window.localStorage.getItem(EMAIL_STORAGE_KEY) || "";
    } catch {
        // localStorage may be unavailable (private mode); ignore.
    }

    function showError(message: string) {
        errorEl.textContent = message;
        errorEl.classList.remove("hidden");
    }

    form.addEventListener("submit", async (event) => {
        event.preventDefault();
        errorEl.classList.add("hidden");

        const data = new FormData(form);

        const honeypot = String(data.get(HONEYPOT_FIELD) || "").trim();
        if (honeypot || Date.now() - loadedAt < MIN_SUBMIT_MS) {
            // Looks automated: pretend it worked, send nothing.
            card.classList.add("hidden");
            success.classList.remove("hidden");
            return;
        }

        const fullName = String(data.get("fullName") || "").trim();
        const email = String(data.get("email") || "").trim();
        const phone = String(data.get("phone") || "").trim();
        const roles = data.getAll("roles").map(String);
        const availability = data.getAll("availability").map(String);
        const languages = String(data.get("languages") || "");
        const before = String(data.get("before") || "");
        const notes = String(data.get("notes") || "").trim();

        if (!fullName) return showError("Please add your name.");
        if (!email || !email.includes("@"))
            return showError("Please add a valid email address.");
        if (roles.length === 0)
            return showError("Please pick at least one way you'd like to help.");
        if (availability.length === 0)
            return showError("Please pick at least one time you're available.");
        if (!languages)
            return showError(
                "Please let us know which languages you're comfortable in.",
            );
        if (!before)
            return showError(
                "Please let us know if you've volunteered with LSP before.",
            );

        submitBtn.disabled = true;
        submitBtn.textContent = "Sending...";

        const params = new URLSearchParams();
        params.set(ENTRY_IDS.fullName, fullName);
        params.set(ENTRY_IDS.email, email);
        if (phone) params.set(ENTRY_IDS.phone, phone);
        roles.forEach((r) => params.append(ENTRY_IDS.roles, r));
        availability.forEach((a) => params.append(ENTRY_IDS.availability, a));
        params.set(ENTRY_IDS.languages, languages);
        params.set(ENTRY_IDS.before, before);
        if (notes) params.set(ENTRY_IDS.notes, notes);

        try {
            // no-cors: Google doesn't send CORS headers on formResponse, so
            // the response is opaque. A resolved fetch means it reached
            // Google; client-side validation above covers required fields.
            await fetch(FORM_ACTION_URL, {
                method: "POST",
                mode: "no-cors",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded",
                },
                body: params.toString(),
            });

            try {
                window.localStorage.setItem(NAME_STORAGE_KEY, fullName);
                window.localStorage.setItem(EMAIL_STORAGE_KEY, email);
            } catch {
                // ignore
            }

            card.classList.add("hidden");
            success.classList.remove("hidden");
            success.scrollIntoView({ behavior: "smooth", block: "center" });
            success.focus({ preventScroll: true });
        } catch (e) {
            console.error("DDLM volunteer submit failed:", e);
            showError(
                "We couldn't send your sign-up. Check your connection and try again.",
            );
            submitBtn.disabled = false;
            submitBtn.textContent = "Sign me up";
        }
    });
</script>
