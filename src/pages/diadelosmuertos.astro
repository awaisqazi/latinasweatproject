    }
    .ddlm-pill {
        display: inline-block;
        border-radius: 9999px;
        background: #000;
        padding: 0.4rem 0.9rem;
        font-size: 0.8125rem;
        font-weight: 700;
        line-height: 1.3;
        white-space: nowrap;
        color: #fff;
        transition: background-color 150ms, color 150ms;
    }
    .ddlm-pill:hover {
        background: #ff7a1a;
        color: #000;
    }
    .ddlm-pill:focus-visible {
        outline: 2px solid #ff7a1a;
        outline-offset: 2px;
    }
    /* Hero copy + #supporters rise-in: the section gets .ddlm-in once
       (DdlmReveal.astro); the blocks rise 12px and fade in 80ms apart (--i).
       Waiting state only with JS and motion allowed; transform/opacity only. */
    @media (prefers-reduced-motion: no-preference) {
        :global(html.js) .ddlm-hero:not(.ddlm-in) .ddlm-rise,
        :global(html.js) .ddlm-supporters:not(.ddlm-in) .ddlm-rise {
            opacity: 0;
            transform: translateY(12px);
        }
        .ddlm-hero.ddlm-in .ddlm-rise,
        .ddlm-supporters.ddlm-in .ddlm-rise {
            animation: ddlm-hero-rise 700ms cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i, 0) * 80ms) both;
        }
    }
    @keyframes ddlm-hero-rise {
        from {
            opacity: 0;
            transform: translateY(12px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    /* Mobile refinement (Instagram in-app browser): no tap flash on the hero
       buttons and the sticky bar. */
    .ddlm-tap,
    .ddlm-tap a {
        -webkit-tap-highlight-color: transparent;
    }
    /* Sticky ticket bar (phones, below md). Shown by the page script with
       .is-shown; without JS it simply stays put at the bottom. Hidden state
       slides it down and fades it, then drops it from the tab order
       (visibility after the transition). */
    :global(html.js) .ddlm-sticky:not(.is-shown) {
        transform: translateY(100%);
        opacity: 0;
        visibility: hidden;
    }
    @media (prefers-reduced-motion: no-preference) {
        .ddlm-sticky {
            transition:
                transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
                opacity 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
                visibility 0s linear 280ms;
        }
        .ddlm-sticky.is-shown {
            transition:
                transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
                opacity 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
                visibility 0s linear 0s;
        }
        /* One attention beat on the pill the first time the bar appears. */
        .ddlm-sticky-pill.ddlm-beat {
            animation: ddlm-beat 600ms cubic-bezier(0.2, 0.8, 0.2, 1) 220ms 1 both;
        }
    }
    @keyframes ddlm-beat {
        0%,
        100% {
            transform: scale(1);
        }
        45% {
            transform: scale(1.04);
        }
    }
    /* Flyer snap scroller on phones: no scrollbar chrome. */
    .ddlm-flyers {
        scrollbar-width: none;
    }
    .ddlm-flyers::-webkit-scrollbar {
        display: none;
    }
    /* lg+: once the browser has hidden the Saturday flyers (after Oct 31
