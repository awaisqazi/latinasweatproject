---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ElectionBallot from "@/components/ElectionBallot.svelte";
import {
    election2026,
    electionLivestream,
    electionEligibility,
    electionRoles,
    candidateInitials,
} from "@/data/elections2026.js";

// No photos or bios have been submitted yet, so this page deliberately does
// not use CandidateCard.astro (it requires both). Cards are name-forward with
// an initials monogram and stay balanced whenever a role has two or three
// candidates. Voting dates are never hardcoded here: the ballot reads the
// live window from the get_voting_status RPC.

// Builds a timestamped link into the livestream replay for a candidate's
// speech, per the watchUrl + (?|&)t=<seconds>s convention. Only called when
// a candidate has a numeric speechTimestamp.
function timestampedSpeechUrl(seconds) {
    const separator = electionLivestream.watchUrl.includes("?") ? "&" : "?";
    return `${electionLivestream.watchUrl}${separator}t=${seconds}s`;
}
---

<Layout
    title={`${election2026.name} | The Latina Sweat Project`}
    description="Meet the candidates for the 2026 Latina Sweat Project Junior Board, watch the candidate speeches, and cast your vote when voting opens."
>
    <Header />
    <main>
        {/* Page Header */}
        <section
            class="bg-gradient-to-br from-light-gray to-pink-50 py-16 sm:py-24"
        >
            <div class="mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
                <span
                    class="rounded-full bg-vibrant-pink/10 px-4 py-1.5 font-sans text-sm font-bold uppercase tracking-wider text-vibrant-pink"
                >
                    {election2026.scheduleNote}
                </span>
                <h1
                    class="mt-6 font-sans text-4xl font-extrabold tracking-tight text-off-black sm:text-5xl"
                >
                    {election2026.name}
                </h1>
                <p
                    class="mx-auto mt-6 max-w-3xl font-body text-xl leading-relaxed text-medium-gray"
                >
                    {election2026.tagline}
                </p>
                <div
                    class="mt-8 flex flex-wrap items-center justify-center gap-3"
                >
                    <a
                        href="#speeches"
                        class="rounded-full bg-off-black px-6 py-3 font-sans text-sm font-bold text-white transition hover:bg-vibrant-pink"
                    >
                        Watch the speeches
                    </a>
                    <a
                        href="#vote"
                        class="rounded-full border-2 border-off-black/15 px-6 py-3 font-sans text-sm font-bold text-off-black transition hover:border-vibrant-pink hover:text-vibrant-pink"
                    >
                        Go to the ballot
                    </a>
                </div>
            </div>
        </section>

        {/* Candidate Speeches Live Stream */}
        <section class="bg-white py-12 px-4 sm:px-6" id="speeches">
            <div class="mx-auto max-w-4xl">
                <div class="text-center mb-8">
                    <span
                        class="inline-flex items-center gap-2 rounded-full bg-red-600/10 px-4 py-1.5 font-sans text-sm font-bold uppercase tracking-wider text-red-600 mb-4"
                    >
                        <span class="relative flex h-3 w-3">
                            <span
                                class="relative inline-flex rounded-full h-3 w-3 bg-red-600"
                            ></span>
                        </span>
                        Watch the replay
                    </span>
                    <h2
                        class="font-sans text-2xl sm:text-3xl font-bold text-off-black"
                    >
                        Candidate Speeches
                    </h2>
                    <p class="mt-2 text-medium-gray">
                        Watch our candidates share their vision for the Junior
                        Board.
                    </p>
                    <p class="mt-3 text-sm text-gray-500 max-w-xl mx-auto">
                        The full candidate speeches are available on demand.
                    </p>
                </div>
                <div
                    class="relative rounded-2xl overflow-hidden shadow-2xl ring-1 ring-black/5 bg-black aspect-video"
                >
                    <iframe
                        src={electionLivestream.embedUrl}
                        title={electionLivestream.title}
                        class="absolute inset-0 w-full h-full"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allowfullscreen></iframe>
                </div>
                <div class="mt-4 text-center">
                    <a
                        href={electionLivestream.watchUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 text-sm font-semibold text-medium-gray transition hover:text-vibrant-pink"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-4 w-4"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            aria-hidden="true"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                            ></path>
                        </svg>
                        Open in YouTube
                    </a>
                </div>
            </div>
        </section>

        {/* Eligibility Info */}
        <section class="bg-white px-4 pb-12 sm:px-6">
            <div class="mx-auto max-w-4xl">
                <div
                    class="rounded-2xl bg-gradient-to-br from-slate-50 to-pink-50 p-8 shadow-lg ring-1 ring-black/5"
                >
                    <h3
                        class="font-sans text-xl font-bold text-off-black flex items-center gap-3 mb-4"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-6 w-6 text-vibrant-pink"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            aria-hidden="true"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                            ></path>
                        </svg>
                        Who Can Vote?
                    </h3>
                    <ul
                        class="list-inside list-disc space-y-2 font-body text-gray-700 ml-9"
                    >
                        {electionEligibility.map((group) => <li>{group}</li>)}
                    </ul>
                    <p class="mt-4 text-sm text-gray-500 italic ml-9">
                        Please review every candidate below and watch the
                        speeches before casting your vote. Voting eligibility is
                        verified after submission.
                    </p>
                </div>
            </div>
        </section>

        {/* Candidates by role */}
        <div class="bg-white">
            {
                electionRoles.map((role, index) => (
                    <section
                        class={`scroll-mt-28 ${index % 2 !== 0 ? "bg-slate-50 py-20" : "bg-white py-20"}`}
                        id={role.id}
                    >
                        <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
                            <div class="mb-12 text-center">
                                <h2 class="inline-block border-b-4 border-accent-gold pb-2 font-sans text-3xl sm:text-4xl font-extrabold uppercase text-off-black tracking-tight">
                                    {role.title}
                                </h2>
                                <p class="mx-auto mt-8 max-w-3xl font-body text-lg leading-relaxed text-gray-600">
                                    {role.responsibilities}
                                </p>
                                <p class="mt-6 font-sans text-xs font-bold uppercase tracking-[0.2em] text-vibrant-pink">
                                    {role.candidates.length} candidates on the
                                    ballot
                                </p>
                            </div>

                            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                                {role.candidates.map((candidate) => {
                                    const hasSpeech =
                                        typeof candidate.speech === "string" &&
                                        candidate.speech.trim().length > 0;
                                    const speechParagraphs = hasSpeech
                                        ? candidate.speech
                                              .split("\n\n")
                                              .map((paragraph) =>
                                                  paragraph.trim(),
                                              )
                                              .filter(Boolean)
                                        : [];
                                    const hasTimestamp =
                                        typeof candidate.speechTimestamp ===
                                        "number";
                                    const speechHref = hasTimestamp
                                        ? timestampedSpeechUrl(
                                              candidate.speechTimestamp,
                                          )
                                        : "#speeches";
                                    return (
                                        <article class="flex h-full flex-col items-center rounded-2xl border border-black/5 bg-white p-8 text-center shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
                                            <span
                                                class="flex h-20 w-20 items-center justify-center rounded-full bg-gradient-to-br from-vibrant-pink/20 to-accent-gold/30 font-sans text-2xl font-extrabold tracking-wide text-off-black"
                                                aria-hidden="true"
                                            >
                                                {candidateInitials(
                                                    candidate.name,
                                                )}
                                            </span>
                                            <h3 class="mt-5 font-sans text-xl font-bold text-off-black">
                                                {candidate.name}
                                            </h3>
                                            <p class="mt-1 font-sans text-xs font-bold uppercase tracking-[0.15em] text-vibrant-pink">
                                                Nominee for {role.title}
                                            </p>
                                            {hasSpeech ? (
                                                <div class="mt-4 w-full">
                                                    <p class="font-sans text-xs font-bold uppercase tracking-[0.15em] text-gray-400">
                                                        From their speech
                                                    </p>
                                                    <details class="mt-2 text-left">
                                                        <summary class="list-none cursor-pointer text-center font-sans text-sm font-semibold text-off-black underline decoration-accent-gold decoration-2 underline-offset-4 transition hover:text-vibrant-pink [&::-webkit-details-marker]:hidden">
                                                            Read their speech
                                                        </summary>
                                                        <div class="mt-3 space-y-3">
                                                            {speechParagraphs.map(
                                                                (
                                                                    paragraph,
                                                                ) => (
                                                                    <p class="font-body text-sm text-gray-600">
                                                                        {
                                                                            paragraph
                                                                        }
                                                                    </p>
                                                                ),
                                                            )}
                                                            <p class="font-body text-xs italic text-gray-400">
                                                                Transcribed
                                                                from the live
                                                                broadcast and
                                                                lightly edited
                                                                for
                                                                readability.
                                                            </p>
                                                        </div>
                                                    </details>
                                                </div>
                                            ) : (
                                                <p class="mt-4 font-body text-sm leading-relaxed text-gray-500">
                                                    Hear from this candidate
                                                    in the speeches above.
                                                </p>
                                            )}
                                            {hasTimestamp ? (
                                                <a
                                                    href={speechHref}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="mt-auto pt-5 font-sans text-sm font-semibold text-off-black underline decoration-accent-gold decoration-2 underline-offset-4 transition hover:text-vibrant-pink"
                                                >
                                                    Watch their speech
                                                </a>
                                            ) : (
                                                <a
                                                    href="#speeches"
                                                    class="mt-auto pt-5 font-sans text-sm font-semibold text-off-black underline decoration-accent-gold decoration-2 underline-offset-4 transition hover:text-vibrant-pink"
                                                >
                                                    Watch the speeches
                                                </a>
                                            )}
                                        </article>
                                    );
                                })}
                            </div>
                        </div>
                    </section>
                ))
            }
        </div>

        {/* Ballot */}
        <section class="bg-off-black py-16 scroll-mt-28" id="vote">
            <div class="mx-auto max-w-4xl px-4 sm:px-6">
                <div class="mb-10 text-center">
                    <h2 class="font-sans text-3xl font-bold text-white">
                        Cast Your Vote
                    </h2>
                    <p class="mx-auto mt-4 max-w-2xl text-gray-300">
                        The ballot below opens and closes on the schedule LSP
                        announces. Watch every speech, confirm each one, then
                        make your selections. Gracias for showing up for
                        nuestra comunidad.
                    </p>
                </div>

                <ElectionBallot roles={electionRoles} client:only="svelte" />

                <p class="mt-8 text-center text-sm text-gray-500">
                    Questions? Reach out at <a
                        href={`mailto:${election2026.contactEmail}`}
                        class="text-vibrant-pink hover:underline"
                        >{election2026.contactEmail}</a
                    >
                </p>
            </div>
        </section>
    </main>
</Layout>
