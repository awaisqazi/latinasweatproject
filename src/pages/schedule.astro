---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import { yttTrio, yttTrioSessions } from "@/data/yttTrio";
---

<Layout title="Schedule | The Latina Sweat Project">
  <Header />
  <main>
    {/* Compact policy strip */}
    <div class="mt-6 mb-4 px-4">
      <div class="mx-auto max-w-5xl">
        <div class="grid gap-3 sm:grid-cols-3">
          {/* Age Policy */}
          <div class="rounded-xl border border-red-200 bg-red-50/70 p-3.5 flex items-start gap-3">
            <span
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-red-100 text-red-700 text-base font-bold"
              >12+</span
            >
            <div class="min-w-0">
              <p
                class="text-[10px] font-bold uppercase tracking-[0.12em] text-red-700/80"
              >
                Age policy
              </p>
              <p
                class="mt-0.5 text-[13px] font-semibold text-red-900 leading-snug"
              >
                Participants must be 12 years or older to register and attend.
              </p>
            </div>
          </div>

          {/* Lockout Policy */}
          <div
            class="rounded-xl border border-vibrant-pink/30 bg-rose-50/70 p-3.5 flex items-start gap-3"
          >
            <span
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-vibrant-pink/15 text-vibrant-pink text-base"
              >🔒</span
            >
            <div class="min-w-0">
              <p
                class="text-[10px] font-bold uppercase tracking-[0.12em] text-vibrant-pink"
              >
                Late policy
              </p>
              <p
                class="mt-0.5 text-[13px] font-semibold text-off-black leading-snug"
              >
                Doors close 5 min after class begins.
                <a
                  href="/latepolicy"
                  class="text-vibrant-pink underline decoration-vibrant-pink/40 underline-offset-2 hover:text-accent-gold transition-colors"
                  >Here's why 🤍</a
                >
              </p>
            </div>
          </div>

          {/* Membership Cancellation */}
          <div
            class="rounded-xl border border-accent-gold/40 bg-amber-50/70 p-3.5 flex items-start gap-3"
          >
            <span
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-accent-gold/20 text-amber-800 text-base"
              >📋</span
            >
            <div class="min-w-0">
              <p
                class="text-[10px] font-bold uppercase tracking-[0.12em] text-amber-800"
              >
                Cancel membership
              </p>
              <p
                class="mt-0.5 text-[13px] font-semibold text-off-black leading-snug"
              >
                Email
                <a
                  href="mailto:membership@latinasweatproject.com"
                  class="text-amber-800 underline decoration-amber-800/40 underline-offset-2 hover:text-vibrant-pink transition-colors break-all"
                  >membership@latinasweatproject.com</a
                >. Takes effect after your 30-day cycle.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Trouble viewing link — tight spacing above the widget */}
    <div class="mt-2 px-4 text-center">
      <p class="text-vibrant-pink text-xs sm:text-sm leading-tight">
        Trouble viewing the schedule or registering below?
        <a
          href="https://latinasweatproject.marianatools.com/?_mt=/schedule/daily/48541?locations=48717"
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold underline transition hover:text-accent-gold"
          data-conversion-event="class_booking_start"
          data-conversion-context="schedule_trouble_link"
          data-conversion-provider="mariana_tek"
          data-conversion-booking-path="external_schedule"
          data-conversion-location-id="48717"
          >Open in a new window.</a
        >
      </p>
    </div>

    {/* MarianaTek embedded schedule */}
    <div
      id="schedule-widget"
      class="schedule-widget-tight"
      data-mariana-integrations="/schedule/daily/48541?locations=48717"
    >
    </div>

    {/* YTT ’26 Trio Community Classes: free community classes spotlighted
        below the schedule (replaces the expired May-to-July free-day
        promo). Daybreak-rose identity: the light sibling of the Graduation
        2026 candlelit-rose room, a deliberate family resemblance since
        these are the teachers who graduated Aug 7 stepping into their
        first live classes. Warm cream/blush ground, rose-ink #2b1520 text,
        gold #d79b47/#f0c57c accents, orchid #e08cb8 as a sparing
        highlight, Fraunces display serif (loaded globally in
        Layout.astro). Signature motif: the trio, one 45-minute flow split
        15 + 15 + 15 across three teachers (the tri-color dots beside each
        instructor name). The next upcoming session gets a NEXT treatment
        via the script at the bottom of this page. */}
    <div id="ytt-trio" class="relative overflow-hidden py-12 px-4 sm:py-16" style="background: linear-gradient(to bottom, #fdf7f0, #f9ede6);">
      {/* Soft daybreak glows: gold rising at the top, a whisper of orchid low */}
      <div class="pointer-events-none absolute -top-16 left-[18%] h-64 w-64 rounded-full blur-[100px]" style="background: rgba(240, 197, 124, 0.4);" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -top-10 right-[22%] h-48 w-48 rounded-full blur-[90px]" style="background: rgba(215, 155, 71, 0.22);" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-20 left-[55%] h-56 w-56 rounded-full blur-[100px]" style="background: rgba(224, 140, 184, 0.18);" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-5xl">
        {/* Series header */}
        <div class="text-center">
          <p class="inline-flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-xs font-extrabold uppercase tracking-[0.22em] sm:text-sm" style="color: #a5702c;">
            <span class="flex items-center gap-1.5" aria-hidden="true">
              <span class="h-1.5 w-1.5 rounded-full" style="background: #d79b47;"></span>
              <span class="h-1.5 w-1.5 rounded-full" style="background: #f0c57c;"></span>
              <span class="h-1.5 w-1.5 rounded-full" style="background: #e08cb8;"></span>
            </span>
            New community series · Fresh from Graduation 2026
          </p>
          <h2 class="mt-3 text-3xl leading-[1.08] tracking-tight sm:text-4xl lg:text-5xl" style="font-family: 'Fraunces', serif; font-weight: 650; color: #2b1520;">
            <span class="italic" style="color: #d79b47;">{yttTrio.cohortLabel}</span> Trio Community Classes
          </h2>
          <p class="mt-4 text-base font-bold sm:text-lg" style="color: #2b1520;">
            {yttTrio.dateRangeLabel} · {yttTrio.timeWindowLabel}
          </p>
          <p class="mt-1 text-sm font-semibold" style="color: rgba(43, 21, 32, 0.6);">
            {yttTrio.venueLine}
          </p>
          <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed" style="color: rgba(43, 21, 32, 0.75);">
            {yttTrio.description}
          </p>
          <div class="mt-5 flex flex-wrap items-center justify-center gap-2.5">
            <span class="rounded-full border px-3.5 py-1.5 text-xs font-bold" style="border-color: rgba(215, 155, 71, 0.45); background: rgba(255, 255, 255, 0.7); color: #2b1520;">
              {yttTrio.priceLine}
            </span>
            <span class="rounded-full border px-3.5 py-1.5 text-xs font-bold" style="border-color: rgba(224, 140, 184, 0.45); background: rgba(255, 255, 255, 0.7); color: #2b1520;">
              {yttTrio.formatLine}
            </span>
          </div>
        </div>

        {/* Every session: three names per card, front and center, since
            attendees come for their teacher. data-trio-date drives the
            NEXT highlight script below. */}
        <div class="mt-9 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
          {yttTrioSessions.map((session) => (
            <div class="trio-card" data-trio-date={session.date}>
              <div class="flex items-baseline justify-between gap-2">
                <p class="text-sm font-extrabold" style="color: #2b1520;">
                  {session.day} · {session.dateLabel}
                </p>
                <p class="text-sm font-extrabold tabular-nums" style="color: #a5702c;">
                  {session.time}
                </p>
              </div>
              <ul class="mt-3 space-y-1.5">
                {session.instructors.map((name, i) => (
                  <li class="flex items-center gap-2.5 text-base font-bold" style="color: #2b1520;">
                    <span class="h-2 w-2 shrink-0 rounded-full" style={`background: ${["#d79b47", "#f0c57c", "#e08cb8"][i]};`} aria-hidden="true"></span>
                    {name}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        {/* The emotional throughline */}
        <p class="mx-auto mt-10 max-w-2xl text-center text-lg italic leading-relaxed" style="font-family: 'Fraunces', serif; font-weight: 450; color: rgba(43, 21, 32, 0.8);">
          {yttTrio.supportLine}
        </p>

        <div class="mt-7 flex flex-col items-center gap-3">
          <a
            href={yttTrio.ticketsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="trio-cta group inline-flex items-center justify-center gap-3 rounded-full px-8 py-4 text-base font-extrabold transition hover:scale-[1.02]"
            data-conversion-event="ytt_trio_ticket_click"
            data-conversion-context="schedule_ytt_trio"
            data-conversion-provider="zeffy"
          >
            {yttTrio.ticketsLabel}
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
          <p class="text-sm font-bold" style="color: rgba(43, 21, 32, 0.65);">
            Free tickets · Donation to LSP encouraged
          </p>
        </div>
      </div>
    </div>

    {/* App Promo Banner — supporting tools at the bottom */}
    <div class="my-8 px-4">
      <div class="mx-auto max-w-5xl">
        <div
          class="rounded-xl bg-gradient-to-r from-off-black via-[#1a1a2e] to-off-black border border-accent-gold/30 p-4 sm:p-5"
        >
          <div class="flex flex-col sm:flex-row sm:items-center gap-4">
            <div class="flex items-center gap-3 flex-1 min-w-0">
              <span
                class="flex h-11 w-11 sm:h-12 sm:w-12 items-center justify-center rounded-lg bg-white p-1.5 shrink-0"
              >
                <img
                  src="/images/lsp-studio-logo.png"
                  alt="LSP Studio App"
                  class="h-full w-full object-contain"
                />
              </span>
              <div class="min-w-0">
                <p class="text-accent-gold font-bold text-sm sm:text-base leading-tight">
                  LSP Studio App
                </p>
                <p class="text-light-gray/75 text-xs sm:text-sm leading-snug">
                  Book classes, track workouts & manage your account on the go.
                </p>
              </div>
            </div>
            <div class="flex gap-2 sm:shrink-0">
              <a
                href="https://apps.apple.com/us/app/lsp-studio/id6755971141"
                target="_blank"
                rel="noopener noreferrer"
                class="group flex-1 sm:flex-initial flex items-center justify-center gap-2 rounded-lg border border-accent-gold/30 hover:border-accent-gold/60 bg-off-black px-4 py-2.5 transition-all duration-300 hover:shadow-lg hover:shadow-accent-gold/10"
                data-conversion-event="app_download_click"
                data-conversion-context="schedule_app_banner"
                data-conversion-platform="ios"
              >
                <svg
                  class="h-5 w-5 text-white"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"
                  ></path>
                </svg>
                <div class="text-left">
                  <p class="text-[10px] text-light-gray/70 leading-none">
                    Download on the
                  </p>
                  <p
                    class="text-sm font-bold text-white group-hover:text-accent-gold transition-colors leading-tight"
                  >
                    App Store
                  </p>
                </div>
              </a>
              <a
                href="https://play.google.com/store/apps/details?id=com.marianatek.latinasweatproject&hl=en_US"
                target="_blank"
                rel="noopener noreferrer"
                class="group flex-1 sm:flex-initial flex items-center justify-center gap-2 rounded-lg border border-green-500/30 hover:border-green-500/60 bg-off-black px-4 py-2.5 transition-all duration-300 hover:shadow-lg hover:shadow-green-500/10"
                data-conversion-event="app_download_click"
                data-conversion-context="schedule_app_banner"
                data-conversion-platform="android"
              >
                <svg
                  class="h-5 w-5 text-white"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.61 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"
                  ></path>
                </svg>
                <div class="text-left">
                  <p class="text-[10px] text-light-gray/70 leading-none">
                    Get it on
                  </p>
                  <p
                    class="text-sm font-bold text-white group-hover:text-green-400 transition-colors leading-tight"
                  >
                    Google Play
                  </p>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <style>
      /* Tighten the gap between the trouble-viewing line and the MarianaTek widget.
         The widget renders its own top spacing inside an iframe-like container we
         can't reach, but we can pull the wrapper up to compensate. */
      .schedule-widget-tight {
        margin-top: -0.5rem;
      }
      .schedule-widget-tight > * {
        margin-top: 0 !important;
        padding-top: 0 !important;
      }

      /* YTT ’26 Trio Community Classes: daybreak-rose session cards */
      .trio-card {
        position: relative;
        border-radius: 1rem;
        background: rgba(255, 255, 255, 0.75);
        border: 1.5px solid rgba(215, 155, 71, 0.35);
        padding: 1rem 1.15rem;
        transition: all 0.25s ease;
      }
      .trio-card:hover {
        background: #ffffff;
        border-color: rgba(215, 155, 71, 0.65);
        transform: translateY(-2px);
        box-shadow: 0 10px 24px -10px rgba(43, 21, 32, 0.18);
      }
      .trio-card[data-trio-next='true'] {
        background:
          linear-gradient(135deg, rgba(240, 197, 124, 0.35), rgba(224, 140, 184, 0.16)),
          #ffffff;
        border-color: #d79b47;
        box-shadow: 0 12px 28px -10px rgba(215, 155, 71, 0.5);
        animation: trio-pulse-gold 2.4s ease-in-out infinite;
      }
      .trio-card[data-trio-next='true']::before {
        content: '↓ NEXT';
        position: absolute;
        top: -10px;
        left: 50%;
        transform: translateX(-50%);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.08em;
        padding: 2px 8px;
        border-radius: 4px;
        background: #2b1520;
        color: #f0c57c;
        white-space: nowrap;
        box-shadow: 0 2px 6px rgba(43, 21, 32, 0.25);
      }
      @keyframes trio-pulse-gold {
        0%, 100% { box-shadow: 0 12px 28px -10px rgba(215, 155, 71, 0.5), 0 0 0 0 rgba(215, 155, 71, 0.45); }
        50% { box-shadow: 0 12px 28px -10px rgba(215, 155, 71, 0.5), 0 0 0 8px rgba(215, 155, 71, 0); }
      }

      /* Gold CTA: deep gold at rest, light gold on hover (rose-ink label) */
      .trio-cta {
        background: #d79b47;
        color: #2b1520;
        box-shadow: 0 12px 26px -10px rgba(215, 155, 71, 0.6);
      }
      .trio-cta:hover {
        background: #f0c57c;
      }
    </style>

    <script>
      (function () {
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        const todayStr =
          today.getFullYear() +
          '-' +
          String(today.getMonth() + 1).padStart(2, '0') +
          '-' +
          String(today.getDate()).padStart(2, '0');

        // Highlight the next upcoming YTT ’26 Trio session. Cards render
        // chronologically and the stable sort keeps same-date sessions in
        // their 6/7/8 PM DOM order, so the first card whose date is today
        // or later is the next one up.
        const cards = Array.from(
          document.querySelectorAll<HTMLElement>('[data-trio-date]'),
        );
        cards.sort((a, b) =>
          (a.dataset.trioDate || '').localeCompare(b.dataset.trioDate || ''),
        );
        const next = cards.find((c) => (c.dataset.trioDate || '') >= todayStr);
        if (next) next.dataset.trioNext = 'true';
      })();
    </script>
  </main>
</Layout>
