</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-rc-lb]");
  const dataEl = document.getElementById("rc-lb-data");
  if (dialog && dataEl) {
    const items: { src: string; srcset: string; alt: string; caption: string }[] = JSON.parse(dataEl.textContent || "[]");
    const img = dialog.querySelector<HTMLImageElement>("[data-rc-lb-img]")!;
    const cap = dialog.querySelector<HTMLElement>("[data-rc-lb-cap]")!;
    const count = dialog.querySelector<HTMLElement>("[data-rc-lb-count]")!;
    let i = 0;
    let opener: HTMLElement | null = null;
    const show = (n: number) => {
      i = (n + items.length) % items.length;
      const it = items[i];
      img.srcset = it.srcset;
      img.sizes = "100vw";
      img.src = it.src;
      img.alt = it.alt;
      cap.textContent = it.caption;
      count.textContent = `${i + 1} of ${items.length}`;
    };
    document.querySelectorAll<HTMLElement>("[data-rc-open]").forEach((btn) => {
      btn.addEventListener("click", () => {
        opener = btn;
        show(Number(btn.dataset.rcOpen));
        dialog.showModal();
      });
    });
    dialog.querySelector("[data-rc-lb-close]")?.addEventListener("click", () => dialog.close());
    dialog.querySelectorAll<HTMLElement>("[data-rc-lb-step]").forEach((b) =>
      b.addEventListener("click", () => show(i + Number(b.dataset.rcLbStep))),
    );
    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") show(i + 1);
      if (e.key === "ArrowLeft") show(i - 1);
    });
    // Tap on the black around the photo closes.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
    let x0: number | null = null;
    dialog.addEventListener("touchstart", (e) => (x0 = e.touches[0].clientX), { passive: true });
    dialog.addEventListener("touchend", (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) show(i + (dx < 0 ? 1 : -1));
      x0 = null;
    });
    dialog.addEventListener("close", () => opener?.focus({ preventScroll: true }));
  }
</script>
