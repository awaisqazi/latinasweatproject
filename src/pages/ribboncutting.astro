<script>
  // Hero loop. The poster (the loop's first frame) is a responsive <img> and
  // paints first; the video is attached only after the page has loaded, is
  // skipped for reduced motion and Save-Data, picks the 3:4 crop on phones and
  // the 16:9 file elsewhere, and fades in over the identical poster once it
  // is actually playing.
  const stage = document.querySelector<HTMLElement>("[data-rc-stage]");
  const vid = stage?.querySelector<HTMLVideoElement>("[data-rc-video]");
  const pp = stage?.querySelector<HTMLButtonElement>("[data-rc-pp]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  const phone = window.matchMedia("(max-width: 767px)");
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
  let userPaused = false;
  const setPaused = (paused: boolean) => {
    if (!pp) return;
    pp.classList.toggle("is-paused", paused);
    pp.setAttribute("aria-label", (paused ? pp.dataset.labelPlay : pp.dataset.labelPause) || "");
  };
  const start = () => {
    if (!stage || !vid || reduce.matches || saveData) return;
    const want = phone.matches ? stage.dataset.tall : stage.dataset.wide;
    if (!want || vid.getAttribute("src") === want) return;
    vid.src = want;
    vid.play().catch(() => {});
  };
  if (stage && vid) {
    vid.addEventListener("playing", () => {
      stage.classList.add("is-playing");
      if (pp) pp.hidden = false;
      setPaused(false);
    });
    vid.addEventListener("pause", () => setPaused(true));
    pp?.addEventListener("click", () => {
      if (vid.paused) {
        userPaused = false;
        vid.play().catch(() => {});
      } else {
        userPaused = true;
        vid.pause();
      }
    });
    // Pause while the stage is off screen (saves battery on phones).
    if ("IntersectionObserver" in window) {
      new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!vid.getAttribute("src")) return;
          if (e.isIntersecting && !userPaused) vid.play().catch(() => {});
          else if (!e.isIntersecting) vid.pause();
        }
      }).observe(stage);
    }
    if (document.readyState === "complete") start();
    else window.addEventListener("load", start, { once: true });
    phone.addEventListener("change", start);
    reduce.addEventListener("change", () => {
      if (reduce.matches) {
        vid.pause();
        stage.classList.remove("is-playing");
        if (pp) pp.hidden = true;
      } else start();
    });
  }

  // Lightbox.
  const dialog = document.querySelector<HTMLDialogElement>("[data-rc-lb]");
  const dataEl = document.getElementById("rc-lb-data");
  if (dialog && dataEl) {
    const items: { src: string; srcset: string; alt: string; caption: string }[] = JSON.parse(dataEl.textContent || "[]");
    const img = dialog.querySelector<HTMLImageElement>("[data-rc-lb-img]")!;
    const cap = dialog.querySelector<HTMLElement>("[data-rc-lb-cap]")!;
    const count = dialog.querySelector<HTMLElement>("[data-rc-lb-count]")!;
    let i = 0;
    let opener: HTMLElement | null = null;
    const show = (n: number) => {
      i = (n + items.length) % items.length;
      const it = items[i];
      img.srcset = it.srcset;
      img.sizes = "100vw";
      img.src = it.src;
      img.alt = it.alt;
      cap.textContent = it.caption;
      count.textContent = `${i + 1} of ${items.length}`;
    };
    document.querySelectorAll<HTMLElement>("[data-rc-open]").forEach((btn) => {
      btn.addEventListener("click", () => {
        opener = btn;
        show(Number(btn.dataset.rcOpen));
        dialog.showModal();
      });
    });
    dialog.querySelector("[data-rc-lb-close]")?.addEventListener("click", () => dialog.close());
    dialog.querySelectorAll<HTMLElement>("[data-rc-lb-step]").forEach((b) =>
      b.addEventListener("click", () => show(i + Number(b.dataset.rcLbStep))),
    );
    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") show(i + 1);
      if (e.key === "ArrowLeft") show(i - 1);
    });
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
    let x0: number | null = null;
    dialog.addEventListener("touchstart", (e) => (x0 = e.touches[0].clientX), { passive: true });
    dialog.addEventListener("touchend", (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) show(i + (dx < 0 ? 1 : -1));
      x0 = null;
    });
    dialog.addEventListener("close", () => opener?.focus({ preventScroll: true }));
  }
</script>
