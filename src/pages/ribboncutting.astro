---
// /ribboncutting: the Mural Park ribbon cutting (Sunday, November 15, 2026)
// and the grand reopening (Monday, November 16, 2026). The route name lives in
// RIBBON_CUTTING_SLUG (src/data/ribbonCutting.js); rename this file with it.
//
// Story order: the cut, moving (hero loop, a red ribbon across it that parts
// as the page arrives) -> how we got here (three beats on a ribbon thread) ->
// in their words (one large line per speaker, each with a frame of them from
// the night) -> the countdown and the cut, full bleed -> [watch: full remarks
// + reels, only when YouTube ids exist] -> the night in photos (five chapters
// by the clock) -> the album -> the ribbon line, named -> we're open.
//
// Identity: the Mural Park opening campaign carried onto the site: Warm White
// #f3eeea and black grounds, Fraunces headlines and quotes, Rubik body, the
// #FFDE59 highlight on exactly two words ("ribbon." and "Open"), plus this
// page's own accent, ribbon red #c3201f (sampled from the photos), used only
// as the ribbon itself: the band across the hero, the thread through the
// story, the underline on the album link. No cards, chips, rules or gradients.
// Type never sits on a face.
//
// All copy, quotes, photo lists and video ids: src/data/ribbonCutting.js.
// Photo derivatives: scripts/prepare-ribboncutting-photos.mjs. Share card:
// scripts/render-ribboncutting-og.mjs. Hero loop recipe:
// marketing/ribbon-cutting/qa/page-v2/README.md.
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import RibbonCuttingVideo from "@/components/RibbonCuttingVideo.astro";
import sizes from "@/data/ribbonCuttingPhotoSizes.json";
import {
  RIBBON_CUTTING_SLUG,
  ribbonCutting as rc,
  ribbonCuttingHeroLoop as loop,
  ribbonCuttingPhotos as photos,
  ribbonCuttingStory as story,
  ribbonCuttingRemarks as remarks,
  ribbonCuttingLinePhoto as line,
  ribbonCuttingCutStill as cut,
  ribbonCuttingVideo as video,
  UNNAMED_SPEAKER,
  PHOTO_DIR,
  PHOTO_WIDTHS,
} from "@/data/ribbonCutting";

const base = import.meta.env.BASE_URL;
const dir = `${base}${PHOTO_DIR}`;
const dims = (id: string) => {
  const d = (sizes as Record<string, [number, number]>)[id];
  if (!d) throw new Error(`ribboncutting: no derivative for ${id}; run scripts/prepare-ribboncutting-photos.mjs`);
  return d;
};
const srcset = (id: string, widths: number[] = PHOTO_WIDTHS) => {
  const [w] = dims(id);
  return widths.map((x) => `${dir}/${id}-${x}.webp ${Math.min(x, w)}w`).join(", ");
};
for (const ch of story) for (const row of ch.rows) for (const id of row) {
  if (!photos[id as keyof typeof photos]) throw new Error(`ribboncutting: ${id} has no alt text`);
}

// Hero loop: posters (the loop's first frame) for both crops.
const posterSet = (p: { poster: string; posterWidths: number[] }) =>
  p.posterWidths.map((w) => `${base}${p.poster}-${w}.webp ${w}w`).join(", ");
const wideSet = posterSet(loop.wide);
const tallSet = posterSet(loop.tall);

type Photo = { alt: string; caption?: string; phoneCrop?: string; phonePosition?: string; crop?: string; position?: string };
const ratio = (r: string) => {
  const [a, b] = r.split("/").map(Number);
  return a / b;
};
// A photo's displayed aspect: its own, or its `crop` when it has one.
const ar = (id: string) => {
  const p = photos[id as keyof typeof photos] as Photo;
  if (p?.crop) return ratio(p.crop);
  const [w, h] = dims(id);
  return w / h;
};
// The lightbox walks every story photo in page order.
const order = story.flatMap((ch) => ch.rows.flat());
const MAX_ROW = 1376; // px, the gallery's content width at desktop

const hasFull = Boolean(video.fullRemarks.youtubeId);
const reels = video.highlights.filter((h) => h.youtubeId);
const hasWatch = hasFull || reels.length > 0;
const albumLabel = rc.album.label.replace("{n}", String(video.albumCount ?? "")).replace("all  ", "all ");

const cutSet = srcset(cut.id, [...PHOTO_WIDTHS, 2400]);
const [cutW, cutH] = dims(cut.id);
const [lineW, lineH] = dims(line.id);

const pageUrl = `https://latinasweatproject.com/${RIBBON_CUTTING_SLUG}`;
---

<Layout
  title={rc.metaTitle}
  socialTitle={rc.socialTitle}
  description={rc.metaDescription}
  socialImage={`${PHOTO_DIR}/ribboncutting-og.jpg`}
  socialImageAlt="We cut the ribbon. Our new home at Mural Park, in Pilsen. Latina Sweat Project."
  socialImageWidth={1200}
  socialImageHeight={630}
  socialImageType="image/jpeg"
  twitterCard="summary_large_image"
>
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,700;0,9..144,900;1,9..144,400&display=swap"
    rel="stylesheet"
  />
  <link slot="head" rel="preload" as="image" imagesrcset={wideSet} imagesizes="100vw" media="(min-width: 768px)" fetchpriority="high" />
  <link slot="head" rel="preload" as="image" imagesrcset={tallSet} imagesizes="100vw" media="(max-width: 767px)" fetchpriority="high" />
  <Header />
  <main class="rc-page font-rubik" data-page-url={pageUrl}>
    {/* ============================ THE CUT =============================== */}
    <section class="rc-hero" aria-labelledby="rc-title">
      <div class="rc-wrap rc-hero-text">
        <h1 id="rc-title" class="rc-display">
          <span class="block">{rc.headline[0]}</span>
          <span class="rc-mark">{rc.headline[1]}</span>
        </h1>
        <div class="rc-hero-side">
          <p class="rc-sub">{rc.sub}</p>
          <p class="rc-date">{rc.dateLine}</p>
        </div>
      </div>
      <div class="rc-stage" data-rc-stage data-wide={`${base}${loop.wide.src}`} data-tall={`${base}${loop.tall.src}`}>
        <picture>
          <source media="(max-width: 767px)" srcset={tallSet} sizes="100vw" width={loop.tall.size[0]} height={loop.tall.size[1]} />
          <img
            class="rc-stage-media"
            src={`${base}${loop.wide.poster}-1600.webp`}
            srcset={wideSet}
            sizes="100vw"
            width={loop.wide.size[0]}
            height={loop.wide.size[1]}
            alt={loop.alt}
            fetchpriority="high"
            decoding="async"
          />
        </picture>
        <video class="rc-stage-media rc-stage-video" muted playsinline loop preload="none" aria-hidden="true" tabindex="-1" disablepictureinpicture data-rc-video></video>
        <div class="rc-ribbon" aria-hidden="true">
          <span class="rc-ribbon-half rc-ribbon-l"></span>
          <span class="rc-ribbon-half rc-ribbon-r"></span>
        </div>
        <button type="button" class="rc-pp" data-rc-pp hidden aria-label={rc.pauseLabel} data-label-pause={rc.pauseLabel} data-label-play={rc.playLabel}>
          <svg class="rc-pp-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"></path></svg>
          <svg class="rc-pp-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z"></path></svg>
        </button>
      </div>
    </section>

    {/* ========================== HOW WE GOT HERE ========================= */}
    <section id="story" class="rc-story" aria-labelledby="rc-story-title">
      <div class="rc-wrap">
        <h2 id="rc-story-title" class="rc-h2">{rc.story.heading}</h2>
        <div class="rc-thread-row">
          <span class="rc-thread" aria-hidden="true"></span>
          <ol class="rc-beats">
            {rc.story.beats.map((b) => (
              <li class="rc-beat">
                <h3 class="rc-beat-title">{b.title}</h3>
                {b.body && <p class="rc-beat-body">{b.body}</p>}
                {b.quote && (
                  <figure class="rc-beat-quote">
                    <blockquote><p>“{b.quote}”</p></blockquote>
                    <figcaption>{b.who}</figcaption>
                  </figure>
                )}
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    {/* ============================ IN THEIR WORDS ======================== */}
    <section id="remarks" class="rc-dark rc-words" aria-labelledby="rc-words-title">
      <div class="rc-wrap">
        <h2 id="rc-words-title" class="rc-h2">{rc.remarks.heading}</h2>
        <div class="rc-quotes">
          {remarks.map((r) =>
            r.room ? (
              <figure class="rc-q rc-q--room">
                <blockquote><p class="rc-q-lead">{r.lead}</p></blockquote>
                <figcaption class="rc-q-who"><span class="rc-q-role">{r.room}</span></figcaption>
              </figure>
            ) : (
              <figure class="rc-q">
                {r.portrait && (
                  <div class="rc-q-photo">
                    <img
                      src={`${dir}/${r.portrait}-640.webp`}
                      srcset={srcset(r.portrait)}
                      sizes="(min-width: 1024px) 352px, 60vw"
                      width={dims(r.portrait)[0]}
                      height={dims(r.portrait)[1]}
                      alt={r.portraitAlt}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}
                <div class="rc-q-body">
                  <blockquote>
                    <p class="rc-q-lead">“{r.lead}”</p>
                    {r.more?.map((m) => <p class="rc-q-more">“{m.text}”</p>)}
                  </blockquote>
                  <figcaption class="rc-q-who">
                    <span class="rc-q-name">{r.name ?? UNNAMED_SPEAKER}</span>
                    {r.name && r.role && <span class="rc-q-role">{r.role}</span>}
                  </figcaption>
                </div>
              </figure>
            ),
          )}
        </div>
        <p class="rc-count">{rc.remarks.countdown}</p>
      </div>
      <figure class="rc-cut">
        <img
          src={`${dir}/${cut.id}-1600.webp`}
          srcset={cutSet}
          sizes="100vw"
          width={cutW}
          height={cutH}
          alt={cut.alt}
          loading="lazy"
          decoding="async"
        />
      </figure>

      {hasWatch && (
        <div id="watch" class="rc-wrap rc-watch">
          <h2 class="rc-h2 rc-watch-title">{rc.watch.heading}</h2>
          {hasFull && (
            <div class="rc-full">
              <RibbonCuttingVideo
                youtubeId={video.fullRemarks.youtubeId!}
                title={video.fullRemarks.title}
                poster={video.fullRemarks.poster}
                imgSizes="(min-width: 1280px) 1216px, 100vw"
                context="ribboncutting_full_remarks"
              >
                <p class="rc-vid-title">
                  {video.fullRemarks.title}
                  {video.fullRemarks.duration && <span class="rc-vid-meta"> · {video.fullRemarks.duration}</span>}
                </p>
              </RibbonCuttingVideo>
            </div>
          )}
          {reels.length > 0 && (
            <div class="rc-reels-block">
              {hasFull && <h3 class="rc-h3">{rc.watch.reelsHeading}</h3>}
              <ul class="rc-reels" style={`--n:${reels.length}`}>
                {reels.map((h, i) => (
                  <li>
                    <RibbonCuttingVideo
                      youtubeId={h.youtubeId!}
                      title={h.title}
                      aspect="9/16"
                      poster={h.poster}
                      imgSizes="(min-width: 1024px) 240px, 70vw"
                      posterPosition={h.posterPosition}
                      context={`ribboncutting_reel_${i + 1}`}
                    >
                      <p class="rc-vid-title">{h.title}</p>
                      {h.speaker && <p class="rc-vid-meta">{h.speaker}</p>}
                    </RibbonCuttingVideo>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )}
    </section>

    {/* ========================= THE NIGHT IN PHOTOS ====================== */}
    <section id="photos" class="rc-dark rc-photos" aria-labelledby="rc-photos-title">
      <div class="rc-wrap">
        <h2 id="rc-photos-title" class="rc-h2">{rc.photos.heading}</h2>
      </div>
      <div class="rc-gallery">
        {story.map((ch) => (
          <div class="rc-chapter" id={`photos-${ch.key}`}>
            <h3 class="rc-ch-title">
              {ch.label}
              <span class="rc-ch-time">{ch.time}</span>
            </h3>
            {ch.rows.map((row, ri) => {
              const sum = row.reduce((n, id) => n + ar(id), 0);
              const lead = ri === 0 && row.length === 1;
              const stack = sum > 1;
              // A lone landscape that is not the lead keeps a little air at its sides.
              const cap = !lead && row.length === 1 ? 1088 : null;
              const rowW = cap ?? MAX_ROW;
              return (
                <div
                  class:list={["rc-row", { "rc-row--stack": stack, "rc-row--lead": lead, "rc-row--cap": cap }]}
                  style={cap ? `--cap:${cap}px` : undefined}
                >
                  {row.map((id) => {
                    const p = photos[id as keyof typeof photos] as Photo;
                    const [w, h] = dims(id);
                    const share = ar(id) / sum;
                    const desk = Math.round(rowW * share);
                    const sizesAttr = `(min-width: 1440px) ${desk}px, (min-width: 640px) ${Math.round(share * 100)}vw, 100vw`;
                    return (
                      <figure
                        class:list={{ "rc-crop": p.phoneCrop, "rc-fixed": p.crop }}
                        style={`--ar:${ar(id).toFixed(4)}` +
                          (p.crop ? `;--dpos:${p.position ?? "50% 50%"}` : "") +
                          (p.phoneCrop ? `;--crop:${p.phoneCrop};--pos:${p.phonePosition ?? "50% 50%"}` : "")}
                      >
                        <button
                          type="button"
                          class="rc-ph"
                          data-rc-open={order.indexOf(id)}
                          aria-label={`Open photo: ${p.alt}`}
                        >
                          <img
                            src={`${dir}/${id}-1080.webp`}
                            srcset={srcset(id)}
                            sizes={sizesAttr}
                            width={w}
                            height={h}
                            alt={p.alt}
                            loading="lazy"
                            decoding="async"
                          />
                        </button>
                        {p.caption && <figcaption>{p.caption}</figcaption>}
                      </figure>
                    );
                  })}
                </div>
              );
            })}
          </div>
        ))}
      </div>
      {video.albumUrl && (
        <div class="rc-wrap rc-album">
          <a
            href={video.albumUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-conversion-event="ribboncutting_album_click"
            data-conversion-context="ribboncutting_photos"
          >{albumLabel}</a>
          <p class="rc-album-note">{rc.album.note}</p>
        </div>
      )}
    </section>

    {/* =========================== THE RIBBON LINE ======================== */}
    <section id="ribbon-line" class="rc-line" aria-labelledby="rc-line-title">
      <div class="rc-wrap">
        <div class="rc-line-head">
          <h2 id="rc-line-title" class="rc-h2">{rc.line.heading}</h2>
          <figure class="rc-line-quote">
            <blockquote><p>“{rc.line.quote}”</p></blockquote>
            <figcaption>{rc.line.who}</figcaption>
          </figure>
        </div>
        <figure class="rc-line-photo">
          <img
            src={`${dir}/${line.id}-1600.webp`}
            srcset={srcset(line.id)}
            sizes="(min-width: 1280px) 1216px, 100vw"
            width={lineW}
            height={lineH}
            alt={line.alt}
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            <p class="rc-line-from">{rc.line.from}</p>
            <ol class="rc-line-names">
              {line.people.map((p) => (
                <li><span class="rc-line-name">{p.name}</span> <span class="rc-line-role">{p.role}</span></li>
              ))}
            </ol>
          </figcaption>
        </figure>
        <p class="rc-line-thanks">{rc.line.thanks}</p>
      </div>
    </section>

    {/* ============================== WE'RE OPEN ========================== */}
    <section id="open" class="rc-open" aria-labelledby="rc-open-title">
      <div class="rc-wrap rc-open-grid">
        <div>
          <h2 id="rc-open-title" class="rc-black">
            <span class="block">{rc.open.heading[0]}</span>
            <span class="block">{rc.open.heading[1]}</span>
          </h2>
          <p class="rc-place">{rc.open.place.map((l, i) => (i ? <><br />{l}</> : l))}</p>
          <div class="rc-cta">
            <a
              href={`${base}${rc.open.bookPath}`}
              class="rc-btn"
              data-conversion-event="class_booking_start"
              data-conversion-context="ribboncutting_open"
              data-conversion-booking-path="schedule_page"
            >{rc.open.bookLabel}</a>
            <a href={rc.open.directionsUrl} class="rc-link" target="_blank" rel="noopener noreferrer">{rc.open.directionsLabel}</a>
          </div>
          <p class="rc-signoff">{rc.open.signoff}</p>
        </div>
        <p class="rc-open-word" aria-hidden="true"><span class="rc-mark">{rc.open.word}</span></p>
      </div>
    </section>
  </main>

  {/* Lightbox, outside <main> so no stacking context traps it under the header. */}
  <dialog class="rc-lb" aria-label="Photos" data-rc-lb>
    <figure>
      <img alt="" data-rc-lb-img />
      <figcaption data-rc-lb-cap></figcaption>
    </figure>
    <button type="button" class="rc-lb-btn rc-lb-close" data-rc-lb-close aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
    <button type="button" class="rc-lb-btn rc-lb-prev" data-rc-lb-step="-1" aria-label="Previous photo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 5l-7 7 7 7"></path></svg>
    </button>
    <button type="button" class="rc-lb-btn rc-lb-next" data-rc-lb-step="1" aria-label="Next photo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5l7 7-7 7"></path></svg>
    </button>
    <p class="rc-lb-count" data-rc-lb-count></p>
  </dialog>
  <script
    type="application/json"
    id="rc-lb-data"
    set:html={JSON.stringify(
      order.map((id) => {
        const p = photos[id as keyof typeof photos] as { alt: string; caption?: string };
        return { src: `${dir}/${id}-1600.webp`, srcset: srcset(id), alt: p.alt, caption: p.caption ?? "" };
      }),
    )}
  />
</Layout>

<style>
  .rc-page {
    --rc-warm: #f3eeea;
    --rc-gray: #4e4f50;
    --rc-hi: #ffde59;
    /* Ribbon red, sampled from the ribbon in the photos and the 4K frames. */
    --rc-red: #c3201f;
    background: var(--rc-warm);
    color: #000;
  }
  .rc-wrap {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
  @media (min-width: 640px) {
    .rc-wrap {
      padding: 0 1.5rem;
    }
  }
  @media (min-width: 1024px) {
    .rc-wrap {
      padding: 0 2rem;
    }
  }

  /* ---------- type ---------- */
  .rc-display,
  .rc-h2,
  .rc-black,
  .rc-beat-title,
  .rc-beat-quote p,
  .rc-q-lead,
  .rc-q-more,
  .rc-count,
  .rc-ch-title,
  .rc-album a,
  .rc-line-quote p,
  .rc-signoff,
  .rc-open-word {
    font-family: "Fraunces", Georgia, serif;
    font-optical-sizing: auto;
  }
  .rc-display {
    font-weight: 400;
    font-size: clamp(3.5rem, 15vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  /* The campaign's highlight: Fraunces Bold on #FFDE59 with soft corners. */
  .rc-mark {
    display: inline-block;
    margin-left: -0.08em;
    margin-top: 0.06em;
    padding: 0.02em 0.14em 0.1em 0.08em;
    border-radius: 0.2em;
    background: var(--rc-hi);
    font-weight: 700;
  }
  .rc-h2 {
    font-weight: 400;
    font-size: clamp(2.375rem, 10vw, 3rem);
    line-height: 1.04;
    letter-spacing: -0.015em;
  }
  .rc-h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .rc-dark {
    background: #000;
    color: #fff;
  }

  /* ---------- hero ---------- */
  .rc-hero {
    padding-top: 1.75rem;
  }
  .rc-hero-text {
    display: grid;
    gap: 0.25rem;
    padding-bottom: 1.25rem;
  }
  .rc-sub {
    text-wrap: balance;
    font-size: 1.25rem;
    line-height: 1.3;
    font-weight: 500;
  }
  .rc-date {
    margin-top: 0.2rem;
    font-size: 1rem;
    color: var(--rc-gray);
  }
  .rc-hero-side {
    order: 3;
    padding: 1.25rem 0 0;
  }
  /* The hero side text sits under the video on phones (see the grid below). */
  @media (max-width: 767px) {
    .rc-hero {
      display: flex;
      flex-direction: column;
    }
    .rc-hero-text {
      display: contents;
    }
    .rc-display {
      order: 1;
      padding: 0 1rem 1.25rem;
    }
    .rc-stage {
      order: 2;
    }
    .rc-hero-side {
      order: 3;
      padding: 1.1rem 1rem 0;
    }
  }
  .rc-stage {
    position: relative;
    overflow: hidden;
    background: #1a1714;
    aspect-ratio: 3 / 4;
  }
  .rc-stage picture {
    display: contents;
  }
  .rc-stage-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0%;
  }
  .rc-stage-video {
    opacity: 0;
    transition: opacity 250ms ease;
  }
  .rc-stage.is-playing .rc-stage-video {
    opacity: 1;
  }
  @media (min-width: 768px) {
    .rc-stage {
      aspect-ratio: auto;
      height: clamp(26rem, calc(100svh - 23.25rem), 56.25vw);
    }
    .rc-stage-media {
      object-position: 50% 6%;
    }
  }

  /* The ribbon across the stage: one flat band of ribbon red, cut in the
     middle as the page arrives; each half swings down from its end of the
     frame like the real ends did, then goes. */
  .rc-ribbon {
    position: absolute;
    left: 0;
    right: 0;
    top: 47%;
    height: clamp(0.875rem, 1.5vw, 1.375rem);
    pointer-events: none;
    --v: clamp(0.875rem, 1.5vw, 1.375rem);
  }
  .rc-ribbon-half {
    position: absolute;
    top: 0;
    bottom: 0;
    width: calc(50% + 1px);
    background: var(--rc-red);
    animation: 1.25s cubic-bezier(0.5, 0, 0.8, 0.5) 0.8s both;
  }
  .rc-ribbon-l {
    left: 0;
    transform-origin: 0 50%;
    clip-path: polygon(0 0, 100% 0, 100% 50%, 100% 100%, 0 100%);
    animation-name: rc-fall-l;
  }
  .rc-ribbon-r {
    right: 0;
