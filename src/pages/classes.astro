---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import PopUpWeekBand from "@/components/PopUpWeekBand.astro";
import StudioTransitionSection from "@/components/StudioTransitionSection.astro";
// Toggle lives in src/data/transition.js: false = studio transition section
// in place of the MarianaTek widget; true = the original booking page.
import { showMarianaSchedule } from "@/data/transition";
---

<Layout title="Schedule | The Latina Sweat Project">
  <Header />
  <main>
    <div class="my-8 px-4">
      <div
        class="mx-auto max-w-4xl rounded-lg border border-red-300 bg-red-50 p-4 text-center"
      >
        <p class="font-semibold text-red-800">
          Please note: Participants must be 12 years of age or older to register
          for and attend classes.
        </p>
      </div>
    </div>
    {!showMarianaSchedule && (
      <div class="my-8 px-4">
        <div class="mx-auto max-w-4xl">
          <StudioTransitionSection
            context="classes_transition"
            popupView="full"
            popupContext="classes_page"
            popupFinishLineContext="classes_finishline_crosslink"
          />
        </div>
      </div>
    )}
    {showMarianaSchedule && (<>
    {/* Pop Up Week 1 (Oct 5 to 11, 2026): Zeffy per location, above the
        MarianaTek widget; shows the current week, auto-hides after the last
        week (see popUpWeeks.js). */}
    <div class="my-8 px-4">
      <div class="mx-auto max-w-4xl">
        <PopUpWeekBand context="classes_popup_band" />
      </div>
    </div>
    <div class="my-8 px-4 text-center">
      <p class="text-vibrant-pink">
        Trouble viewing the schedule or registering below?
        <a
          href="https://latinasweatproject.marianatools.com/?_mt=/schedule/daily/48541?locations=48717"
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold underline transition hover:text-accent-gold"
          data-conversion-event="class_booking_start"
          data-conversion-context="classes_trouble_link"
          data-conversion-provider="mariana_tek"
          data-conversion-booking-path="external_schedule"
          data-conversion-location-id="48717"
          >Open in a new window.</a
        >
      </p>
    </div>
    <div
      data-mariana-integrations="/schedule/daily/48541?locations=48717"
    >
    </div>
    </>)}
  </main>
</Layout>
