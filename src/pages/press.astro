---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Abc7Segment from "@/components/Abc7Segment.astro";
import { pressArticles } from "@/data/press";
import { abc7Feature } from "@/data/abc7WindyCity";
const base = import.meta.env.BASE_URL;
const featured = pressArticles.find((a) => a.featured);
// ABC7 has its own "on air" hero below, so its card stays out of the grid.
const rest = pressArticles.filter((a) => !a.featured && a.key !== abc7Feature.key);
---

<Layout title="In the Press | Latina Sweat Project">
  <Header />
  <main>
    {/* Hero Header */}
    <section class="relative bg-off-black py-20 sm:py-28">
      <div class="absolute inset-0 bg-gradient-to-br from-vibrant-pink/10 via-transparent to-accent-gold/10"></div>
      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-sm font-bold uppercase tracking-widest text-vibrant-pink">
          Media Coverage
        </p>
        <h1 class="mt-3 font-sans text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
          Latina Sweat Project<br />in the Press
        </h1>
        <p class="mt-6 mx-auto max-w-2xl font-body text-lg text-slate-300 sm:text-xl">
          See what the community is saying about our mission to make yoga and wellness accessible to all.
        </p>
      </div>
    </section>

    {/* ON AIR: ABC7 Chicago "Windy City Weekend" (Sep 25, 2026, gala day).
        A broadcast identity (abc blue #0058f0, ink #202030) inside the
        design.md dark-section blueprint, so it reads as a clip from the
        outlet. The player is a click-to-load facade (Abc7Segment). */}
    <section id="abc7-windy-city" class="relative scroll-mt-24 overflow-hidden bg-off-black py-14 sm:py-20">
      <div class="absolute inset-0 bg-gradient-to-br from-off-black via-off-black to-[#202030]" aria-hidden="true"></div>
      {/* Top accent line */}
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-[#0058f0] to-transparent opacity-90" aria-hidden="true"></div>
      {/* Decorative glows: abc blue behind the player, gold behind the copy */}
      <div class="pointer-events-none absolute -top-32 -right-20 h-[420px] w-[420px] rounded-full bg-[#0058f0]/20 blur-[120px]" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-32 -left-20 h-[400px] w-[400px] rounded-full bg-accent-gold/10 blur-[120px]" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
          {/* Player: first on mobile, right on desktop */}
          <div class="order-1 lg:order-2 lg:col-span-7">
            <Abc7Segment variant="spotlight" context="press_abc7_hero" id="abc7-player-press" />
          </div>

          {/* Copy */}
          <div class="order-2 lg:order-1 lg:col-span-5">
            <div class="flex flex-wrap items-center gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-white shadow-lg">
                <img
                  src={`${base}${abc7Feature.logo.replace(/^\//, "")}`}
                  alt="ABC7 Chicago"
                  width="512"
                  height="512"
                  class="h-full w-full scale-[1.2] object-contain"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <div class="inline-flex items-center gap-2 rounded-full border border-[#0058f0]/50 bg-[#0058f0]/15 px-4 py-1.5">
                <span class="relative flex h-2 w-2">
                  <span class="absolute inline-flex h-full w-full rounded-full bg-red-500 opacity-75 motion-safe:animate-ping"></span>
                  <span class="relative inline-flex h-2 w-2 rounded-full bg-red-500"></span>
                </span>
                <p class="text-xs font-bold uppercase tracking-[0.25em] text-white">On air · ABC7 Chicago</p>
              </div>
            </div>

            <p class="mt-6 text-xs font-extrabold uppercase tracking-[0.22em] text-white/55">
              {abc7Feature.byline}
            </p>
            <h2 class="mt-3 font-sans text-4xl font-black leading-[1.02] tracking-tight text-white sm:text-5xl xl:text-6xl">
              “Latina Sweat Project joins{" "}
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-vibrant-pink to-accent-gold">‘Windy City Weekend’</span>”
            </h2>
            <p class="mt-5 font-body text-base leading-relaxed text-slate-300 sm:text-lg">
              {abc7Feature.blurb}
            </p>

            {/* Segment chips */}
            <div class="mt-6 flex flex-wrap gap-2">
              {abc7Feature.chips.map((chip) => (
                <span class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-white/70">
                  <span class="text-accent-gold">{chip.n}</span> {chip.en}
                </span>
              ))}
            </div>

            <blockquote class="mt-8 border-l-4 border-[#0058f0] pl-5">
              <p class="font-display text-xl italic leading-snug text-white sm:text-2xl">“{abc7Feature.quote}”</p>
              <cite class="mt-2 block text-xs font-extrabold uppercase not-italic tracking-[0.18em] text-[#8fb4ff]">{abc7Feature.quoteAttribution}</cite>
            </blockquote>

            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a
                href={abc7Feature.articleUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-conversion-event="press_abc7_click"
                data-conversion-context="press_abc7_hero"
                class="inline-flex items-center gap-2 rounded-full bg-[#0058f0] px-6 py-3 text-sm font-bold text-white shadow-lg shadow-[#0058f0]/25 transition-all duration-300 hover:-translate-y-0.5 hover:brightness-110 hover:shadow-xl"
              >
                {abc7Feature.cta.readOnAbc7.en}
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
              <a
                href={abc7Feature.videoPageUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-conversion-event="press_abc7_click"
                data-conversion-context="press_abc7_hero"
                class="inline-flex items-center gap-2 rounded-full border-2 border-white/20 bg-white/5 px-6 py-3 text-sm font-bold text-white transition-all duration-300 hover:border-[#0058f0]/70 hover:bg-white/10"
              >
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M8 5v14l11-7z" />
                </svg>
                {abc7Feature.cta.watchOnAbc7.en}
              </a>
            </div>
          </div>
        </div>
      </div>

      {/* Bottom accent line */}
      <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-accent-gold to-transparent opacity-40" aria-hidden="true"></div>
    </section>

    {/* Featured coverage: the Chicago Reader's graduation feature, in the
        Reader's own yellow/black newsprint look (their wordmark, their
        pull-quote orange), so it reads as a clipping, not an LSP card. */}
    {featured && (
      <section class="bg-[#ffd210] py-12 sm:py-16">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="grid items-center gap-10 lg:grid-cols-2">
            <div>
              <img
                src={`${base}${featured.logo.replace(/^\//, "")}`}
                alt="Chicago Reader"
                width="848"
                height="222"
                class="h-12 w-auto sm:h-14"
                loading="lazy"
                decoding="async"
              />
              <div class="mt-5 h-1.5 w-24 bg-[#111111]"></div>
              <p class="mt-6 text-xs font-extrabold uppercase tracking-[0.22em] text-[#111111]/70">
                Featured · {featured.byline}
              </p>
              <h2 class="mt-3 font-sans text-4xl font-black leading-[1.02] tracking-tight text-[#111111] sm:text-5xl lg:text-6xl">
                “{featured.title}”
              </h2>
              <p class="mt-5 max-w-xl font-body text-lg leading-relaxed text-[#111111]/85">
                {featured.snippet}
              </p>
              {featured.quote && (
                <blockquote class="mt-7 border-l-4 border-[#f79102] pl-5">
                  <p class="font-serif text-2xl italic leading-snug text-[#111111]">“{featured.quote}”</p>
                  <cite class="mt-2 block text-xs font-extrabold uppercase not-italic tracking-[0.18em] text-[#f79102]">{featured.quoteAttribution}</cite>
                </blockquote>
              )}
              <a
                href={featured.url}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-8 inline-flex items-center gap-2 bg-[#111111] px-7 py-3.5 text-sm font-extrabold uppercase tracking-widest text-[#ffd210] transition-all duration-300 hover:-translate-y-0.5 hover:bg-black hover:shadow-xl"
              >
                {featured.ctaLabel ?? "Read the Story"}
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
            <div>
              <div class="relative">
              <div class="absolute inset-0 translate-x-3 translate-y-3 bg-[#f79102]" aria-hidden="true"></div>
              <div class="relative border-[10px] border-[#111111] bg-[#111111]">
                <img
                  src={`${base}${featured.image.replace(/^\//, "")}`}
                  alt={featured.imageAlt}
                  width="1600"
                  height="1067"
                  class="block w-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              </div>
              <p class="mt-6 text-[11px] font-bold uppercase tracking-[0.18em] text-[#111111]/60">Photo: Estevan Cruz · Latina Sweat Project</p>
            </div>
          </div>
        </div>
      </section>
    )}

    {/* Press Cards */}
    <section class="py-12 sm:py-16 lg:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
          {rest.map((article) => (
            <div class="group rounded-2xl bg-white p-8 shadow-sm border border-gray-100 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-vibrant-pink/20">
              <div class="flex items-center gap-3 mb-4">
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-vibrant-pink/10">
                  <svg class="h-5 w-5 text-vibrant-pink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                  </svg>
                </span>
                <p class="text-sm font-bold uppercase tracking-wider text-vibrant-pink">
                  {article.outlet}
                </p>
              </div>
              <h2 class="font-sans text-xl font-bold text-off-black leading-snug sm:text-2xl">
                {article.title}
              </h2>
              <p class="mt-3 font-body text-base text-medium-gray leading-relaxed">
                {article.snippet}
              </p>
              <a
                href={article.isInternal ? `${base}${article.url.replace(/^\//, "")}` : article.url}
                target={article.isInternal ? undefined : "_blank"}
                rel={article.isInternal ? undefined : "noopener noreferrer"}
                class="mt-6 inline-flex items-center gap-2 rounded-full bg-off-black px-6 py-2.5 text-sm font-bold text-white transition-all duration-300 hover:bg-vibrant-pink hover:scale-105 hover:shadow-lg"
              >
                {article.ctaLabel ?? (article.isVideo ? "Watch Full Spotlight" : "Read Full Article")}
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          ))}
        </div>

        {/* Back to Home CTA */}
        <div class="mt-16 text-center">
          <p class="font-body text-lg text-medium-gray mb-6">
            Want to learn more about our mission?
          </p>
          <div class="flex flex-wrap items-center justify-center gap-4">
            <a
              href={`${base}about`}
              class="btn inline-flex items-center gap-2 rounded-full bg-vibrant-pink px-8 py-3 text-base font-bold text-white shadow-lg transition-all hover:scale-105 hover:shadow-xl"
            >
              About Us
            </a>
            <a
              href="mailto:press@latinasweatproject.com"
              class="btn inline-flex items-center gap-2 rounded-full border-2 border-off-black px-8 py-3 text-base font-bold text-off-black transition-all hover:bg-off-black hover:text-white"
            >
              Get in Touch
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
