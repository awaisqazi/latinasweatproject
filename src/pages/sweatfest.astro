      </svg>
    </button>

    <button class="sf-gal-nav sf-gal-next" type="button" data-gal-next aria-label="Next photo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>

    <button class="sf-gal-close" type="button" data-gal-close aria-label="Close photo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>
</Layout>

<style>
  /* ============================================================
     Sweat Fest "printed flyer" utilities. Scoped to this page.
     The three arc colors ride on --sf-sunrise / --sf-ember / --sf-dusk,
     set from sweatFestColors on <main> so CSS and data never drift.
     ============================================================ */

  /* Paper grain over everything: printed stock, not backlit glass. */
  .sf-grain {
    background-repeat: repeat;
    background-size: 180px 180px;
    opacity: 0.05;
    mix-blend-mode: multiply;
  }

  /* The print kit itself (.sf-print, .sf-stamp, .sf-tag, .sf-btn,
     .sf-picado, .sf-tape, .sf-taped) lives in global.css, shared with the
     homepage and links callouts. Below are the page-only pieces. */

  /* Bulletin-board note: tilted paper that straightens when grabbed. */
  .sf-note {
    border: 2px solid rgba(18, 63, 54, 0.85);
    border-radius: 4px;
    box-shadow: 4px 5px 0 rgba(18, 63, 54, 0.12);
    transform: rotate(var(--sf-note-tilt, 0deg));
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .sf-note:hover {
    transform: rotate(0deg) translateY(-2px);
    box-shadow: 6px 8px 0 rgba(18, 63, 54, 0.14);
  }

  /* Merch drop photos: paper-bordered prints pinned on the dark band. */
  .sf-merch-photo {
    position: relative;
    overflow: hidden;
    border: 2.5px solid #e2ecac;
    border-radius: 6px;
    background: #2b3434;
    box-shadow: 0.3rem 0.3rem 0 var(--sf-dusk, #00a7ab);
    transform: rotate(var(--sf-merch-tilt, 0deg));
    transition: transform 0.25s ease;
  }
  .sf-merch-photo:hover {
    transform: rotate(0deg) translateY(-2px);
  }
  /* Cutout garments sit on paper, like a print pinned to the board. */
  .sf-merch-photo.is-cutout {
    background: #f4f7dc;
  }
  .sf-merch-zoom {
    cursor: zoom-in;
  }
  .sf-merch-zoom:focus-visible {
    outline: 3px solid #e2ecac;
    outline-offset: 3px;
  }
  .sf-merch-zoom-hint {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border: 2px solid #123f36;
    border-radius: 8px;
    background: #e2ecac;
    color: #123f36;
    padding: 0.2rem 0.5rem;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow: 2px 3px 0 rgba(18, 63, 54, 0.3);
  }
  .sf-merch-swatch[aria-pressed="true"] {
    border-color: #e2ecac;
    background: rgba(226, 236, 172, 0.16);
    box-shadow: 0 0 0 2px #00a7ab;
  }

  /* Run of show: schedule entries on pale paper, the stage color riding the
     top edge. DJ sets on stage rows flip to ink, like the ticker tape. */
  .sf-sched-card {
    border: 2px solid rgba(18, 63, 54, 0.85);
    border-radius: 6px;
    background: #f4f7dc;
    box-shadow: 4px 5px 0 rgba(18, 63, 54, 0.12);
  }
  .sf-sched-dj {
    background: #123f36;
  }
  .sf-sched-band {
    border-radius: 10px;
    box-shadow: 5px 6px 0 rgba(18, 63, 54, 0.22);
  }
  .sf-sched-details > summary {
    list-style: none;
  }
  .sf-sched-details > summary::-webkit-details-marker {
    display: none;
  }
  .sf-sched-details[open] .sf-sched-chevron {
    transform: rotate(180deg);
  }
  /* Motion-safe: the chevron turns and the description rises in. Under
     reduced motion the native instant <details> toggle is untouched. */
  @media (prefers-reduced-motion: no-preference) {
    .sf-sched-chevron {
      transition: transform 0.2s ease;
    }
    .sf-sched-details[open] > p {
      animation: sf-rise 0.3s ease both;
    }
  }

  /* Album wall: hard-edged print thumbs in the checker language. */
  .sf-gal-thumb {
    overflow: hidden;
    border: 2px solid rgba(18, 63, 54, 0.85);
    border-radius: 3px;
    background: #f4f7dc;
    cursor: zoom-in;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .sf-gal-thumb:hover {
    transform: translateY(-2px);
    box-shadow: 3px 4px 0 rgba(18, 63, 54, 0.2);
  }
  .sf-gal-thumb:focus-visible {
    outline: 3px solid var(--sf-dusk);
    outline-offset: 2px;
  }

  /* Album lightbox: ink backdrop, honeydew-bordered frame, sf buttons.
     `[hidden]` must win over the grid display below or the dialog can
     never close. */
  .sf-gal-lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    grid-template-rows: 1fr auto;
    background: rgba(18, 63, 54, 0.92);
    padding: 3.5rem 1rem 1.25rem;
  }
  .sf-gal-lightbox[hidden] {
    display: none !important;
  }
  .sf-gal-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
  }
  .sf-gal-image {
    max-width: min(100%, 72rem);
    max-height: 80vh;
    border: 3px solid #e2ecac;
    border-radius: 4px;
    background: #123f36;
    box-shadow: 6px 7px 0 rgba(0, 0, 0, 0.35);
  }
  .sf-gal-counter {
    margin-top: 0.9rem;
    text-align: center;
    color: #eaf0c8;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .sf-gal-nav,
  .sf-gal-close {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.9rem;
    height: 2.9rem;
    border: 2px solid #123f36;
    border-radius: 8px;
    background: #e2ecac;
    color: #123f36;
    cursor: pointer;
    box-shadow: 3px 4px 0 rgba(0, 0, 0, 0.35);
    transition: background-color 0.16s ease, transform 0.16s ease;
  }
  .sf-gal-nav:hover,
  .sf-gal-close:hover {
    background: #f4f7dc;
    transform: translateY(-1px);
  }
  .sf-gal-nav:focus-visible,
  .sf-gal-close:focus-visible {
    outline: 3px solid var(--sf-sunrise, #ee3083);
    outline-offset: 2px;
  }
  .sf-gal-nav svg,
  .sf-gal-close svg {
    width: 1.4rem;
    height: 1.4rem;
  }
  .sf-gal-prev {
    left: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .sf-gal-next {
    right: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .sf-gal-prev:hover,
  .sf-gal-next:hover {
    transform: translateY(calc(-50% - 1px));
  }
  .sf-gal-close {
    right: 0.9rem;
    top: 0.9rem;
  }

  /* Itinerary card: thick boxy frame in the phase color over a pale
     honeydew interior, the flat block language of the logo. */
  .sf-loteria {
    background: var(--sf-card, #123f36);
    border: 3px solid rgba(18, 63, 54, 0.25);
    border-radius: 14px;
    padding: 9px;
    box-shadow: 7px 8px 0 rgba(18, 63, 54, 0.3);
    transform: rotate(var(--sf-note-tilt, 0deg));
    transition: transform 0.25s ease;
  }
  .sf-loteria:hover {
    transform: rotate(0deg) translateY(-3px);
  }
  .sf-loteria-inner {
    background: #f4f7dc;
    border: none;
    border-radius: 8px;
  }

  /* Ticker strip: one long screen-printed tape, scrolling when motion is
     allowed and standing still otherwise. */
  .sf-ticker-wrap {
    overflow: hidden;
    margin-left: -0.75rem;
    margin-right: -0.75rem;
  }
  .sf-ticker {
    border-top: 2px solid #123f36;
    border-bottom: 2px solid #123f36;
    transform-origin: center;
    scale: 1.02 1;
  }
  .sf-ticker-track {
    display: flex;
    width: max-content;
  }
  @media (prefers-reduced-motion: no-preference) {
    .sf-ticker-track {
      animation: sf-ticker-scroll 36s linear infinite;
    }
    .sf-ticker-track-reverse {
      animation-direction: reverse;
    }
  }
  @keyframes sf-ticker-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (forced-colors: active) {
    .sf-grain {
      display: none;
    }
  }

  /* Hero load-in rise (mirrors gala's hero-rise, scoped here). */
  @media (prefers-reduced-motion: no-preference) {
    .sf-rise {
      opacity: 0;
      animation: sf-rise 0.85s cubic-bezier(0.25, 0.8, 0.25, 1) forwards;
    }
  }
  @keyframes sf-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Ember motes drifting up through the closing band. Invisible unless
     motion is allowed (they are pure garnish). */
  .sf-mote {
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .sf-mote {
      animation-name: sf-mote-float;
      animation-timing-function: linear;
      animation-iteration-count: infinite;
    }
  }
  @keyframes sf-mote-float {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }
    12% {
      opacity: var(--sf-peak, 0.35);
    }
    88% {
      opacity: var(--sf-peak, 0.35);
    }
    100% {
      transform: translate(var(--sf-drift, 0px), -85vh);
      opacity: 0;
    }
  }
</style>

<script>
  // Count-up for the impact stats, modeled on GalaImpactStats: final values
  // are server-rendered so layout is reserved and no-JS / reduced-motion
  // users still see the real figures.
  (() => {
    const nums = Array.from(
      document.querySelectorAll<HTMLElement>("[data-sf-countup]"),
    );
    if (!nums.length) return;

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    if (reduceMotion || !("IntersectionObserver" in window)) return;

    const fmt = (n: number, comma: boolean) =>
      comma ? Math.round(n).toLocaleString("en-US") : String(Math.round(n));

    const render = (el: HTMLElement, value: number) => {
      const prefix = el.dataset.sfCountupPrefix || "";
      const suffix = el.dataset.sfCountupSuffix || "";
      const comma = el.dataset.sfCountupComma === "true";
      el.textContent = `${prefix}${fmt(value, comma)}${suffix}`;
    };

    const animate = (el: HTMLElement) => {
      const to = Number(el.dataset.sfCountupTo || "0");
      const duration = 1600;
      const ease = (t: number) => 1 - Math.pow(1 - t, 3);
      let start: number | null = null;
      const step = (ts: number) => {
        if (start === null) start = ts;
        const progress = Math.min(1, (ts - start) / duration);
        render(el, to * ease(progress));
        if (progress < 1) requestAnimationFrame(step);
        else render(el, to);
      };
      requestAnimationFrame(step);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            render(el, 0);
            animate(el);
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.4 },
    );

    nums.forEach((el) => observer.observe(el));
  })();

  // Album wall + lightbox. Every photo in this set ships _q/_c/_h renditions
  // (no error-retry ladder needed, unlike /graduation), but broken cells are
  // still hidden and skipped gracefully via a shared `broken` set.
  (() => {
    const wall = document.querySelector<HTMLElement>("[data-gal-wall]");
    const lightbox = document.querySelector<HTMLElement>(
      "#sf-gallery-lightbox",
    );
    const lbImage = document.querySelector<HTMLImageElement>("[data-gal-image]");
    const lbCounter = document.querySelector<HTMLElement>("[data-gal-counter]");
    const lbPrev = document.querySelector<HTMLButtonElement>("[data-gal-prev]");
    const lbNext = document.querySelector<HTMLButtonElement>("[data-gal-next]");
    const lbClose = document.querySelector<HTMLButtonElement>("[data-gal-close]");
    const lbStage = document.querySelector<HTMLElement>("[data-gal-stage]");
    const expandButton =
      document.querySelector<HTMLButtonElement>("[data-gal-expand]");

    if (!wall || !lightbox || !lbImage || !lbCounter || !lbPrev || !lbNext || !lbClose) {
      return;
    }

    const cdn = wall.dataset.galCdn || "";
    const thumbs = Array.from(
      wall.querySelectorAll<HTMLButtonElement>(".sf-gal-thumb"),
    );
    const total = thumbs.length;
    // Indices whose CDN URL turned out dead, so we never land on them twice.
    const broken = new Set<number>();
    let current = -1;
    let opener: HTMLButtonElement | null = null;
    let openTracked = false;

    const fullSrc = (index: number) => {
      const stem = thumbs[index]?.dataset.galStem;
      return stem ? `${cdn}${stem}.jpg` : "";
    };

    // Thumbnails: `error` does not bubble, so catch it on the way down and
    // retire the whole cell instead of leaving a broken square in the wall.
    wall.addEventListener(
      "error",
      (event) => {
        const image = event.target;
        if (!(image instanceof HTMLImageElement)) return;
        const thumb = image.closest<HTMLButtonElement>(".sf-gal-thumb");
        if (!thumb) return;
        broken.add(Number(thumb.dataset.index));
        const cell = thumb.closest<HTMLElement>("[data-gal-cell]");
        if (cell) cell.hidden = true;
      },
      true,
    );

    // Some engines never kick off `loading="lazy"` fetches for these grid
    // cells (observed in embedded Chromium): nudge each thumb to eager as it
    // approaches the viewport, which preserves the bandwidth behaviour and
    // guarantees the fetch actually starts.
    if ("IntersectionObserver" in window) {
      const nudge = new IntersectionObserver(
        (observations) => {
          for (const entry of observations) {
            if (!entry.isIntersecting) continue;
            const image = entry.target;
            if (image instanceof HTMLImageElement && !image.complete) {
              image.loading = "eager";
            }
            nudge.unobserve(entry.target);
          }
        },
        { rootMargin: "600px 0px" },
      );
      wall
        .querySelectorAll<HTMLImageElement>("img[loading='lazy']")
        .forEach((image) => nudge.observe(image));
    } else {
      wall
        .querySelectorAll<HTMLImageElement>("img[loading='lazy']")
        .forEach((image) => {
          image.loading = "eager";
        });
    }

    const preload = (index: number) => {
      if (!total) return;
      const wrapped = ((index % total) + total) % total;
      if (broken.has(wrapped)) return;
      const src = fullSrc(wrapped);
      if (!src) return;
      const image = new Image();
      image.decoding = "async";
      image.src = src;
    };

    // `step` is the direction of travel, so a dead image keeps the visitor
    // moving the way they asked rather than bouncing them backwards.
    const show = (index: number, step = 1) => {
      if (!total) return;
      const wrapped = ((index % total) + total) % total;

      if (broken.has(wrapped)) {
        if (broken.size >= total) return;
        show(wrapped + step, step);
        return;
      }

      current = wrapped;
      lbImage.src = fullSrc(wrapped);
      lbImage.alt = `Sweat Fest photo ${wrapped + 1} of ${total}`;
      lbCounter.textContent = `${wrapped + 1} / ${total}`;
      preload(wrapped + 1);
      preload(wrapped - 1);
    };

    lbImage.addEventListener("error", () => {
      // Ignore the error the browser may raise when close() drops the src.
      if (current < 0 || lightbox.hidden) return;
      broken.add(current);
      if (broken.size >= total) return;
      show(current + 1, 1);
    });

    const open = (index: number, trigger: HTMLButtonElement) => {
      opener = trigger;
      lightbox.hidden = false;
      document.body.style.overflow = "hidden";
      show(index, 1);
      lbClose.focus();

      if (!openTracked) {
        openTracked = true;
        window.trackConversion?.("sweatfest_gallery_open", {
          event_category: "sweatfest_recap",
          context: "sweatfest_page_photos",
        });
      }
    };

    const close = () => {
      lightbox.hidden = true;
      current = -1;
      document.body.style.overflow = "";
      lbImage.removeAttribute("src");
      opener?.focus();
      opener = null;
    };

    thumbs.forEach((thumb) => {
      thumb.addEventListener("click", () =>
        open(Number(thumb.dataset.index), thumb),
      );
    });

    lbPrev.addEventListener("click", () => show(current - 1, -1));
    lbNext.addEventListener("click", () => show(current + 1, 1));
    lbClose.addEventListener("click", close);

    // Backdrop click, but not a click on the photo or the controls.
    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox || event.target === lbStage) close();
    });

    document.addEventListener("keydown", (event) => {
      if (lightbox.hidden) return;

      if (event.key === "Escape") {
        event.preventDefault();
        close();
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        show(current + 1, 1);
      } else if (event.key === "ArrowLeft") {
        event.preventDefault();
        show(current - 1, -1);
      } else if (event.key === "Tab") {
        // Keep focus inside the dialog while it is open.
        const focusable = [lbClose, lbPrev, lbNext];
        const position = focusable.indexOf(
          document.activeElement as HTMLButtonElement,
        );
        event.preventDefault();
        const offset = event.shiftKey ? -1 : 1;
        const next =
          (((position < 0 ? 0 : position + offset) % focusable.length) +
            focusable.length) %
          focusable.length;
        focusable[next].focus();
      }
    });

    // Horizontal swipe, ignoring gestures that are mostly vertical.
    let touchX = 0;
    let touchY = 0;

    lightbox.addEventListener(
      "touchstart",
      (event) => {
        const touch = event.changedTouches[0];
        touchX = touch.clientX;
        touchY = touch.clientY;
      },
      { passive: true },
    );

    lightbox.addEventListener(
      "touchend",
      (event) => {
        const touch = event.changedTouches[0];
        const deltaX = touch.clientX - touchX;
        const deltaY = touch.clientY - touchY;
        if (Math.abs(deltaX) < 44 || Math.abs(deltaX) < Math.abs(deltaY)) return;
        show(current + (deltaX < 0 ? 1 : -1), deltaX < 0 ? 1 : -1);
      },
      { passive: true },
    );

    expandButton?.addEventListener("click", () => {
      const hiddenCells = Array.from(
        wall.querySelectorAll<HTMLElement>("[data-gal-cell][hidden]"),
      );
      hiddenCells.forEach((cell) => {
        cell.hidden = false;
      });
      expandButton.hidden = true;
      // Send focus to the first newly revealed thumb so keyboard and screen
      // reader users land where the new content starts.
      hiddenCells[0]?.querySelector<HTMLButtonElement>(".sf-gal-thumb")?.focus();
    });
  })();
</script>
