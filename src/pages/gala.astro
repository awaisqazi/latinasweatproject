---
// /gala: the Annual Gala 2026 RECAP. The gala was Friday, September 25, 2026
// at the Museum of Contemporary Art Chicago; this page is the thank-you of
// record, the results, the honors and the full photo album. Nothing here
// sells tickets any more: the only ask is the new-home campaign (/donate).
// Results are aggregates and levels only (see src/data/galaRecap2026.js):
// never render donor, bidder or guest names, and never caption people in
// photos.
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import RecapStats from "@/components/gala/recap/RecapStats.astro";
import RecapConstellation from "@/components/gala/recap/RecapConstellation.astro";
import RecapHonors from "@/components/gala/recap/RecapHonors.astro";
import RecapAlbum from "@/components/gala/recap/RecapAlbum.astro";
import RecapLightbox from "@/components/gala/recap/RecapLightbox.astro";
import RecapGratitude from "@/components/gala/recap/RecapGratitude.astro";
import Abc7Segment from "@/components/Abc7Segment.astro";
import {
  galaRecap,
  galaResults,
  galaAuctionPackages,
} from "@/data/galaRecap2026";
import { galaAlbumUrl, galaPhotoCount } from "@/data/galaGallery2026";
import { abc7Feature } from "@/data/abc7WindyCity";

const RECAP_IMG = "/images/gala/2026/recap";
// ABC7 "Windy City Weekend" band (aired gala day): the logo for its eyebrow.
const abc7LogoSrc = `${import.meta.env.BASE_URL}${abc7Feature.logo.replace(/^\//, "")}`;
const flickr2025Url =
  "https://www.flickr.com/photos/88623248@N07/albums/72177720330894284";

const money = (n) =>
  "$" +
  n.toLocaleString("en-US", {
    minimumFractionDigits: Number.isInteger(n) ? 0 : 2,
    maximumFractionDigits: 2,
  });
const auction = galaResults.silentAuction;
const claimedCount = galaAuctionPackages.filter((p) => p.claimed).length;

const pageTitle = "Annual Gala 2026 Recap | The Latina Sweat Project";
const pageDescription = `Gracias, comunidad: the Annual Gala 2026 at the Museum of Contemporary Art Chicago raised ${money(galaResults.raisedOnTheNight)} on the night for accessible classes and teacher training. See the honors, the paddle raise and all ${galaPhotoCount} photos.`;

// Floating gold particles drifting up through the hero (desktop only, motion-safe).
const heroParticles = Array.from({ length: 22 }, (_, i) => ({
  left: (i * 53 + 7) % 100,
  size: i % 5 === 0 ? 6 + (i % 3) : 3 + (i % 4),
  duration: 11 + (i % 6) * 2.5,
  delay: (i % 8) * 1.7,
  drift: (i % 2 === 0 ? 1 : -1) * (12 + (i % 3) * 10),
  opacity: 0.22 + (i % 3) * 0.12,
  bokeh: i % 5 === 0,
}));

// Denser particle field for the closing section so the page bookends visually.
const closingParticles = Array.from({ length: 16 }, (_, i) => ({
  left: (i * 67 + 5) % 100,
  size: i % 4 === 0 ? 6 : 3 + (i % 4),
  duration: 12 + (i % 6) * 2,
  delay: (i % 8) * 1.5,
  drift: (i % 2 === 0 ? 1 : -1) * (10 + (i % 3) * 10),
  opacity: 0.2 + (i % 3) * 0.12,
  bokeh: i % 4 === 0,
}));
---

<Layout
  title={pageTitle}
  description={pageDescription}
  socialImage={`${RECAP_IMG}/og-gala-recap.jpg`}
  socialImageAlt="Gracias, comunidad. Annual Gala 2026 at MCA Chicago: the dinner room with golden lanterns and the podium."
  socialImageWidth={1200}
  socialImageHeight={630}
  socialImageType="image/jpeg"
  twitterCard="summary_large_image"
>
  <Header />
  <main class="gr-page text-white">
    {/* ============================ HERO ============================ */}
    <section
      id="save-the-date"
      class="gr-hero relative isolate flex overflow-hidden border-b border-accent-gold/25"
    >
      <picture class="absolute inset-0 -z-10 block" aria-hidden="true">
        <source media="(max-width: 767px)" srcset={`${RECAP_IMG}/gala-recap-hero-900.webp`} type="image/webp" />
        <img
          src={`${RECAP_IMG}/gala-recap-hero-1600.webp`}
          alt=""
          width="1600"
          height="1067"
          fetchpriority="high"
          decoding="async"
          class="gr-hero-img h-full w-full object-cover"
        />
      </picture>
      {/* Navy scrim: heavy at the bottom and left where the type sits. */}
      <div class="gr-hero-scrim pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
      <div class="gala-lattice pointer-events-none absolute inset-0 -z-10 opacity-[0.035]" aria-hidden="true"></div>
      <div class="absolute inset-x-0 top-0 h-px gala-foil-rule" aria-hidden="true"></div>
      <div class="gala-theater-sweep pointer-events-none absolute inset-0" aria-hidden="true"></div>

      <div class="pointer-events-none absolute inset-0 hidden overflow-hidden lg:block" aria-hidden="true">
        {
          heroParticles.map((p) => (
            <span
              class:list={["gala-particle absolute bottom-0 rounded-full bg-accent-gold", p.bokeh && "gala-particle--bokeh"]}
              style={`left: ${p.left}%; width: ${p.size}px; height: ${p.size}px; --drift: ${p.drift}px; --peak: ${p.opacity}; animation-duration: ${p.duration}s; animation-delay: ${p.delay}s;`}
            />
          ))
        }
      </div>

      <div class="relative mx-auto flex w-full max-w-7xl items-end px-4 pb-14 pt-24 sm:px-6 sm:pb-16 lg:px-8 lg:pb-20">
        <div class="max-w-3xl">
          <p class="hero-rise flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.2em] text-white/80 sm:text-xs sm:tracking-[0.3em]">
            <span class="h-px w-8 bg-accent-gold/80" aria-hidden="true"></span>
            {galaRecap.eyebrow}
          </p>
          <h1
            class="hero-rise mt-5 font-display text-5xl font-bold leading-[1.02] tracking-tight sm:text-7xl lg:text-8xl"
            style="animation-delay: 0.06s;"
          >
            <span class="gala-foil gr-hero-title">{galaRecap.heading}</span>
          </h1>
          <div class="gala-rule-draw hero-rise mt-6 flex items-center gap-3" style="animation-delay: 0.12s;" aria-hidden="true">
            <span class="h-px w-14 gala-foil-rule"></span>
            <span class="h-1.5 w-1.5 rotate-45 bg-accent-gold"></span>
            <span class="h-px w-full max-w-[14rem] gala-foil-rule"></span>
          </div>
          <p
            class="hero-rise mt-6 max-w-2xl text-base font-semibold leading-relaxed text-white/90 sm:text-lg"
            style="animation-delay: 0.2s;"
          >
            {galaRecap.dateLine}
          </p>
          <div class="hero-rise mt-9 flex flex-col gap-3 sm:flex-row" style="animation-delay: 0.3s;">
            <a
              href="#photos"
              class="gala-btn gala-btn--ghost gr-ghost-solid group inline-flex items-center justify-center gap-3 px-7 py-4 text-base font-extrabold"
            >
              See the photos
              <svg class="h-4 w-4 text-accent-gold transition-transform group-hover:translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </a>
            <a
              href={galaRecap.givePath}
              class="gala-btn gala-btn--gold gala-sheen group inline-flex items-center justify-center gap-3 px-7 py-4 text-base font-extrabold"
              data-conversion-event="donation_click"
              data-conversion-context="gala_recap_hero"
            >
              <span class="relative z-[1]">{galaRecap.giveLabel}</span>
              <svg class="relative z-[1] h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* ====================== THE THANK-YOU OF RECORD ====================== */}
    <section id="gracias" class="relative overflow-hidden py-16 scroll-mt-28 sm:py-20 lg:py-24">
      <div class="gala-ambient pointer-events-none absolute left-1/2 top-10 h-72 w-2/3 -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgba(255,189,89,0.14),transparent_65%)] blur-2xl" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <div class="gala-invite reveal relative px-6 py-12 text-off-black sm:px-12 sm:py-16 lg:px-16">
          <div class="gala-invite-frame absolute inset-3 sm:inset-4" aria-hidden="true">
            <span class="absolute -left-1 -top-1 h-2 w-2 rotate-45 bg-accent-gold"></span>
            <span class="absolute -right-1 -top-1 h-2 w-2 rotate-45 bg-accent-gold"></span>
            <span class="absolute -bottom-1 -left-1 h-2 w-2 rotate-45 bg-accent-gold"></span>
            <span class="absolute -bottom-1 -right-1 h-2 w-2 rotate-45 bg-accent-gold"></span>
          </div>
          <div class="relative">
            <div class="flex items-center justify-center gap-3" aria-hidden="true">
              <span class="h-px w-12 bg-[#8a5700]/40"></span>
              <span class="h-1.5 w-1.5 rotate-45 bg-[#b8860b]"></span>
              <span class="h-px w-12 bg-[#8a5700]/40"></span>
            </div>
            <p class="mt-6 text-center text-[11px] font-extrabold uppercase tracking-[0.24em] text-[#8a5700] sm:text-xs sm:tracking-[0.35em]">
              {galaRecap.shortDateLine}
            </p>
            <h2 class="mt-4 text-center font-display text-3xl font-semibold italic leading-tight tracking-tight sm:text-4xl">
              Thank you
            </h2>
            <div class="mt-8 space-y-5 text-base leading-relaxed text-[#3a3a3a] sm:text-[1.075rem]">
              {galaRecap.thankYou.map((para) => <p>{para}</p>)}
            </div>
            <p lang="es" class="mt-8 text-balance text-center font-display text-xl italic leading-snug text-[#8a5700] sm:text-2xl">
              {galaRecap.thankYouEs}
            </p>
            <div class="mt-8 flex items-center justify-center gap-3" aria-hidden="true">
              <span class="h-px w-10 bg-[#8a5700]/35"></span>
              <span class="h-1 w-1 rotate-45 bg-[#b8860b]"></span>
              <span class="h-px w-10 bg-[#8a5700]/35"></span>
            </div>
            <p class="mt-6 text-center font-display text-lg italic text-off-black">
              {galaRecap.signoff}
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ===================== AS SEEN ON ABC7 (gala day) ===================== */}
    {/* ABC7's "Windy City Weekend" aired the afternoon of the gala. Compact
        band: gold eyebrow with the ABC7 bug, one serif line, the short
        blurb, the click-to-load player and a ghost link to the article.
        No new photos, no names beyond the on-air guests in the blurb. */}
    <section id="abc7" class="relative overflow-hidden pb-16 pt-4 scroll-mt-28 sm:pb-20 lg:pb-24">
      <div class="gala-ambient pointer-events-none absolute left-1/2 top-1/3 h-72 w-2/3 -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgba(0,88,240,0.14),transparent_65%)] blur-2xl" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <div class="reveal flex items-center justify-center gap-3" aria-hidden="true">
            <span class="h-px w-12 gala-foil-rule sm:w-20"></span>
            <span class="h-1.5 w-1.5 rotate-45 bg-accent-gold"></span>
            <span class="h-px w-12 gala-foil-rule sm:w-20"></span>
          </div>
          <p class="reveal mt-6 flex items-center justify-center gap-3 text-xs font-extrabold uppercase tracking-[0.3em] text-accent-gold" style="transition-delay: 60ms;">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center overflow-hidden rounded-md bg-white shadow-lg">
              <img
                src={abc7LogoSrc}
                alt=""
                width="512"
                height="512"
                class="h-full w-full scale-[1.2] object-contain"
                loading="lazy"
                decoding="async"
              />
            </span>
            As seen on ABC7 Chicago
          </p>
          <h2 class="reveal mt-4 text-balance font-display text-3xl font-bold leading-tight tracking-tight sm:text-4xl" style="transition-delay: 120ms;">
            Windy City Weekend, gala day
          </h2>
          <p class="reveal mt-5 text-balance text-base leading-relaxed text-white/70 sm:text-lg" style="transition-delay: 180ms;">
            {abc7Feature.shortBlurb}
          </p>
        </div>

        <div class="reveal mt-10" style="transition-delay: 240ms;">
          <Abc7Segment id="abc7-player-gala" variant="inline" context="gala_recap_abc7" class="mx-auto max-w-3xl" />
        </div>

        <div class="reveal mt-8 flex justify-center" style="transition-delay: 300ms;">
          <a
            href={abc7Feature.articleUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-conversion-event="press_abc7_click"
            data-conversion-context="gala_recap_abc7"
            class="gala-btn gala-btn--ghost gr-ghost-solid group inline-flex items-center justify-center gap-3 px-7 py-3.5 text-sm font-extrabold"
          >
            {abc7Feature.cta.readOnAbc7.en}
            <svg class="h-4 w-4 text-accent-gold transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <div class="gala-ribbon relative h-8" aria-hidden="true">
      <div class="absolute inset-x-0 top-1/2 flex -translate-y-1/2 items-center justify-center gap-4">
        <span class="h-px w-24 sm:w-40 gala-foil-rule"></span>
        <span class="h-2 w-2 rotate-45 bg-accent-gold"></span>
        <span class="h-px w-24 sm:w-40 gala-foil-rule"></span>
      </div>
    </div>

    {/* ======================= THE NIGHT IN NUMBERS ======================= */}
    <section id="numbers" class="relative overflow-hidden py-16 scroll-mt-28 sm:py-20 lg:py-24">
      <span id="impact" class="absolute top-0" aria-hidden="true"></span>
      <div class="gala-aurora gala-aurora--soft pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <p class="reveal text-xs font-extrabold uppercase tracking-[0.3em] text-accent-gold">Friday, by the numbers</p>
          <h2 class="reveal mt-4 text-balance font-display text-4xl font-bold leading-tight tracking-tight sm:text-5xl" style="transition-delay: 90ms;">
            The night in numbers
          </h2>
        </div>
        <div class="mt-12">
          <RecapStats />
        </div>
      </div>
    </section>

    {/* ===================== THE PADDLE RAISE, REPLAYED ===================== */}
    <section id="paddle-raise" class="gr-band relative overflow-hidden border-y border-accent-gold/15 py-16 scroll-mt-28 sm:py-20 lg:py-28">
      <div class="gr-night-sky pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <p class="reveal text-xs font-extrabold uppercase tracking-[0.3em] text-accent-gold">
            {galaResults.paddleRaise.startedAt} · La Constelación
          </p>
          <h2 class="reveal mt-4 text-balance font-display text-4xl font-bold leading-tight tracking-tight sm:text-5xl" style="transition-delay: 90ms;">
            The paddle raise, replayed
          </h2>
          <p class="reveal mt-5 text-lg leading-relaxed text-white/70" style="transition-delay: 180ms;">
            On the night, every gift crossed the projector as a comet and
            settled as a star in the glowing LSP X. This is the sky the room
            built, one star for each paddle.
          </p>
        </div>
        <div class="mt-14">
          <RecapConstellation />
        </div>
      </div>
    </section>

    {/* ========================== SILENT AUCTION ========================== */}
    <section id="auction" class="relative overflow-hidden py-16 scroll-mt-28 sm:py-20 lg:py-24">
      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <p class="reveal text-xs font-extrabold uppercase tracking-[0.3em] text-accent-gold">Silent auction</p>
          <h2 class="reveal mt-4 text-balance font-display text-4xl font-bold leading-tight tracking-tight sm:text-5xl" style="transition-delay: 90ms;">
            {claimedCount} packages found new homes
          </h2>
          <p class="reveal mt-6 font-display text-5xl font-bold leading-none tracking-tight sm:text-6xl" style="transition-delay: 150ms;">
            <span class="gala-foil tabular-nums lining-nums">{money(auction.total)}</span>
          </p>
          <p class="reveal mt-4 text-base leading-relaxed text-white/65" style="transition-delay: 210ms;">
            Raised in the silent auction, from {galaAuctionPackages.length} donated packages.
          </p>
        </div>

        <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
          {
            galaAuctionPackages.map((pkg, i) => (
              <li
                class="gala-detail-card reveal group relative overflow-hidden rounded-2xl border border-accent-gold/20 bg-white/[0.035] px-6 py-6"
                style={`transition-delay: ${(i % 3) * 80}ms;`}
              >
                <span class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent-gold/45 to-transparent" aria-hidden="true" />
                <span class="pointer-events-none absolute left-2 top-2 h-3.5 w-3.5 rounded-tl border-l-2 border-t-2 border-accent-gold/55" aria-hidden="true" />
                <span class="pointer-events-none absolute right-2 top-2 h-3.5 w-3.5 rounded-tr border-r-2 border-t-2 border-accent-gold/55" aria-hidden="true" />
                <span class="pointer-events-none absolute bottom-2 left-2 h-3.5 w-3.5 rounded-bl border-b-2 border-l-2 border-accent-gold/55" aria-hidden="true" />
                <span class="pointer-events-none absolute bottom-2 right-2 h-3.5 w-3.5 rounded-br border-b-2 border-r-2 border-accent-gold/55" aria-hidden="true" />
                <p class="text-[11px] font-extrabold uppercase tracking-[0.22em] text-accent-gold">{pkg.donor}</p>
                <p class="mt-2 font-display text-xl font-semibold leading-snug text-white">{pkg.title}</p>
                {pkg.claimed && (
                  <p class="mt-4">
                    <span class="gr-seal">
                      <span class="gr-seal-diamond" aria-hidden="true"></span>
                      Claimed
                    </span>
                  </p>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <div class="gala-ribbon relative h-8" aria-hidden="true">
      <div class="absolute inset-x-0 top-1/2 flex -translate-y-1/2 items-center justify-center gap-4">
        <span class="h-px w-24 sm:w-40 gala-foil-rule"></span>
        <span class="h-2 w-2 rotate-45 bg-accent-gold"></span>
        <span class="h-px w-24 sm:w-40 gala-foil-rule"></span>
      </div>
    </div>

    {/* ============================== HONORS ============================== */}
    <section id="honors" class="relative overflow-hidden py-16 scroll-mt-28 sm:py-20 lg:py-24">
      <div class="gala-aurora gala-aurora--soft pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <p class="reveal text-xs font-extrabold uppercase tracking-[0.3em] text-accent-gold">Honors</p>
          <h2 class="reveal mt-4 text-balance font-display text-4xl font-bold leading-tight tracking-tight sm:text-5xl" style="transition-delay: 90ms;">
            The night's honorees
          </h2>
        </div>
        <div class="mt-12">
          <RecapHonors />
        </div>
      </div>
    </section>

    {/* ========================= THE NIGHT IN PHOTOS ========================= */}
    <section id="photos" class="gr-band relative overflow-hidden border-y border-accent-gold/15 py-16 scroll-mt-28 sm:py-20 lg:py-24">
      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <p class="reveal text-xs font-extrabold uppercase tracking-[0.3em] text-accent-gold">The album · {galaPhotoCount} photos</p>
          <h2 class="reveal mt-4 text-balance font-display text-4xl font-bold leading-tight tracking-tight sm:text-5xl" style="transition-delay: 90ms;">
            {galaRecap.photosHeading}
          </h2>
          <p class="reveal mt-5 text-lg leading-relaxed text-white/70" style="transition-delay: 180ms;">
            {galaRecap.photosIntro}
          </p>
          <p class="reveal mt-5" style="transition-delay: 240ms;">
            <a
              href={galaAlbumUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm font-extrabold text-white underline decoration-accent-gold decoration-1 underline-offset-[6px] transition-colors hover:text-accent-gold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-gold"
              data-conversion-event="gala_gallery_click"
              data-conversion-context="gala_recap_photos"
            >
              Open the album on Flickr
              <svg class="h-4 w-4 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          </p>
        </div>

        <div class="mt-14">
          <RecapAlbum />
        </div>

        <p class="mt-16 text-center">
          <a
            href={flickr2025Url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-bold uppercase tracking-[0.24em] text-white/50 underline decoration-white/25 underline-offset-4 transition-colors hover:text-accent-gold hover:decoration-accent-gold"
          >
            Looking back: the 2025 gallery<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </p>
      </div>
    </section>

    {/* ============================ WITH GRATITUDE ============================ */}
    <section id="gratitude" class="relative overflow-hidden py-16 scroll-mt-28 sm:py-20 lg:py-24">
      <span id="fashion-show" class="absolute top-0" aria-hidden="true"></span>
      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <p class="reveal text-xs font-extrabold uppercase tracking-[0.3em] text-accent-gold">With gratitude</p>
          <h2 class="reveal mt-4 text-balance font-display text-4xl font-bold leading-tight tracking-tight sm:text-5xl" style="transition-delay: 90ms;">
            The partners behind the night
          </h2>
        </div>
        <div class="mt-12">
          <RecapGratitude />
        </div>
      </div>
    </section>

    {/* ======================= WHAT THE NIGHT BUILDS ======================= */}
    <section id="give" class="relative overflow-hidden py-20 scroll-mt-28 sm:py-24 lg:py-28">
      <span id="tickets" class="absolute top-0" aria-hidden="true"></span>
      <span id="gala-interest" class="absolute top-0" aria-hidden="true"></span>
      <div class="gala-lattice pointer-events-none absolute inset-0 opacity-[0.05]" aria-hidden="true"></div>
      <div class="gala-ambient pointer-events-none absolute left-1/2 top-0 h-64 w-2/3 -translate-x-1/2 rounded-full bg-gradient-to-b from-accent-gold/15 to-transparent blur-3xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-0 hidden overflow-hidden lg:block" aria-hidden="true">
        {
          closingParticles.map((p) => (
            <span
              class:list={["gala-particle absolute bottom-0 rounded-full bg-accent-gold", p.bokeh && "gala-particle--bokeh"]}
              style={`left: ${p.left}%; width: ${p.size}px; height: ${p.size}px; --drift: ${p.drift}px; --peak: ${p.opacity}; animation-duration: ${p.duration}s; animation-delay: ${p.delay}s;`}
            />
          ))
        }
      </div>

      <div class="relative mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
        <div class="reveal flex items-center justify-center gap-4" aria-hidden="true">
          <span class="h-px w-20 sm:w-32 gala-foil-rule"></span>
          <span class="h-2 w-2 rotate-45 bg-accent-gold"></span>
          <span class="h-px w-20 sm:w-32 gala-foil-rule"></span>
        </div>
        <p class="reveal mt-8 text-xs font-extrabold uppercase tracking-[0.3em] text-accent-gold">What the night builds</p>
        <h2 class="reveal mt-4 text-balance font-display text-4xl font-bold leading-tight tracking-tight sm:text-5xl" style="transition-delay: 90ms;">
          {galaRecap.giveHeading}
        </h2>
        <p class="reveal mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-white/75" style="transition-delay: 180ms;">
          {galaRecap.giveBody}
        </p>
        <div class="reveal mt-10 flex justify-center" style="transition-delay: 240ms;">
          <a
            href={galaRecap.givePath}
            class="gala-btn gala-btn--gold gala-sheen group inline-flex items-center justify-center gap-3 px-8 py-4 text-base font-extrabold"
            data-conversion-event="donation_click"
            data-conversion-context="gala_recap_closing"
          >
            <span class="relative z-[1]">{galaRecap.giveLabel}</span>
            <svg class="relative z-[1] h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  {/* The album viewer stays OUTSIDE <main> so the fixed header can never
      trap it (see RecapLightbox). */}
  <RecapLightbox />
</Layout>

<style>
