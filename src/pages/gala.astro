     here so nothing leaks into global.css. */
  .gr-page {
    --gr-night: #0b1320;
    --gr-navy: #111a27;
    background: linear-gradient(180deg, #0b1320 0%, #101824 40%, #0e141d 100%);
  }
  /* Playfair defaults to old-style figures; set every display numeral on
