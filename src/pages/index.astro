---
// Homepage section order (Sep 2026 gala-forward refresh). Theme in brackets;
// below the crafted hero -> gala seam the light/dark cadence strictly
// alternates:
//   1. Hero [D]
//   2. Annual Gala 2026 recap spotlight [D]  <- crafted gold seam, the
//      page's one deliberate dark/dark junction (documented exception).
//      Post-gala (Sep 26 2026) the slot and theme are unchanged; only the
//      content became the recap.
//   3. "Relive the summer" recap band [L] (Graduation 2026 + Sweat Fest '26)
//   4. ABC7 Windy City Weekend spotlight [D] (#abc7-windy-city, media RIGHT)
//   5. Monday Miles Tee merch [L]
//   6. 40 Under 40 [D]
//   7. Monday Miles community runs [L]
//   8. A New Chapter (relocation) [D]
//   9. Events carousel [L]
//  10. Instagram [D]
//  11. In The Press [L]
// Desktop media zig-zag: Gala photo LEFT -> ABC7 video RIGHT -> Tee LEFT ->
// 40 Under 40 flyer RIGHT -> Monday Miles visual LEFT -> A New Chapter RIGHT.
// (Recap band, carousel, Instagram, and Press sit outside the zig-zag.)
// Retired from this page in Sep 2026: the YTT '26 Trio companion band (series
// ended Aug 31), the standalone Graduation 2026 and Sweat Fest spotlights
// (both now ride in the recap band and the carousel), the Sweat Fest merch
// drop section (sold in person on Aug 22 only), and the light-band copy of
// GalaTicketDeadline. Retired Sep 26 2026 (post-gala): the evening timeline,
// the inline GalaTicketDeadline module, the impact strip, and every gala
// ticket CTA (hero pill, spotlight, carousel card). Also retired Sep 26
// 2026: the WGN9 Around Town spotlight (slot 4), replaced in place by the
// ABC7 Windy City Weekend spotlight; WGN9 remains a card in In The Press and
// keeps its own page, /wgn9-around-town.
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import GalaPhotoFrame from "@/components/GalaPhotoFrame.astro";
import SweatFestArtwork from "@/components/SweatFestArtwork.astro";
import { galaRecapCard, galaTeaser } from "@/data/galaTeaser";
import { sweatFest, sweatFestDay, sweatFestCheckerUri } from "@/data/sweatFest";
import { pressArticles } from "@/data/press";
import { abc7Feature } from "@/data/abc7WindyCity";
import Abc7Segment from "@/components/Abc7Segment.astro";
const base = import.meta.env.BASE_URL;
const withBase = (path) => `${base}${path.replace(/^\//, "")}`;

// Gala (Sep 25, 2026) is past: the lead spotlight and the carousel card are
// the recap. Copy and the three aggregate numbers come from galaRecapCard in
// src/data/galaTeaser.js; the local photo is album #69 (dinner under the
// gold lanterns), converted to webp in public/images/gala/2026/recap-home/.
const galaPageUrl = withBase(galaTeaser.recapPath);
const galaRecapPhotosUrl = withBase("gala#photos");
const galaRecapPhoto = {
  src: "/images/gala/2026/recap-home/gala-2026-recap-card.webp",
  alt: "The Annual Gala 2026 dinner at MCA Chicago, tables leading to the podium beneath glowing gold lanterns",
  objectPosition: "50% 55%",
};
// Floating gold motes over the gala spotlight (desktop only, motion-safe;
// same idea as the /gala hero particle field, kept deliberately sparse).
const galaMotes = Array.from({ length: 12 }, (_, i) => ({
  left: (i * 41 + 6) % 100,
  size: i % 4 === 0 ? 5 : 3,
  duration: 13 + (i % 5) * 2.5,
  delay: (i % 6) * 2.1,
  drift: (i % 2 === 0 ? 1 : -1) * (10 + (i % 3) * 8),
  opacity: 0.16 + (i % 3) * 0.08,
}));

// Deepened arc stops (deep gold -> ember -> magenta) so day-phase labels
// stay legible on the light recap card and the light carousel card.
const sweatFestDeepAccents = { rosa: "#c21e64", cielo: "#017277", lima: "#43722c" };
// Homepage CTAs route to the full Sweat Fest page (the story, itinerary,
// and ticket stubs live there); /sweatfest owns the jump to Zeffy.
const sweatFestPrimaryUrl = withBase("sweatfest");
const sweatFestPrimaryLabel = "Relive the day";
// Graduation 2026 (YTT ceremony, Fri Aug 7, 2026): the recap band and
// carousel card route to the /graduation photo-and-story recap page;
// the full 307-photo album lives on Flickr.
const graduationPageUrl = withBase("graduation");
const graduationFlickrUrl =
  "https://www.flickr.com/photos/88623248@N07/albums/72177720335041327";
---

<Layout title="The Latina Sweat Project | Home">
  <Header />
  <main>

    {/* START: Hero Section */}
    <section class="relative h-[60vh] min-h-[480px] w-full sm:h-screen">
      <div class="absolute inset-0 bg-black/50"></div>

      <video
        autoplay
        loop
        muted
        playsinline
        class="hidden h-full w-full object-cover sm:block"
      >
        <source src={`${base}videos/heroclip.mp4`} type="video/mp4" />
      </video>

      <div
        class="sm:hidden h-full w-full bg-cover bg-center"
        style='background-image: url("https://images.pexels.com/photos/4753997/pexels-photo-4753997.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2");'
      >
      </div>

      <div
        class="absolute inset-0 flex flex-col items-center justify-center p-4 text-center text-white"
      >
        <a
          href={galaRecapPhotosUrl}
          class="group mb-5 inline-flex items-center gap-2.5 rounded-full border border-white/35 bg-off-black/45 px-4 py-2 text-xs font-extrabold uppercase tracking-[0.14em] text-white shadow-lg backdrop-blur-md transition hover:border-accent-gold hover:bg-off-black/65 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-gold focus-visible:ring-offset-4 focus-visible:ring-offset-off-black sm:text-sm"
          data-conversion-event="gala_recap_click"
          data-conversion-context="home_hero_announcement"
        >
          <span class="h-1.5 w-1.5 rotate-45 bg-accent-gold" aria-hidden="true"></span>
          <span>Annual Gala 2026 · Gracias, comunidad · see the photos</span>
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
        <h1
          class="font-sans text-4xl font-extrabold tracking-tighter sm:text-5xl md:text-6xl lg:text-7xl"
        >
          Empowering Through Movement
        </h1>
        <p class="mt-4 max-w-2xl font-body text-lg sm:text-xl">
          Join our vibrant community in Chicago and experience fitness that
          celebrates our culture.
        </p>
        <a
          href={`${base}schedule`}
          class="btn mt-8 rounded-full bg-vibrant-pink px-8 py-3 text-base font-bold text-white shadow-lg transition hover:scale-105 hover:bg-accent-gold focus:outline-none focus:ring-2 focus:ring-vibrant-pink focus:ring-offset-2 focus:ring-offset-slate-900"
          data-conversion-event="class_booking_start"
          data-conversion-context="home_hero"
          data-conversion-booking-path="schedule_page"
        >
          Join a Class
        </a>
      </div>
    </section>
    {/* END: Hero Section */}

    {/* START: Annual Gala 2026 recap spotlight (post-gala, Sep 26 2026).
        Same slot, same theme as the pre-gala marquee so the documented
        cadence holds. Gala identity per design.md 8B: off-black room, gold
        #ffbd59 foil, mauve ambient, Playfair via `font-display`, sharp
        .gala-btn keylines. This hero -> gala junction is the page's one
        deliberate dark/dark adjacency, carried by the crafted gold seam: a
        .gala-foil-rule hairline on the very top edge, a static gold wash
        pooling up into the hero, two slow-breathing .gala-ambient blobs, the
        diamond lattice at 5%, and a sparse desktop-only mote field. Media
        sits LEFT so the ABC7 video swings right directly below. One ask:
        "See the photos" into the /gala recap; the ghost button is the
        new-home campaign. Results are aggregates only (galaRecapCard). */}
    <section
      id="gala"
      class="relative overflow-hidden bg-off-black py-16 text-white scroll-mt-28 sm:py-20 lg:py-24"
    >
      {/* Seam: foil hairline, then a static gold wash pooling at the top edge */}
      <div class="gala-foil-rule pointer-events-none absolute inset-x-0 top-0 h-px" aria-hidden="true"></div>
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-40"
        style="background: radial-gradient(62% 130% at 50% 0%, rgba(255, 189, 89, 0.18), transparent 72%);"
        aria-hidden="true"
      >
      </div>
      <div class="gala-lattice pointer-events-none absolute inset-0 opacity-[0.05]" aria-hidden="true"></div>
      <div
        class="gala-ambient pointer-events-none absolute -left-24 top-0 h-80 w-80 rounded-full blur-[120px]"
        style="background: rgba(255, 189, 89, 0.18);"
        aria-hidden="true"
      >
      </div>
      <div
        class="gala-ambient pointer-events-none absolute -right-20 bottom-0 h-80 w-80 rounded-full blur-[130px]"
        style="background: rgba(181, 161, 141, 0.16); animation-delay: 3.5s;"
        aria-hidden="true"
      >
      </div>

      {/* Floating gold motes: desktop only, static (invisible) under
          prefers-reduced-motion, see .home-gala-mote below. */}
      <div
        class="pointer-events-none absolute inset-0 hidden overflow-hidden lg:block"
        aria-hidden="true"
      >
        {
          galaMotes.map((mote) => (
            <span
              class="home-gala-mote absolute bottom-0 rounded-full bg-accent-gold"
              style={`left: ${mote.left}%; width: ${mote.size}px; height: ${mote.size}px; --drift: ${mote.drift}px; --peak: ${mote.opacity}; animation-duration: ${mote.duration}s; animation-delay: ${mote.delay}s;`}
            />
          ))
        }
      </div>

      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid items-center gap-10 lg:grid-cols-5 lg:gap-14">
          {/* Media (LEFT on desktop, first in DOM order) */}
          <div class="reveal group relative mx-auto w-full max-w-md lg:col-span-2 lg:max-w-none">
            <div
              class="gala-ambient pointer-events-none absolute -inset-6 rounded-[2.5rem] bg-gradient-to-br from-accent-gold/25 via-vibrant-pink/10 to-transparent blur-2xl"
              aria-hidden="true"
            >
            </div>
            <a
              href={galaRecapPhotosUrl}
              class="relative block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-gold focus-visible:ring-offset-4 focus-visible:ring-offset-off-black"
              aria-label="See the Annual Gala 2026 photos"
              data-conversion-event="gala_recap_click"
              data-conversion-context="home_gala_recap_photo"
            >
              <GalaPhotoFrame slot={galaRecapPhoto} variant="hero" label={false} corners />
              <span class="absolute -top-3 right-5 z-20 rounded-full border border-accent-gold/40 bg-off-black/85 px-4 py-1.5 text-[11px] font-extrabold uppercase tracking-[0.18em] text-accent-gold shadow-lg backdrop-blur-sm">
                Sep 25 · MCA Chicago
              </span>
            </a>
            <p class="relative mt-4 text-center text-[11px] font-bold uppercase tracking-[0.16em] text-white/45 lg:text-left">
              {galaTeaser.venueLine}
            </p>
          </div>

          {/* Copy (RIGHT on desktop) */}
          <div class="reveal text-center lg:col-span-3 lg:text-left" style="transition-delay: 120ms;">
            <p class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-xs font-extrabold uppercase tracking-[0.24em] text-white/60 lg:justify-start">
              <span class="gala-foil-rule h-px w-8" aria-hidden="true"></span>
              {galaRecapCard.eyebrow}
            </p>

            <h2 class="mt-5 font-display text-4xl leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">
              <span class="gala-foil">{galaRecapCard.heading}</span>
            </h2>
            <p class="mt-3 text-xs font-extrabold uppercase tracking-[0.2em] text-accent-gold/85">
              {galaRecapCard.dateLine}
            </p>

            <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-white/70 sm:text-lg lg:mx-0">
              {galaRecapCard.blurb}
            </p>

            {/* The night in three numbers (aggregates only) */}
            <dl class="mx-auto mt-8 grid max-w-xl grid-cols-[1.4fr_1fr_1fr] border-y sm:grid-cols-3 border-accent-gold/25 lg:mx-0">
              {
                galaRecapCard.stats.map((stat, i) => (
                  <div
                    class:list={[
                      "px-2 py-4 text-center sm:px-4 lg:text-left",
                      i > 0 && "border-l border-accent-gold/20",
                    ]}
                  >
                    <dt class="sr-only">{stat.label}</dt>
                    <dd class="font-display text-2xl font-bold leading-none text-white sm:text-3xl">
                      {stat.value}
                    </dd>
                    <dd class="mt-2 text-[10px] font-extrabold uppercase leading-snug tracking-[0.18em] text-accent-gold sm:text-[11px]" aria-hidden="true">
                      {stat.label}
                    </dd>
                  </div>
                ))
              }
            </dl>

            <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row sm:flex-wrap lg:justify-start">
              <a
                href={galaRecapPhotosUrl}
                class="gala-btn gala-btn--gold group inline-flex items-center gap-2.5 px-7 py-3.5 text-sm font-extrabold uppercase tracking-[0.14em] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-gold focus-visible:ring-offset-2 focus-visible:ring-offset-off-black"
                data-conversion-event="gala_recap_click"
                data-conversion-context="home_gala_recap"
              >
                {galaRecapCard.ctaLabel}
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </a>
              <a
                href={withBase("donate")}
                class="gala-btn gala-btn--ghost inline-flex items-center gap-2.5 px-7 py-3.5 text-sm font-extrabold uppercase tracking-[0.14em] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-gold focus-visible:ring-offset-2 focus-visible:ring-offset-off-black"
                data-conversion-event="donation_click"
                data-conversion-context="home_gala_recap"
              >
                Support the new home
              </a>
            </div>
            <p class="mt-6 text-center lg:text-left">
              <a
                href="#abc7-windy-city"
                data-conversion-event="press_abc7_click"
                data-conversion-context="home_gala_spotlight"
                class="group inline-flex items-center gap-2 text-xs font-extrabold uppercase tracking-[0.2em] text-accent-gold/85 underline-offset-4 transition-colors hover:text-accent-gold hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-gold focus-visible:ring-offset-2 focus-visible:ring-offset-off-black"
              >
                Watch Yari and Savannah on ABC7
                <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </a>
            </p>
          </div>
        </div>
      </div>
    </section>
    {/* END: Annual Gala 2026 recap spotlight */}

    {/* START: Relive the summer recap band (light). Both summer events were
        demoted from full spotlights to this one compact band on Sep 2026.
        Per the design.md Option H exception, each card is an ambassador of
        its OWN identity: Graduation keeps the candlelit-rose room (Fraunces,
        #f0c57c gold, candle-bokeh dots, cream keepsake mat, never .gala-foil
        or accent-gold) and Sweat Fest keeps the v4 checkerboard print kit
        (honeydew field, #123f36 ink, hard offset shadow, sf-* utilities). */}
    <section class="relative overflow-hidden bg-gradient-to-br from-[#f7efe3] via-white to-[#f5ede3] py-14 sm:py-18">
      <div
        class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-accent-gold/15 blur-[120px]"
        aria-hidden="true"
      >
      </div>

      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-xs font-extrabold uppercase tracking-[0.22em] text-accent-gold">
            Recaps · Summer 2026
          </p>
          <h2 class="mt-2 font-sans text-3xl font-extrabold tracking-tight text-off-black sm:text-4xl">
            Relive the summer
          </h2>
          <p class="mt-3 text-medium-gray">
            Graduation night and our first festival, in photos.
          </p>
        </div>

        <div class="mt-10 grid gap-6 lg:grid-cols-2">
          {/* Graduation 2026 (Option H: candlelit rose) */}
          <article
            class="reveal flex h-full flex-col rounded-[1.75rem] p-6 text-[#f6efe3] shadow-xl shadow-[#2b1520]/20 sm:p-8"
            style="background: linear-gradient(165deg, #2b1520, #1e1216 78%);"
          >
            {/* Candle-bokeh dot row (this identity's divider: no hairlines) */}
            <div class="flex items-center gap-2" aria-hidden="true">
              <span class="h-1.5 w-1.5 rounded-full bg-[#d79b47]/70 blur-[1px]"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#f0c57c]/80 blur-[1.5px]"></span>
              <span class="h-1 w-1 rounded-full bg-[#e08cb8]/60 blur-[1px]"></span>
              <span class="h-2 w-2 rounded-full bg-[#d79b47]/50 blur-[2px]"></span>
              <span class="h-1.5 w-1.5 rounded-full bg-[#f0c57c]/45 blur-[1.5px]"></span>
            </div>

            <p class="mt-4 text-xs font-extrabold uppercase tracking-[0.2em] text-[#f0c57c]">
              Recap · Friday, August 7 · LSP Studio
            </p>
            <h3 class="mt-3 text-3xl leading-tight [font-family:Fraunces,serif] [font-weight:650] sm:text-4xl">
              Graduation <span class="italic text-[#f0c57c]">2026</span>
            </h3>
            <p class="mt-4 text-xl text-[#f0c57c] [font-family:Fraunces,serif] [font-weight:560] sm:text-2xl">
              Nearly 100 teachers strong.
            </p>
            <p class="mt-1 text-base italic text-[#f0c57c]/90 [font-family:Fraunces,serif] [font-weight:560]">
              Casi 100 maestras y contando.
            </p>

            <figure class="mt-6 rounded-[1.6rem] bg-[#f6efe3] p-2.5 shadow-lg shadow-black/30">
              <img
                src={`${base}images/graduation/g15.jpg`}
                width="1024"
                height="683"
                alt="YTT graduates celebrating at the 2026 graduation ceremony at LSP Studio"
                class="w-full rounded-[1.15rem] object-cover"
                loading="lazy"
                decoding="async"
              />
            </figure>

            <div class="mt-auto flex flex-col items-start gap-4 pt-7 sm:flex-row sm:items-center">
              <a
                href={graduationPageUrl}
                class="group inline-flex items-center gap-2.5 rounded-full bg-[#d79b47] px-6 py-3.5 text-sm font-extrabold text-off-black shadow-lg shadow-[#d79b47]/25 transition hover:bg-[#f0c57c] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f0c57c] focus-visible:ring-offset-2 focus-visible:ring-offset-[#2b1520]"
                data-conversion-event="graduation_spotlight_click"
                data-conversion-context="home_summer_recap"
              >
                Relive the night
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </a>
              <a
                href={graduationFlickrUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-extrabold text-[#f0c57c] underline-offset-4 transition hover:text-[#f6efe3] hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f0c57c] focus-visible:ring-offset-2 focus-visible:ring-offset-[#2b1520]"
                data-conversion-event="graduation_gallery_click"
                data-conversion-context="home_summer_recap"
              >
                Photo gallery
              </a>
            </div>
          </article>

          {/* Sweat Fest '26 (Option F v4: official checkerboard-logo kit) */}
          <article
            class="reveal flex h-full flex-col overflow-hidden rounded-xl border-[3px] border-[#123f36] bg-[#f4f7dc] shadow-[6px_7px_0_#ee3083]"
            style="transition-delay: 110ms;"
          >
            <div
              class="sf-picado h-[26px]"
              style={`background-image: ${sweatFestCheckerUri}; background-size: 78px 26px;`}
              aria-hidden="true"
            >
            </div>

            <div class="flex flex-1 flex-col p-5 sm:p-7">
              <SweatFestArtwork variant="landscape" className="rounded-md ring-1 ring-off-black/15" />

              <span class="sf-stamp mt-6 self-start px-3 py-1.5 text-[11px]" style="color: #b23c14;">
                Recap · Sat, Aug 22
              </span>
              <h3 class="mt-4 font-slab text-3xl uppercase leading-[0.98] tracking-tight sm:text-4xl" style="color: #123f36;">
                <span class="sf-print" style="--sf-print: #60a444;">Sweat Fest</span>
                <span class="sf-print" style="--sf-print: #ee3083;">&rsquo;26</span>
              </h3>
              <p class="mt-4 text-base leading-relaxed text-medium-gray">
                Gracias, Chicago: a sunrise 5K, two stages, and the closing
                Pachanga.
              </p>

              <div class="mt-5 flex flex-wrap gap-2">
                {sweatFestDay.map((phase, i) => (
                  <span
                    class="sf-tag inline-flex items-center gap-2 px-3 py-1.5 text-[11px] font-extrabold uppercase tracking-[0.08em] text-off-black"
                    style={`transform: rotate(${[-1.2, 0.8, -0.6][i % 3]}deg);`}
                  >
                    <span class="inline-block h-2 w-2 rotate-45" style={`background-color: ${sweatFestDeepAccents[phase.accent]};`} aria-hidden="true"></span>
                    {phase.title}
                  </span>
                ))}
              </div>

              <div class="mt-auto flex flex-wrap items-center gap-4 pt-7">
                <a
                  href={withBase("sweatfest#photos")}
                  class="sf-btn inline-flex items-center justify-center gap-2.5 bg-[#ee3083] px-6 py-3.5 text-sm font-extrabold text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#123f36] focus-visible:ring-offset-4"
                  data-conversion-event="sweatfest_gallery_click"
                  data-conversion-context="home_summer_recap"
                >
                  Every photo
                </a>
                <a
                  href={withBase("sweatfest#merch")}
                  class="sf-btn inline-flex items-center justify-center gap-2.5 bg-white px-6 py-3.5 text-sm font-extrabold text-[#123f36] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#123f36] focus-visible:ring-offset-4"
                  data-conversion-event="sweatfest_merch_click"
                  data-conversion-context="home_summer_recap"
                >
                  The merch drop
                </a>
                <a
                  href={withBase("sweatfest/program")}
                  class="text-sm font-extrabold text-[#b23c14] underline-offset-4 transition hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#123f36] focus-visible:ring-offset-2"
