---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import GalaCountdown from "@/components/GalaCountdown.astro";
import GalaPhotoFrame from "@/components/GalaPhotoFrame.astro";
import GalaImpactStats from "@/components/GalaImpactStats.astro";
import SweatFestArtwork from "@/components/SweatFestArtwork.astro";
import MerchLightbox from "@/components/MerchLightbox.astro";
import { galaPhotos, galaTeaser, galaTickets } from "@/data/galaTeaser";
import {
  sweatFest,
  sweatFestDay,
  sweatFestColors,
  sweatFestCheckerUri,
  sweatFestMerch,
} from "@/data/sweatFest";
import { pressArticles } from "@/data/press";
import { yttTrio, yttTrioSessions } from "@/data/yttTrio";
const base = import.meta.env.BASE_URL;
const withBase = (path) => `${base}${path.replace(/^\//, "")}`;
// Merch lightbox payloads (every colorway; see MerchLightbox.astro).
const merchShot = (img, label) => ({ src: withBase(img.src), alt: img.alt, label, cutout: !!img.cutout });
const teeShots = sweatFestMerch.hero.variants.flatMap((v) => [
  merchShot(v.front, `${v.color} · front`),
  merchShot(v.back, `${v.color} · back, the lineup`),
]);
const itemShots = (item) => item.shots.map((shot) => merchShot(shot.img, shot.label));
const galaPageUrl = withBase(galaTeaser.pagePath);
// Lowest live ticket price, for the early-bird note near the gala CTAs.
const galaFromPrice = Math.min(
  ...galaTickets.tiers.map((tier) => tier.earlyBird),
);
// Deepened arc stops (deep gold -> ember -> magenta) so day-phase labels
// stay legible on the cream lead spotlight and the light carousel card.
const sweatFestDeepAccents = { rosa: "#c21e64", cielo: "#017277", lima: "#43722c" };
// Homepage CTAs route to the full Sweat Fest page (the story, itinerary,
// and ticket stubs live there); /sweatfest owns the jump to Zeffy.
const sweatFestPrimaryUrl = withBase("sweatfest");
const sweatFestPrimaryLabel = "Learn More";
// Graduation 2026 (YTT ceremony, Fri Aug 7, 2026): the homepage spotlight
// and carousel card route to the /graduation photo-and-story recap page;
// the full 307-photo album lives on Flickr.
const graduationPageUrl = withBase("graduation");
const graduationFlickrUrl =
  "https://www.flickr.com/photos/88623248@N07/albums/72177720335041327";
---

<Layout title="The Latina Sweat Project | Home">
  <Header />
  <main>

    {/* START: Hero Section */}
    <section class="relative h-[60vh] min-h-[480px] w-full sm:h-screen">
      <div class="absolute inset-0 bg-black/50"></div>

      <video
        autoplay
        loop
        muted
        playsinline
        class="hidden h-full w-full object-cover sm:block"
      >
        <source src={`${base}videos/heroclip.mp4`} type="video/mp4" />
      </video>

      <div
        class="sm:hidden h-full w-full bg-cover bg-center"
        style='background-image: url("https://images.pexels.com/photos/4753997/pexels-photo-4753997.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2");'
      >
      </div>

      <div
        class="absolute inset-0 flex flex-col items-center justify-center p-4 text-center text-white"
      >
        <a
          href={withBase("sweatfest")}
          class="group mb-5 inline-flex items-center gap-2.5 rounded-full border border-white/35 bg-off-black/45 px-4 py-2 text-xs font-extrabold uppercase tracking-[0.14em] text-white shadow-lg backdrop-blur-md transition hover:border-accent-gold hover:bg-off-black/65 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-gold focus-visible:ring-offset-4 focus-visible:ring-offset-off-black sm:text-sm"
          data-conversion-event="sweatfest_explore_click"
          data-conversion-context="home_hero_announcement"
        >
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent-gold opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-accent-gold"></span>
          </span>
          First-ever Sweat Fest · {sweatFest.shortDateLabel}
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
        <h1
          class="font-sans text-4xl font-extrabold tracking-tighter sm:text-5xl md:text-6xl lg:text-7xl"
        >
          Empowering Through Movement
        </h1>
        <p class="mt-4 max-w-2xl font-body text-lg sm:text-xl">
          Join our vibrant community in Chicago and experience fitness that
          celebrates our culture.
        </p>
        <a
          href={`${base}schedule`}
          class="btn mt-8 rounded-full bg-vibrant-pink px-8 py-3 text-base font-bold text-white shadow-lg transition hover:scale-105 hover:bg-accent-gold focus:outline-none focus:ring-2 focus:ring-vibrant-pink focus:ring-offset-2 focus:ring-offset-slate-900"
          data-conversion-event="class_booking_start"
          data-conversion-context="home_hero"
          data-conversion-booking-path="schedule_page"
        >
          Join a Class
        </a>
      </div>
    </section>
    {/* END: Hero Section */}

    {/* START: Graduation 2026 (LEAD dark celebration spotlight; the
        "candlelit rose" identity, consistent with /graduation: deep
        rose-ink #2b1520/#1e1216 room, cream #f6efe3 text, gold #f0c57c
        accents with #d79b47 CTA fill, orchid #e08cb8 + gold glows,
        Fraunces display serif (450/560/650, loaded in Layout.astro), Rubik
        body. Keepsake framing: generous radii, dark gold-washed mat,
        candle-bokeh dots, no hairline rules or gradient bands. Leads
        directly after the dark hero: that dark/dark junction is the page's
        one deliberate chapter break, crafted via the candlelit-horizon
        seam treatment below (the hero's overlay is neutral black, this
        room is warm rose-ink, and gold + orchid candlelight bleeds across
        the top edge). Strict light/dark alternation holds at every
        junction below this seam. Media sits RIGHT in the zig-zag so the
        Sweat Fest poster swings left directly below. Not a gala surface:
        no .gala-foil, no accent-gold.) */}
    <section
      class="relative overflow-hidden py-16 text-[#f6efe3] sm:py-20"
      style="background:
        radial-gradient(44rem 24rem at 86% -6rem, rgba(215, 155, 71, 0.16), transparent 62%),
        radial-gradient(36rem 20rem at -8% 104%, rgba(224, 140, 184, 0.12), transparent 60%),
        linear-gradient(to bottom, #2b1520, #1e1216);"
    >
      {/* Seam treatment: the candlelit horizon. Where the neutral-black
          hero ends, warm candle light spills over the sill of the rose-ink
          room: a full-width static wash of gold + orchid pooling at the top
          edge, two slow-breathing light pools hugging the seam, and a few
          candle-bokeh dots rising into it. Photosensitivity-safe: only
          gala-ambient's ~8s breathing, staggered; no flicker, no strobe. */}
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-44"
        style="background:
          radial-gradient(58% 130% at 26% 0%, rgba(215, 155, 71, 0.26), transparent 72%),
          radial-gradient(50% 115% at 72% 0%, rgba(224, 140, 184, 0.22), transparent 70%),
          linear-gradient(to bottom, rgba(240, 197, 124, 0.12), transparent 55%);"
        aria-hidden="true"
      >
      </div>
      <div class="gala-ambient pointer-events-none absolute -top-14 left-[10%] h-36 w-72 rounded-full blur-[80px]" style="background: rgba(215, 155, 71, 0.3);" aria-hidden="true"></div>
      <div class="gala-ambient pointer-events-none absolute -top-16 right-[14%] h-40 w-80 rounded-full blur-[90px]" style="background: rgba(224, 140, 184, 0.26); animation-delay: 4s;" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-x-0 top-0 h-24" aria-hidden="true">
        <span class="gala-ambient absolute left-[16%] top-7 h-2 w-2 rounded-full bg-[#f0c57c]/70 blur-[1.5px]"></span>
        <span class="gala-ambient absolute left-[31%] top-3 h-1.5 w-1.5 rounded-full bg-[#d79b47]/60 blur-[1px]" style="animation-delay: 2s;"></span>
        <span class="gala-ambient absolute left-[55%] top-9 h-1 w-1 rounded-full bg-[#e08cb8]/60 blur-[1px]" style="animation-delay: 5s;"></span>
        <span class="gala-ambient absolute left-[68%] top-4 h-2.5 w-2.5 rounded-full bg-[#e08cb8]/50 blur-[2px]" style="animation-delay: 3s;"></span>
        <span class="gala-ambient absolute left-[84%] top-8 h-1.5 w-1.5 rounded-full bg-[#f0c57c]/55 blur-[1.5px]" style="animation-delay: 6.5s;"></span>
      </div>

      {/* Slow-breathing candlelight glows (gala-ambient pulse: ~8s
          scale/opacity drift, nothing close to a flash) */}
      <div class="gala-ambient pointer-events-none absolute -left-24 top-4 h-72 w-72 rounded-full blur-[110px]" style="background: rgba(215, 155, 71, 0.2);" aria-hidden="true"></div>
      <div class="gala-ambient pointer-events-none absolute -right-16 bottom-0 h-80 w-80 rounded-full blur-[120px]" style="background: rgba(224, 140, 184, 0.16); animation-delay: 2.5s;" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
          {/* Copy (left on desktop; DOM order copy-first preserved for
              mobile) */}
          <div class="reveal text-center lg:order-1 lg:text-left">
            <p class="text-xs font-extrabold uppercase tracking-[0.22em] text-[#f0c57c] sm:text-sm">
              A night that lives forever
            </p>
            <h2 class="mt-3 text-4xl leading-[1.05] tracking-tight [font-family:Fraunces,serif] [font-weight:650] sm:text-5xl">
              <span class="text-[#f6efe3]">Graduation</span>
              <span class="italic text-[#f0c57c]">2026</span>
            </h2>
            <p class="mt-4 text-lg font-bold text-[#f6efe3]">
              Friday, August 7, 2026 · LSP Studio, Pilsen
            </p>
            <p class="mt-1 text-base font-semibold text-[#f6efe3]/60">
              The YTT cohorts of 2025 and 2026 received their certificates together
            </p>

            <p class="mt-6 text-2xl text-[#f0c57c] [font-family:Fraunces,serif] [font-weight:560] sm:text-3xl">
              Nearly 100 teachers strong.
            </p>
            <p class="mt-1 text-base italic text-[#f0c57c]/90 [font-family:Fraunces,serif] [font-weight:560]">
              Casi 100 maestras y contando.
            </p>

            <blockquote class="mx-auto mt-6 max-w-xl text-left lg:mx-0">
              {/* Candle-bokeh dot row (replaces the hairline quote rule) */}
              <div class="flex items-center gap-2" aria-hidden="true">
                <span class="h-1.5 w-1.5 rounded-full bg-[#d79b47]/70 blur-[1px]"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-[#f0c57c]/80 blur-[1.5px]"></span>
                <span class="h-1 w-1 rounded-full bg-[#e08cb8]/60 blur-[1px]"></span>
                <span class="h-2 w-2 rounded-full bg-[#d79b47]/50 blur-[2px]"></span>
                <span class="h-1.5 w-1.5 rounded-full bg-[#f0c57c]/45 blur-[1.5px]"></span>
              </div>
              <p class="mt-3 text-lg italic leading-relaxed text-[#f6efe3]/80 [font-family:Fraunces,serif] [font-weight:450]">
                &ldquo;The Latina Sweat Project was never these walls. It has
                always been the people.&rdquo;
              </p>
              <footer class="mt-2 text-sm font-semibold text-[#f6efe3]/50">
                Margarita Quiñones-Peña, Founder
              </footer>
            </blockquote>

            <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:flex-wrap sm:justify-center lg:justify-start">
              <a
                href={graduationPageUrl}
                class="group inline-flex items-center justify-center gap-3 rounded-full bg-[#d79b47] px-7 py-4 text-base font-extrabold text-off-black shadow-lg shadow-[#d79b47]/25 transition hover:bg-[#f0c57c] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f0c57c] focus-visible:ring-offset-2 focus-visible:ring-offset-[#2b1520]"
                data-conversion-event="graduation_spotlight_click"
                data-conversion-context="home_graduation"
              >
                Relive the night
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </a>
              <a
                href={graduationFlickrUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center justify-center gap-3 rounded-full border border-[#f0c57c]/45 bg-white/[0.04] px-7 py-4 text-base font-extrabold text-[#f0c57c] backdrop-blur-sm transition hover:border-[#f0c57c] hover:bg-white/[0.08] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f0c57c] focus-visible:ring-offset-2 focus-visible:ring-offset-[#2b1520]"
                data-conversion-event="graduation_gallery_click"
                data-conversion-context="home_graduation"
              >
                View the full gallery
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </a>
            </div>
            <p class="mt-5 text-center text-xs font-extrabold uppercase tracking-[0.2em] text-[#f6efe3]/45 lg:text-left">
              Photos and the full story on the recap page
            </p>
          </div>

          {/* Media (right on desktop): the class photo on a dark
              gold-washed keepsake mat */}
          <div class="reveal relative mx-auto w-full max-w-xl lg:order-2" style="transition-delay: 120ms;">
            <div class="pointer-events-none absolute -inset-6 rounded-[2rem] bg-gradient-to-br from-[#d79b47]/25 via-[#e08cb8]/12 to-transparent opacity-80 blur-2xl" aria-hidden="true"></div>
            <figure class="relative">
              <div class="rounded-[2rem] bg-gradient-to-br from-[#d79b47]/20 via-[#2b1520] to-[#1e1216] p-2.5 shadow-2xl shadow-black/40 sm:p-3">
                <img
                  src={`${base}images/graduation/hero.jpg`}
                  width="1024"
                  height="683"
                  alt="The 2025 and 2026 YTT cohorts holding their certificates at LSP Studio"
                  class="w-full rounded-[1.4rem]"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption class="mt-4 flex flex-wrap items-center justify-center gap-x-2 text-xs font-bold uppercase tracking-[0.18em] text-[#f6efe3]/45 lg:justify-end">
                <span class="text-[#f0c57c]">Graduation night</span>
                <span aria-hidden="true">·</span>
                <span>Friday, August 7, 2026</span>
              </figcaption>
            </figure>
          </div>
        </div>

        {/* Companion band: YTT ’26 Trio Community Classes (Aug 11 to 31).
            Placement rationale: the trio series is the graduation story's
            next chapter (the same teachers, now taking the mat for their
            first live classes), so the promo lives INSIDE this candlelit
            rose room at the bottom of the spotlight rather than as its own
            section. That attaches it to the story it belongs to AND keeps
            the page's strict light/dark alternation intact: Sweat Fest's
            light honeydew section still lands directly below the same dark
            room. Compact by design: one keepsake-mat band, gold CTA to
            Zeffy (free tickets, donation encouraged), ghost CTA to
            /schedule where every session card lives. Same identity rules
            as the section: Fraunces display, #f0c57c/#d79b47 gold, orchid
            only in the trio-dot motif, no .gala-foil, no accent-gold. */}
        <div class="reveal relative mt-14 rounded-3xl border border-[#f0c57c]/25 bg-white/[0.04] p-6 sm:p-8" style="transition-delay: 200ms;">
          <div class="flex flex-col items-center gap-7 text-center lg:flex-row lg:justify-between lg:text-left">
            <div class="max-w-2xl">
              <p class="flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1 text-xs font-extrabold uppercase tracking-[0.2em] text-[#f0c57c] lg:justify-start">
                <span class="flex items-center gap-1.5" aria-hidden="true">
                  <span class="h-1.5 w-1.5 rounded-full bg-[#d79b47]"></span>
                  <span class="h-1.5 w-1.5 rounded-full bg-[#f0c57c]"></span>
                  <span class="h-1.5 w-1.5 rounded-full bg-[#e08cb8]"></span>
                </span>
                {yttTrio.title}
              </p>
              <h3 class="mt-3 text-2xl leading-tight text-[#f6efe3] [font-family:Fraunces,serif] [font-weight:650] sm:text-3xl">
                They graduated Aug 7.
                <span class="italic text-[#f0c57c]">Now they take the mat.</span>
              </h3>
              <p class="mt-3 text-base leading-relaxed text-[#f6efe3]/70">
                Free community classes: one 45-minute flow, three new
                teachers, 15 minutes each. Come be their first room.
              </p>
              <p class="mt-2 text-sm font-bold text-[#f6efe3]/85">
                {yttTrio.dateRangeLabel} · {yttTrio.venueName} · Free tickets
                · Donation to LSP encouraged
              </p>
            </div>
            <div class="flex shrink-0 flex-col items-center gap-3 sm:flex-row lg:flex-col xl:flex-row">
              <a
                href={yttTrio.ticketsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center justify-center gap-2.5 rounded-full bg-[#d79b47] px-6 py-3.5 text-sm font-extrabold text-off-black shadow-lg shadow-[#d79b47]/25 transition hover:bg-[#f0c57c] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f0c57c] focus-visible:ring-offset-2 focus-visible:ring-offset-[#2b1520]"
                data-conversion-event="ytt_trio_ticket_click"
                data-conversion-context="home_ytt_trio"
                data-conversion-provider="zeffy"
              >
                {yttTrio.ticketsLabel}
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </a>
              <a
                href={`${base}schedule`}
                class="inline-flex items-center justify-center gap-2.5 rounded-full border border-[#f0c57c]/45 bg-white/[0.04] px-6 py-3.5 text-sm font-extrabold text-[#f0c57c] backdrop-blur-sm transition hover:border-[#f0c57c] hover:bg-white/[0.08] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f0c57c] focus-visible:ring-offset-2 focus-visible:ring-offset-[#2b1520]"
                data-conversion-event="ytt_trio_schedule_click"
                data-conversion-context="home_ytt_trio"
              >
                All {yttTrioSessions.length} dates
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
    {/* END: Graduation 2026 */}

    {/* START: Sweat Fest (first event spotlight, official checkerboard-logo
        identity: checkerboard tile strip, taped-up poster, handmade
        wordmark over honeydew. First light section, directly after the
        dark Graduation lead) */}
    <section class="relative overflow-hidden py-16 sm:py-20 lg:py-24" style="background: linear-gradient(to bottom, #eaf0c8, #e2ecac 45%, #dde8a8);">
      {/* Checkerboard tile strip along the top */}
      <div
        class="sf-picado absolute inset-x-0 top-0 h-[52px]"
        style={`background-image: ${sweatFestCheckerUri};`}
        aria-hidden="true"
      >
      </div>
      {/* Soft magenta-to-teal glow behind the poster */}
      <div class="pointer-events-none absolute -top-24 -right-16 h-80 w-80 rounded-full bg-gradient-to-br from-[#ee3083]/25 to-[#00a7ab]/15 blur-[110px]" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-7xl px-4 pt-8 sm:px-6 lg:px-8 text-off-black">
        <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-14">
          {/* Media (left): the campaign poster taped to the wall. The official
              logo and event copy are real DOM, never baked into generated art. */}
          <div class="reveal relative mx-auto w-full max-w-md lg:max-w-none">
            <div class="sf-taped -rotate-[1.3deg]">
              <span class="sf-tape -left-4 -top-3 rotate-[-38deg]" aria-hidden="true"></span>
              <span class="sf-tape -right-4 -top-3 rotate-[34deg]" aria-hidden="true"></span>
              <SweatFestArtwork variant="portrait" className="rounded-[3px]" />
              <p class="mt-3 text-center font-slab text-sm uppercase tracking-[0.2em] text-off-black/70">
                {sweatFest.tagline}
              </p>
            </div>
          </div>

          {/* Copy (right) */}
          <div class="reveal text-center lg:text-left" style="transition-delay: 80ms;">
            <span class="sf-stamp px-3 py-1.5 text-[11px] sm:text-xs" style="color: #b23c14;">
              LSP's first-ever all-day festival · Chicago · August 22
            </span>
            <h2 class="mt-6 font-slab text-5xl uppercase leading-[0.98] tracking-tight sm:text-6xl lg:text-7xl" style="color: #123f36;">
              <span class="sf-print" style="--sf-print: #ee3083;">Run.</span>
              <span class="sf-print" style="--sf-print: #00a7ab;">Sweat.</span>
              <span class="sf-print whitespace-nowrap" style="--sf-print: #60a444;">Pachanga.</span>
            </h2>
            <p class="mt-5 text-lg font-bold text-off-black">
              {sweatFest.dateLabel} · {sweatFest.timeLabel}
            </p>
            <p class="mt-1 text-base font-semibold text-medium-gray">
              {sweatFest.venueLine}
            </p>
            <p class="mt-3 text-base font-semibold text-off-black/70">
              {sweatFest.taglineSub}
            </p>

            <div class="mt-6 flex flex-wrap justify-center gap-3 lg:justify-start">
              {sweatFestDay.map((phase, i) => (
                <span
                  class="sf-tag inline-flex items-center gap-2 px-3.5 py-1.5 text-xs font-extrabold uppercase tracking-[0.08em] text-off-black"
                  style={`transform: rotate(${[-1.2, 0.8, -0.6][i % 3]}deg);`}
                >
                  <span class="inline-block h-2 w-2 rotate-45" style={`background-color: ${sweatFestDeepAccents[phase.accent]};`} aria-hidden="true"></span>
                  {phase.title} · {phase.time}
                </span>
              ))}
            </div>

            <p class="mt-5 max-w-2xl text-lg leading-relaxed text-medium-gray mx-auto lg:mx-0">
              {sweatFest.homepageDescription}
            </p>

            <p class="mt-3 text-sm font-bold text-off-black/70">
              Passes from $25 · All-day $60 · All levels welcome
            </p>

            <div class="mt-8 flex flex-col items-center gap-5 sm:flex-row sm:justify-center lg:justify-start">
              <a
                href={sweatFestPrimaryUrl}
