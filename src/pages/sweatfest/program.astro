<script>
  // ---------- Sticky tab bar: highlight the section in view ----------
  (() => {
    const tabs = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("[data-prog-tab]"),
    );
    if (!tabs.length || !("IntersectionObserver" in window)) return;
    const byId = new Map(tabs.map((tab) => [tab.dataset.progTab, tab]));
    const setActive = (id: string | undefined) => {
      tabs.forEach((tab) =>
        tab.setAttribute(
          "aria-current",
          tab.dataset.progTab === id ? "true" : "false",
        ),
      );
    };
    const visible = new Map<string, number>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          visible.set(entry.target.id, entry.intersectionRatio);
        });
        let best: string | undefined;
        let bestRatio = 0;
        visible.forEach((ratio, id) => {
          if (ratio > bestRatio) {
            bestRatio = ratio;
            best = id;
          }
        });
        if (best) setActive(best);
      },
      { rootMargin: "-72px 0px -40% 0px", threshold: [0, 0.15, 0.4, 0.8] },
    );
    byId.forEach((_tab, id) => {
      const section = id && document.getElementById(id);
      if (section) observer.observe(section);
    });
  })();

  // ---------- Map: legend <-> marker highlighting ----------
  (() => {
    const legends = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-map-legend]"),
    );
    const markers = Array.from(
      document.querySelectorAll<SVGGElement>("[data-map-marker]"),
    );
    const detail = document.querySelector<HTMLElement>("[data-map-detail]");
    if (!legends.length || !markers.length) return;

    const activate = (id: string | null) => {
      legends.forEach((legend) =>
        legend.classList.toggle("is-active", legend.dataset.mapLegend === id),
      );
      markers.forEach((marker) =>
        marker.classList.toggle("is-active", marker.dataset.mapMarker === id),
      );
      const legend = legends.find((l) => l.dataset.mapLegend === id);
      if (detail) {
        if (legend) {
          detail.classList.remove("hidden");
          detail.innerHTML = "";
          const strong = document.createElement("strong");
          strong.textContent = legend.dataset.mapLabel || "";
          const text = document.createElement("span");
          text.textContent = ` — ${legend.dataset.mapDetailText || ""}`;
          detail.append(strong, text);
        } else {
          detail.classList.add("hidden");
        }
      }
    };

    let current: string | null = null;
    const toggle = (id: string) => {
      current = current === id ? null : id;
      activate(current);
    };
    legends.forEach((legend) =>
      legend.addEventListener("click", () => {
        toggle(legend.dataset.mapLegend!);
        if (current)
          legend
            .closest("section")
            ?.querySelector("svg")
            ?.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }),
    );
    markers.forEach((marker) => {
      marker.addEventListener("click", () => toggle(marker.dataset.mapMarker!));
      marker.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          toggle(marker.dataset.mapMarker!);
        }
      });
    });

    // "Find on map" buttons scattered through the schedule: jump to the map
    // with that spot highlighted.
    document
      .querySelectorAll<HTMLButtonElement>("[data-find-on-map]")
      .forEach((button) =>
        button.addEventListener("click", () => {
          current = button.dataset.findOnMap!;
          activate(current);
          document
            .getElementById("map")
            ?.scrollIntoView({ behavior: "smooth", block: "start" });
        }),
      );
  })();

  // ---------- Save-to-phone walkthrough dialog ----------
  (() => {
    const dialog = document.querySelector<HTMLDialogElement>(
      "[data-shortcut-dialog]",
    );
    const opener = document.querySelector<HTMLButtonElement>(
      "[data-shortcut-open]",
    );
    if (!dialog || !opener) return;
    opener.addEventListener("click", () => dialog.showModal());
    dialog
      .querySelector("[data-shortcut-close]")
      ?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  })();

  // ---------- Happening now: live badges on event day ----------
  (() => {
    const strip = document.querySelector<HTMLElement>("[data-prog-now]");
    const body = document.querySelector<HTMLElement>("[data-prog-now-body]");
    const slots = Array.from(
      document.querySelectorAll<HTMLElement>("[data-prog-slot]"),
    );
    if (!strip || !body || !slots.length) return;

    const chicagoNow = () => {
      const parts = new Intl.DateTimeFormat("en-US", {
        timeZone: "America/Chicago",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
      }).formatToParts(new Date());
      const get = (type: string) =>
        parts.find((part) => part.type === type)?.value ?? "";
      return {
        date: `${get("year")}-${get("month")}-${get("day")}`,
        minutes: Number(get("hour")) * 60 + Number(get("minute")),
      };
    };

    const fmt = (minutes: number) => {
      const h24 = Math.floor(minutes / 60);
      const h = h24 % 12 === 0 ? 12 : h24 % 12;
      const m = String(minutes % 60).padStart(2, "0");
      return `${h}:${m} ${h24 < 12 ? "AM" : "PM"}`;
    };

    const update = () => {
      const now = chicagoNow();
      // Live only on festival day while the day is running.
      const live = now.date === "2026-08-22" && now.minutes >= 6 * 60 && now.minutes < 21 * 60 + 30;
      const current: HTMLElement[] = [];
      let nextStart = Infinity;
      slots.forEach((slot) => {
        const start = Number(slot.dataset.start);
        const end = Number(slot.dataset.end);
        const badge = slot.querySelector<HTMLElement>("[data-prog-badge]");
        const isNow = live && now.minutes >= start && now.minutes < end;
        if (isNow) current.push(slot);
        if (live && start > now.minutes && start < nextStart) nextStart = start;
        if (badge) {
          badge.classList.toggle("hidden", !isNow);
          if (isNow) badge.textContent = "Now";
        }
        slot.classList.toggle("ring-4", isNow);
        slot.classList.toggle("ring-[var(--sf-sunrise)]", isNow);
      });
      if (!live) {
        strip.classList.add("hidden");
        return;
      }
      strip.classList.remove("hidden");
      body.innerHTML = "";
      const add = (label: string, value: string) => {
        const cell = document.createElement("p");
        const tag = document.createElement("span");
        tag.className =
          "mr-2 text-[10px] font-extrabold uppercase tracking-[0.18em] text-white/60";
        tag.textContent = label;
        cell.append(tag, document.createTextNode(value));
        body.append(cell);
      };
      if (current.length)
        current.forEach((slot) =>
          add(
            slot.dataset.where || "Now",
            slot.dataset.title || "",
          ),
        );
      else add("Now", "Between sets. Hydrate, visit the vendors.");
      if (nextStart < Infinity) {
        const upNext = slots
          .filter((slot) => Number(slot.dataset.start) === nextStart)
          .map((slot) =>
            slot.dataset.where
              ? `${slot.dataset.title} (${slot.dataset.where})`
              : slot.dataset.title,
          )
          .join(" · ");
        add(`Up next · ${fmt(nextStart)}`, upNext || "");
      }
    };

    update();
    window.setInterval(update, 30_000);
  })();
</script>
