---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import {
  sweatFest,
  sweatFestLineup,
  sweatFestMoments,
  sweatFestProgram,
  sweatFestColors,
  sweatFestPalette,
  sweatFestCheckerUri,
} from "@/data/sweatFest";

// Sweat Fest day-of program: the digital, interactive version of the printed
// program carousel. This is the page every program QR code opens, so it is
// built phone-first for someone standing on Peoria St: a live "happening
// now" strip on event day, the two-stage lineup with tap-open descriptions,
// a tappable festival map, the packing list, and transportation. Facts render
// from src/data/sweatFest.js (sweatFestProgram + the shared lineup).

const p = sweatFestPalette;
const picadoUri = sweatFestCheckerUri;

// Deepened accent for small text on light grounds (same recipe as /sweatfest).
const deep = (hex) => `color-mix(in oklab, ${hex} 48%, #123f36)`;

const stageAccent = {
  West: p.magenta,
  East: p.teal,
};
const stageNames = ["West", "East"];

// Minutes since midnight from labels like "7:00 AM", "8:00 to 10:00 AM", or
// "11:45 AM to 12:30 PM" (same parser as /sweatfest).
const startMinutes = (label) => {
  const time = label.match(/(\d{1,2}):(\d{2})/);
  const meridiem = label.match(/AM|PM/);
  if (!time) return 0;
  const hours = (Number(time[1]) % 12) + (meridiem?.[0] === "PM" ? 12 : 0);
  return hours * 60 + Number(time[2]);
};
// End minutes: the last clock time in a range label paired with the final
// meridiem; single-time labels get null (a moment, not a span).
const endMinutes = (label) => {
  const times = [...label.matchAll(/(\d{1,2}):(\d{2})/g)];
  if (times.length < 2) return null;
  const last = times[times.length - 1];
  const meridiems = [...label.matchAll(/AM|PM/g)];
  const meridiem = meridiems[meridiems.length - 1]?.[0];
  const hours = (Number(last[1]) % 12) + (meridiem === "PM" ? 12 : 0);
  return hours * 60 + Number(last[2]);
};

// Group classes and moments into time-ordered slots, mirroring /sweatfest:
// classes land on their stage, staged DJ sets share the row, stageless
// moments run full-width.
const slotMap = new Map();
const slotAt = (minutes, timeLabel) => {
  if (!slotMap.has(minutes))
    slotMap.set(minutes, {
      minutes,
      timeLabel,
      West: null,
      East: null,
      wide: null,
    });
  return slotMap.get(minutes);
};
for (const cls of sweatFestLineup)
  slotAt(startMinutes(cls.start), cls.timeLabel)[cls.stage] = {
    kind: "class",
    end: endMinutes(cls.timeLabel) ?? startMinutes(cls.start) + 45,
    ...cls,
  };
for (const moment of sweatFestMoments) {
  const start = startMinutes(moment.timeLabel);
  const slot = slotAt(start, moment.timeLabel);
  const entry = {
    kind: "moment",
    end: endMinutes(moment.timeLabel),
    ...moment,
  };
  if (moment.stage) slot[moment.stage] = entry;
  else slot.wide = entry;
}
const runOfShow = [...slotMap.values()].sort((a, b) => a.minutes - b.minutes);

// Short time chip for a slot ("9:00 AM" from any label shape).
const chipTime = (label) => {
  const time = label.match(/\d{1,2}:\d{2}/)?.[0] ?? label;
  const meridiem = label.match(/AM|PM/)?.[0] ?? "";
  return `${time} ${meridiem}`.trim();
};

// Program sections drive both the sticky tab bar and the section anchors.
const sections = [
  { id: "schedule", label: "Schedule" },
  { id: "lineup", label: "Lineup" },
  { id: "map", label: "Map" },
  { id: "pack", label: "Pack" },
  { id: "getting-here", label: "Getting here" },
];

// The map artwork is the artist's final festival map; interactivity sits on
// top as invisible hotspots. Coordinates are pixels in the source image
// (3181x2219), centered on each icon the artist drew.
const mapImage = {
  src: "/images/sweatfest/festival-map.webp",
  width: 3181,
  height: 2219,
};
const mapSpots = {
  "west-stage": { x: 312, y: 223, r: 190 },
  "east-stage": { x: 2840, y: 223, r: 190 },
  "water-west": { x: 959, y: 207, r: 110 },
  food: { x: 1277, y: 194, r: 110 },
  vendors: { x: 2107, y: 204, r: 110 },
  "first-aid": { x: 2584, y: 119, r: 105 },
  "water-east": { x: 2587, y: 273, r: 105 },
  bathrooms: { x: 1627, y: 501, r: 150 },
  info: { x: 1625, y: 1005, r: 110 },
  rest: { x: 1625, y: 1243, r: 110 },
  "check-in": { x: 1625, y: 1466, r: 110 },
  entrance: { x: 1625, y: 1757, r: 150 },
};
const numberedPois = sweatFestProgram.map.pois.filter(
  (poi) => poi.kind !== "stage",
);
const poiNumber = (id) => numberedPois.findIndex((poi) => poi.id === id) + 1;

// Marker pictograms, echoing the printed map's white icon chips. Each glyph
// is drawn in a 24x24 box; `inside: true` glyphs are filled shapes that
// carry their number inside the graphic (the first-aid plus, the water
// droplets), everything else gets a corner number badge.
const ink = "#123f36";
const stroked = (d, color, width = 2.2) =>
  `<path d="${d}" fill="none" stroke="${color}" stroke-width="${width}" stroke-linecap="round" stroke-linejoin="round"/>`;
const poiGlyphs = {
  "check-in": { svg: stroked("M4.5 13l5 5L19.5 6.5", "#ffffff", 3.4) },
  entrance: {
    svg: stroked("M6.5 20.5v-8a5.5 5.5 0 0 1 11 0v8", "#ffffff", 3),
  },
  info: {
    svg:
      `<circle cx="12" cy="12" r="9.2" fill="none" stroke="${p.verde}" stroke-width="2.4"/>` +
      stroked("M12 11v5.4", p.verde, 2.6) +
      `<circle cx="12" cy="7.4" r="1.5" fill="${p.verde}"/>`,
  },
  rest: {
    svg: stroked(
      "M4 9.5h16M9 9.5l-3.2 9M15 9.5l3.2 9M6.8 14.5h10.4",
      p.naranja,
    ),
  },
  "water-west": {
    inside: true,
    numY: 8,
    svg: `<path d="M12 2.4C8.5 7.2 5.6 10.8 5.6 14.3a6.4 6.4 0 0 0 12.8 0c0-3.5-2.9-7.1-6.4-11.9z" fill="${p.teal}" stroke="${ink}" stroke-width="1.4"/>`,
  },
  food: {
    svg: stroked(
      "M7.2 3v4.4a2 2 0 0 0 4 0V3M9.2 3v18M9.2 12h.01M15.8 3c-1.5.9-2.4 2.7-2.4 5 0 2.2.9 3.6 2.4 4V3zm0 9v9",
      p.naranja,
    ),
  },
  vendors: {
    svg: stroked(
      "M4.5 8.6L6 4.5h12l1.5 4.1M4.5 8.6V20h15V8.6M4.5 8.6c0 1.3 1.1 2.4 2.5 2.4s2.5-1.1 2.5-2.4c0 1.3 1.1 2.4 2.5 2.4s2.5-1.1 2.5-2.4c0 1.3 1.1 2.4 2.5 2.4s2.5-1.1 2.5-2.4M9.5 20v-5.5h5V20",
      p.naranja,
      2,
    ),
  },
  bathrooms: {
    svg:
      `<circle cx="7.6" cy="4.9" r="1.9" fill="${p.naranja}"/>` +
      stroked("M7.6 8v6.5M5.5 21l2.1-6.5 2.1 6.5M5.4 11.4h4.4", p.naranja, 2) +
      `<circle cx="16.4" cy="4.9" r="1.9" fill="${p.naranja}"/>` +
      stroked("M13.8 15l2.6-7 2.6 7zM16.4 15v6", p.naranja, 2),
  },
  "first-aid": {
    inside: true,
    numY: 5.5,
    svg: `<path d="M9 3h6v6h6v6h-6v6H9v-6H3V9h6z" fill="${p.naranja}" stroke="${ink}" stroke-width="1.4" stroke-linejoin="round"/>`,
  },
};
poiGlyphs["water-east"] = poiGlyphs["water-west"];

// Full marker artwork around the origin: starbursts for the stages, icon
// chips with integrated numbers for everything else. Reused by the map
// markers and, shrunk into small <svg> elements, by the legend buttons.
const starPath =
  "M 0 -38 l 9 24 25 -15 -15 25 24 9 -24 9 15 25 -25 -15 -9 24 -9 -24 -25 15 15 -25 -24 -9 24 -9 -15 -25 25 15 z";
const markerBody = (poi) => {
  if (poi.kind === "stage") {
    const word = poi.label.split(" ")[0].toUpperCase();
    return (
      `<path d="${starPath}" fill="${p.magenta}" stroke="${ink}" stroke-width="3" stroke-linejoin="round"/>` +
      `<text x="0" y="-3" text-anchor="middle" font-size="12" font-weight="900" fill="#ffffff">${word}</text>` +
      `<text x="0" y="11" text-anchor="middle" font-size="12" font-weight="900" fill="#ffffff">STAGE</text>`
    );
  }
  const n = poiNumber(poi.id);
  const glyph = poiGlyphs[poi.id];
  const chipFill = poi.kind === "access" ? p.verde : "#ffffff";
  let s = `<rect x="-24" y="-24" width="48" height="48" rx="11" fill="${chipFill}" stroke="${ink}" stroke-width="3"/>`;
  if (glyph.inside) {
    s += `<g transform="translate(-19.2 -20.2) scale(1.6)">${glyph.svg}</g>`;
    s += `<text x="0" y="${glyph.numY}" text-anchor="middle" font-size="16" font-weight="900" fill="#ffffff">${n}</text>`;
  } else {
    s += `<g transform="translate(-15.6 -15.6) scale(1.3)">${glyph.svg}</g>`;
    s += `<circle cx="19" cy="-19" r="13.5" fill="${ink}" stroke="#ffffff" stroke-width="2.5"/>`;
    s += `<text x="19" y="-13.4" text-anchor="middle" font-size="16" font-weight="900" fill="#ffffff">${n}</text>`;
  }
  return s;
};

// "Find on map" targets: stage items point at their stage marker; the
// stageless framing moments map to the spot they actually happen at.
const stageMarker = { West: "west-stage", East: "east-stage" };
const wideMarker = { "Kickoff 5K": "entrance", "Doors open": "check-in" };
const pinGlyph =
  '<path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-6.5-5.4-6.5-10.2a6.5 6.5 0 0 1 13 0C18.5 15.6 12 21 12 21z"/><circle cx="12" cy="10.6" r="2.3"/>';

// Transportation mode icons (24x24 stroke paths), keyed by entry id.
const transitIcons = {
  train:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M7 3h10a2 2 0 012 2v9a3 3 0 01-3 3H8a3 3 0 01-3-3V5a2 2 0 012-2zM5 10h14M9.5 14.5h.01M14.5 14.5h.01M8 17l-2 4m10-4l2 4m-9-1h6" />',
  bus: '<path stroke-linecap="round" stroke-linejoin="round" d="M5 4h14a1 1 0 011 1v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5a1 1 0 011-1zM4 9.5h16M8.5 14.5h.01M15.5 14.5h.01M7 18v2.5M17 18v2.5" />',
  bike: '<circle cx="6" cy="16.5" r="3.5" /><circle cx="18" cy="16.5" r="3.5" /><path stroke-linecap="round" stroke-linejoin="round" d="M6 16.5L9.5 9h6L18 16.5M9.5 9L8.5 6H7m5.5 10.5L15.5 9" />',
  metra:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M8 3.5h8a3 3 0 013 3V14a2.5 2.5 0 01-2.5 2.5h-9A2.5 2.5 0 015 14V6.5a3 3 0 013-3zM5 10h14M9.5 13.5h.01M14.5 13.5h.01M8.5 16.5L6 21m12-4.5L20.5 21M9 21h6" />',
  parking:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M6 4h12a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2zm4 12v-8h3.25a2.5 2.5 0 010 5H10" />',
};

// Map-app destination links: both major phone platforms, from one query.
const gmaps = (q) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`;
const amaps = (q) => `https://maps.apple.com/?q=${encodeURIComponent(q)}`;

const metaDescription =
  "The Sweat Fest 2026 day-of program: the two-stage class schedule, festival map, packing list, and how to get to 18th & Peoria.";
---

<Layout
  title="Sweat Fest Program | The Latina Sweat Project"
  description={metaDescription}
  socialImage="/images/sweatfest/sweatfest-social-v4.jpg"
  socialImageAlt="Sweat Fest: the checkerboard-bordered Sweat Fest logo over August 22, 2026, 7:00 AM to 9:00 PM, 18th & Peoria, Chicago"
  socialImageWidth={1200}
  socialImageHeight={675}
  socialImageType="image/jpeg"
  twitterCard="summary_large_image"
>
  {/* Home-screen shortcut identity: saving this page to a phone gets the
      checkerboard Sweat Fest tile instead of a generic screenshot. */}
  <link
    slot="head"
    rel="manifest"
    href="/sweatfest-program.webmanifest"
  />
  <link
    slot="head"
    rel="apple-touch-icon"
    sizes="180x180"
    href="/images/sweatfest/program-icon-180.png"
  />
  <Header />
  <main
    class="overflow-x-clip bg-[#e2ecac] text-choco"
    style={`--sf-sunrise: ${sweatFestColors.sunrise}; --sf-ember: ${sweatFestColors.ember}; --sf-dusk: ${sweatFestColors.dusk};`}
  >
    {/* ---------- Program masthead ---------- */}
    <section class="relative overflow-hidden bg-[#e2ecac] pb-8 pt-10 sm:pt-14">
      <div
        class="sf-picado absolute inset-x-0 top-0 h-[26px] opacity-90"
        style={`background-image: ${picadoUri}; background-size: 104px 34.6px;`}
        aria-hidden="true"
      >
      </div>
      <div class="relative mx-auto max-w-3xl px-4 pt-4 text-center">
        <p
          class="text-[11px] font-extrabold uppercase tracking-[0.28em] text-choco/70"
        >
          {sweatFest.presentedBy}
        </p>
        <h1
          class="mt-3 font-slab uppercase leading-[0.95] tracking-tight"
        >
          <span
            class="sf-print block text-[3.4rem] sm:text-[4.6rem]"
            style="--sf-print: #60a444;">Sweat Fest</span
          >
          <span
            class="sf-print block text-[2.5rem] sm:text-[3.4rem]"
            style="--sf-print: #ee3083;">Program</span
          >
        </h1>
        <div class="mt-5 flex flex-wrap items-center justify-center gap-2">
          {
            [
              sweatFest.dateLabel,
              sweatFest.venueLine,
              "7:00 AM to 9:00 PM",
            ].map((fact) => (
              <span class="sf-tag inline-flex items-center px-3 py-1.5 text-[11px] font-extrabold uppercase tracking-[0.08em] text-choco">
                {fact}
              </span>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------- Sticky section tabs ---------- */}
    <nav
      class="sf-prog-tabs sticky top-0 z-40 border-y-2 border-choco bg-[#f4f7dc]"
      aria-label="Program sections"
    >
      <div
        class="mx-auto flex max-w-3xl items-stretch gap-1 overflow-x-auto px-2 py-2"
      >
        {
          sections.map((section) => (
            <a
              href={`#${section.id}`}
              data-prog-tab={section.id}
              class="sf-prog-tab flex-none whitespace-nowrap rounded-lg px-3.5 py-2 text-xs font-extrabold uppercase tracking-[0.08em] text-choco/80 transition-colors"
            >
              {section.label}
            </a>
          ))
        }
      </div>
    </nav>

    {/* ---------- Happening now (event day only, filled by JS) ---------- */}
    <section
      id="now"
      data-prog-now
      class="hidden border-b-2 border-choco bg-choco px-4 py-5 text-white"
    >
      <div class="mx-auto max-w-3xl">
        <p
          class="inline-flex items-center gap-2 text-[11px] font-extrabold uppercase tracking-[0.24em] text-white/80"
        >
          <span
            class="sf-prog-live-dot h-2.5 w-2.5 rounded-full"
            style={`background: ${p.magenta};`}
            aria-hidden="true"></span>
          Happening now
        </p>
        <div
          data-prog-now-body
          class="mt-3 grid gap-2 text-sm font-semibold sm:grid-cols-2"
        >
        </div>
      </div>
    </section>

    {/* ---------- Day at a glance ---------- */}
    <section id="schedule" class="scroll-mt-24 px-4 py-10 sm:py-12">
      <div class="mx-auto max-w-3xl">
        <h2
          class="font-slab text-3xl uppercase tracking-tight sm:text-4xl"
        >
          The day at a glance
        </h2>
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          {
            sweatFestProgram.glance.map((row, i) => (
              <div
                class="sf-note flex items-center gap-4 p-4"
                style={`transform: rotate(${[-0.7, 0.5, -0.4, 0.6][i % 4]}deg);`}
              >
                <span
                  class="flex-none rounded-lg border-2 border-choco px-2.5 py-1.5 text-xs font-extrabold uppercase tracking-[0.04em]"
                  style={`background: ${[p.rosa, p.honeydew, "#bfe0e1", "#cfe3b6"][i % 4]};`}
                >
                  {row.time}
                </span>
                <span class="text-base font-extrabold uppercase tracking-[0.06em]">
                  {row.title}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------- Two-stage lineup ---------- */}
    <section
      id="lineup"
      class="scroll-mt-24 border-t-2 border-dashed border-choco/25 px-4 py-10 sm:py-12"
    >
      <div class="mx-auto max-w-3xl">
        <h2 class="font-slab text-3xl uppercase tracking-tight sm:text-4xl">
          Sweat schedule
        </h2>
        <p class="mt-2 text-sm font-semibold text-choco/75">
          Every class is 45 minutes. Tap a class for its description.
        </p>
        <div class="mt-4 flex flex-wrap gap-2" aria-hidden="true">
          {
            stageNames.map((stage) => (
              <span
                class="inline-flex items-center gap-2 rounded-lg border-2 border-choco bg-white px-3 py-1.5 text-[11px] font-extrabold uppercase tracking-[0.1em]"
                style={`color: ${deep(stageAccent[stage])};`}
              >
                <span
                  class="h-2.5 w-2.5 rounded-full"
                  style={`background: ${stageAccent[stage]};`}
                />
                {stage} Stage
              </span>
            ))
          }
        </div>

        <div class="mt-6 space-y-3">
          {
            runOfShow.map((slot) => (
              <>
                {slot.wide && (
                  <div
                    class="relative overflow-hidden rounded-xl border-2 border-choco bg-choco px-4 py-3.5 text-white"
                    data-prog-slot
                    data-start={slot.minutes}
                    data-end={slot.wide.end ?? slot.minutes + 30}
                    data-title={slot.wide.title}
                    data-where=""
                  >
                    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                      <span class="text-xs font-extrabold uppercase tracking-[0.14em] text-white/75">
                        {slot.wide.timeLabel}
                      </span>
                      <span class="font-slab text-xl uppercase tracking-tight">
                        {slot.wide.title}
                      </span>
                      <span
                        data-prog-badge
                        class="hidden rounded-md px-2 py-0.5 text-[10px] font-extrabold uppercase tracking-[0.12em] text-choco"
                        style={`background: ${p.honeydew};`}
                      />
                    </div>
                    {slot.wide.detail && (
                      <p class="mt-1 text-sm font-semibold text-white/80">
                        {slot.wide.detail}
                      </p>
                    )}
                    {wideMarker[slot.wide.title] && (
                      <button
                        type="button"
                        data-find-on-map={wideMarker[slot.wide.title]}
                        class="sf-find-map mt-2 inline-flex items-center gap-1.5 rounded-lg border-2 border-white/40 px-2.5 py-1 text-[11px] font-extrabold uppercase tracking-[0.1em] text-white/90 transition-colors hover:border-white hover:bg-white/10"
                      >
                        <svg
                          class="h-3.5 w-3.5"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2"
                          aria-hidden="true"
                          set:html={pinGlyph}
                        />
                        Find on map
                      </button>
                    )}
                  </div>
                )}
                {(slot.West || slot.East) && (
                  <div class="grid gap-3 sm:grid-cols-[auto_1fr_1fr] sm:items-stretch">
                    <div class="hidden sm:flex sm:w-24 sm:flex-none sm:items-start sm:justify-center sm:pt-4">
                      <span class="sf-tag px-2.5 py-1 text-xs font-extrabold uppercase tracking-[0.04em] text-choco">
                        {chipTime(slot.timeLabel)}
                      </span>
                    </div>
                    {stageNames.map((stage) => {
                      const entry = slot[stage];
                      if (!entry)
                        return (
                          <div
                            class="hidden items-center justify-center rounded-xl border-2 border-dashed border-choco/20 sm:flex"
                            aria-hidden="true"
                          >
                            <span class="text-choco/30">~</span>
                          </div>
                        );
                      const accent = stageAccent[stage];
                      if (entry.kind === "moment")
                        return (
                          <article
                            class="relative overflow-hidden rounded-xl border-2 border-choco bg-white p-4"
                            data-prog-slot
                            data-start={slot.minutes}
                            data-end={entry.end ?? slot.minutes + 45}
                            data-title={entry.title}
                            data-where={`${stage} Stage`}
                          >
                            <span
                              class="absolute inset-y-0 left-0 w-1.5"
                              style={`background: ${accent};`}
                              aria-hidden="true"
                            />
                            <div class="flex flex-wrap items-center gap-2 pl-2">
                              <span
                                class="text-[11px] font-extrabold uppercase tracking-[0.12em]"
                                style={`color: ${deep(accent)};`}
                              >
                                {entry.timeLabel} · {stage} Stage
                              </span>
                              <span
                                data-prog-badge
                                class="hidden rounded-md px-2 py-0.5 text-[10px] font-extrabold uppercase tracking-[0.12em] text-white"
                                style={`background: ${p.magenta};`}
                              />
                            </div>
                            <p class="pl-2 pt-1 font-slab text-xl uppercase tracking-tight">
                              {entry.title}
                            </p>
                            {entry.detail && (
                              <p class="pl-2 pt-1 text-sm font-semibold text-choco/75">
                                {entry.detail}
                              </p>
                            )}
                            <button
                              type="button"
                              data-find-on-map={stageMarker[stage]}
                              class="sf-find-map ml-2 mt-2 inline-flex items-center gap-1.5 rounded-lg border-2 border-choco/30 px-2.5 py-1 text-[11px] font-extrabold uppercase tracking-[0.1em] text-choco/75 transition-colors hover:border-choco hover:bg-[#f4f7dc]"
                            >
                              <svg
                                class="h-3.5 w-3.5"
