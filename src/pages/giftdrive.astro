        .gd-btn {
            transition: none;
        }
        .gd-btn:hover,
        .gd-btn:active {
            transform: none;
        }
    }
</style>

<script>
    import { initGiftDrivePlacements } from "@/lib/giftDrivePlacement.js";
    import { giftDriveChecklistKey } from "@/data/giftDrive.js";

    initGiftDrivePlacements();

    // ---------------------------------------------------- the checklist --
    const boxes = Array.from(document.querySelectorAll<HTMLInputElement>(".gd-box"));
    const done = document.getElementById("gd-done");
    const reset = document.getElementById("gd-reset") as HTMLButtonElement | null;
    const DONE_LINE = "You're all set. Thank you for filling a wish list.";

    function load(): Record<string, boolean> {
        try {
            return JSON.parse(window.localStorage.getItem(giftDriveChecklistKey) || "{}") || {};
        } catch {
            return {};
        }
    }
    function save() {
        const state: Record<string, boolean> = {};
        boxes.forEach((b) => {
            if (b.checked) state[b.dataset.key || ""] = true;
        });
        try {
            if (Object.keys(state).length) window.localStorage.setItem(giftDriveChecklistKey, JSON.stringify(state));
            else window.localStorage.removeItem(giftDriveChecklistKey);
        } catch {
            /* private mode: the ticks just won't be remembered */
        }
    }
    function render() {
        const n = boxes.filter((b) => b.checked).length;
        if (done) done.textContent = n === boxes.length && n > 0 ? DONE_LINE : "";
        if (reset) reset.hidden = n === 0;
    }
    const saved = load();
    boxes.forEach((b) => {
        b.checked = !!saved[b.dataset.key || ""];
        b.addEventListener("change", () => {
            save();
            render();
        });
    });
    render();
    reset?.addEventListener("click", () => {
        boxes.forEach((b) => (b.checked = false));
        save();
        render();
        boxes[0]?.focus();
    });

    // ------------------------------------------------------- share page --
    const share = document.getElementById("gd-share") as HTMLButtonElement | null;
    const shareUrl = `${window.location.origin}/giftdrive`;
    share?.addEventListener("click", async () => {
        if (navigator.share) {
            try {
                await navigator.share({ title: "Holiday Gift Drive | Latina Sweat Project", url: shareUrl });
                return;
            } catch (err) {
                if ((err as Error)?.name === "AbortError") return;
            }
        }
        try {
            await navigator.clipboard.writeText(shareUrl);
        } catch {
            const ta = document.createElement("textarea");
            ta.value = shareUrl;
            ta.setAttribute("readonly", "");
            ta.style.position = "fixed";
            ta.style.opacity = "0";
            document.body.appendChild(ta);
            ta.select();
            try {
                document.execCommand("copy");
            } catch {
                /* nothing more to try */
            }
            ta.remove();
        }
        share.textContent = "Link copied";
        window.setTimeout(() => (share.textContent = "Share this page"), 2000);
    });
</script>
