    }
    .gd-reset {
        display: inline-block;
        margin-top: 0.75rem;
        min-height: 44px;
        padding: 0;
        background: none;
        border: 0;
        color: var(--gd-ink);
        font: inherit;
        font-size: 1rem;
        font-weight: 500;
        text-decoration: underline;
        text-decoration-thickness: 1.5px;
        text-underline-offset: 4px;
        cursor: pointer;
    }

    /* ----------------------------- team up ---------------------------- */
    .gd-gifts-close {
        margin: 0 auto 3.5rem;
    }
    .gd-share {
        margin-top: 1.75rem;
    }
    .gd-flyers {
        display: grid;
        gap: 1.25rem;
        margin-top: 3.5rem;
    }
    .gd-flyer {
        display: block;
    }
    .gd-flyer img {
        display: block;
        /* The flyer's paper is the page's paper: a hairline edge so each page
           reads as a sheet (no shadow, no card). */
        outline: 1px solid rgb(4 5 1 / 0.2);
        outline-offset: -1px;
        width: 100%;
        height: auto;
        aspect-ratio: 989 / 1280;
        background: var(--gd-paper);
    }
    .gd-flyer-note {
        margin-top: 0.75rem;
        font-size: 0.95rem;
    }
    .gd-ask {
        margin-top: 3.5rem;
    }
    .gd-schedule {
        margin-top: 1rem;
    }
    .gd-close {
        padding-bottom: 5rem;
    }
    /* Closed: the hero and "Who the gifts are for" share the paper, so they
       read as one section. */
    .gd-page:has(#how[hidden]) .gd-who {
        padding-top: 0;
    }

    @media (min-width: 640px) {
        .gd-wrap,
        .gd-hero-grid {
            padding: 0 1.5rem;
        }
        .gd-sec {
            padding: 5rem 0 5.5rem;
        }
        .gd-hero-photo {
            width: 75%;
            justify-self: center;
        }
        .gd-flyers {
