---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import { sweatFest, sweatFestTickets } from "@/data/sweatFest";
import { galaTeaser } from "@/data/galaTeaser";
import galleryPhotos, { galleryCdnBase } from "@/data/graduationGallery";

// Public recap of the YTT 2025 + 2026 graduation ceremony (Friday, August 7,
// 2026, LSP Studio, Pilsen). This route used to be the private RSVP form for
// that night; the event has passed, so the form, its Google-Form plumbing, the
// noindex robots tag, and hideFooter are all gone, and the page is now an
// indexable story page whose job is to send people to the photo gallery.
//
// IDENTITY: "candlelit rose", drawn from the room in the photos (soft rose and
// orchid party light, rows of candles, cream walls). It is deliberately NOT the
// gala and NOT Haus of LSP, and the rules that keep it distinct are:
//   - Display type is FRAUNCES (450/560/650, italics 450/560, loaded globally
//     in Layout.astro). Body and labels stay Rubik.
//   - NO hairline rules and NO gradient bars anywhere. Dividers and ornaments
//     are candle-bokeh dot rows (`.sep`), soft glow orbs, and generously
//     rounded shapes: cream photo mats, pill badges, large corner radii.
//   - Gold stays soft: #f0c57c for accents, #d79b47 in CTA fills only.
//
// THE ONE EXCEPTION is the closing invitation section: those two cards are
// invitations FROM Sweat Fest and from the gala, so each carries its own full
// identity per design.md (Option F daylight for Sweat Fest; dark luxe with
// Playfair, `.gala-foil`, and gold hairlines for the gala). Those signature
// moves are scoped to their own card and must not leak into the rest of the
// page, which stays rose ink and Fraunces.
//
// NOTE: /graduation is still listed in the sitemap `filter` exclusion array in
// astro.config.mjs (left over from its private-RSVP days). That file is owned
// elsewhere; removing "/graduation" from that list is what actually puts this
// page in the sitemap now that it is public.

const base = import.meta.env.BASE_URL;
const withBase = (path) => `${base}${path.replace(/^\//, "")}`;
const img = (file) => withBase(`images/graduation/${file}`);

// The full album lives on Flickr; we link out rather than committing the files.
// The count appears exactly ONCE on the page (the hero stat). Every gallery CTA
// is a warm invitation, never a number.
const galleryUrl =
  "https://www.flickr.com/photos/88623248@N07/albums/72177720335041327";
const galleryCount = 307;

// The album renders natively: a thumbnail wall plus our own lightbox, with
// every image hotlinked from Flickr's CDN (src/data/graduationGallery.js holds
// the path stems in album order). All 307 cells ship in the HTML, but the ones
// past INITIAL_THUMBS start with the `hidden` attribute, so their lazy images
// are never fetched until someone expands the wall.
const galleryTotal = galleryPhotos.length;
const INITIAL_THUMBS = 24;

const eventDateLabel = "Friday, August 7, 2026";
const eventVenueLabel = "LSP Studio · Pilsen, Chicago";

// The three leaders, exactly as they are titled. Never invent titles here, and
// never render nicknames: full name plus title only.
const leaders = [
  { name: "Margarita Quiñones-Peña", role: "Founder" },
  { name: "Vanessa Tirado", role: "Co-Founder & Director" },
  { name: "Veronica Quiñones", role: "Co-Founder, Director & Studio Manager" },
];

// The night, in five short chapters. Every photo is described from what is
// actually in the frame. `tall` photos are portrait (683x1024), the rest are
// landscape (1024x683), and all of them render at their natural aspect ratio so
// nobody's face gets cropped by a grid.
const chapters = [
  {
    id: "llegada",
    step: "6:00 PM",
    label: "Llegada",
    title: "The room filled before the ceremony did",
    body: "Bouquets still in their paper, diploma folders already in hand, and the studio kitchen full of hugs and introductions before anyone sat down.",
    photos: [
      {
        file: "g01.jpg",
        w: 1600,
        h: 1067,
        alt: "A guest laughs with his eyes shut while holding a wrapped bouquet of yellow and lavender flowers, surrounded by friends and family in the studio kitchen.",
      },
      {
        file: "g02.jpg",
        w: 1024,
        h: 683,
        alt: "A graduate holds her black and gold LSP diploma folder against her chest, talking with two friends beside a counter of sunflowers, a disco ball hanging overhead.",
      },
      {
        file: "g03.jpg",
        w: 1024,
        h: 683,
        alt: "Two people talk across a table of iced coffees, a laptop covered in stickers open between them.",
      },
    ],
  },
  {
    id: "breathwork",
    // The ceremonial heart of the night: rendered as a featured moment on a
    // raised panel with cream keepsake mats, not as three more grid photos.
    ceremonial: true,
    step: "The opening",
    label: "Respiración guiada · Guided breathwork",
    title: "Guided breathwork, hands over hearts",
    body: "A sound bath opened the ceremony. Then the whole room, graduates, familias and friends together, breathed through a guided practice with a hand resting over the heart.",
    photos: [
      {
        file: "g04.jpg",
        w: 683,
        h: 1024,
        tall: true,
        alt: "An older woman in a black and silver brocade dress sits with her hand over her heart, eyes forward, a younger woman doing the same behind her, both lit in warm pink light.",
      },
      {
        file: "g05.jpg",
        w: 683,
        h: 1024,
        tall: true,
        alt: "A row of guests seated in front of a gold fringe curtain with their hands over their hearts and eyes closed, one man standing behind them doing the same.",
      },
      {
        file: "g06.jpg",
        w: 1024,
        h: 683,
        alt: "Guests standing along the studio wall with hands pressed over their hearts, kettlebells stacked on the floor behind them.",
      },
    ],
    quote: {
      text: "The Latina Sweat Project was never these walls. It was never an address. It has always been the people standing in this room.",
      author: "Margarita Quiñones-Peña",
      role: "Founder",
    },
  },
  {
    id: "diplomas",
    step: "The ceremony",
    label: "Diplomas",
    title: "Names called, one at a time",
    body: "Diplomas were presented at the front of the studio, and almost nobody made it back to their spot without being pulled into a hug first.",
    photos: [
      {
        file: "g07.jpg",
        w: 1024,
        h: 683,
        alt: "Two graduates hold each other in a long hug while a classmate waits alongside them holding diploma folders, candles glowing at the base of the mirror.",
      },
      {
        file: "g08.jpg",
        w: 1024,
        h: 683,
        alt: "A graduate is lifted into a hug, her diploma folder still in her hand, while a guest films the moment on his phone from across the room.",
      },
      {
        file: "g09.jpg",
        w: 1024,
        h: 683,
        alt: "The room applauds as two graduates embrace, one in a gold dress holding her diploma folder behind her friend's back, rows of candles lining the floor.",
      },
    ],
  },
  {
    id: "speeches",
    step: "The mic",
    label: "Speeches",
    title: "Then the microphone went around the room",
    body: "Our founders spoke. So did our Junior Board and our graduates, several of them reading from notes on their phones, with the rest of the room sitting on the floor around them.",
    photos: [
      {
        file: "g10.jpg",
        w: 683,
        h: 1024,
        tall: true,
        credit: { name: "Vanessa Tirado", role: "Co-Founder & Director" },
        alt: "Vanessa Tirado speaks into a handheld microphone while reading from her phone, wearing a Chicago basketball jersey, the seated room reflected in the mirror behind her.",
      },
      {
        file: "g11.jpg",
        w: 683,
        h: 1024,
        tall: true,
        credit: { name: "Margarita Quiñones-Peña", role: "Founder" },
        alt: "Margarita Quiñones-Peña speaks mid-sentence with a microphone, in a white top and long strand of pearls, graduates seated on the floor around her.",
      },
      {
        file: "g12.jpg",
        w: 683,
        h: 1024,
        tall: true,
        credit: {
          name: "Yesi Peyret",
          role: "Vice President, 2025 Junior Board",
        },
        alt: "Yesi Peyret smiles as she speaks into a microphone, holding her phone in her other hand, wearing a cream rebozo printed with monarch butterflies.",
      },
      {
        file: "g13.jpg",
        w: 683,
        h: 1024,
        tall: true,
        credit: { name: "Margarita Quiñones-Peña", role: "Founder" },
        alt: "Margarita Quiñones-Peña laughs mid-speech with the microphone in one hand and a bouquet of blue hydrangeas and roses held against her chest.",
      },
    ],
  },
  {
    id: "celebracion",
    step: "After",
    label: "Flores y celebración",
    title: "Flowers, one very crowded selfie, and the class photo",
    body: "Bouquets went around, everyone piled into a group selfie, and the night closed with the whole graduating group together, certificates in the frame.",
    photos: [
      {
        file: "g14.jpg",
        w: 1024,
        h: 683,
        alt: "A crowd of graduates and guests packs into a group selfie, one arm stretched out holding the phone, everyone leaning in and laughing.",
      },
      {
        file: "g16.jpg",
        w: 1024,
        h: 683,
        alt: "The full graduating group poses together in warm pink light, some kneeling in front, gold and white balloons on the studio floor around them.",
      },
      {
        file: "g15.jpg",
        w: 1024,
        h: 683,
        feature: true,
        caption: "The 2025 and 2026 cohorts with their certificates.",
        alt: "The full 2025 and 2026 cohorts pose in two rows across the studio, nearly every person holding a framed certificate, papel picado and a gold fringe curtain visible in the room behind them.",
      },
    ],
  },
];

// What makes this training one of a kind, in its own band: the anchor quote,
// where graduates go on to teach, and the lineage that follows them.
const programQuote = {
  text: "We were never trying to create simply more yoga teachers. We were always building leaders and a pipeline of teachers.",
  author: "Margarita Quiñones-Peña",
  role: "Founder",
};

const programPlaces = [
  "Studios",
  "Schools",
  "Parks",
  "Hospitals",
  "Shelters",
];

const lineage = [
  {
    figure: "2025 + 2026",
    label: "The cohorts honored this August",
  },
  {
    figure: "Nearly 100",
    label: "Teachers certified through LSP so far",
  },
  {
    figure: "Hundreds more",
    label: "Still to come, taught by the ones in this room",
  },
];

// Speech lines that carry the night. Verified against the footage; attribute
// exactly as written.
const voices = [
  {
    text: "You are not simply graduating from the Latina Sweat Project. You are building its future.",
    author: "Margarita Quiñones-Peña",
    role: "Founder",
  },
  {
    text: "Continue to lead with courage, service, and compassion.",
    author: "Vanessa Tirado",
    role: "Co-Founder & Director",
  },
];

// What the share button and the copy button hand out: this page, not the raw
// Flickr album, so anyone who follows it lands on the story first.
const pageShareUrl = "https://latinasweatproject.com/graduation";
const pageShareLabel = "latinasweatproject.com/graduation";
const pageShareText =
  "Graduation 2026 at the Latina Sweat Project. Nearly 100 teachers strong.";

// Share kit, generated in this same candlelit rose identity. The story graphic
// is the one shown; the rest stay reachable as quiet download links. If a file
// is not there yet, its preview removes itself instead of rendering broken.
const shareGraphics = [
  {
    key: "story",
    file: "story.jpg",
    label: "Story graphic",
    note: "1080 x 1920 · Instagram story",
    download: "lsp-graduation-2026-story.jpg",
    w: 1080,
    h: 1920,
    alt: "Instagram story graphic for the LSP Graduation 2026 photo gallery.",
    tall: true,
  },
  {
    key: "carousel_1",
    file: "carousel-1.jpg",
    label: "Carousel · 1",
    note: "1080 x 1350 · first slide",
    download: "lsp-graduation-2026-carousel-1.jpg",
    w: 1080,
    h: 1350,
    alt: "First slide of the LSP Graduation 2026 Instagram carousel.",
  },
  {
    key: "carousel_2",
    file: "carousel-2.jpg",
    label: "Carousel · 2",
    note: "1080 x 1350 · second slide",
    download: "lsp-graduation-2026-carousel-2.jpg",
    w: 1080,
    h: 1350,
    alt: "Second slide of the LSP Graduation 2026 Instagram carousel.",
  },
  {
    key: "carousel_3",
    file: "carousel-3.jpg",
    label: "Carousel · 3",
    note: "1080 x 1350 · third slide",
    download: "lsp-graduation-2026-carousel-3.jpg",
    w: 1080,
    h: 1350,
    alt: "Third slide of the LSP Graduation 2026 Instagram carousel.",
  },
  {
    key: "post",
    file: "post.jpg",
    label: "Feed post",
    note: "1080 x 1350 · single post",
    download: "lsp-graduation-2026-post.jpg",
    w: 1080,
    h: 1350,
    alt: "Single feed post graphic for the LSP Graduation 2026 photo gallery.",
  },
];

// The story graphic is the only one previewed; the feed post and the three
// carousel slides live in the quiet "More sizes" line beneath the button.
const storyGraphic = shareGraphics.find((g) => g.key === "story");
const moreGraphics = [
  { ...shareGraphics.find((g) => g.key === "post"), short: "post" },
  { ...shareGraphics.find((g) => g.key === "carousel_1"), short: "carousel 1" },
  { ...shareGraphics.find((g) => g.key === "carousel_2"), short: "carousel 2" },
  { ...shareGraphics.find((g) => g.key === "carousel_3"), short: "carousel 3" },
];

// Closing invitations. Both events read from their own single source of truth,
// so links, prices, and on-sale state never drift from the rest of the site.
const sweatFestHasTickets = sweatFestTickets.onSale && sweatFestTickets.url;
const sweatFestPrimaryUrl = sweatFestHasTickets
  ? sweatFestTickets.url
  : withBase("sweatfest");
const sweatFestPrimaryLabel = sweatFestHasTickets
  ? sweatFest.ticketsLabel
  : "Learn more";
const sweatFestPrimaryEvent = sweatFestHasTickets
  ? "sweatfest_ticket_click"
  : "sweatfest_explore_click";
const sweatFestVolunteerUrl = withBase("sweatfest#volunteer");
const galaPageUrl = withBase(galaTeaser.pagePath);

const pageTitle = "Graduation 2026 | The Latina Sweat Project";
const pageDescription = `Photos and speeches from the Latina Sweat Project Yoga Teacher Training graduation on ${eventDateLabel} in Pilsen, Chicago, where the 2025 and 2026 cohorts were certified and LSP reached nearly 100 teachers trained.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  socialImage="images/graduation/hero.jpg"
  socialImageAlt="The 2025 and 2026 LSP Yoga Teacher Training cohorts holding their certificates at the studio in Pilsen."
  socialImageWidth={1024}
  socialImageHeight={683}
  socialImageType="image/jpeg"
  twitterCard="summary_large_image"
>
  <Header />

  <main class="grad-page">
    {/* Candle bokeh drifting behind the whole page: the page's signature
        ornament, static and low contrast so it never competes with the photos. */}
    <div class="candles" aria-hidden="true">
      <span style="--x: 6%; --y: 14%; --s: 14px; --o: 0.5;"></span>
      <span style="--x: 21%; --y: 47%; --s: 9px; --o: 0.34;"></span>
      <span style="--x: 46%; --y: 8%; --s: 11px; --o: 0.3;"></span>
      <span style="--x: 79%; --y: 27%; --s: 16px; --o: 0.42;"></span>
      <span style="--x: 92%; --y: 61%; --s: 10px; --o: 0.3;"></span>
      <span style="--x: 63%; --y: 78%; --s: 13px; --o: 0.28;"></span>
      <span style="--x: 12%; --y: 88%; --s: 11px; --o: 0.26;"></span>
    </div>

    {/* ============================== HERO ============================== */}
    <section class="hero" aria-labelledby="graduation-title">
      <div class="wrap">
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Yoga Teacher Training · Pilsen, Chicago</p>
            <h1 id="graduation-title" class="display hero-title">
              <span class="hero-title-main">Graduation</span>
              <span class="hero-title-year">2026</span>
            </h1>
            {/* The class lockup, treated with commencement honor. */}
            <p class="class-lockup">
              <span class="class-lockup-label">In honor of the</span>
              <span class="class-lockup-name display">
                YTT Class of 2025 <span class="class-lockup-amp">+</span> 2026
              </span>
            </p>
            <div class="sep sep--left" aria-hidden="true"></div>
            <p class="hero-facts">
              {eventDateLabel} · 6:00 PM<br />
              {eventVenueLabel}
            </p>
            <p class="lede">
              One candlelit Friday: a sound bath, guided breathwork with a hand
              over every heart, and two cohorts of new yoga teachers.
            </p>
            <p class="lede-es" lang="es">Casi 100 maestras y contando.</p>

            <div class="cta-row">
              <a
                class="btn btn--gold"
                href={galleryUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-conversion-event="graduation_gallery_click"
                data-conversion-context="graduation_hero"
              >
                Relive Graduation Night
                <svg
                  class="btn-arrow"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </a>
              <a class="btn btn--ghost" href="#story">Read the story of the night</a>
            </div>

            <dl class="stats">
              <div class="stat">
                <dt>Teachers certified through LSP</dt>
                <dd>Nearly 100</dd>
              </div>
              <div class="stat">
                <dt>Cohorts honored</dt>
                <dd>2</dd>
              </div>
              <div class="stat">
                <dt>Photos from the night</dt>
                <dd>{galleryCount}</dd>
              </div>
            </dl>
          </div>

          <figure class="hero-figure">
            <div class="mat mat--cream">
              <img
                src={img("hero.jpg")}
                width="1024"
                height="683"
                alt="The full 2025 and 2026 cohorts pose in two rows across the studio, nearly every person holding a framed certificate."
                fetchpriority="high"
                decoding="async"
              />
            </div>

            {/* Soft gold seal, pressed into the corner of the keepsake mat the
                way a seal is pressed into a diploma. Purely ornamental: the
                class lockup beside it carries the same words in real text. */}
            {/* Seal geometry, worked against the ring circumference so the two
                arc texts can never collide (the old build overflowed both):
                  · text arcs are semicircles of r=45, length pi*45 = 141.4
                  · both texts are centred with text-anchor=middle +
                    startOffset=50%, so gaps are symmetric by construction
                  · top "YOGA TEACHER TRAINING" ~= 12.64em; at 6.5px with
                    0.8px tracking that is ~99px, leaving ~21px clear at each
                    of the 3 and 9 o'clock ends
                  · bottom "LATINA SWEAT PROJECT" ~= 12.16em, ~95px, ~23px clear
                  · top glyphs sit r45 -> r49.6 (cap height .7em), inside the
                    r=52 ring; bottom glyphs sit inward, r40.5 -> r45, so the
                    two bands never overlap
                  · separator dots sit exactly at the 3 and 9 o'clock junctions
                  · centre block stays inside r=39: "CLASS OF" ~48px wide,
                    "2025 + 2026" at 10.5px ~64px wide (half-width 32 against
                    a 37.7 half-chord at that height) */}
            <svg
              class="seal"
              viewBox="0 0 120 120"
              role="presentation"
              aria-hidden="true"
            >
              <circle cx="60" cy="60" r="57" class="seal-disc" />
              <circle cx="60" cy="60" r="52" class="seal-ring" />
              <path
                id="seal-arc-top"
                d="M 60 60 m -45 0 a 45 45 0 1 1 90 0"
                fill="none"></path>
              <path
                id="seal-arc-bottom"
                d="M 60 60 m -45 0 a 45 45 0 1 0 90 0"
                fill="none"></path>
              <text class="seal-text" text-anchor="middle">
                <textPath href="#seal-arc-top" startOffset="50%"
                  >YOGA TEACHER TRAINING</textPath
                >
              </text>
              <text class="seal-text" text-anchor="middle">
                <textPath href="#seal-arc-bottom" startOffset="50%"
                  >LATINA SWEAT PROJECT</textPath
                >
              </text>
              <circle cx="15" cy="60" r="1.5" class="seal-dot" />
              <circle cx="105" cy="60" r="1.5" class="seal-dot" />
              <text class="seal-small" x="60" y="52" text-anchor="middle">
                CLASS OF
              </text>
              <text class="seal-year" x="60" y="70" text-anchor="middle">
                2025 + 2026
              </text>
              <circle cx="54.5" cy="82" r="1.1" class="seal-dot" />
              <circle cx="60" cy="82" r="1.1" class="seal-dot" />
              <circle cx="65.5" cy="82" r="1.1" class="seal-dot" />
            </svg>

            <figcaption>
              The class of 2025 and 2026, certificates in hand, at LSP Studio.
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    {/* ============================= THE STORY ========================== */}
    <section id="story" class="story" aria-labelledby="story-title">
      <div class="wrap">
        <div class="sep" aria-hidden="true"></div>
        <header class="section-head">
          <p class="eyebrow">La noche, en fotos</p>
          <h2 id="story-title" class="display">The story of the night</h2>
          <p class="section-lede">
            Two cohorts walked into the studio as students and walked out as
            teachers. Here is how it went, in order.
          </p>
        </header>

        {
          chapters.map((chapter) => (
            <article
              class:list={["chapter", chapter.ceremonial && "chapter--ceremony"]}
              aria-labelledby={`ch-${chapter.id}`}
            >
              {chapter.ceremonial && <div class="sep" aria-hidden="true" />}
              <div class="chapter-head reveal">
                <p class="chapter-step">
                  <span class="chapter-step-time">{chapter.step}</span>
                  <span class="chapter-step-label">{chapter.label}</span>
                </p>
                <h3 id={`ch-${chapter.id}`} class="display chapter-title">
                  {chapter.title}
                </h3>
                <p class="chapter-body">{chapter.body}</p>
              </div>

              <div
                class:list={[
                  "mosaic",
                  chapter.photos.length === 4 && "mosaic--four",
                ]}
              >
                {chapter.photos.map((photo) => (
                  <figure
                    class:list={[
                      "shot",
                      "reveal",
                      photo.tall && "shot--tall",
                      photo.feature && "shot--feature",
                    ]}
                  >
                    <div
                      class:list={[
                        "mat",
                        (photo.feature || chapter.ceremonial) && "mat--cream",
                      ]}
                    >
                      <img
                        src={img(photo.file)}
                        width={photo.w}
                        height={photo.h}
                        alt={photo.alt}
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    {photo.credit && (
                      <figcaption class="shot-credit">
                        <span class="shot-credit-name">
                          {photo.credit.name}
                        </span>
                        <span class="shot-credit-role">
                          {photo.credit.role}
                        </span>
                      </figcaption>
                    )}
                    {photo.caption && <figcaption>{photo.caption}</figcaption>}
                  </figure>
                ))}
              </div>

              {chapter.quote && (
                <blockquote class="pull reveal">
                  <span class="pull-mark" aria-hidden="true">
                    “
                  </span>
                  <p>{chapter.quote.text}</p>
                  <footer>
                    <span class="pull-author">{chapter.quote.author}</span>
                    <span class="pull-role">{chapter.quote.role}</span>
                  </footer>
                </blockquote>
              )}
            </article>
          ))
        }

        {/* The whole album, on the page. Both Flickr embed routes (the embedr
            transform script and the static /player iframe) came up empty in
            testing, so this is a native thumbnail wall plus our own lightbox,
            hotlinking Flickr's CDN the same way /adobe and /gallery do. The
            outbound album link stays underneath as attribution. */}
        <div class="gallery-band reveal">
          <div class="gallery-band-head">
            <div class="gallery-band-copy">
              <p class="eyebrow">The full album</p>
              <p class="gallery-band-title display">
                Every moment from the night
              </p>
              <p class="gallery-band-note">
                Flip through all of it right here: find yourself, find your
                cohort, and take home anything you want.
              </p>
              <p class="gallery-band-es" lang="es">
                Revive la noche de graduación.
              </p>
            </div>

