    font-weight: 450;
    line-height: 1.45;
  }

  .pull-mark {
    display: block;
    margin-bottom: -0.7rem;
    color: rgba(224, 140, 184, 0.6);
    font-family: "Fraunces", Georgia, serif;
    font-size: 3rem;
    font-weight: 560;
    line-height: 1;
  }

  .pull footer,
  .voice footer,
  .next-home-quote footer,
  .voice-closer footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.7rem;
    margin-top: 1.3rem;
  }

  .pull-author {
    color: var(--gold-light);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .pull-role {
    color: var(--paper-faint);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ------------------- A training like no other + lineage -------------- */
  .places {
    max-width: 46rem;
    margin: clamp(2rem, 4vw, 3rem) auto 0;
    text-align: center;
  }

  .places-label {
    margin: 0;
    color: var(--paper-faint);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .places-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .place-chip {
    border-radius: 999px;
    background: var(--panel-strong);
    padding: 0.55rem 1.15rem;
    color: var(--paper);
    font-size: 0.84rem;
    font-weight: 600;
  }

  .places-quote {
    margin: 1.4rem 0 0;
    color: var(--gold-light);
    font-family: "Fraunces", Georgia, serif;
    font-size: clamp(1.05rem, 3vw, 1.35rem);
    font-style: italic;
    font-weight: 450;
    line-height: 1.5;
  }

  .places-cite {
    display: block;
    margin-top: 0.5rem;
    color: var(--paper-faint);
    font-family: "Rubik", sans-serif;
    font-size: 0.72rem;
    font-style: normal;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .lineage {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    border-radius: 2rem;
    background: var(--panel);
    padding: clamp(1.6rem, 4vw, 2.6rem);
    text-align: center;
  }

  .lineage-label {
    margin: 0;
    color: var(--rose);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .lineage-thread {
    display: none;
  }

  .lineage-anchor {
    fill: #f0c57c;
  }

  .lineage-nodes {
    display: grid;
    gap: 1.5rem;
    margin: 1.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  .lineage-node {
    position: relative;
    padding-left: 1.7rem;
    text-align: left;
  }

  .lineage-dot {
    position: absolute;
    left: 0;
    top: 0.45rem;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      #f0c57c,
      rgba(215, 155, 71, 0.35) 58%,
      transparent 72%
    );
    filter: drop-shadow(0 0 7px rgba(240, 197, 124, 0.6));
  }

  /* Mobile: the thread between nodes is a short column of candle dots. */
  .lineage-node:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 0.22rem;
    top: 1.5rem;
    width: 3px;
    height: calc(100% - 0.6rem);
    background-image: radial-gradient(
      circle 1.5px at 1.5px 1.5px,
      rgba(240, 197, 124, 0.55) 0 60%,
      transparent 70%
    );
    background-size: 3px 9px;
    background-repeat: repeat-y;
  }

  .lineage-figure {
    margin: 0;
    color: var(--gold-light);
    font-size: clamp(1.5rem, 4.4vw, 2.1rem);
    font-weight: 560;
  }

  .lineage-note {
    margin: 0.35rem 0 0;
    color: var(--paper-soft);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .lineage-closer {
    max-width: 40rem;
    margin: clamp(1.6rem, 4vw, 2.2rem) auto 0;
    color: var(--paper);
    font-family: "Fraunces", Georgia, serif;
    font-size: clamp(1.05rem, 3vw, 1.3rem);
    font-style: italic;
    font-weight: 450;
    line-height: 1.6;
  }

  @media (min-width: 46rem) {
    .lineage-thread {
      display: block;
      width: 100%;
      height: 64px;
      margin: 1.4rem 0 -0.5rem;
    }

    .lineage-nodes {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.2rem;
      margin-top: 0.4rem;
    }

    .lineage-node {
      padding-left: 0;
      text-align: center;
    }

    .lineage-dot,
    .lineage-node:not(:last-child)::after {
      display: none;
    }
  }

  /* ------------------------------- Voices ------------------------------ */
  .voice-grid {
    display: grid;
    gap: 1.2rem;
  }

  @media (min-width: 46rem) {
    .voice-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .voice-closer {
    margin: 0;
    padding: 0;
    text-align: center;
  }

  .voice-closer p {
    margin: 0;
    color: var(--gold-light);
    font-size: clamp(1.9rem, 6vw, 3.2rem);
    font-style: italic;
    font-weight: 560;
  }

  .voice-closer footer {
    justify-content: center;
  }

  /* -------------------------- Gallery CTA band ------------------------- */
  .gallery-band {
    position: relative;
    overflow: hidden;
    grid-column: 1 / -1;
    width: 100%;
    max-width: 72rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    margin-inline: auto;
    border-radius: 2rem;
    background: linear-gradient(
      120deg,
      rgba(224, 140, 184, 0.16),
      rgba(43, 21, 32, 0.68) 58%
    );
    padding: clamp(1.6rem, 4vw, 2.4rem);
  }

  .gallery-band::after {
    content: "";
    position: absolute;
    top: -8rem;
    right: -5rem;
    width: 18rem;
    height: 18rem;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(240, 197, 124, 0.22),
      transparent 70%
    );
    filter: blur(40px);
    pointer-events: none;
  }

  .gallery-band > * {
    position: relative;
    z-index: 1;
  }

  /* Header copy left, the quiet outbound button right on desktop and stacked
     underneath on phones. */
  .gallery-band-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .gallery-band-copy {
    min-width: min(100%, 18rem);
    flex: 1 1 22rem;
  }

  .gallery-band-out {
    flex-shrink: 0;
  }

  .gallery-band-title {
    margin: 0.55rem 0 0;
    font-size: clamp(1.4rem, 3.4vw, 2rem);
  }

  .gallery-band-note {
    margin: 0.5rem 0 0;
    color: var(--paper-soft);
    font-size: 0.94rem;
  }

  /* ------------------------- Native album wall ------------------------- */
  .gallery-wall {
    width: 100%;
    margin-top: clamp(1.4rem, 3vw, 2rem);
  }

  .thumb-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 34rem) {
    .thumb-grid {
      grid-template-columns: repeat(5, 1fr);
      gap: 0.5rem;
    }
  }

  @media (min-width: 52rem) {
    .thumb-grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  .thumb-cell {
    min-width: 0;
  }

  .thumb {
    display: block;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 1;
    border: 0;
    border-radius: 0.5rem;
    background: rgba(30, 18, 22, 0.08);
    padding: 0;
    cursor: pointer;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumb:hover {
    transform: scale(1.04);
    box-shadow: 0 0.4rem 1rem rgba(30, 18, 22, 0.28);
  }

  .thumb:focus-visible {
    outline: 3px solid #c07b2a;
    outline-offset: 2px;
    border-radius: 0.5rem;
  }

  /* The mat is cream, so this button is inked rather than cream-on-cream. */
  .gallery-expand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    width: 100%;
    margin-top: 0.75rem;
    border: 0;
    border-radius: 999px;
    background: rgba(30, 18, 22, 0.07);
    padding: 0.85rem 1.4rem;
    color: #2b1520;
    cursor: pointer;
    font-family: "Rubik", sans-serif;
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    transition: background-color 160ms ease;
  }

  .gallery-expand:hover {
    background: rgba(30, 18, 22, 0.12);
  }

  .gallery-expand:focus-visible {
    outline: 3px solid #c07b2a;
    outline-offset: 2px;
  }

  .gallery-expand-es {
    color: rgba(43, 21, 32, 0.62);
    font-size: 0.74rem;
    font-weight: 600;
    font-style: italic;
  }

  /* --------------------------- Lightbox viewer ------------------------- */
  /* z-index 1000 clears the site header (fixed, z-50) and the mobile menu
     (fixed, z-40). This only works because the dialog sits outside
     `.grad-page`; see the note on the markup. The palette vars are redeclared
     here for the same reason. */
  .lightbox {
    --paper: #f6efe3;
    --paper-faint: rgba(246, 239, 227, 0.46);
    --gold-light: #f0c57c;

    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    grid-template-rows: 1fr auto;
    place-items: center;
    background: rgba(30, 18, 22, 0.96);
    padding: calc(env(safe-area-inset-top, 0px) + clamp(3.5rem, 9vw, 4.5rem))
      clamp(0.75rem, 4vw, 3.5rem)
      calc(env(safe-area-inset-bottom, 0px) + clamp(1rem, 4vw, 2rem));
  }

  .lightbox[hidden] {
    display: none !important;
  }

  .lb-stage {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .lb-image {
    display: block;
    max-width: 100%;
    max-height: 100%;
    border-radius: 0.75rem;
    box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.55);
    object-fit: contain;
  }

  .lb-counter {
    margin: 0.9rem 0 0;
    color: var(--paper-faint);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.16em;
  }

  /* Controls have to stay legible over a bright photo, so they are inked
     circles with a cream ring and a shadow, never a faint translucent wash. */
  .lb-nav,
  .lb-close {
    display: grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    border: 1.5px solid rgba(246, 239, 227, 0.72);
    border-radius: 999px;
    background: rgba(43, 21, 32, 0.82);
    padding: 0;
    color: var(--paper);
    cursor: pointer;
    box-shadow: 0 0.35rem 1.1rem rgba(0, 0, 0, 0.55);
    transition:
      background-color 160ms ease,
      border-color 160ms ease;
  }

  .lb-nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 2.9rem;
    height: 2.9rem;
    translate: 0 -50%;
  }

  .lb-nav svg,
  .lb-close svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .lb-prev {
    left: clamp(0.5rem, 2vw, 1.5rem);
  }

  .lb-next {
    right: clamp(0.5rem, 2vw, 1.5rem);
  }

  /* Fixed to the viewport (not the padding box) and inset past any notch, so
     nothing can push it off-screen or under a rounded corner. */
  .lb-close {
    position: fixed;
    top: calc(env(safe-area-inset-top, 0px) + 0.85rem);
    right: calc(env(safe-area-inset-right, 0px) + 0.85rem);
    z-index: 3;
    width: 2.9rem;
    height: 2.9rem;
  }

  .lb-nav:hover,
  .lb-close:hover {
    border-color: var(--gold-light);
    background: rgba(215, 155, 71, 0.9);
  }

  .lb-nav:focus-visible,
  .lb-close:focus-visible {
    outline: 3px solid var(--gold-light);
    outline-offset: 3px;
  }

  .gallery-embed-note {
    margin: 1rem 0 0;
    color: var(--paper-faint);
    font-size: 0.86rem;
    text-align: center;
  }

  .gallery-embed-link {
    color: var(--gold-light);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  .gallery-embed-link:hover {
    color: var(--paper);
  }

  /* -------------------------------- Share ------------------------------ */
  /* One preview at roughly phone scale, with the controls beside it on wider
     screens and stacked underneath on phones. */
  .share-kit {
    display: grid;
    justify-items: center;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .share-preview {
    width: min(15rem, 70vw);
  }

  .share-preview[hidden] {
    display: none;
  }

  .share-controls {
    display: grid;
    justify-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 26rem;
  }

  .share-primary {
    width: 100%;
    padding-block: 1rem;
  }

  .share-primary-label {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.2;
  }

  .share-primary-es {
    font-size: 0.72rem;
    font-weight: 600;
    font-style: italic;
    opacity: 0.72;
  }

  .share-link-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 0.75rem;
    width: 100%;
    border-radius: 1rem;
    background: var(--panel);
    padding: 0.7rem 0.9rem;
  }

  .share-link-text {
    color: var(--paper-soft);
    font-size: 0.84rem;
    letter-spacing: 0.01em;
    overflow-wrap: anywhere;
    user-select: all;
  }

  .share-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(240, 197, 124, 0.16);
    padding: 0.4rem 0.8rem;
    color: var(--gold-light);
    cursor: pointer;
    font-family: "Rubik", sans-serif;
    font-size: 0.74rem;
    font-weight: 700;
    transition: background-color 160ms ease;
  }

  .share-copy:hover {
    background: rgba(240, 197, 124, 0.28);
  }

  .share-copy:focus-visible {
    outline: 3px solid var(--gold-light);
    outline-offset: 3px;
  }

  .share-copy.is-copied {
    background: rgba(240, 197, 124, 0.34);
    color: var(--paper);
  }

  .share-more {
    margin: 0;
    color: var(--paper-faint);
    font-size: 0.78rem;
    text-align: center;
  }

  .share-more-link {
    color: var(--paper-soft);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .share-more-link:hover {
    color: var(--gold-light);
  }

  @media (min-width: 46rem) {
    .share-kit {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      justify-items: start;
    }

    .share-controls {
      justify-items: start;
    }

    .share-more {
      text-align: left;
    }

    .share-link-row {
      justify-content: flex-start;
    }
  }

  /* ------------------------------- Gracias ----------------------------- */
  .gracias-inner {
    max-width: 46rem;
  }

  .gracias-inner h2 {
    margin: 0.7rem 0 0;
    font-size: clamp(2rem, 5.5vw, 3rem);
  }

  .gracias-body {
    margin: 1.2rem 0 0;
    color: var(--paper-soft);
    font-size: 1.04rem;
    line-height: 1.85;
  }

  .leaders {
    display: grid;
    gap: 1rem;
    margin: 2.2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .leader {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.7rem;
    padding-left: 1.5rem;
  }

  /* A single candle dot in place of the old rule. */
  .leader::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55rem;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      #f0c57c,
      rgba(215, 155, 71, 0.35) 58%,
      transparent 72%
    );
    filter: drop-shadow(0 0 6px rgba(240, 197, 124, 0.55));
  }

  .leader-name {
    color: var(--paper);
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.2rem;
    font-weight: 560;
  }

  .leader-role {
    color: var(--gold-light);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  /* ------------------------------ Next home ---------------------------- */
  .next-home-inner {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: clamp(1.7rem, 4vw, 2.8rem);
    border-radius: 2rem;
    background: linear-gradient(
      140deg,
      rgba(224, 140, 184, 0.16),
      rgba(30, 18, 22, 0.72) 62%
    );
    padding: clamp(1.7rem, 4.5vw, 3rem);
  }

  .next-home-inner::after {
    content: "";
    position: absolute;
    bottom: -9rem;
    left: -6rem;
    width: 20rem;
    height: 20rem;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(224, 140, 184, 0.22),
      transparent 70%
    );
    filter: blur(44px);
    pointer-events: none;
  }

  .next-home-inner > * {
    position: relative;
    z-index: 1;
  }

  .next-home-copy h2 {
    margin: 0.7rem 0 0;
    font-size: clamp(1.7rem, 4.6vw, 2.5rem);
  }

  .next-home-copy p {
    margin: 1rem 0 0;
    color: var(--paper-soft);
    font-size: 1rem;
    line-height: 1.8;
  }

  .next-home-es {
    color: var(--rose) !important;
    font-family: "Fraunces", Georgia, serif;
    font-style: italic;
    font-weight: 450;
  }

  .next-home-quote {
    align-self: center;
    background: rgba(30, 18, 22, 0.5);
  }

  @media (min-width: 62rem) {
    .next-home-inner {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
    }
  }

  /* -------------------------------- Invite ----------------------------- */
  .invite-grid {
    display: grid;
    gap: 1.3rem;
  }

  @media (min-width: 52rem) {
    .invite-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Each card is a small ambassador of its own event, so the two identities
     below are intentionally NOT the graduation palette. The rose-ink frame
     around them (section heading, spacing, Fraunces) stays graduation. */
  .invite-card {
    position: relative;
    overflow: hidden;
    border-radius: 1.9rem;
    padding: clamp(1.6rem, 4vw, 2.3rem);
  }

  .invite-card > * {
    position: relative;
    z-index: 1;
  }

  /* ---------- Sweat Fest: Option F bright daylight (design.md) ---------- */
  .invite-card--fest {
    background: linear-gradient(
      to bottom right,
      #fff8ef,
      #ffffff 46%,
      #ffefe2
    );
    color: #1e1e1e;
    box-shadow: 0 1.2rem 3rem rgba(0, 0, 0, 0.34);
  }

  /* The sunrise arc, thin accent only: gold to ember to magenta. */
  .fest-strip {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 4px;
    background: linear-gradient(90deg, #ffbd59, #ff6b52 52%, #e94f8a);
  }

  /* Filson Soft, the rounded geometric subhead face of the Sweat Fest kit
     (self-hosted in global.css), carries everything on this card except the
     wordmark. Rubik does not appear here. */
  .fest-eyebrow {
    margin: 0.35rem 0 0;
    color: #b23c14;
    font-family: "Filson Soft", "Rubik", sans-serif;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* Hello Baddie, the handmade distressed display face of the official
     identity. It ships at a single weight, so no synthetic bolding: the face
     is already heavy and faux-bold muddies its texture. Deepened stops stay,
     since the signature sunrise colors are too pale to read on cream. */
  .fest-wordmark {
    margin: 0.55rem 0 0;
    background-image: linear-gradient(100deg, #d47500, #e8452a 52%, #c81e63);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    font-family: "Hello Baddie", "Rubik", sans-serif;
    font-size: clamp(2.3rem, 6.4vw, 3.1rem);
    font-weight: 400;
    letter-spacing: -0.005em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .fest-tagline {
    margin: 0.5rem 0 0;
    color: #d63d22;
    font-family: "Filson Soft", "Rubik", sans-serif;
    font-size: 0.86rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .fest-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .fest-chip {
    border-radius: 999px;
