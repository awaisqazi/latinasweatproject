  </main>

  {/* Full-screen viewer for the album wall.

      IT MUST STAY OUTSIDE <main class="grad-page">. `.grad-page` sets
      `isolation: isolate` (so the candle bokeh can sit at z-index -1 without
      falling behind the page background), which makes it a stacking context
      and traps every descendant's z-index inside it. While the dialog lived in
      there, the site header (`#header-wrapper`, fixed, z-50 in the ROOT
      stacking context) painted on top of the open lightbox and covered the
      close button, no matter how high the dialog's own z-index went. Out here
      the dialog competes in the root stacking context, where its z-index 1000
      clears the header (50) and the mobile menu (40).

      Because it no longer inherits from `.grad-page`, the palette custom
      properties it needs are redeclared on `.lightbox` itself. */}
  <div
    id="lightbox"
    class="lightbox"
    role="dialog"
    aria-modal="true"
    aria-label="Graduation photo viewer"
    hidden
  >
    <div class="lb-stage">
      <img id="lb-image" class="lb-image" alt="" decoding="async" />
    </div>

    <p id="lb-counter" class="lb-counter" role="status" aria-live="polite"></p>

    <button id="lb-prev" class="lb-nav lb-prev" type="button" aria-label="Previous photo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 5l-7 7 7 7"></path>
      </svg>
    </button>

    <button id="lb-next" class="lb-nav lb-next" type="button" aria-label="Next photo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>

    <button id="lb-close" class="lb-close" type="button" aria-label="Close photo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>
</Layout>

<script>
  // Share tools: copy-to-clipboard with a success state, the native share sheet
  // where the browser offers one, and a guard so a share graphic that has not
  // been generated yet removes its own card instead of rendering broken art.
  const GALLERY_MESSAGE =
    "Graduation 2026 at the Latina Sweat Project. Nearly 100 teachers strong.";

  const copyButton = document.querySelector<HTMLButtonElement>("#copy-link");
  const copyStatus = document.querySelector<HTMLElement>("#copy-status");
  const shareButton = document.querySelector<HTMLButtonElement>("#share-social");
  // The page, not the raw album: whoever follows the link gets the story.
  const shareUrl = copyButton?.dataset.copy || "";

  const writeToClipboard = async (value: string) => {
    if (navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(value);
        return true;
      } catch {
        // Fall through to the textarea fallback below.
      }
    }

    const scratch = document.createElement("textarea");
    scratch.value = value;
    scratch.setAttribute("readonly", "");
    scratch.style.position = "fixed";
    scratch.style.opacity = "0";
    document.body.appendChild(scratch);
    scratch.select();
    let copied = false;
    try {
      copied = document.execCommand("copy");
    } catch {
      copied = false;
    }
    document.body.removeChild(scratch);
    return copied;
  };

  let resetTimer: number | undefined;

  copyButton?.addEventListener("click", async () => {
    if (!galleryUrl) return;
    const label = copyButton.querySelector<HTMLElement>(".copy-label");
    const copied = await writeToClipboard(galleryUrl);

    if (label) label.textContent = copied ? "Link copied" : "Copy failed";
    copyButton.classList.toggle("is-copied", copied);
    if (copyStatus) {
      copyStatus.textContent = copied
        ? "Page link copied to your clipboard."
        : "Copy failed. Long press the link to copy it manually.";
    }

    if (copied) {
      window.trackConversion?.("graduation_copy_link", {
        event_category: "graduation_recap",
        context: "graduation_share_section",
      });
    }

    window.clearTimeout(resetTimer);
    resetTimer = window.setTimeout(() => {
      if (label) label.textContent = "Copy";
      copyButton.classList.remove("is-copied");
      if (copyStatus) copyStatus.textContent = "";
    }, 2600);
  });

  /* Share on social media, best available route first:
   *   1. the story graphic as a FILE plus the link (iOS/Android share sheets),
   *   2. link + text only (desktop Safari, Edge, Android browsers),
   *   3. download the jpg so it can be posted by hand. */
  shareButton?.addEventListener("click", async () => {
    const fileUrl = shareButton.dataset.file || "";
    const fileName = shareButton.dataset.download || "lsp-graduation-2026.jpg";
    const payload = { title: "LSP Graduation 2026", text: GALLERY_MESSAGE };

    const track = (method: string) =>
      window.trackConversion?.("graduation_share_native", {
        event_category: "graduation_recap",
        context: "graduation_share_section",
        method,
      });

    // A dismissed share sheet is a decision, not a failure: stop there rather
    // than surprising the visitor with a download.
    const dismissed = (error: unknown) =>
      error instanceof DOMException && error.name === "AbortError";

    if (typeof navigator.share === "function") {
      if (fileUrl && typeof navigator.canShare === "function") {
        try {
          const response = await fetch(fileUrl);
          if (response.ok) {
            const blob = await response.blob();
            const file = new File([blob], fileName, {
              type: blob.type || "image/jpeg",
            });
            if (navigator.canShare({ files: [file] })) {
              await navigator.share({ ...payload, url: shareUrl, files: [file] });
              track("file");
              return;
            }
          }
        } catch (error) {
          if (dismissed(error)) return;
          // Fetch blocked or files unsupported: fall through to link sharing.
        }
      }

      try {
        await navigator.share({ ...payload, url: shareUrl });
        track("link");
        return;
      } catch (error) {
        if (dismissed(error)) return;
        // Browser refused the payload: fall through to the download.
      }
    }

    if (!fileUrl) return;
    const link = document.createElement("a");
    link.href = fileUrl;
    link.download = fileName;
    document.body.appendChild(link);
    link.click();
    link.remove();
    window.trackConversion?.("graduation_share_download", {
      event_category: "graduation_recap",
      context: "graduation_share_section",
      label: "story",
    });
  });

  document
    .querySelectorAll<HTMLImageElement>("[data-share-img]")
    .forEach((image) => {
      image.addEventListener("error", () => {
        const card = image.closest<HTMLElement>("[data-share-card]");
        if (card) card.hidden = true;
      });
    });

  /* ------------------------------------------------------------------ *
   * Native album: thumbnail wall + lightbox.                           *
   * ------------------------------------------------------------------ */
  const wall = document.querySelector<HTMLElement>(".gallery-wall");
  const lightbox = document.querySelector<HTMLElement>("#lightbox");
  const lbImage = document.querySelector<HTMLImageElement>("#lb-image");
  const lbCounter = document.querySelector<HTMLElement>("#lb-counter");
  const lbPrev = document.querySelector<HTMLButtonElement>("#lb-prev");
  const lbNext = document.querySelector<HTMLButtonElement>("#lb-next");
  const lbClose = document.querySelector<HTMLButtonElement>("#lb-close");
  const expandButton = document.querySelector<HTMLButtonElement>("#gallery-expand");

  if (wall && lightbox && lbImage && lbCounter && lbPrev && lbNext && lbClose) {
    const cdn = wall.dataset.cdn || "";
    const thumbs = Array.from(
      wall.querySelectorAll<HTMLButtonElement>(".thumb"),
    );
    const total = thumbs.length;
    // Stems whose CDN URL is dead, so we never land on them twice.
    const broken = new Set<number>();
    // Indices we have already re-pointed at the 1600px rendition, and the
    // URL that actually worked, so a second visit skips the failed request.
    const retried = new Set<number>();
    const resolved = new Map<number, string>();
    let current = -1;
    let opener: HTMLButtonElement | null = null;
    let openTracked = false;

    // Flickr does not serve every photo in this album at the smaller _z/_b
    // renditions: 22 of them exist only at _h (1600px) and the rest 410.
    // Rather than hard-coding that list here, anything that fails gets one
    // retry at _h, which recovers all of them.
    const highRes = (src: string) =>
      !src || src.includes("_h.jpg") ? "" : src.replace(/_[a-z]\.jpg$/, "_h.jpg");

    const fullSrc = (index: number) => {
      const known = resolved.get(index);
      if (known) return known;
      const stem = thumbs[index]?.dataset.full;
      return stem ? `${cdn}${stem}.jpg` : "";
    };

    // Thumbnails: `error` does not bubble, so catch it on the way down.
    wall.addEventListener(
      "error",
      (event) => {
        const image = event.target;
        if (!(image instanceof HTMLImageElement) || image.dataset.retried) {
          return;
        }
        const next = highRes(image.currentSrc || image.src);
        if (!next) return;
        image.dataset.retried = "1";
        image.src = next;
      },
      true,
    );

    // Some engines never kick off `loading="lazy"` fetches for these grid
    // cells (observed in embedded Chromium): nudge each thumb to eager as it
    // approaches the viewport, which preserves the bandwidth behaviour and
    // guarantees the fetch actually starts.
    if ("IntersectionObserver" in window) {
      const nudge = new IntersectionObserver(
        (observations) => {
          for (const entry of observations) {
            if (!entry.isIntersecting) continue;
            const image = entry.target;
            if (image instanceof HTMLImageElement && !image.complete) {
              image.loading = "eager";
            }
            nudge.unobserve(entry.target);
          }
        },
        { rootMargin: "600px 0px" },
      );
      wall
        .querySelectorAll<HTMLImageElement>("img[loading='lazy']")
        .forEach((image) => nudge.observe(image));
    } else {
      wall
        .querySelectorAll<HTMLImageElement>("img[loading='lazy']")
        .forEach((image) => {
          image.loading = "eager";
        });
    }

    const preload = (index: number) => {
      const src = fullSrc(index);
      if (!src || broken.has(index)) return;
      const image = new Image();
      image.decoding = "async";
      image.src = src;
    };

    // `step` is the direction we were travelling, so a dead image keeps the
    // visitor moving the way they asked rather than bouncing them backwards.
    const show = (index: number, step = 1) => {
      if (!total) return;
      const wrapped = ((index % total) + total) % total;

      if (broken.has(wrapped)) {
        if (broken.size >= total) return;
        show(wrapped + step, step);
        return;
      }

      current = wrapped;
      lbImage.src = fullSrc(wrapped);
      lbImage.alt = `Graduation photo ${wrapped + 1} of ${total}`;
      lbCounter.textContent = `${wrapped + 1} / ${total}`;
      preload(wrapped + 1);
      preload(wrapped - 1);
    };

    lbImage.addEventListener("error", () => {
      // Ignore the error the browser may raise when close() drops the src.
      if (current < 0 || lightbox.hidden) return;

      // One retry at the 1600px rendition before writing the photo off.
      if (!retried.has(current)) {
        const next = highRes(lbImage.src);
        if (next) {
          retried.add(current);
          resolved.set(current, next);
          lbImage.src = next;
          return;
        }
      }

      resolved.delete(current);
      broken.add(current);
      if (broken.size >= total) return;
      show(current + 1, 1);
    });

    const open = (index: number, trigger: HTMLButtonElement) => {
      opener = trigger;
      lightbox.hidden = false;
      document.body.style.overflow = "hidden";
      show(index, 1);
      lbClose.focus();

      if (!openTracked) {
        openTracked = true;
        window.trackConversion?.("graduation_gallery_open", {
          event_category: "graduation_recap",
          context: "graduation_story_end",
        });
      }
    };

    const close = () => {
      lightbox.hidden = true;
      current = -1;
      document.body.style.overflow = "";
      lbImage.removeAttribute("src");
      opener?.focus();
      opener = null;
    };

    thumbs.forEach((thumb, index) => {
      thumb.addEventListener("click", () => open(index, thumb));
    });

    lbPrev.addEventListener("click", () => show(current - 1, -1));
    lbNext.addEventListener("click", () => show(current + 1, 1));
    lbClose.addEventListener("click", close);

    // Backdrop click, but not a click on the photo or the controls.
    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox || event.target === lbImage.parentElement) {
        close();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (lightbox.hidden) return;

      if (event.key === "Escape") {
        event.preventDefault();
        close();
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        show(current + 1, 1);
      } else if (event.key === "ArrowLeft") {
        event.preventDefault();
        show(current - 1, -1);
      } else if (event.key === "Tab") {
        // Keep focus inside the dialog while it is open.
        const focusable = [lbClose, lbPrev, lbNext];
        const position = focusable.indexOf(
          document.activeElement as HTMLButtonElement,
        );
        event.preventDefault();
        const offset = event.shiftKey ? -1 : 1;
        const next =
          (((position < 0 ? 0 : position + offset) % focusable.length) +
            focusable.length) %
          focusable.length;
        focusable[next].focus();
      }
    });

    // Horizontal swipe, ignoring gestures that are mostly vertical.
    let touchX = 0;
    let touchY = 0;

    lightbox.addEventListener(
      "touchstart",
      (event) => {
        const touch = event.changedTouches[0];
        touchX = touch.clientX;
        touchY = touch.clientY;
      },
      { passive: true },
    );

    lightbox.addEventListener(
      "touchend",
      (event) => {
        const touch = event.changedTouches[0];
        const deltaX = touch.clientX - touchX;
        const deltaY = touch.clientY - touchY;
        if (Math.abs(deltaX) < 44 || Math.abs(deltaX) < Math.abs(deltaY)) return;
        show(current + (deltaX < 0 ? 1 : -1), deltaX < 0 ? 1 : -1);
      },
      { passive: true },
    );

    expandButton?.addEventListener("click", () => {
      const hiddenCells = Array.from(
        wall.querySelectorAll<HTMLElement>(".thumb-cell[hidden]"),
      );
      hiddenCells.forEach((cell) => {
        cell.hidden = false;
      });
      expandButton.hidden = true;
      // Send focus to the first newly revealed thumb so keyboard and screen
      // reader users land where the new content starts.
      hiddenCells[0]?.querySelector<HTMLButtonElement>(".thumb")?.focus();
    });
  }
</script>

