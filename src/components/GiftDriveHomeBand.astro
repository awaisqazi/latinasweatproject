---
// Homepage band for the Holiday Gift Drive (LSP's Community Impact Team, on
// until Sunday, December 13, 2026). Between the Giving Tuesday band and the
// LSP Posadas band (date order: Dec 1, Dec 13, Dec 19). LIGHT in the cadence:
// the team's flyer, its cream paper #fef9e6 and ink #040501, its own title
// lockup as the heading (public/images/giftdrive/lockup.svg), "On now until
// Dec 13" in the hand face (Shantell Sans 500, loaded for those few letters
// only) over the flyer's row of round dots, Rubik for the rest, and the one
// /giftdrive button (flyer green #04b17a, ink outline, hard ink offset). The
// tree photo LEFT on desktop (plain rectangle, 3:4); on phones the lockup,
// then the photo (4:5), then the copy, with the DOM order heading, copy,
// photo for assistive tech (grid-template-areas).
//
// Seams: while the dark Giving Tuesday band is directly above, none. When the
// section above is light (the cream "Our new home", once Giving Tuesday has
// stepped back after Dec 3 or is toggled off), the band draws the flyer's
// row of dots along its top (data-gd-seam, set here at build time and kept
// current in the browser by syncPosadaSeam in src/lib/posadaPlacement.js).
// The Posadas band below draws its own ruled seam while this band is above it.
//
// Live (src/lib/giftDrivePlacement.js): the countdown in Chicago days, and
// the band removes itself after giftDrive.endsAt (data-gd-until). Toggle:
// showGiftDriveHomeBand in src/data/giftDrive.js.
import {
  giftDrive,
  giftDrivePlacementCopy as pc,
  giftDrivePhase,
  giftDriveCountdown,
  showGiftDriveHomeBand,
} from "@/data/giftDrive";
import { showGivingHomeBand, givingPlacementPhase } from "@/data/givingTuesday";

const nowMs = Date.now();
const show = showGiftDriveHomeBand && giftDrivePhase(nowMs) !== "off";
const seam = !(showGivingHomeBand && givingPlacementPhase(nowMs) !== "off");
const c = giftDriveCountdown(nowMs);
const base = import.meta.env.BASE_URL;
const pageUrl = `${base}${giftDrive.pagePath}`;
const icsHref = `${base}${giftDrive.calendarFile}`;
const p = giftDrive.photo;
const countText = c ? (c.short ? c.en : `${c.en} · ${pc.due}`) : "";
---

{show && (
  <section
    id="gift-drive"
    class="gdb"
    aria-labelledby="gdb-title"
    data-gd-place
    data-gd-until={giftDrive.endsAt}
    data-gd-seam={seam ? "" : undefined}
  >
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Shantell+Sans:wght@500&text=On%20nowutilDec13&display=swap" />
    <div class="gdb-wrap">
      <div class="gdb-head">
        <h2 id="gdb-title" class="gdb-h">
          <img
            src={`${base}images/giftdrive/lockup.svg`}
            alt="The Latina Sweat Project's Holiday Gift Drive"
            width="616"
            height="326"
            loading="lazy"
            decoding="async"
          />
        </h2>
        <p class="gdb-onnow">On now until Dec 13</p>
      </div>
      <div class="gdb-copy">
        <p class="gdb-lead">{pc.lead}</p>
        <p class="gdb-count" data-gd-countdown data-lang="en" data-gd-tail={pc.due}>{countText}</p>
        <p class="gdb-muted">{pc.who}</p>
        <div class="gdb-cta">
          <a
            href={pageUrl}
            class="gdb-btn"
            data-conversion-event="giftdrive_page_click"
            data-conversion-context="home_giftdrive_band"
          >{pc.cta}</a>
          <a
            href={icsHref}
            class="gdb-link"
            download
            data-conversion-event="giftdrive_calendar_click"
            data-conversion-context="home_giftdrive_band"
          >{pc.calendar}</a>
        </div>
      </div>
      <a
        href={pageUrl}
        class="gdb-art"
        tabindex="-1"
        aria-hidden="true"
        data-conversion-event="giftdrive_page_click"
        data-conversion-context="home_giftdrive_band_art"
      >
        <picture>
          <source
            type="image/webp"
            srcset={`${base}${p.webp640} 640w, ${base}${p.webp960} 960w`}
            sizes="(min-width: 1024px) 368px, calc(100vw - 2rem)"
          />
          <img
            src={`${base}${p.jpg}`}
            alt=""
            width={p.width}
            height={p.height}
            loading="lazy"
            decoding="async"
          />
        </picture>
      </a>
    </div>
  </section>
)}

<script>
  import { initGiftDrivePlacements } from "@/lib/giftDrivePlacement.js";
  initGiftDrivePlacements();
</script>

<style>
  .gdb {
    --paper: #fef9e6;
    --ink: #040501;
    --green: #04b17a;
    --muted: rgb(4 5 1 / 0.74);
    background: var(--paper);
    color: var(--ink);
    font-family: "Rubik", system-ui, sans-serif;
    overflow-x: clip;
  }
  .gdb [hidden] { display: none !important; }
  /* The flyer's row of round dots as the seam under a light section. */
  .gdb[data-gd-seam] .gdb-wrap { position: relative; }
  .gdb[data-gd-seam] .gdb-wrap::before {
    content: "";
    position: absolute;
    top: 0;
    left: 1rem;
    right: 1rem;
    height: 6px;
    background: radial-gradient(circle, var(--ink) 2.3px, transparent 2.8px) 0 50% / 9px 6px space no-repeat;
  }
  .gdb-wrap {
    display: grid;
    grid-template-areas: "head" "art" "copy";
    margin: 0 auto;
    max-width: 80rem;
    padding: 3.5rem 1rem 4.5rem;
  }
  .gdb-head {
    grid-area: head;
    width: 100%;
    max-width: 34rem;
    text-align: center;
  }
  .gdb-h img {
    display: block;
    width: 100%;
    height: auto;
  }
  .gdb-onnow {
    display: inline-block;
    margin-top: 0.8rem;
    font-family: "Shantell Sans", "Rubik", system-ui, sans-serif;
    font-weight: 500;
    font-size: clamp(1.5rem, 6.5vw, 2rem);
    line-height: 1.2;
  }
  .gdb-onnow::after {
    content: "";
    display: block;
    height: 6px;
    margin: 0.5rem 6% 0;
    background: radial-gradient(circle, var(--ink) 2.3px, transparent 2.8px) 0 50% / 9px 6px space no-repeat;
  }
  .gdb-copy { grid-area: copy; }
  .gdb-lead {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: 1.15rem;
    line-height: 1.45;
    text-wrap: pretty;
  }
  .gdb-count {
    margin-top: 1rem;
    max-width: 34rem;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.4;
  }
  .gdb-muted {
    margin-top: 0.6rem;
    max-width: 34rem;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }
  .gdb-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.5rem;
    margin-top: 2rem;
  }
  .gdb-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    border: 2.5px solid var(--ink);
    border-radius: 12px;
    padding: 0 1.75rem;
    background: var(--green);
    color: var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    font-size: 1.0625rem;
    font-weight: 700;
    transition: transform 90ms, box-shadow 90ms;
  }
  .gdb-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 var(--ink);
  }
  .gdb-btn:active {
    transform: translate(3px, 3px);
    box-shadow: 0 0 0 var(--ink);
  }
  .gdb-link {
    color: var(--ink);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }
  .gdb-link:hover { text-decoration-thickness: 2.5px; }
  .gdb-link:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
    border-radius: 2px;
  }
  .gdb-btn:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 5px;
  }

  .gdb-art {
    grid-area: art;
    display: block;
    margin-top: 2rem;
  }
  .gdb-art img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    max-height: 70vh;
    object-fit: cover;
    object-position: 50% 55%;
    border-radius: 3px;
    background: #ece5cf;
  }

  @media (min-width: 640px) {
    .gdb-wrap { padding: 4.5rem 1.5rem 5.5rem; }
    .gdb[data-gd-seam] .gdb-wrap::before { left: 1.5rem; right: 1.5rem; }
    .gdb-art { width: 75%; }
  }
  @media (min-width: 1024px) {
    .gdb[data-gd-seam] .gdb-wrap::before { left: 2rem; right: 2rem; }
    .gdb-wrap {
      /* The pair is centred in the band so the margins match left and right. */
      grid-template-columns: 23rem minmax(0, 34rem);
      justify-content: center;
      grid-template-rows: 1fr auto auto 1fr;
      grid-template-areas:
        "art ."
        "art head"
        "art copy"
        "art .";
      column-gap: 6rem;
      padding: 6rem 2rem;
    }
    .gdb-art {
      width: 100%;
      margin-top: 0;
    }
    .gdb-art img {
      aspect-ratio: 3 / 4;
      max-height: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gdb-btn { transition: none; }
    .gdb-btn:hover, .gdb-btn:active { transform: none; }
  }
</style>
