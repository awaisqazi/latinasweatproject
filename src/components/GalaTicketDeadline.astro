---
/**
 * Gala ticket deadline module: the site's primary gala conversion unit.
 *
 * Three phases are always server-rendered and the client script picks the live
 * one on load and every 30 s:
 *   full  · full-evening (Benefactor) seats still on sale
 *   late  · full evening closed, late-night (Supporter) access still on sale
 *   past  · gala day is over; the whole module hides and gala CTAs fall back
 *           to the details page
 *
 * Variants:
 *   banner · standalone card (schedule, /gala) with copy column + module
 *   inline · just the module, dropped inside an existing dark gala section
 *
 * Copy rule: one ask per surface, calm urgency. No caps-lock urgency, no red,
 * no pinging dots, and the deadline sentence is said once.
 */
import GalaCountdown from "@/components/GalaCountdown.astro";
import GalaPhotoFrame from "@/components/GalaPhotoFrame.astro";
import { galaPhotos, galaTeaser, galaTicketDeadline } from "@/data/galaTeaser";

interface Props {
  context: string;
  bilingual?: boolean;
  variant?: "banner" | "inline";
}

const { context, bilingual = false, variant = "banner" } = Astro.props;
const isBanner = variant === "banner";

const base = import.meta.env.BASE_URL;
const detailsUrl = `${base}gala#tickets`;

const {
  closesAtISO,
  eventEndsAtISO,
  closesDateLabel,
  closesDateLabelEs,
  closesTimeLabel,
  closesTimeLabelEs,
  fullNightPrice,
  lateNightPrice,
  lateNightAccessLabel,
} = galaTicketDeadline;

const closesAt = new Date(closesAtISO).getTime();
const eventEndsAt = new Date(eventEndsAtISO).getTime();
const now = Date.now();
const phase =
  now >= eventEndsAt ? "past" : now >= closesAt ? "late" : "full";

// Server fallback for the foil line, computed exactly like the client script
// so the text never changes shape once JS runs.
const daysLeft = Math.floor((closesAt - now) / 3.6e6 / 24);
const daysLeftEn =
  daysLeft >= 2
    ? `${daysLeft} days left`
    : daysLeft === 1
      ? "1 day left"
      : "Closes tonight";
const daysLeftEs =
  daysLeft >= 2
    ? `Quedan ${daysLeft} días`
    : daysLeft === 1
      ? "Queda 1 día"
      : "Cierra esta noche";
---

<aside
  class:list={[
    "gala-deadline relative text-white",
    isBanner
      ? "gala-deadline--banner reveal overflow-hidden rounded-3xl border border-accent-gold/45 bg-off-black p-5 shadow-2xl sm:p-7 lg:p-9"
      : "gala-deadline--inline",
  ]}
  data-gala-ticket-deadline
  data-deadline={closesAtISO}
  data-event-end={eventEndsAtISO}
  data-tickets-url={galaTeaser.ticketsUrl}
  data-details-url={detailsUrl}
  data-full-price={fullNightPrice}
  data-late-price={lateNightPrice}
  hidden={phase === "past"}
  aria-label="Annual Gala tickets"
>
  {
    isBanner && (
      <Fragment>
        <div
          class="gala-foil-rule pointer-events-none absolute inset-x-0 top-0 h-px"
          aria-hidden="true"
        />
        <div
          class="gala-lattice pointer-events-none absolute inset-0 opacity-[0.07]"
          aria-hidden="true"
        />
        <div
          class="gala-ambient pointer-events-none absolute -right-20 -top-24 h-64 w-64 rounded-full bg-accent-gold/20 blur-3xl"
          aria-hidden="true"
        />
        <div
          class="gala-ambient pointer-events-none absolute -bottom-28 -left-24 h-64 w-64 rounded-full bg-vibrant-pink/12 blur-3xl"
          aria-hidden="true"
        />
      </Fragment>
    )
  }

  {/* ---------------- PHASE: full evening on sale ---------------- */}
  <div class="relative" data-phase="full" hidden={phase !== "full"}>
    <div
      class:list={[
        "deadline-grid grid gap-8",
        isBanner && "deadline-grid--banner",
      ]}
    >
      {
        isBanner && (
          <div class="deadline-copy min-w-0">
            <p class="flex flex-wrap items-center gap-3 text-[0.68rem] font-bold uppercase tracking-[0.2em] text-accent-gold sm:text-xs">
              <span
                class="gala-foil-rule block h-px w-8 shrink-0"
                aria-hidden="true"
              />
              <span class:list={[bilingual && "lang-en"]}>
                Annual Gala · Friday, September 25 · MCA Chicago
              </span>
              {bilingual && (
                <span class="lang-es hidden">
                  Gala Anual · viernes 25 de septiembre · MCA Chicago
                </span>
              )}
            </p>

            <h2 class="mt-4 font-display text-3xl font-bold leading-[1.12] sm:text-4xl">
              <span class:list={[bilingual && "lang-en"]}>
                Make it a <span class="gala-foil">full night</span> to remember.
              </span>
              {bilingual && (
                <span class="lang-es hidden">
                  Vive una <span class="gala-foil">noche completa</span> e
                  inolvidable.
                </span>
              )}
            </h2>

            <p class="mt-4 text-sm leading-relaxed text-white/80 sm:text-base">
              <span class:list={[bilingual && "lang-en"]}>
                Start with cocktails and a three-course dinner. Stay for the
                art, open bar, fashion show, and dancing. Your Benefactor ticket
                supports accessible wellness across Chicago.
              </span>
              {bilingual && (
                <span class="lang-es hidden">
                  Comienza con cócteles y una cena de tres tiempos. Quédate para
                  disfrutar del arte, la barra libre, el desfile de moda y el
                  baile. Tu boleto Benefactor apoya el acceso al bienestar en
                  Chicago.
                </span>
              )}
            </p>

            <p class="mt-5 text-sm font-bold text-accent-gold">
              <span class:list={[bilingual && "lang-en"]}>
                6 PM to midnight · Black tie · ${fullNightPrice} per person
              </span>
              {bilingual && (
                <span class="lang-es hidden">
                  6 p. m. a medianoche · Etiqueta formal · ${fullNightPrice} por
                  persona
                </span>
              )}
            </p>

            <div class="deadline-photo mt-7">
              <GalaPhotoFrame
                slot={galaPhotos.facade}
                variant="links"
                label={false}
              />
            </div>
          </div>
        )
      }

      <div class="deadline-module min-w-0">
        {
          !isBanner && (
            <div
              class="gala-foil-rule mb-5 h-px w-full opacity-80"
              aria-hidden="true"
            />
          )
        }

        <p class="text-[0.66rem] font-bold uppercase tracking-[0.22em] text-white/60 sm:text-[0.7rem]">
          <span class:list={[bilingual && "lang-en"]}>
            Full-evening seats close
          </span>
          {
            bilingual && (
              <span class="lang-es hidden">
                Los boletos de noche completa cierran
              </span>
            )
          }
        </p>

        <p class="deadline-days mt-1.5 font-display font-bold leading-[1.05]">
          {
            bilingual ? (
              <Fragment>
                <span
                  class="gala-foil lang-en"
                  data-gala-days-left
                  data-lang="en"
                >
                  {daysLeftEn}
                </span>
                <span
                  class="gala-foil lang-es hidden"
                  data-gala-days-left
                  data-lang="es"
                >
                  {daysLeftEs}
                </span>
              </Fragment>
            ) : (
              <span class="gala-foil" data-gala-days-left>
                {daysLeftEn}
              </span>
            )
          }
        </p>

        <p class="mt-2 text-xs text-white/60">
          <span class:list={[bilingual && "lang-en"]}>
            {closesDateLabel} · {closesTimeLabel}
          </span>
          {
            bilingual && (
              <span class="lang-es hidden">
                {closesDateLabelEs} · {closesTimeLabelEs}
              </span>
            )
          }
        </p>

        <GalaCountdown
          target={closesAtISO}
          variant="compact"
          units={["days", "hours", "minutes"]}
          label="Time remaining to reserve full-evening Gala tickets"
          bilingual={bilingual}
          className="mt-4"
        />

        <a
          href={galaTeaser.ticketsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="gala-btn gala-btn--gold gala-sheen group mt-5 flex w-full items-center justify-center gap-2 px-4 py-3.5 text-center text-sm font-extrabold sm:text-base"
          data-gala-full-night-cta
          data-conversion-event="gala_ticket_click"
          data-conversion-context={context}
        >
          <span data-gala-cta-label class="relative z-[1]">
            <span class:list={[bilingual && "lang-en"]}>
              Reserve the Full Evening · ${fullNightPrice}
            </span>
            {
              bilingual && (
                <span class="lang-es hidden">
                  Reservar la noche completa · ${fullNightPrice}
                </span>
              )
            }
          </span>
          <svg
            class="relative z-[1] h-4 w-4 shrink-0 transition-transform group-hover:translate-x-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M14 5l7 7m0 0l-7 7m7-7H3"
            />
          </svg>
        </a>

        <p class="mt-2.5 text-center text-[0.72rem] leading-relaxed text-white/65">
          <span class:list={[bilingual && "lang-en"]}>
            Choose “Benefactor · The Full Evening” at checkout.
          </span>
          {
            bilingual && (
              <span class="lang-es hidden">
                Elige “Benefactor · The Full Evening” al comprar.
              </span>
            )
          }
        </p>

        <p class="mt-4 text-center text-[0.78rem] leading-relaxed text-white/70">
          <a
            href={galaTeaser.ticketsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="deadline-quiet underline-offset-4 transition-colors hover:text-accent-gold hover:underline"
            data-conversion-event="gala_ticket_click"
            data-conversion-context={`${context}_late_night`}
          >
            <span class:list={[bilingual && "lang-en"]}>
              Joining at 9 PM instead? Late-night access is ${lateNightPrice}.
            </span>
            {
              bilingual && (
                <span class="lang-es hidden">
                  ¿Llegas a las 9 PM? El acceso nocturno cuesta ${lateNightPrice}.
                </span>
              )
            }
          </a>
        </p>
      </div>
    </div>
  </div>

  {/* ---------------- PHASE: late-night access only ---------------- */}
  <div class="relative" data-phase="late" hidden={phase !== "late"}>
    {
      isBanner ? (
        <div class="max-w-2xl">
          <p class="flex flex-wrap items-center gap-3 text-[0.68rem] font-bold uppercase tracking-[0.2em] text-accent-gold sm:text-xs">
            <span
              class="gala-foil-rule block h-px w-8 shrink-0"
              aria-hidden="true"
            />
            <span class:list={[bilingual && "lang-en"]}>
              Annual Gala · Friday, September 25 · MCA Chicago
            </span>
            {bilingual && (
              <span class="lang-es hidden">
                Gala Anual · viernes 25 de septiembre · MCA Chicago
              </span>
            )}
          </p>
          <h2 class="mt-4 font-display text-3xl font-bold leading-[1.12] sm:text-4xl">
            <span class:list={[bilingual && "lang-en"]}>
              The full evening has closed.{" "}
              <span class="gala-foil">The night is still open.</span>
            </span>
            {bilingual && (
              <span class="lang-es hidden">
                La noche completa cerró.{" "}
                <span class="gala-foil">La fiesta sigue abierta.</span>
              </span>
            )}
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-white/80 sm:text-base">
            <span class:list={[bilingual && "lang-en"]}>
              Late-night access begins at 9 PM: full gallery access, open bar,
              the awards presentation, the fashion show, and dancing until
              midnight.
            </span>
            {bilingual && (
              <span class="lang-es hidden">
                El acceso nocturno comienza a las 9 p. m.: galerías abiertas,
                barra libre, la entrega de premios, el desfile de moda y baile
                hasta la medianoche.
              </span>
            )}
          </p>
          <a
            href={galaTeaser.ticketsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="gala-btn gala-btn--gold gala-sheen group mt-6 inline-flex items-center justify-center gap-2 px-6 py-3.5 text-sm font-extrabold sm:text-base"
            data-conversion-event="gala_ticket_click"
            data-conversion-context={`${context}_late`}
          >
            <span class="relative z-[1]">
              <span class:list={[bilingual && "lang-en"]}>
                Get Late-Night Access · ${lateNightPrice}
              </span>
              {bilingual && (
                <span class="lang-es hidden">
                  Acceso nocturno · ${lateNightPrice}
                </span>
              )}
            </span>
            <svg
              class="relative z-[1] h-4 w-4 shrink-0 transition-transform group-hover:translate-x-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M14 5l7 7m0 0l-7 7m7-7H3"
              />
            </svg>
          </a>
          <p class="mt-3 text-xs text-white/60">
            {galaTeaser.lateNightStatusLabel}
          </p>
        </div>
      ) : (
        <div>
          <div
            class="gala-foil-rule mb-5 h-px w-full opacity-80"
            aria-hidden="true"
          />
          <p class="text-sm leading-relaxed text-white/80">
            <span class:list={[bilingual && "lang-en"]}>
              The full evening has closed. Late-night access ({lateNightAccessLabel}) is still open.
            </span>
            {bilingual && (
              <span class="lang-es hidden">
                La noche completa cerró. El acceso nocturno (desde las 9 p. m.)
                sigue abierto.
              </span>
            )}
          </p>
          <a
            href={galaTeaser.ticketsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="gala-btn gala-btn--gold gala-sheen group mt-4 flex w-full items-center justify-center gap-2 px-4 py-3.5 text-center text-sm font-extrabold sm:text-base"
            data-conversion-event="gala_ticket_click"
            data-conversion-context={`${context}_late`}
          >
            <span class="relative z-[1]">
              <span class:list={[bilingual && "lang-en"]}>
                Get Late-Night Access · ${lateNightPrice}
              </span>
              {bilingual && (
                <span class="lang-es hidden">
                  Acceso nocturno · ${lateNightPrice}
                </span>
              )}
            </span>
            <svg
              class="relative z-[1] h-4 w-4 shrink-0 transition-transform group-hover:translate-x-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M14 5l7 7m0 0l-7 7m7-7H3"
              />
            </svg>
          </a>
        </div>
      )
    }
  </div>

  {/* ---------------- PHASE: after gala day (root is hidden) ---------------- */}
  <div class="relative" data-phase="past" hidden={phase !== "past"}>
    <p class="text-sm leading-relaxed text-white/80">
      <span class:list={[bilingual && "lang-en"]}>
        Thank you for supporting accessible wellness in Chicago. Visit the gala
        page for details and what comes next.
      </span>
      {
        bilingual && (
          <span class="lang-es hidden">
            Gracias por apoyar el acceso al bienestar en Chicago. Visita la
            página de la gala para ver los detalles y lo que viene.
          </span>
        )
      }
    </p>
    <a
      href={detailsUrl}
      class="gala-btn gala-btn--ghost mt-4 inline-flex px-5 py-3 text-sm font-bold"
    >
      <span class:list={[bilingual && "lang-en"]}>View Gala Details</span>
      {bilingual && <span class="lang-es hidden">Ver detalles de la gala</span>}
    </a>
  </div>
</aside>

<style>
  [hidden] {
    display: none !important;
  }

  .gala-deadline {
    text-wrap: pretty;
    container-type: inline-size;
  }

  /* The hero line: scales with the module's own width, so it stays elegant in
     a 320px links card and commanding in a full-width banner. */
  .deadline-days {
    font-size: clamp(1.6rem, 7.5cqi, 2.6rem);
  }

  /* Banner: stack below 48rem, copy + module side by side above it. */
  @container (min-width: 48rem) {
    .gala-deadline--banner .deadline-grid--banner {
      grid-template-columns: 1.2fr 1fr;
      align-items: center;
      gap: 2.75rem;
    }
  }

  /* The venue frame only earns its place on the widest banners. */
  .deadline-photo {
    display: none;
  }
  @container (min-width: 64rem) {
    .deadline-photo {
      display: block;
    }
  }

  :global(.lang-active-es) .gala-deadline :global(.lang-en) {
    display: none !important;
  }
  :global(.lang-active-es) .gala-deadline :global(.lang-es) {
    display: inline !important;
  }

  .gala-deadline a:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 4px;
    border-radius: 4px;
  }
</style>

<script>
  type GalaPhase = "full" | "late" | "past";

  (() => {
    const flag = window as unknown as { __lspGalaDeadline?: boolean };
    if (flag.__lspGalaDeadline) return;
    flag.__lspGalaDeadline = true;

    const roots = Array.from(
      document.querySelectorAll<HTMLElement>("[data-gala-ticket-deadline]"),
    );
    const source = roots[0];
    if (!source) return;

    const closesAt = new Date(source.dataset.deadline || "").getTime();
    const endsAt = new Date(source.dataset.eventEnd || "").getTime();
    if (!Number.isFinite(closesAt) || !Number.isFinite(endsAt)) return;

    const ticketsUrl = source.dataset.ticketsUrl || "";
    const detailsUrl = source.dataset.detailsUrl || "";
    const latePrice = source.dataset.latePrice || "";

    const isSpanish = (el: Element) =>
      (el as HTMLElement).dataset.lang === "es" ||
      el.classList.contains("lang-es") ||
      Boolean(el.closest(".lang-es"));

    const daysLeft = (now: number) =>
      Math.floor((closesAt - now) / 3.6e6 / 24);

    const daysText = (phase: GalaPhase, now: number, es: boolean) => {
      if (phase === "past") return "";
      if (phase === "late")
        return es ? "Acceso nocturno disponible" : "Late-night access open";
      const days = daysLeft(now);
      if (days >= 2) return es ? `Quedan ${days} días` : `${days} days left`;
      if (days === 1) return es ? "Queda 1 día" : "1 day left";
      return es ? "Cierra esta noche" : "Closes tonight";
    };

    const closesInText = (phase: GalaPhase, now: number, es: boolean) => {
      if (phase === "past") return "";
      if (phase === "late")
        return es ? "acceso nocturno a la venta" : "late-night access on sale";
      const days = daysLeft(now);
      if (days >= 2)
        return es ? `cierra en ${days} días` : `closes in ${days} days`;
      if (days === 1) return es ? "cierra en 1 día" : "closes in 1 day";
      return es ? "cierra esta noche" : "closes tonight";
    };

    // Relabel a CTA without ever clobbering its icon: prefer the label hook,
    // then any bilingual pair inside it, then the first span.
    const setCtaLabel = (link: HTMLAnchorElement, en: string, es: string) => {
      const scope =
        link.querySelector<HTMLElement>("[data-gala-cta-label]") || link;
      const enEl = scope.querySelector<HTMLElement>(".lang-en");
      const esEl = scope.querySelector<HTMLElement>(".lang-es");
      if (enEl || esEl) {
        if (enEl) enEl.textContent = en;
        if (esEl) esEl.textContent = es;
        return;
      }
      const target =
        scope === link
          ? link.querySelector<HTMLElement>("span") || link
          : scope;
      target.textContent = en;
    };

    const apply = () => {
      const now = Date.now();
      const phase: GalaPhase =
        now >= endsAt ? "past" : now >= closesAt ? "late" : "full";

      roots.forEach((root) => {
        root.hidden = phase === "past";
        root
          .querySelectorAll<HTMLElement>("[data-phase]")
          .forEach((block) => {
            block.hidden = block.dataset.phase !== phase;
          });
      });

      document
        .querySelectorAll<HTMLElement>("[data-gala-days-left]")
        .forEach((el) => {
          el.textContent = daysText(phase, now, isSpanish(el));
        });

      document
        .querySelectorAll<HTMLElement>("[data-gala-closes-in]")
        .forEach((el) => {
          el.textContent = closesInText(phase, now, isSpanish(el));
        });

      document
        .querySelectorAll<HTMLElement>("[data-gala-phase-only]")
        .forEach((el) => {
          const allowed = (el.dataset.galaPhaseOnly || "")
            .split(/[|,\s]+/)
            .filter(Boolean);
          el.hidden = allowed.length > 0 && !allowed.includes(phase);
        });

      if (phase === "full") return;

      document
        .querySelectorAll<HTMLAnchorElement>("[data-gala-full-night-cta]")
        .forEach((link) => {
          if (phase === "late") {
            if (ticketsUrl) link.href = ticketsUrl;
            setCtaLabel(
              link,
              `Get Late-Night Access · $${latePrice}`,
              `Acceso nocturno · $${latePrice}`,
            );
            return;
          }
          link.href = detailsUrl;
          link.removeAttribute("target");
          link.removeAttribute("data-conversion-event");
          setCtaLabel(link, "View Gala Details", "Ver detalles de la gala");
        });
    };

    apply();
    // The countdown ticks its own digits every second; the phase only needs a
    // slow poll.
    window.setInterval(apply, 30000);
  })();
</script>
