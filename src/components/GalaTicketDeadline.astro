---
import GalaCountdown from "@/components/GalaCountdown.astro";
import { galaTeaser, galaTicketDeadline } from "@/data/galaTeaser";

interface Props {
  context: string;
  bilingual?: boolean;
}
const { context, bilingual = false } = Astro.props;
const detailsUrl = `${import.meta.env.BASE_URL}gala#tickets`;
const closed = Date.now() >= new Date(galaTicketDeadline.closesAtISO).getTime();
---

<aside class="gala-deadline relative overflow-hidden rounded-3xl border border-accent-gold/45 bg-off-black p-5 text-white shadow-xl sm:p-8" data-gala-ticket-deadline data-deadline={galaTicketDeadline.closesAtISO} data-details-url={detailsUrl} aria-label="Annual Gala full-night tickets">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(255,189,89,0.16),transparent_65%)]" aria-hidden="true"></div>
  <div class="deadline-layout relative grid items-center gap-6" data-sale-open hidden={closed}>
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-accent-gold">
        <span class:list={[bilingual && "lang-en"]}>Annual Gala · Full-night sales close September 15</span>
        {bilingual && <span class="lang-es hidden">Gala Anual · Noche completa a la venta hasta el 15 de septiembre</span>}
      </p>
      <h2 class="mt-3 font-display text-3xl font-bold leading-tight sm:text-4xl">
        <span class:list={[bilingual && "lang-en"]}>Make it a full night to remember.</span>
        {bilingual && <span class="lang-es hidden">Vive una noche completa e inolvidable.</span>}
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-white/85 sm:text-base">
        <span class:list={[bilingual && "lang-en"]}>Start with cocktails and a three-course dinner. Stay for the art, open bar, fashion show, and dancing. Your Benefactor ticket supports accessible wellness across Chicago.</span>
        {bilingual && <span class="lang-es hidden">Comienza con cócteles y una cena de tres tiempos. Quédate para disfrutar del arte, la barra libre, el desfile de moda y el baile. Tu boleto Benefactor apoya el acceso al bienestar en Chicago.</span>}
      </p>
      <p class="mt-4 text-sm font-bold text-accent-gold">
        <span class:list={[bilingual && "lang-en"]}>September 25 · 6 PM–midnight · MCA Chicago · ${galaTicketDeadline.fullNightPrice} per person</span>
        {bilingual && <span class="lang-es hidden">25 de septiembre · 6 p. m.–medianoche · MCA Chicago · ${galaTicketDeadline.fullNightPrice} por persona</span>}
      </p>
    </div>
    <div class="min-w-0">
      <p class="mb-3 text-sm font-bold text-white/90">
        <span class:list={[bilingual && "lang-en"]}>Time left to get your full-night tickets</span>
        {bilingual && <span class="lang-es hidden">Tiempo para comprar tus boletos para la noche completa</span>}
      </p>
      <GalaCountdown target={galaTicketDeadline.closesAtISO} variant="compact" label="Time remaining to buy full-night Gala tickets" bilingual={bilingual} />
      <p class="mt-3 text-xs leading-relaxed text-white/75">
        <span class:list={[bilingual && "lang-en"]}>Sales close September 15 at 11:59 PM Chicago time.</span>
        {bilingual && <span class="lang-es hidden">La venta cierra el 15 de septiembre a las 11:59 p. m., hora de Chicago.</span>}
      </p>
      <a href={galaTeaser.ticketsUrl} target="_blank" rel="noopener noreferrer" class="gala-btn gala-btn--gold mt-4 flex w-full items-center justify-center px-4 py-4 text-center text-base font-extrabold" data-conversion-event="gala_ticket_click" data-conversion-context={context} data-gala-full-night-cta>
        <span class:list={[bilingual && "lang-en"]}>Get My Full-Night Tickets →</span>
        {bilingual && <span class="lang-es hidden">Comprar boletos para la noche completa →</span>}
      </a>
      <p class="mt-2 text-center text-xs text-white/75">
        <span class:list={[bilingual && "lang-en"]}>Choose “Benefactor · The Full Evening” at checkout.</span>
        {bilingual && <span class="lang-es hidden">Elige “Benefactor · The Full Evening” al comprar.</span>}
      </p>
    </div>
  </div>
  <div class="relative" data-sale-closed hidden={!closed}>
    <h2 class="font-display text-3xl font-bold">
      <span class:list={[bilingual && "lang-en"]}>Full-night ticket sales have closed.</span>
      {bilingual && <span class="lang-es hidden">La venta de boletos para la noche completa ha cerrado.</span>}
    </h2>
    <p class="mt-3 text-white/85">
      <span class:list={[bilingual && "lang-en"]}>Thank you for supporting accessible wellness in Chicago. Visit the gala page for event details and updates.</span>
      {bilingual && <span class="lang-es hidden">Gracias por apoyar el acceso al bienestar en Chicago. Visita la página de la gala para ver los detalles y novedades.</span>}
    </p>
    <a href={detailsUrl} class="gala-btn gala-btn--gold mt-5 inline-flex px-6 py-3 font-bold">
      <span class:list={[bilingual && "lang-en"]}>View Gala Details</span>
      {bilingual && <span class="lang-es hidden">Ver detalles de la gala</span>}
    </a>
  </div>
</aside>

<style>
  [hidden] { display: none !important; }
  .gala-deadline { text-wrap: pretty; container-type: inline-size; }
  @container (min-width: 48rem) {
    .deadline-layout { grid-template-columns: 1.25fr 1fr; }
  }
  :global(.lang-active-es) .gala-deadline :global(.lang-en) { display: none !important; }
  :global(.lang-active-es) .gala-deadline :global(.lang-es) { display: inline !important; }
  .gala-deadline a:focus-visible { outline: 3px solid white; outline-offset: 4px; }
</style>

<script>
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-gala-ticket-deadline]"));
  const updateSales = () => {
    const panel = panels[0];
    if (!panel || Date.now() < new Date(panel.dataset.deadline!).getTime()) return false;
    panels.forEach((item) => {
      item.querySelector<HTMLElement>("[data-sale-open]")!.hidden = true;
      item.querySelector<HTMLElement>("[data-sale-closed]")!.hidden = false;
    });
    document.querySelectorAll<HTMLAnchorElement>("[data-gala-full-night-cta]").forEach((link) => {
      link.href = panel.dataset.detailsUrl!;
      link.removeAttribute("target");
      link.removeAttribute("data-conversion-event");
      const label = link.querySelector("[data-gala-cta-label]") || link;
      const en = label.querySelector(".lang-en");
      const es = label.querySelector(".lang-es");
      if (en && es) {
        en.textContent = "View Gala Details";
        es.textContent = "Ver detalles de la gala";
      } else {
        label.textContent = "View Gala Details";
      }
    });
    return true;
  };
  if (!updateSales()) {
    const timer = window.setInterval(() => {
      if (updateSales()) window.clearInterval(timer);
    }, 1000);
  }
</script>
