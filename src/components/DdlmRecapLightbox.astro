---
// One viewer for the whole Día de los Muertos weekend album, built on /gala's
// RecapLightbox (same rendition ladder, same no-cascade failure handling), in
// the black and white DDLM identity. It MUST be rendered OUTSIDE <main>: out
// there it competes in the root stacking context, where z-index 1000 clears the
// fixed site header. It walks every [data-dl-photo] button on the page in
// document order (the story frames, then the walls): the script writes each
// button's data-index and its "photo N of T" label, so prev/next walks from the
// essay straight into the walls. Credit and album link come from the nearest
// [data-dl-credit] (story rows and wall articles both carry them), the title
// from the nearest [data-dl-title].
import { ddlmAlbums, ddlmCdnBase, ddlmLocalBase, ddlmPhotoCount } from "@/data/ddlmGallery2026";

const base = import.meta.env.BASE_URL;
---

<div
  id="dl-lightbox"
  class="dl-lb font-rubik"
  role="dialog"
  aria-modal="true"
  aria-label="Día de los Muertos weekend photo viewer"
  data-cdn={ddlmCdnBase}
  data-local-base={`${base}${ddlmLocalBase}`}
  data-album-fallback={ddlmAlbums.saturday.url}
  data-total={ddlmPhotoCount}
  hidden
>
  <div class="dl-lb-stage" data-dl-stage>
    <img class="dl-lb-image" data-dl-image alt="" decoding="async" />
  </div>

  <p class="dl-lb-counter" data-dl-counter role="status" aria-live="polite"></p>

  <button class="dl-lb-btn dl-lb-prev" type="button" data-dl-prev aria-label="Previous photo">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 5l-7 7 7 7"></path>
    </svg>
  </button>
  <button class="dl-lb-btn dl-lb-next" type="button" data-dl-next aria-label="Next photo">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
    </svg>
  </button>
  <button class="dl-lb-btn dl-lb-close" type="button" data-dl-close aria-label="Close photo viewer">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18"></path>
    </svg>
  </button>
</div>

<style>
  /* `[hidden]` must beat the grid display or the dialog can never close. */
  .dl-lb {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    background: rgba(0, 0, 0, 0.96);
    padding: 4rem 1rem 1.25rem;
  }
  .dl-lb[hidden] {
    display: none !important;
  }
  @media (prefers-reduced-motion: no-preference) {
    .dl-lb:not([hidden]) {
      animation: dl-lb-in 150ms linear both;
    }
  }
  @keyframes dl-lb-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  .dl-lb-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
  }
  .dl-lb-image {
    display: block;
    max-width: min(100%, 76rem);
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .dl-lb-counter {
    margin-top: 1rem;
    text-align: center;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.9375rem;
    line-height: 1.3;
  }
  .dl-lb-btn {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.9rem;
    height: 2.9rem;
    background: transparent;
    color: #fff;
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .dl-lb-btn:hover {
    color: #ff7a1a;
  }
  .dl-lb-btn:focus-visible {
    outline: 2px solid #ff7a1a;
    outline-offset: 2px;
  }
  .dl-lb-btn svg {
    width: 1.6rem;
    height: 1.6rem;
  }
  .dl-lb-prev {
    left: 0.6rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .dl-lb-next {
    right: 0.6rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .dl-lb-close {
    right: 0.6rem;
    top: 0.6rem;
  }
  /* Phones: arrows drop to the bottom corners, level with the counter, so
     they never sit on top of the photo. */
  @media (max-width: 639px) {
    .dl-lb {
      padding: 4rem 0.75rem 1rem;
    }
    .dl-lb-counter {
      margin-top: 0;
      min-height: 2.9rem;
      padding: 0 3rem;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.875rem;
    }
    .dl-lb-prev,
    .dl-lb-next {
      top: auto;
      bottom: 1rem;
      transform: none;
    }
    .dl-lb-image {
      max-height: calc(100% - 1rem);
    }
  }
</style>

<script>
  (() => {
    const lb = document.getElementById("dl-lightbox");
    if (!lb) return;
    const root = document;
    const img = lb.querySelector<HTMLImageElement>("[data-dl-image]")!;
    const counter = lb.querySelector<HTMLElement>("[data-dl-counter]")!;
    const prevBtn = lb.querySelector<HTMLButtonElement>("[data-dl-prev]")!;
    const nextBtn = lb.querySelector<HTMLButtonElement>("[data-dl-next]")!;
    const closeBtn = lb.querySelector<HTMLButtonElement>("[data-dl-close]")!;
    const stage = lb.querySelector<HTMLElement>("[data-dl-stage]")!;
    const cdn = lb.dataset.cdn || "";
    const localBase = lb.dataset.localBase || "";
    const albumFallback = lb.dataset.albumFallback || "";

    // Every photo button in document order: the index, the label and the
    // walk are all assigned here, so the story and the walls share one order.
    const byIndex = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-dl-photo]"));
    const count = byIndex.length;
    if (!count) return;
    const total = Number(lb.dataset.total) || count;
    const describe = (b: HTMLButtonElement) => b.querySelector("img")?.alt?.trim() || "";
    const titleOf = (b?: HTMLButtonElement) =>
      b?.closest<HTMLElement>("[data-dl-title]")?.dataset.dlTitle?.trim() || "";
    const sentence = (t: string) => (!t || /[.!?]$/.test(t) ? t : `${t}.`);
    byIndex.forEach((b, i) => {
      b.dataset.index = String(i);
      const lead = sentence(describe(b) || titleOf(b));
      b.setAttribute("aria-label", `${lead ? `${lead} ` : ""}Photo ${i + 1} of ${total}, view large`);
    });

    const creditOf = (b?: HTMLButtonElement) => b?.closest<HTMLElement>("[data-dl-credit]");

    const broken = new Set<number>();
    let current = -1;
    let opener: HTMLElement | null = null;
    let tracked = false;

    // Rendition ladder: the stored _h 1600px stem first, then _b 1024px and
    // _c 800px built from the base stem. Flickr occasionally throttles a
    // burst of full-size loads; stepping down keeps the photo on screen
    // instead of marking it broken. Self-hosted photos: _h.webp, then _c.webp;
    // the Sunday guest frames carry their own two renditions.
    const sources = (i: number) => {
      const b = byIndex[i];
      if (b?.dataset.full) {
        return [b.dataset.full, b.dataset.fallback || ""].filter(Boolean);
      }
      if (b?.dataset.set === "local") {
        const id = b.dataset.id;
        return id ? [`${localBase}${id}_h.webp`, `${localBase}${id}_c.webp`] : [];
      }
      const stem = b?.dataset.stem;
      const base = b?.dataset.base;
      const out: string[] = [];
      if (stem) out.push(`${cdn}${stem}.jpg`);
      if (base) out.push(`${cdn}${base}_b.jpg`, `${cdn}${base}_c.jpg`);
      return out;
    };
    const fullSrc = (i: number) => sources(i)[0] || "";
    let tier = 0;

    // "Could not load" notice, built here so it needs no scoped styles.
    const msg = document.createElement("p");
    msg.hidden = true;
    msg.setAttribute("role", "status");
    msg.style.cssText =
      "position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);max-width:22rem;margin:0;padding:1rem 1.25rem;text-align:center;font-size:.95rem;line-height:1.5;color:#fff;background:#000;z-index:2;";
    const msgLink = document.createElement("a");
    msgLink.target = "_blank";
    msgLink.rel = "noopener noreferrer";
    msgLink.textContent = "open the album";
    msgLink.style.cssText = "color:#ff7a1a;text-decoration:underline;text-underline-offset:3px";
    msg.append("This photo did not load. Try the next one, or ", msgLink, ".");
    stage.style.position = stage.style.position || "relative";
    stage.appendChild(msg);
    const wrap = (i: number) => ((i % count) + count) % count;

    // Broken thumbs retire their whole cell (error does not bubble, so listen
    // in the capture phase), and the viewer skips them.
    root.addEventListener(
      "error",
      (event) => {
        const t = event.target;
        if (!(t instanceof HTMLImageElement)) return;
        const btn = t.closest<HTMLButtonElement>("[data-dl-photo]");
        if (!btn) return;
        broken.add(Number(btn.dataset.index));
        const cell = btn.closest<HTMLElement>("[data-dl-cell]");
        if (cell) {
          cell.hidden = true;
          cell.dataset.dlBroken = "true";
        }
      },
      true,
    );

    // Some engines never start `loading="lazy"` fetches for grid cells (seen
    // in embedded Chromium): nudge each image to eager as it nears the
    // viewport. Hidden cells are skipped until they are revealed.
    const lazyImgs = Array.from(
      root.querySelectorAll<HTMLImageElement>("[data-dl-photo] img[loading='lazy']"),
    );
    let nudge: IntersectionObserver | null = null;
    if ("IntersectionObserver" in window) {
      nudge = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const im = e.target as HTMLImageElement;
            if (!im.complete) im.loading = "eager";
            nudge!.unobserve(im);
          }
        },
        { rootMargin: "600px 0px" },
      );
      lazyImgs.forEach((im) => nudge!.observe(im));
    } else {
      lazyImgs.forEach((im) => (im.loading = "eager"));
    }

    const preload = (i: number) => {
      const w = wrap(i);
      if (broken.has(w)) return;
      const src = fullSrc(w);
      if (!src) return;
      const p = new Image();
      p.decoding = "async";
      p.src = src;
    };

    const show = (i: number, step = 1) => {
      let w = wrap(i);
      let guard = 0;
      while (broken.has(w) && guard++ < count) w = wrap(w + step);
      if (broken.has(w)) return;
      current = w;
      tier = 0;
      msg.hidden = true;
      img.style.visibility = "";
      img.src = fullSrc(w);
      const holder = creditOf(byIndex[w]);
      const title = sentence(describe(byIndex[w]) || titleOf(byIndex[w]));
      const credit = holder?.dataset.dlCredit;
      img.alt = `${title ? `${title} ` : ""}Photo ${w + 1} of ${total}`;
      counter.textContent = `${w + 1} of ${total}${credit ? ` · ${credit}` : ""}`;
      msgLink.href = holder?.dataset.dlAlbum || albumFallback;
      preload(w + 1);
      preload(w - 1);
    };

    // A failed load steps down the rendition ladder for the SAME photo; when
    // every size fails the viewer says so and stays put (prev/next still
    // work). It never advances on its own, so one bad response cannot cascade
    // through the album.
    img.addEventListener("error", () => {
      if (current < 0 || lb.hidden) return;
      const list = sources(current);
      tier += 1;
      if (tier < list.length) {
        img.src = list[tier];
        return;
      }
      img.style.visibility = "hidden";
      msg.hidden = false;
    });
    img.addEventListener("load", () => {
      msg.hidden = true;
      img.style.visibility = "";
    });

    const open = (i: number, trigger: HTMLElement) => {
      opener = trigger;
      lb.hidden = false;
      document.documentElement.style.overflow = "hidden";
      document.body.style.overflow = "hidden";
      show(i, 1);
      closeBtn.focus();
      if (!tracked) {
        tracked = true;
        (window as any).trackConversion?.("ddlm_gallery_open", {
          event_category: "ddlm_recap",
          context: "ddlm_page_photos",
        });
      }
    };

    const close = () => {
      lb.hidden = true;
      current = -1;
      document.documentElement.style.overflow = "";
      document.body.style.overflow = "";
      img.removeAttribute("src");
      // Return focus to the photo that opened the viewer.
      opener?.focus();
      opener = null;
    };

    byIndex.forEach((b, i) => b.addEventListener("click", () => open(i, b)));
    prevBtn.addEventListener("click", () => show(current - 1, -1));
    nextBtn.addEventListener("click", () => show(current + 1, 1));
    closeBtn.addEventListener("click", close);
    lb.addEventListener("click", (e) => {
      if (e.target === lb || e.target === stage) close();
    });

    document.addEventListener("keydown", (e) => {
      if (lb.hidden) return;
      if (e.key === "Escape") {
        e.preventDefault();
        close();
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        show(current + 1, 1);
      } else if (e.key === "ArrowLeft") {
        e.preventDefault();
        show(current - 1, -1);
      } else if (e.key === "Tab") {
        // Focus stays inside the dialog while it is open.
        const f = [closeBtn, prevBtn, nextBtn];
        const pos = f.indexOf(document.activeElement as HTMLButtonElement);
        e.preventDefault();
        const off = e.shiftKey ? -1 : 1;
        const next = pos < 0 ? 0 : (((pos + off) % f.length) + f.length) % f.length;
        f[next].focus();
      }
    });

    // Horizontal swipe; mostly-vertical gestures are ignored.
    let tx = 0;
    let ty = 0;
    lb.addEventListener(
      "touchstart",
      (e) => {
        const t = e.changedTouches[0];
        tx = t.clientX;
        ty = t.clientY;
      },
      { passive: true },
    );
    lb.addEventListener(
      "touchend",
      (e) => {
        const t = e.changedTouches[0];
        const dx = t.clientX - tx;
        const dy = t.clientY - ty;
        if (Math.abs(dx) < 44 || Math.abs(dx) < Math.abs(dy)) return;
        show(current + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
      },
      { passive: true },
    );

    // Per-chapter expanders: reveal that chapter's hidden cells (never the
    // ones retired as broken) and move focus to the first new photo.
    root.querySelectorAll<HTMLButtonElement>("[data-dl-expand]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const wall = btn.closest<HTMLElement>("[data-dl-wall]");
        if (!wall) return;
        const cells = Array.from(
          wall.querySelectorAll<HTMLElement>("[data-dl-cell][hidden]"),
        ).filter((c) => c.dataset.dlBroken !== "true");
        cells.forEach((c) => (c.hidden = false));
        btn.setAttribute("aria-expanded", "true");
        btn.closest("p")?.setAttribute("hidden", "");
        cells[0]?.querySelector<HTMLButtonElement>("[data-dl-photo]")?.focus();
      });
    });
  })();
</script>
