---
// Every photo from the Día de los Muertos weekend: one square thumbnail wall
// per set, in date order (the team's Oct 28 phone photos, self-hosted; Estevan
// Cruz's Saturday frames on the Flickr CDN; the Sunday album, empty for now).
// Anything listed in ddlmStory is already on the page, so it leaves its wall.
// The Mayor's two frames are story frames and never wall thumbs. A wall with
// no photos renders nothing. First 24 visible, the rest behind an expander.
//
// Every photo is a [data-dl-photo] button; DdlmRecapLightbox (outside <main>)
// numbers them in document order at runtime, after the story's frames. Flickr
// buttons carry data-stem/data-base; self-hosted buttons carry data-set="local"
// + data-id. Each wall carries its credit, album link and title for the viewer.
//
// Data: src/data/ddlmGallery2026.js and ddlmRecap2026.js.
import {
  ddlmAlbums,
  ddlmAlbumChapters,
  ddlmCdnBase,
  ddlmLocalBase,
  ddlmMakingPhotos,
  ddlmPhotoCount,
  ddlmSaturdayPhotos,
  ddlmSundayGuestPhotos,
  ddlmSundayPhotos,
} from "@/data/ddlmGallery2026";
import { ddlmStory } from "@/data/ddlmRecap2026";

const base = import.meta.env.BASE_URL;
const WALL_VISIBLE = 24;
const localBase = `${base}${ddlmLocalBase}`;

const framesOf = (moments) => moments.flatMap((m) => m.rows.flatMap((r) => r.frames));
const inStory = new Set([
  ...ddlmStory.making,
  ...framesOf(ddlmStory.saturday).map((f) => f.t),
  ...framesOf(ddlmStory.sunday).map((f) => f.sun),
]);

// The photos of each wall, by SET.
const sets = {
  making: ddlmMakingPhotos.map((p) => ({ set: "local", p, key: p.id })),
  saturday: ddlmSaturdayPhotos.map((p) => ({ set: "flickr", p, key: p.t })),
  sunday: ddlmSundayPhotos.map((p) => ({ set: "flickr", p, key: p.t })),
};

const credit = (chapter) => {
  if (chapter.album === "team") return { line: "Photo by the LSP team", url: null };
  const album = ddlmAlbums[chapter.album];
  const who = album?.photographer?.name;
  return { line: who ? `Photo by ${who}` : "", url: album?.url ?? null };
};

const walls = ddlmAlbumChapters.flatMap((chapter) => {
  const all = sets[chapter.key] ?? [];
  if (!all.length) return [];
  return [
    {
      ...chapter,
      credit: credit(chapter),
      count: all.length,
      items: all.filter((x) => !inStory.has(x.key)),
    },
  ];
});

const rendered =
  walls.reduce((acc, w) => acc + w.items.length, 0) + inStory.size + ddlmSundayGuestPhotos.length;
if (rendered !== ddlmPhotoCount) {
  throw new Error(`DdlmRecapAlbum: page holds ${rendered} photos, album has ${ddlmPhotoCount}. Check the stems in ddlmStory.`);
}

const attrs = (x) =>
  x.set === "local"
    ? { "data-set": "local", "data-id": x.p.id }
    : { "data-stem": x.p.f, "data-base": x.p.t };

const thumbImg = (x) =>
  x.set === "local"
    ? { src: `${localBase}${x.p.id}_q.webp`, width: 320, height: 320 }
    : { src: `${ddlmCdnBase}${x.p.t}_q.jpg`, width: 150, height: 150 };
---

<div class="space-y-10 lg:space-y-14">
  {
    walls.map((wall) => (
      <article
        id={`photos-${wall.key}`}
        class="scroll-mt-32"
        aria-labelledby={`dl-wall-${wall.key}`}
        data-dl-credit={wall.credit.line}
        data-dl-album={wall.credit.url ?? undefined}
        data-dl-title={wall.time}
        data-dl-wall
      >
        <h3 id={`dl-wall-${wall.key}`} class="text-[1.125rem] font-bold text-white">{wall.time}</h3>
        <ul class="dl-wall mt-3" role="list">
          {wall.items.map((x, wi) => (
            <li class="dl-wall-cell" data-dl-cell hidden={wi >= WALL_VISIBLE}>
              <button type="button" class="dl-thumb" data-dl-photo {...attrs(x)} aria-label="View large">
                <img {...thumbImg(x)} alt="" loading="lazy" decoding="async" />
              </button>
            </li>
          ))}
        </ul>
        {wall.items.length > WALL_VISIBLE && (
          <p class="mt-4">
            <button
              type="button"
              class="dl-more inline-flex min-h-[44px] items-center text-base font-bold text-white underline decoration-[#FF7A1A] decoration-2 underline-offset-4 hover:text-[#FF7A1A]"
              data-dl-expand
              aria-expanded="false"
            >
              Show all {wall.count} photos
            </button>
          </p>
        )}
      </article>
    ))
  }
</div>

<style>
  /* Square thumbnail wall: 4 across on phones, 8 at md. */
  .dl-wall {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 3px;
  }
  @media (min-width: 768px) {
    .dl-wall {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      gap: 4px;
    }
  }
  .dl-wall-cell[hidden] {
    display: none;
  }
  .dl-thumb {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    cursor: zoom-in;
  }
  .dl-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .dl-thumb:focus-visible,
  .dl-more:focus-visible {
    outline: 2px solid #ff7a1a;
    outline-offset: 2px;
  }
</style>
