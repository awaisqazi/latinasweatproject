---
// Papel picado row (Día de los Muertos identity, src/lib/ddlmFlair.ts):
// 13 flat orange/magenta flags strung on a full-width white/40 cord along
// the TOP edge of the host. The host must be `position: relative` (and
// should clip with overflow-hidden). Fixed height per breakpoint
// (32 / 40 / 52px) with "xMidYMin slice", so phones see fewer, larger flags
// cropped at the sides, never a vertical squash; the cord is a separate
// full-width hairline so it never ends where the flags crop.
//   ground: the color the cut-outs are punched in (the host's ground).
//   sway:   each flag swings gently from its top edge (7s), each one
//           0.35s behind its left neighbor so a slow wave travels along
//           the string; only under prefers-reduced-motion: no-preference.
// Motifs (ddlmFlair.ts PICADO_MOTIFS): ring, flower, lattice, diamond and,
// on every 4th flag, a calavera.
//   size:   "md" (default, 32 / 40 / 52px) or "sm" (a thin 20 / 24px row
//           for cards: the DDLM event cards and the /links #ddlm-card).
//   cord:   CSS color of the string (default white at 40%, for dark or
//           photo grounds; pass an ink tint on cream).
// Used by /diadelosmuertos (hero art + facts band), the homepage
// #ddlm-weekend and DDLM card, /events #fall-events and /links #ddlm-card.
import { PICADO_FLAGS, PETALS_8, LATTICE, CALAVERA, diamond, r2 } from "@/lib/ddlmFlair";

interface Props {
  ground?: string;
  sway?: boolean;
  size?: "md" | "sm";
  cord?: string;
  class?: string;
}
const { ground = "#000000", sway = false, size = "md", cord, class: className } = Astro.props;
---

<div
  class:list={["pointer-events-none absolute inset-x-0 top-0 overflow-hidden", className]}
  aria-hidden="true"
>
  <div class:list={["absolute inset-x-0 top-[2px] h-px", !cord && "bg-white/40"]} style={cord ? `background:${cord}` : undefined}></div>
  <svg
    viewBox="0 0 1280 52"
    preserveAspectRatio="xMidYMin slice"
    class:list={[
      "relative mx-auto block w-full max-w-[1280px]",
      size === "sm" ? "h-5 sm:h-6" : "h-8 sm:h-10 lg:h-[52px]",
    ]}
    focusable="false"
  >
    {PICADO_FLAGS.map((f, i) => (
      <g
        class:list={[sway && "ddlm-picado-flag"]}
        style={sway ? `animation-delay: ${r2(i * 0.35 - 7)}s;` : undefined}
      >
        <path d={f.d} fill={f.fill} />
        <g transform={`translate(${f.cx} 23)`} fill={ground}>
          {f.motif === "flower" && (
            <>
              {PETALS_8.map((p) => (
                <circle cx={p.x} cy={p.y} r="2.6" />
              ))}
              <circle r="3" />
              <polygon points={diamond(-f.side, 0, 3.5)} />
              <polygon points={diamond(f.side, 0, 3.5)} />
            </>
          )}
          {f.motif === "diamond" && (
            <>
              <polygon points={diamond(0, 0, 12)} />
              <circle r="3.2" fill={f.fill} />
              <circle cx={-f.side} cy="-9" r="2" />
              <circle cx={f.side} cy="-9" r="2" />
              <circle cx={-f.side} cy="9" r="2" />
              <circle cx={f.side} cy="9" r="2" />
            </>
          )}
          {f.motif === "lattice" && (
            <>
              {LATTICE.map((p) => (
                <polygon points={diamond(p.x, p.y, 2.7)} />
              ))}
              <circle cx={-f.side} r="3" />
              <circle cx={f.side} r="3" />
            </>
          )}
          {f.motif === "calavera" && (
            <>
              <path d={CALAVERA.skull} />
              <g fill={f.fill}>
                {CALAVERA.eyes.map((e) => (
                  <circle cx={e.x} cy={e.y} r={e.r} />
                ))}
                <polygon points={CALAVERA.nose} />
                {CALAVERA.teeth.map((t) => (
                  <rect x={t.x} y={t.y} width={t.w} height={t.h} />
                ))}
              </g>
              <circle cx={-f.side} cy="-9" r="2" />
              <circle cx={-f.side} cy="9" r="2" />
              <circle cx={f.side} cy="-9" r="2" />
              <circle cx={f.side} cy="9" r="2" />
            </>
          )}
          {f.motif === "ring" && (
            <>
              <circle r="10" />
              <circle r="5.5" fill={f.fill} />
              <circle r="1.8" />
              <polygon points={diamond(-f.side, 0, 3)} />
              <polygon points={diamond(f.side, 0, 3)} />
            </>
          )}
        </g>
      </g>
    ))}
  </svg>
</div>

<style>
  /* Each flag swings from the middle of its top edge, like paper on a
     string in a light breeze; the per-flag delay (i * 0.35s) turns the
     row into one travelling wave. Static under reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .ddlm-picado-flag {
      transform-box: fill-box;
      transform-origin: 50% 0;
      animation: ddlm-picado-sway 7s ease-in-out infinite;
    }
  }
  @keyframes ddlm-picado-sway {
    0%,
    100% {
      transform: rotate(-2.5deg) translateY(0);
    }
    25% {
      transform: rotate(0deg) translateY(1px);
    }
    50% {
      transform: rotate(2.5deg) translateY(0);
    }
    75% {
      transform: rotate(0deg) translateY(-0.5px);
    }
  }
</style>
