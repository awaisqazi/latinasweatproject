---
// Tonight's honors, in program order. The four honorees with a headshot in
// public/images/gala/2026/honorees get it in a gold-keyline circle; the
// other four get the monogram tile the projector showed. Headshots are the
// only photos ever paired with an honoree name.
import { galaHonors, galaVoices } from "@/data/galaRecap2026";

const initials = (name) => {
  const words = name
    .replace(/[“”"(].*?[“”")]/g, " ")
    .split(/\s+/)
    .filter(Boolean);
  const first = words[0]?.[0] || "";
  const last = words.length > 1 ? words[words.length - 1][0] : "";
  return (first + last).toUpperCase();
};
const joinNames = (list) =>
  list.length <= 1
    ? list.join("")
    : `${list.slice(0, -1).join(", ")} and ${list[list.length - 1]}`;
---

<ol class="grid gap-5 sm:grid-cols-2 xl:grid-cols-4" role="list">
  {
    galaHonors.map((h, i) => (
      <li
        class="gala-detail-card reveal group relative flex flex-col items-center overflow-hidden rounded-2xl border border-accent-gold/20 bg-white/[0.035] px-6 pb-7 pt-8 text-center"
        style={`transition-delay: ${(i % 4) * 90}ms;`}
      >
        <span class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent-gold/50 to-transparent" aria-hidden="true" />
        <span class="pointer-events-none absolute left-2 top-2 h-4 w-4 rounded-tl border-l-2 border-t-2 border-accent-gold/55" aria-hidden="true" />
        <span class="pointer-events-none absolute right-2 top-2 h-4 w-4 rounded-tr border-r-2 border-t-2 border-accent-gold/55" aria-hidden="true" />
        <span class="pointer-events-none absolute bottom-2 left-2 h-4 w-4 rounded-bl border-b-2 border-l-2 border-accent-gold/55" aria-hidden="true" />
        <span class="pointer-events-none absolute bottom-2 right-2 h-4 w-4 rounded-br border-b-2 border-r-2 border-accent-gold/55" aria-hidden="true" />

        {h.photo ? (
          <span class="gr-honor-ring">
            <img
              src={h.photo}
              alt={h.name}
              width="112"
              height="112"
              loading="lazy"
              decoding="async"
              class="h-full w-full rounded-full object-cover"
            />
          </span>
        ) : (
          <span class="gr-honor-ring gr-honor-mono" aria-hidden="true">
            <span class="font-display text-3xl font-bold tracking-wide text-accent-gold">
              {initials(h.name)}
            </span>
          </span>
        )}

        <p class="mt-6 text-[11px] font-extrabold uppercase tracking-[0.24em] text-accent-gold">
          {h.title}
        </p>
        <h3 class="mt-2 font-display text-2xl font-bold leading-snug text-white">{h.name}</h3>
        <span class="mt-4 h-px w-10 gala-foil-rule" aria-hidden="true" />
        <p class="mt-4 text-sm leading-relaxed text-white/65">{h.description}</p>
      </li>
    ))
  }
</ol>

<div class="reveal mx-auto mt-14 max-w-4xl text-center">
  <div class="flex items-center justify-center gap-3" aria-hidden="true">
    <span class="h-px w-12 gala-foil-rule"></span>
    <span class="h-1.5 w-1.5 rotate-45 bg-accent-gold"></span>
    <span class="h-px w-12 gala-foil-rule"></span>
  </div>
  <div class="mt-8 grid gap-8 sm:grid-cols-3 sm:gap-6">
    <div class="sm:col-span-3">
      <p class="text-[11px] font-extrabold uppercase tracking-[0.28em] text-accent-gold">Featured voices</p>
      <ul class="mt-3 flex flex-wrap justify-center gap-x-7 gap-y-1 font-display text-xl leading-relaxed text-white sm:text-2xl" role="list">
        {galaVoices.featured.map((name) => <li class="whitespace-nowrap">{name}</li>)}
      </ul>
    </div>
    <div class="sm:col-start-1 sm:col-span-3 sm:mx-auto sm:grid sm:w-full sm:max-w-2xl sm:grid-cols-2 sm:gap-6">
      <div>
        <p class="text-[11px] font-extrabold uppercase tracking-[0.28em] text-accent-gold">Founder's remarks</p>
        <p class="mt-3 font-display text-xl text-white">{galaVoices.founderRemarks}</p>
      </div>
      <div class="mt-8 sm:mt-0">
        <p class="text-[11px] font-extrabold uppercase tracking-[0.28em] text-accent-gold">MCs</p>
        <p class="mt-3 font-display text-xl text-white">{joinNames(galaVoices.mcs)}</p>
      </div>
    </div>
  </div>
</div>

<style>
  .gr-honor-ring {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 7rem;
    height: 7rem;
    border-radius: 9999px;
    padding: 4px;
    background: #0b1320;
    box-shadow:
      0 0 0 1.5px #ffbd59,
      0 0 0 5px rgba(11, 19, 32, 1),
      0 0 0 6px rgba(255, 189, 89, 0.35),
      0 18px 40px -18px rgba(255, 189, 89, 0.45);
  }
  .gr-honor-mono {
    background: radial-gradient(circle at 50% 35%, #1b2a40, #0b1320 72%);
  }
</style>
