---
// The night in photos: the whole album from BOTH photographers (the colour
// Flickr set and the second camera's black-and-white set, self-hosted), in
// five clock-ordered chapters. Each chapter merges the two sets by capture
// time, opens with an editorial mosaic of six hand-picked frames (Flickr _c
// 800px or the black-and-white _c.webp), then a square thumb wall of the rest
// (first 16 visible, the remainder behind a per-chapter expander). Every
// photo is a button carrying one global index in RENDERED order, which is
// the order the shared lightbox (RecapLightbox, outside <main>) walks.
// Flickr buttons carry data-stem/data-base; black-and-white buttons carry
// data-set="bw" + data-id (renditions under galaBwBase).
import {
  galaAlbumCdnBase,
  galaAlbumChapters,
  galaAllPhotoCount,
  galaPhotoStems,
} from "@/data/galaGallery2026";
import { galaBwBase, galaBwPhotos, galaClockKey } from "@/data/galaGallery2026bw";
import { galaRecapPhotos } from "@/data/galaRecap2026";

const total = galaAllPhotoCount;
const WALL_VISIBLE = 16;
const cdn = galaAlbumCdnBase;

// One list, both sets. `key` identifies a photo for lead matching.
const SET_ORDER = { flickr: 0, bw: 1 };
const everything = [
  ...galaPhotoStems.map((p, i) => ({ set: "flickr", p, i, key: `f:${i}` })),
  ...galaBwPhotos.map((p, i) => ({ set: "bw", p, i, key: `bw:${p.id}` })),
];

// Clock order inside a chapter (after midnight sorts last); ties go colour
// set first, then each set's own order.
const byClock = (a, b) =>
  galaClockKey(a.p.at).localeCompare(galaClockKey(b.p.at)) ||
  SET_ORDER[a.set] - SET_ORDER[b.set] ||
  a.i - b.i;

// A lead pick is `{ i }` (colour album index) or `{ bw: "<camera id>" }`.
const pickKey = (l) => (l.bw ? `bw:${l.bw}` : `f:${l.i}`);

let running = 0;
const chapters = galaAlbumChapters.map((chapter) => {
  const all = everything.filter((x) => x.p.c === chapter.key).sort(byClock);
  const picks = galaRecapPhotos.leads[chapter.key] || [];
  const leadSet = new Set(picks.map(pickKey));
  const bigSet = new Set(picks.filter((l) => l.big).map(pickKey));
  const leads = all.filter((x) => leadSet.has(x.key));
  if (leads.length !== picks.length) {
    throw new Error(`RecapAlbum: a lead in "${chapter.key}" is not in that chapter`);
  }
  const wall = all.filter((x) => !leadSet.has(x.key));
  const withIndex = (list, kind) =>
    list.map((x) => ({
      ...x,
      g: running++,
      kind,
      big: bigSet.has(x.key),
    }));
  const leadItems = withIndex(leads, "lead");
  const wallItems = withIndex(wall, "wall");
  return { ...chapter, count: all.length, leadItems, wallItems };
});

if (running !== total) {
  throw new Error(`RecapAlbum: rendered ${running} photos, album has ${total}`);
}

// Per-set rendering details for one photo.
const attrs = (x) =>
  x.set === "bw"
    ? { "data-set": "bw", "data-id": x.p.id }
    : { "data-stem": x.p.f, "data-base": x.p.t };
const mosaicImg = (x) =>
  x.set === "bw"
    ? { src: `${galaBwBase}${x.p.id}_c.webp`, width: x.p.w, height: x.p.h }
    : {
        src: `${cdn}${x.p.t}_c.jpg`,
        width: x.p.o === "p" ? 533 : 800,
        height: x.p.o === "p" ? 800 : 533,
      };
const thumbImg = (x) =>
  x.set === "bw"
    ? { src: `${galaBwBase}${x.p.id}_q.webp`, width: 320, height: 320 }
    : { src: `${cdn}${x.p.t}_q.jpg`, width: 150, height: 150 };
---

<div class="space-y-20 sm:space-y-24">
  {
    chapters.map((chapter, ci) => (
      <article class="gr-chapter" aria-labelledby={`gr-chapter-${chapter.key}`}>
        <header class="reveal grid gap-4 border-t border-accent-gold/25 pt-7 sm:grid-cols-[auto_1fr] sm:items-end sm:gap-10">
          <div>
            <p class="flex items-center gap-3 text-xs font-extrabold uppercase tracking-[0.3em] text-accent-gold">
              <span class="h-1.5 w-1.5 rotate-45 bg-accent-gold" aria-hidden="true"></span>
              {chapter.time}
              <span class="text-white/35">·</span>
              <span class="text-white/55">Chapter {ci + 1}</span>
            </p>
            <h3
              id={`gr-chapter-${chapter.key}`}
              class="mt-3 font-display text-3xl font-bold leading-tight tracking-tight text-white sm:text-4xl"
            >
              {chapter.title}
            </h3>
          </div>
          <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-1 sm:pb-1">
            <p class="max-w-xl text-base leading-relaxed text-white/65">{chapter.detail}</p>
            <p class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] font-extrabold uppercase tracking-[0.26em] text-white/45">
              {chapter.key === "afterdark" && (
                <a
                  href="/gala/fashion-show"
                  class="link-underline text-accent-gold hover:text-white"
                  data-conversion-event="gala_runway_open"
                  data-conversion-context="gala_album_chapter"
                >
                  Watch the runway replay &rarr;
                </a>
              )}
              <span>{chapter.count} photos</span>
            </p>
          </div>
        </header>

        <div class="gr-mosaic-wrap mt-7">
          <ul class="gr-mosaic" role="list">
            {chapter.leadItems.map((x) => (
              <li
                class:list={[
                  "gr-tile",
                  x.big && "is-big",
                  !x.big && x.p.o === "p" && "is-tall",
                ]}
                data-gr-cell
              >
                <button
                  type="button"
                  class="gr-photo gr-tile-btn"
                  data-gr-photo
                  data-index={x.g}
                  {...attrs(x)}
                  aria-label={`Photo ${x.g + 1} of ${total}, view large`}
                >
                  <img
                    {...mosaicImg(x)}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              </li>
            ))}
          </ul>
        </div>

        {chapter.wallItems.length > 0 && (
          <div class="mt-3" data-gr-wall>
            <ul class="gr-wall" role="list">
              {chapter.wallItems.map((x, wi) => (
                <li class="gr-wall-cell" data-gr-cell hidden={wi >= WALL_VISIBLE}>
                  <button
                    type="button"
                    class="gr-photo gr-thumb"
                    data-gr-photo
                    data-index={x.g}
                    {...attrs(x)}
                    aria-label={`Photo ${x.g + 1} of ${total}, view large`}
                  >
                    <img
                      {...thumbImg(x)}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  </button>
                </li>
              ))}
            </ul>
            {chapter.wallItems.length > WALL_VISIBLE && (
              <p class="mt-6 text-center">
                <button
                  type="button"
                  class="gala-btn gala-btn--ghost inline-flex items-center justify-center gap-3 px-6 py-3 text-sm font-extrabold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-gold focus-visible:ring-offset-2 focus-visible:ring-offset-[#0b1320]"
                  data-gr-expand
                  aria-expanded="false"
                >
                  Show all {chapter.count} from this chapter
                  <svg class="h-4 w-4 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
              </p>
            )}
          </div>
        )}
      </article>
    ))
  }
</div>

<style>
  /* Editorial lead mosaic. Cells are 3:2 (row height derived from the
     container width via container query units), so a landscape frame fills
     a 1x1 or 2x2 exactly and a portrait sits in a 1x2 at 3:4. */
  .gr-mosaic-wrap {
    container-type: inline-size;
  }
  .gr-mosaic {
    --gap: 6px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: calc((100cqi - var(--gap)) / 2 * 2 / 3);
    gap: var(--gap);
  }
  @media (min-width: 768px) {
    .gr-mosaic {
      --gap: 8px;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: calc((100cqi - 3 * var(--gap)) / 4 * 2 / 3);
    }
  }
  .gr-tile.is-big {
    grid-column: span 2;
    grid-row: span 2;
  }
  .gr-tile.is-tall {
    grid-row: span 2;
  }
  .gr-tile-btn {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 2px;
    background: #121c2b;
    cursor: zoom-in;
  }
  .gr-tile-btn img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s cubic-bezier(0.25, 0.8, 0.25, 1), filter 0.4s ease;
    filter: saturate(0.94);
  }
  .gr-tile-btn::after {
    content: "";
    position: absolute;
    inset: 7px;
    border: 1px solid rgba(255, 189, 89, 0);
    transition: border-color 0.35s ease;
    pointer-events: none;
  }
  .gr-tile-btn:hover img {
    transform: scale(1.035);
    filter: saturate(1.05);
  }
  .gr-tile-btn:hover::after,
  .gr-tile-btn:focus-visible::after {
    border-color: rgba(255, 243, 216, 0.7);
  }
  .gr-tile-btn:focus-visible {
    outline: 2px solid #ffbd59;
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .gr-tile-btn img {
      transition: none;
    }
    .gr-tile-btn:hover img {
      transform: none;
    }
  }

  /* Square thumb wall: 4 across on phones, 8 on desktop. Each cell carries a
     0.75px gold-tint padding, so neighbours meet in a 1.5px gold hairline
     and a short last row never shows an empty tinted slot. */
  .gr-wall {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  @media (min-width: 768px) {
    .gr-wall {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }
  }
  .gr-wall-cell {
    padding: 0.75px;
    background: rgba(255, 189, 89, 0.26);
  }
  .gr-wall-cell[hidden] {
    display: none;
  }
  .gr-thumb {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #121c2b;
    cursor: zoom-in;
  }
  .gr-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.9;
    transition: opacity 0.25s ease, transform 0.4s ease;
  }
  .gr-thumb:hover img {
    opacity: 1;
    transform: scale(1.05);
  }
  .gr-thumb:focus-visible {
    outline: 2px solid #ffbd59;
    outline-offset: -2px;
  }
  .gr-thumb:focus-visible img {
    opacity: 1;
  }
</style>
