---
import { galaAllPhotoCount } from "@/data/galaGallery2026";
// La Constelación del Runway: the player's last screen. The paddle raise on
// the projector turned every gift into a gold star in the glowing LSP X;
// here the twenty looks do the same. Star positions are computed at build
// time (no runtime randomness): looks 1 to 10 run down the first stroke of
// the X, looks 11 to 20 down the second, leaving the crossing open. Each
// star is a real button that reopens its look (see RunwayPlayer's script).
import {
  runwayLooks,
  runwayFinale,
  runwayDesigners,
  runwayPhotoCount,
} from "./runwayData";

const VB = 600;
const C = VB / 2;
const END = 44; // stroke ends sit this far in from the corners

// Two strokes: A (top-left to bottom-right), B (top-right to bottom-left).
const strokes = [
  { from: [END, END], to: [VB - END, VB - END] },
  { from: [VB - END, END], to: [END, VB - END] },
];
// Ten slots per stroke, five either side of the crossing.
const slotsT = [0.03, 0.13, 0.23, 0.33, 0.43, 0.57, 0.67, 0.77, 0.87, 0.97];

// Small seeded wobble off the stroke so the X reads as a constellation.
function mulberry32(seed) {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = mulberry32(20260925);

const perStroke = Math.ceil(runwayLooks.length / 2);
const stars = runwayLooks.map((look, k) => {
  const s = strokes[Math.floor(k / perStroke)];
  const t = slotsT[k % perStroke] ?? (k % perStroke) / perStroke;
  const dx = s.to[0] - s.from[0];
  const dy = s.to[1] - s.from[1];
  const len = Math.hypot(dx, dy);
  const nx = -dy / len;
  const ny = dx / len;
  const wob = (rand() - 0.5) * 16;
  const x = s.from[0] + dx * t + nx * wob;
  const y = s.from[1] + dy * t + ny * wob;
  // Numeral sits on the outer side of the stroke.
  const side = k % 2 === 0 ? 1 : -1;
  return {
    k,
    look,
    x: +x.toFixed(1),
    y: +y.toFixed(1),
    lx: +(x + nx * 24 * side).toFixed(1),
    ly: +(y + ny * 24 * side + 5).toFixed(1),
    r: 6.5 + rand() * 1.5,
  };
});
const pct = (v) => `${((v / VB) * 100).toFixed(3)}%`;
const label = "La Constelación del Runway: twenty gold stars along the two strokes of the LSP X, one for each look.";
---

<section class="rw-sky" data-rw-sky hidden aria-labelledby="rw-sky-title">
  <div class="rw-sky-dust" aria-hidden="true"></div>
  <button type="button" class="rw-icon-btn rw-sky-close" data-rw-close aria-label="Close the show">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
  </button>

  <div class="rw-sky-inner">
    <p class="rw-caps text-accent-gold">The finale</p>
    <h2 id="rw-sky-title" tabindex="-1" class="rw-sky-title font-display">
      <span class="gala-foil">La Constelación del Runway</span>
    </h2>
    <p class="rw-sky-lede">Twenty looks, twenty stars in the glowing X. Tap a star to see that look again.</p>

    <div class="rw-x" data-rw-x>
      <div class="rw-x-halo" aria-hidden="true"></div>
      <svg class="rw-x-svg" viewBox={`0 0 ${VB} ${VB}`} role="img" aria-label={label}>
        <defs>
          <radialGradient id="rw-star-halo">
            <stop offset="0" stop-color="#ffd48a" stop-opacity="0.85" />
            <stop offset="0.35" stop-color="#ffbd59" stop-opacity="0.3" />
            <stop offset="1" stop-color="#ffbd59" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="rw-star-core">
            <stop offset="0" stop-color="#fffaf0" />
            <stop offset="0.55" stop-color="#ffe2a8" />
            <stop offset="1" stop-color="#ffbd59" />
          </radialGradient>
          <linearGradient id="rw-stroke-a" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#ffbd59" stop-opacity="0.1" />
            <stop offset="0.5" stop-color="#ffbd59" stop-opacity="1" />
            <stop offset="1" stop-color="#ffbd59" stop-opacity="0.1" />
          </linearGradient>
          <linearGradient id="rw-stroke-b" x1="1" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ffbd59" stop-opacity="0.1" />
            <stop offset="0.5" stop-color="#ffbd59" stop-opacity="1" />
            <stop offset="1" stop-color="#ffbd59" stop-opacity="0.1" />
          </linearGradient>
          <filter id="rw-soft" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="14" />
          </filter>
        </defs>
        <g aria-hidden="true">
          {strokes.map((s, i) => (
            <line x1={s.from[0]} y1={s.from[1]} x2={s.to[0]} y2={s.to[1]} stroke={`url(#rw-stroke-${i ? "b" : "a"})`} stroke-width="60" stroke-linecap="round" opacity="0.2" filter="url(#rw-soft)" />
          ))}
          {strokes.map((s, i) => (
            <line class="rw-x-line" style={`--d:${i * 0.35}s`} pathLength="1" x1={s.from[0]} y1={s.from[1]} x2={s.to[0]} y2={s.to[1]} stroke={`url(#rw-stroke-${i ? "b" : "a"})`} stroke-width="1" opacity="0.55" />
          ))}
          <circle cx={C} cy={C} r="20" fill="none" stroke="#ffbd59" stroke-opacity="0.35" stroke-width="0.9" />
          <rect x={C - 3.5} y={C - 3.5} width="7" height="7" fill="#ffbd59" opacity="0.6" transform={`rotate(45 ${C} ${C})`} />
        </g>
        <g aria-hidden="true">
          {stars.map((s) => (
            <g class="rw-star" style={`--i:${s.k};transform-origin:${s.x}px ${s.y}px;`}>
              <circle cx={s.x} cy={s.y} r={(s.r * 3.6).toFixed(2)} fill="url(#rw-star-halo)" opacity="0.75" />
              <circle cx={s.x} cy={s.y} r={s.r.toFixed(2)} fill="url(#rw-star-core)" />
              <text x={s.lx} y={s.ly} text-anchor="middle" class="rw-star-num">{s.look.num}</text>
            </g>
          ))}
        </g>
      </svg>
      <ul class="rw-x-hits" role="list">
        {stars.map((s) => (
          <li style={`left:${pct(s.x)};top:${pct(s.y)};`}>
            <button type="button" class="rw-star-btn" data-rw-star={s.k} aria-label={`Replay look ${s.look.n}`}>
              <span class="rw-star-tip" aria-hidden="true">
                <img data-src={s.look.heroPhoto.c} alt="" width="533" height="800" draggable="false" />
                <span class="rw-star-tip-label">Look <span class="rw-didot">{s.look.num}</span></span>
              </span>
            </button>
          </li>
        ))}
      </ul>
    </div>

    <figure class="rw-group">
      <div class="rw-group-frame rw-brackets">
        <span></span><span></span><span></span><span></span>
        <img src={runwayFinale.group.b} alt={runwayFinale.group.alt} width="1024" height="683" loading="lazy" decoding="async" draggable="false" />
      </div>
    </figure>

    <h3 class="rw-thanks-title font-display">Gracias to the designers</h3>
    <ul class="rw-thanks" role="list">
      {runwayDesigners.map((d) => (
        <li>
          <a
            href={d.instagram}
            target="_blank"
            rel="noopener"
            class="rw-thanks-tag rw-tag rw-tag--top"
            data-conversion-event="gala_runway_designer_click"
            data-conversion-context="runway_finale"
          >
            <span class="rw-tag__eyelet"></span>
            {d.logoOnCream ? (
              <img src={d.logo} alt="" loading="lazy" decoding="async" draggable="false" />
            ) : (
              <span class="rw-thanks-name">{d.name}</span>
            )}
            <span class="sr-only">{d.name} on Instagram (opens in a new tab)</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="rw-sky-actions">
      <button type="button" class="gala-btn gala-btn--gold inline-flex items-center justify-center gap-3 px-7 py-4 text-base font-extrabold" data-rw-again data-conversion-event="gala_runway_replay">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7" /><path d="M3 4v5h5" /></svg>
        Watch again
      </button>
      <button type="button" class="gala-btn gala-btn--ghost inline-flex items-center justify-center gap-3 px-7 py-4 text-base font-extrabold" data-rw-browse>
        Browse the looks
      </button>
      <a href="/gala" class="gala-btn gala-btn--ghost inline-flex items-center justify-center gap-3 px-7 py-4 text-base font-extrabold">
        Back to the gala recap
      </a>
    </div>
    <p class="mt-7 text-center">
      <a href="/gala#photos" class="rw-sky-link">See all {galaAllPhotoCount} photos</a>
    </p>
  </div>
</section>

<style>
  .rw-sky {
    position: fixed;
    inset: 0;
    z-index: 30;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y;
    background:
      radial-gradient(70% 45% at 50% 22%, rgba(255, 189, 89, 0.1), transparent 70%),
      linear-gradient(180deg, #05070c 0%, #0b1320 45%, #05070c 100%);
    opacity: 0;
    transition: opacity 0.45s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .rw-sky {
      transition: none;
    }
  }
  .rw-sky[hidden] {
    display: none;
  }
  .rw-sky:global(.is-on) {
    opacity: 1;
  }
  .rw-sky-dust {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(1px 1px at 12% 18%, rgba(255, 243, 216, 0.5), transparent),
      radial-gradient(1px 1px at 82% 9%, rgba(255, 243, 216, 0.4), transparent),
      radial-gradient(1px 1px at 91% 44%, rgba(255, 243, 216, 0.35), transparent),
      radial-gradient(1px 1px at 6% 52%, rgba(255, 243, 216, 0.35), transparent),
      radial-gradient(1.5px 1.5px at 30% 36%, rgba(255, 243, 216, 0.3), transparent),
      radial-gradient(1px 1px at 68% 30%, rgba(255, 243, 216, 0.3), transparent);
  }
  .rw-sky-close {
    position: fixed;
    z-index: 2;
    border: 1px solid rgba(255, 189, 89, 0.45);
    background: rgba(5, 7, 12, 0.7);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    top: calc(env(safe-area-inset-top, 0px) + 10px);
    right: calc(env(safe-area-inset-right, 0px) + 10px);
  }
  .rw-sky-inner {
    position: relative;
    margin: 0 auto;
    max-width: 44rem;
    padding: calc(env(safe-area-inset-top, 0px) + 4.25rem) 1rem calc(env(safe-area-inset-bottom, 0px) + 3.5rem);
    text-align: center;
  }
  .rw-sky-title {
    margin-top: 0.6rem;
    font-size: clamp(2.1rem, 9vw, 3.6rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.01em;
    outline: none;
    text-wrap: balance;
  }
  .rw-sky-title .gala-foil {
    padding: 0 0.06em 0.08em;
  }
  .rw-sky-lede {
    margin: 0.9rem auto 0;
    max-width: 26rem;
    font-size: 0.98rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.72);
    text-wrap: balance;
  }

  /* The X: SVG art + an overlay of real buttons at the same positions. */
  .rw-x {
    position: relative;
    margin: 1.6rem auto 0;
    width: min(100%, 30rem, 62vh);
    aspect-ratio: 1;
  }
  .rw-x-halo {
    position: absolute;
    inset: 12%;
    border-radius: 9999px;
    background: radial-gradient(circle, rgba(255, 189, 89, 0.16), transparent 68%);
    filter: blur(10px);
  }
  .rw-x-svg {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .rw-star-num {
    font-family: "Didot", "Bodoni 72", "Playfair Display", serif;
    font-style: italic;
    font-size: 19px;
    fill: rgba(255, 243, 216, 0.62);
  }
  .rw-x-hits {
    position: absolute;
    inset: 0;
  }
  .rw-x-hits li {
    position: absolute;
    width: 0;
    height: 0;
  }
  .rw-star-btn {
    position: absolute;
    left: -21px;
    top: -21px;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 0;
    background: transparent;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .rw-star-btn:focus-visible {
    outline: 2px solid #ffbd59;
    outline-offset: -4px;
  }
  .rw-star-btn:hover {
    background: radial-gradient(circle, rgba(255, 243, 216, 0.22), transparent 70%);
  }
  .rw-star-tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 6px);
    z-index: 5;
    display: none;
    width: 5.5rem;
    padding: 0.3rem 0.3rem 0.35rem;
    transform: translateX(-50%);
    background: linear-gradient(180deg, #fffcf6, #f4ecdf);
    border-radius: 4px;
    box-shadow:
      0 0 0 1px rgba(255, 189, 89, 0.6),
      0 16px 30px -12px rgba(0, 0, 0, 0.8);
    pointer-events: none;
  }
  .rw-star-tip img {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: 2px;
    background: #111a27;
  }
  .rw-star-tip-label {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.55rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8a5700;
  }
  .rw-star-tip-label .rw-didot {
    font-size: 0.95rem;
    letter-spacing: 0;
    color: #1e1e1e;
    text-transform: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .rw-star-btn:hover .rw-star-tip {
      display: block;
    }
  }
  .rw-star-btn:focus-visible .rw-star-tip {
    display: block;
  }

  /* Assembly: the strokes draw, then the stars arrive one by one. */
  @media (prefers-reduced-motion: no-preference) {
    .rw-x:global(.is-assembling) .rw-x-line {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: rw-draw 0.9s cubic-bezier(0.5, 0, 0.2, 1) var(--d, 0s) forwards;
    }
    .rw-x:global(.is-assembling) .rw-star {
      opacity: 0;
      animation: rw-star-in 0.7s cubic-bezier(0.3, 0, 0.2, 1.3) calc(0.7s + var(--i) * 0.11s) forwards;
    }
    .rw-x:global(.is-assembling) .rw-star circle:last-of-type {
      animation: rw-twinkle 4.2s ease-in-out calc(3.4s + var(--i) * 0.17s) infinite;
    }
  }
  @keyframes rw-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes rw-star-in {
    0% {
      opacity: 0;
      transform: scale(0.2);
    }
    60% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes rw-twinkle {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.7;
    }
  }

  .rw-group {
    margin: 2.6rem auto 0;
    max-width: 38rem;
    padding: 0 0.5rem;
  }
  .rw-group-frame {
    position: relative;
    padding: 5px;
    border: 1px solid rgba(255, 189, 89, 0.45);
    border-radius: 2px;
    background: #0b1320;
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.9);
  }
  .rw-group-frame img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: #111a27;
  }

  .rw-thanks-title {
    margin-top: 2.8rem;
    font-size: clamp(1.6rem, 6vw, 2.2rem);
    font-style: italic;
    font-weight: 600;
    color: #fff;
  }
  .rw-thanks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 0.85rem;
    margin: 1.4rem auto 0;
    max-width: 34rem;
  }
  @media (min-width: 640px) {
    .rw-thanks {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
  .rw-thanks-tag {
    display: flex;
    width: 100%;
    height: 5.6rem;
    justify-content: center;
    padding: 1.4rem 0.9rem 0.65rem;
    transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1), box-shadow 0.3s ease;
  }
  .rw-thanks-tag img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .rw-thanks-name {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #1e1e1e;
  }
  .rw-thanks-tag:hover {
    transform: translateY(-2px) rotate(-1deg);
    box-shadow:
      0 0 0 1.5px #ffbd59,
      0 16px 28px -12px rgba(0, 0, 0, 0.8);
  }
  .rw-thanks-tag:focus-visible {
    outline: 2px solid #ffbd59;
    outline-offset: 3px;
  }

  .rw-sky-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 2.6rem auto 0;
    max-width: 22rem;
  }
  @media (min-width: 640px) {
    .rw-sky-actions {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      max-width: none;
    }
  }
  .rw-sky-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
    text-decoration: underline;
    text-decoration-color: rgba(255, 189, 89, 0.5);
    text-underline-offset: 6px;
  }
  .rw-sky-link:hover {
    color: #ffbd59;
  }
</style>
