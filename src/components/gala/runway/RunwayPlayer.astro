  .rw-icon-btn .rw-ico-play {
    display: none;
  }
  .rw-icon-btn[aria-pressed="true"] .rw-ico-play {
    display: block;
  }
  .rw-icon-btn[aria-pressed="true"] .rw-ico-pause {
    display: none;
  }

  /* Caption. */
  .rw-caption {
    position: absolute;
    left: calc(env(safe-area-inset-left, 0px) + 18px);
    /* The box hugs its text and leaves the bottom-right corner to the
       next-look peek. */
    right: auto;
    max-width: calc(100% - env(safe-area-inset-left, 0px) - env(safe-area-inset-right, 0px) - 168px);
    bottom: calc(env(safe-area-inset-bottom, 0px) + 22px);
    pointer-events: none;
    z-index: 3;
  }
  .rw-caption-look {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.4rem;
    line-height: 1;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.55);
  }
  .rw-caption-look [data-rw-capword] {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #ffbd59;
  }
  .rw-caption-look .rw-didot {
    font-size: 3.4rem;
    color: #fff;
  }
  /* The beat label: "Walking out", "The look", "The back" or
     "Black and white". */
  .rw-caption-beat {
    white-space: nowrap;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
  }
  .rw-caption-sep {
    margin-right: 0.15rem;
    color: #ffbd59;
  }
  .rw-caption-beat[hidden],
  .rw-caption-hint[hidden] {
    display: none;
  }
  .rw-caption-hint {
    margin-top: 0.45rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.78);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
  }
  /* Flip cue: a small cream tag centred above the caption row, so it never
     meets the caption (bottom left) or the next-look peek (bottom right).
     --rw-cap-h is the caption's live height, set by the script. */
  .rw-flipcue {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 22px + var(--rw-cap-h, 56px) + 14px);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    padding: 0.45rem 0.75rem 0.45rem 0.6rem;
    border-radius: 999px;
    color: #1e1e1e;
    background: linear-gradient(180deg, #fffcf6 0%, #f4ecdf 55%, #efe3d0 100%);
    box-shadow:
      0 0 0 1px rgba(255, 189, 89, 0.55),
      0 10px 22px -10px rgba(0, 0, 0, 0.75);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
