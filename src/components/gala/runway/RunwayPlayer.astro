---
// The Runway player: a full-screen modal <dialog> that replays the show one
// look at a time, every look in the same fixed grammar:
//   1. "Walking out": one distant walk-out frame (900 ms, a hard cut with a
//      slow push-in). Looks without a walk frame skip this beat.
//   2. "The look": the close-up the show holds on (3 s), with the
//      photographer's flash, crowd flashes and the next-look peek.
// One progress segment per beat. A look has up to three faces, in order:
// the front (always), "The back" (a back view from the main camera, when
// there is one) and "Black and white" (the same look from the second
// photographer's camera, when there is one). Tapping the stage (or the flip
// button, F, Enter) turns the look over like a card to the next face and
// cycles front, back, black and white, front, skipping missing faces; any
// face but the front pauses autoplay. Looks with only a front ignore stage
// taps (the tag just nudges). Vertical swipes change looks, horizontal drags scrub
// the beats, press and hold pauses, and a vertical "runway track" of twenty
// gold diamonds jumps anywhere. After look 20 the finale walk plays, then
// La Constelación del Runway (RunwayConstellation).
// Vanilla TypeScript, no framework. Styles are global (rw- prefix) because
// the script builds frames and progress segments at runtime.
import RunwayConstellation from "./RunwayConstellation.astro";
import { runwayClientData, runwayLooks, pad2 } from "./runwayData";
import { galaBwCredit } from "@/data/galaGallery2026bw";

const total = runwayLooks.length;
const clientJson = JSON.stringify(runwayClientData);
---

<script is:inline type="application/json" id="rw-data" set:html={clientJson} />

<dialog id="rw-player" class="rw-player" data-mode="look" aria-label="The Runway: Annual Gala 2026 fashion show" tabindex="-1">
  <div class="rw-backdrop" aria-hidden="true">
    <img class="rw-backdrop-img" data-rw-backdrop alt="" draggable="false" />
    <div class="rw-backdrop-shade"></div>
    <div class="rw-backdrop-lattice gala-lattice"></div>
  </div>

  <p class="sr-only" aria-live="polite" aria-atomic="true" data-rw-live></p>

  <div class="rw-frame" data-rw-frame>
    {/* Keyboard and screen-reader controls: hidden until focused. */}
    <div class="rw-skip">
      <button type="button" class="rw-skip-btn" data-rw-act="prev-frame">Previous frame</button>
      <button type="button" class="rw-skip-btn" data-rw-act="next-frame">Next frame</button>
      <button type="button" class="rw-skip-btn" data-rw-act="prev-look">Previous look</button>
      <button type="button" class="rw-skip-btn" data-rw-act="next-look">Next look</button>
    </div>

    <div class="rw-stage" data-rw-stage>
      <div class="rw-reel" data-rw-reel>
        {/* The current look is a two-sided card: the front side holds the
            walk and the close-up, the reverse side holds whichever other
            face (back or black and white) is turned up. The cover layer on
            the front side briefly holds the outgoing face when the card
            turns from one reverse face to the next, so every change is a
            full card flip. */}
        <div class="rw-panel rw-panel--cur" data-rw-curpanel>
          <div class="rw-flip" data-rw-flip>
            <div class="rw-face" data-rw-cur></div>
            <div class="rw-face rw-face--over" data-rw-overface></div>
            <div class="rw-face rw-face--back" data-rw-backface></div>
          </div>
        </div>
        <div class="rw-panel rw-panel--adj" data-rw-adj hidden></div>
      </div>
      <div class="rw-flash" data-rw-flash aria-hidden="true"></div>
      <div class="rw-crowd" data-rw-crowd aria-hidden="true"></div>
      <div class="rw-sweep" data-rw-sweep aria-hidden="true"></div>
      <div class="rw-scrim-top" aria-hidden="true"></div>
      <div class="rw-scrim-bottom" aria-hidden="true"></div>
      <div class="rw-shimmer" data-rw-shimmer hidden aria-hidden="true"></div>
    </div>

    <div class="rw-edge rw-brackets" aria-hidden="true"><span></span><span></span><span></span><span></span></div>

    <div class="rw-top">
      <div class="rw-bars" data-rw-bars aria-hidden="true"></div>
      <div class="rw-row">
        <div class="rw-tagline">
          <span class="rw-ptag" data-rw-tagwrap aria-hidden="true">
            <span class="rw-ptag-string"></span>
            <span class="rw-tag rw-tag--top rw-ptag-card">
              <span class="rw-tag__eyelet"></span>
              <span class="rw-tag__word" data-rw-tagword>Look</span>
              <span class="rw-tag__num" data-rw-tagnum>01</span>
            </span>
          </span>
          <span class="rw-of rw-caps" data-rw-of aria-hidden="true">of {pad2(total)}</span>
          <span class="rw-pill rw-caps" data-rw-pill hidden>Paused</span>
        </div>
        <div class="rw-actions">
          <button type="button" class="rw-icon-btn" data-rw-act="flip" aria-pressed="false" aria-label="See the back" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="6" width="8" height="12.5" rx="1.3" fill="currentColor" /><rect x="12.5" y="6" width="8" height="12.5" rx="1.3" fill="none" stroke="currentColor" stroke-width="1.7" stroke-dasharray="2 1.6" /><path d="M7.5 4.2c1.4-1.6 7.6-1.6 9 0" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /><path d="M14.4 2.6l2.2 1.6-1.4 2.2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <button type="button" class="rw-icon-btn" data-rw-act="pause" aria-pressed="false" aria-label="Pause">
            <svg class="rw-ico-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="6.5" y="5" width="3.6" height="14" rx="0.8" fill="currentColor" /><rect x="13.9" y="5" width="3.6" height="14" rx="0.8" fill="currentColor" /></svg>
            <svg class="rw-ico-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.2v13.6L19 12z" fill="currentColor" /></svg>
          </button>
          <button type="button" class="rw-icon-btn" data-rw-act="save" aria-label="Save this look as a story card">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3.5" width="14" height="17" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M12 8v7.2M9.2 12.6l2.8 2.8 2.8-2.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <button type="button" class="rw-icon-btn" data-rw-act="share" aria-label="Share this look">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5v11M8 7.2l4-3.7 4 3.7M7.5 10.5H6a1.5 1.5 0 0 0-1.5 1.5v7A1.5 1.5 0 0 0 6 20.5h12a1.5 1.5 0 0 0 1.5-1.5v-7a1.5 1.5 0 0 0-1.5-1.5h-1.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <button type="button" class="rw-icon-btn" data-rw-close aria-label="Close the show">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          </button>
        </div>
      </div>
    </div>

    <div class="rw-caption" data-rw-caption>
      <p class="rw-caption-look"><span data-rw-capword>Look</span> <span class="rw-didot" data-rw-capnum>01</span> <span class="rw-caption-beat" data-rw-capbeat><span class="rw-caption-sep" aria-hidden="true">·</span> <span data-rw-beatword>Walking out</span></span></p>
      <p class="rw-caption-hint" data-rw-caphint hidden>Tap to turn back</p>
      <p class="rw-caption-credit" data-rw-credit hidden>
        by <a href="#" target="_blank" rel="noopener noreferrer" data-rw-creditlink><span data-rw-creditname></span><span class="sr-only"> on Instagram (opens in a new tab)</span></a>
      </p>
      {/* The second photographer, only while the black-and-white face is up. */}
      <p class="rw-caption-credit" data-rw-bwcredit hidden>
        <a href={galaBwCredit.url} target="_blank" rel="noopener noreferrer">Black and white by {galaBwCredit.handle}<span class="sr-only"> on Instagram (opens in a new tab)</span></a>
      </p>
    </div>

    {/* Flip cue: on any face of a look that has more than a front, naming the
        face a tap turns to next. Visual only (the stage takes the tap; the
        flip button serves keyboards and screen readers). */}
    <p class="rw-flipcue" data-rw-flipcue hidden aria-hidden="true">
      <svg viewBox="0 0 24 24"><rect x="3.5" y="6" width="8" height="12.5" rx="1.3" fill="currentColor" /><rect x="12.5" y="6" width="8" height="12.5" rx="1.3" fill="none" stroke="currentColor" stroke-width="1.7" stroke-dasharray="2 1.6" /><path d="M7.5 4.2c1.4-1.6 7.6-1.6 9 0" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /><path d="M14.4 2.6l2.2 1.6-1.4 2.2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <span data-rw-cuetext>Tap to see the back</span>
    </p>

    {/* Swipe cue: while the show holds on a close-up, the next tag peeks in. */}
    <button type="button" class="rw-next" data-rw-next data-rw-act="next-look" hidden>
      <span class="rw-next-word rw-caps" data-rw-nextword>Next</span>
      <span class="rw-next-num rw-didot" data-rw-nextnum>02</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 14l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>

    <nav class="rw-track" data-rw-track aria-label="Jump to a look">
      <span class="rw-track-line" aria-hidden="true"></span>
      <ol role="list">
        {runwayLooks.map((l, k) => (
          <li>
            <button type="button" class="rw-track-btn" data-rw-jump={k} aria-label={`Look ${l.n}`}>
              <span class="rw-diamond" aria-hidden="true"></span>
            </button>
          </li>
        ))}
      </ol>
    </nav>

    <div class="rw-chevrons">
      <button type="button" class="rw-icon-btn rw-chev" data-rw-act="prev-look" aria-label="Previous look">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 15l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      <button type="button" class="rw-icon-btn rw-chev" data-rw-act="next-look" aria-label="Next look">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
    </div>
  </div>

  <RunwayConstellation />

  <template data-rw-skyteaser>
    <div class="rw-teaser">
      <svg viewBox="0 0 100 100" aria-hidden="true"><path d="M20 20L80 80M80 20L20 80" stroke="#ffbd59" stroke-width="0.6" stroke-opacity="0.7" /><circle cx="50" cy="50" r="4" fill="none" stroke="#ffbd59" stroke-opacity="0.5" stroke-width="0.4" /></svg>
    </div>
  </template>

  <p class="rw-toast" role="status" data-rw-toast></p>
</dialog>

<style is:global>
  /* ============ The Runway player (global: runtime-built nodes) ============ */
  html.rw-locked,
  html.rw-locked body {
    overflow: hidden;
    overscroll-behavior: none;
  }
  .rw-player {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #05070c;
    color: #fff;
    overflow: hidden;
    overscroll-behavior: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
    outline: none;
  }
  .rw-player:not([open]) {
    display: none;
  }
  .rw-player::backdrop {
    background: #05070c;
  }

  /* Blurred, darkened copy of the current frame (desktop column, finale). */
  .rw-backdrop {
    position: absolute;
    inset: 0;
    display: none;
    overflow: hidden;
  }
  .rw-backdrop-img {
    position: absolute;
    inset: -8%;
    width: 116%;
    height: 116%;
    object-fit: cover;
    filter: blur(38px) saturate(1.15) brightness(0.42);
    transform: translateZ(0);
  }
  .rw-backdrop-shade {
    position: absolute;
    inset: 0;
    background: radial-gradient(75% 70% at 50% 45%, rgba(5, 7, 12, 0.15), rgba(5, 7, 12, 0.75));
  }
  .rw-backdrop-lattice {
    position: absolute;
    inset: 0;
    opacity: 0.05;
  }
  .rw-player[data-mode="walk"] .rw-backdrop {
    display: block;
  }

  /* Phone: the frame fills the screen. */
  .rw-frame {
    position: absolute;
    inset: 0;
  }
  .rw-stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
    touch-action: none;
    -webkit-touch-callout: none;
    cursor: pointer;
  }
  .rw-reel {
    position: absolute;
    inset: 0;
    will-change: transform;
  }
  .rw-panel {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: transparent;
  }
  .rw-panel--adj {
    background: #05070c;
  }
  /* The flip card: perspective on the panel, the two faces inside. */
  .rw-panel--cur {
    perspective: 1600px;
  }
  .rw-flip {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateY(0deg);
  }
  .rw-flip.is-flipped {
    transform: rotateY(180deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .rw-flip.is-animated {
      transition: transform 520ms cubic-bezier(0.45, 0.05, 0.25, 1);
    }
  }
  .rw-face {
    position: absolute;
    inset: 0;
    overflow: hidden;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }
  .rw-face--back {
    transform: rotateY(180deg);
    background: #05070c;
  }
  .rw-face--over {
    background: #05070c;
  }
  .rw-face--over:empty {
    display: none;
  }
  .rw-panel[hidden] {
    display: none;
  }
  .rw-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    visibility: hidden;
    transform-origin: 50% 42%;
    -webkit-user-drag: none;
    -webkit-touch-callout: none;
    pointer-events: none;
  }
  .rw-img.is-on {
    visibility: visible;
  }
  .rw-player[data-mode="walk"] .rw-panel:not(.rw-panel--adj) .rw-img,
  .rw-panel--adj.is-walk .rw-img {
    object-fit: contain;
  }
  .rw-teaser {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: radial-gradient(60% 40% at 50% 45%, rgba(255, 189, 89, 0.12), transparent 70%), #05070c;
  }
  .rw-teaser svg {
    width: min(70%, 22rem);
  }

  .rw-flash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(90% 55% at 50% 0%, rgba(255, 255, 255, 1), rgba(255, 250, 240, 0.4) 45%, rgba(255, 255, 255, 0) 75%);
  }
  /* Crowd flashes: phones going off along the runway when the hero frame
     lands. Pinpoints live in the lower half, off the center third. */
  .rw-crowd {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .rw-crowd span {
    position: absolute;
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    border-radius: 50%;
    opacity: 0;
    background: radial-gradient(circle, #fff 0 22%, rgba(255, 236, 200, 0.75) 40%, rgba(255, 189, 89, 0) 70%);
    filter: blur(0.6px);
  }
  /* Light sweep: a diagonal band of gold light crosses the stage once when
     a new look steps out, like a spotlight finding the walker. */
  .rw-sweep {
    position: absolute;
    inset: -20%;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(115deg, transparent 38%, rgba(255, 226, 168, 0.55) 49%, rgba(255, 189, 89, 0.28) 52%, transparent 62%);
    mix-blend-mode: screen;
    transform: translateX(-60%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .rw-sweep.is-on {
      animation: rw-sweep 760ms cubic-bezier(0.3, 0.7, 0.3, 1) 1;
    }
  }
  @keyframes rw-sweep {
    0% { opacity: 0; transform: translateX(-60%); }
    18% { opacity: 1; }
    100% { opacity: 0; transform: translateX(60%); }
  }
  /* Next-look peek: a small cream tag that slides up at the bottom right
     during the hero hold. Above the caption's row, clear of the track. */
  .rw-next {
    position: absolute;
    right: calc(env(safe-area-inset-right, 0px) + 14px);
    bottom: calc(env(safe-area-inset-bottom, 0px) + 24px);
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.35rem 0.7rem 0.35rem 0.85rem;
    border: 0;
    border-radius: 4px;
    color: #1e1e1e;
    background: linear-gradient(180deg, #fffcf6 0%, #f4ecdf 55%, #efe3d0 100%);
    box-shadow:
      0 0 0 1px rgba(255, 189, 89, 0.55),
      0 10px 22px -10px rgba(0, 0, 0, 0.75);
    cursor: pointer;
    opacity: 1;
    transform: none;
  }
  .rw-next[hidden] {
    display: none;
  }
  /* Before the finale the peek stacks "Up next" over "Finale", so it is no
     wider than a numbered peek. */
  .rw-next--word {
    display: inline-grid;
    grid-template-columns: auto auto;
    align-items: center;
    column-gap: 0.5rem;
    row-gap: 0.15rem;
  }
  .rw-next--word .rw-next-word {
    grid-column: 1;
    grid-row: 1;
    line-height: 1;
  }
  .rw-next--word .rw-next-num {
    grid-column: 1;
    grid-row: 2;
    font-size: 1.1rem;
  }
  .rw-next--word svg {
    grid-column: 2;
    grid-row: 1 / span 2;
  }
  .rw-next-word {
    color: #8a5700;
    font-size: 0.56rem;
  }
  .rw-next-num {
    font-size: 1.25rem;
    line-height: 1;
  }
  .rw-next svg {
    width: 16px;
    height: 16px;
    color: #8a5700;
  }
  @media (prefers-reduced-motion: no-preference) {
    .rw-next.is-in {
      animation: rw-next-in 520ms cubic-bezier(0.2, 0.9, 0.3, 1.1) both;
    }
    .rw-next svg {
      animation: rw-next-nudge 1.6s ease-in-out infinite;
    }
  }
  @keyframes rw-next-in {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes rw-next-nudge {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }
  .rw-scrim-top,
  .rw-scrim-bottom {
    position: absolute;
    inset-inline: 0;
    pointer-events: none;
  }
  .rw-scrim-top {
    top: 0;
    height: calc(env(safe-area-inset-top, 0px) + 150px);
    background: linear-gradient(180deg, rgba(5, 7, 12, 0.72), rgba(5, 7, 12, 0.35) 55%, rgba(5, 7, 12, 0));
  }
  .rw-scrim-bottom {
    bottom: 0;
    height: calc(env(safe-area-inset-bottom, 0px) + 190px);
    background: linear-gradient(0deg, rgba(5, 7, 12, 0.85), rgba(5, 7, 12, 0.4) 55%, rgba(5, 7, 12, 0));
  }
  .rw-shimmer {
    position: absolute;
    left: 30%;
    right: 30%;
    top: 50%;
    height: 2px;
    overflow: hidden;
    background: rgba(255, 189, 89, 0.25);
    pointer-events: none;
  }
  .rw-shimmer::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, #fff3d8, #ffbd59, transparent);
    transform: translateX(-100%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .rw-shimmer::after {
      animation: rw-shimmer 1.1s ease-in-out infinite;
    }
  }
  @keyframes rw-shimmer {
    to {
      transform: translateX(100%);
    }
  }
  .rw-shimmer[hidden] {
    display: none;
  }
  .rw-edge {
    display: none;
  }

  /* Top chrome. */
  .rw-top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    padding: calc(env(safe-area-inset-top, 0px) + 10px) calc(env(safe-area-inset-right, 0px) + 10px) 0 calc(env(safe-area-inset-left, 0px) + 12px);
    pointer-events: none;
    z-index: 3;
  }
  .rw-bars {
    display: flex;
    gap: 3px;
    height: 3px;
  }
  .rw-seg {
    position: relative;
    flex: 1 1 0;
    overflow: hidden;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.28);
    box-shadow: 0 0 0 0.5px rgba(0, 0, 0, 0.15);
  }
  .rw-seg-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #f4a833, #ffbd59 60%, #fff3d8);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }
  .rw-seg.is-hero {
    background: rgba(255, 243, 216, 0.4);
  }
  .rw-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
    margin-top: 10px;
  }
  .rw-tagline {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    padding-top: 6px;
  }
  .rw-ptag {
    position: relative;
    display: inline-block;
    transform-origin: 50% 0;
  }
  .rw-ptag-string {
    position: absolute;
    left: 50%;
    bottom: calc(100% - 8px);
    width: 1px;
    height: 16px;
    background: linear-gradient(180deg, rgba(255, 189, 89, 0), #ffbd59);
  }
  .rw-ptag-card {
    flex-direction: column;
    gap: 1px;
    padding: 17px 13px 6px;
    min-width: 58px;
  }
  .rw-ptag-card .rw-tag__num {
    font-size: 1.3rem;
  }
  .rw-of {
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
  }
  .rw-pill {
    padding: 5px 9px 5px 10px;
    border: 1px solid rgba(255, 189, 89, 0.7);
    border-radius: 999px;
    background: rgba(5, 7, 12, 0.72);
    color: #ffbd59;
    font-size: 0.6rem;
  }
  .rw-pill[hidden],
  .rw-of[hidden] {
    display: none;
  }
  .rw-actions {
    display: flex;
    gap: 2px;
    pointer-events: auto;
  }
  .rw-icon-btn {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #fff;
    cursor: pointer;
    filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.6));
    transition: color 0.2s ease, background-color 0.2s ease;
