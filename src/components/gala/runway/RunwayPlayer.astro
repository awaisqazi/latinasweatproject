  .rw-flipcue svg {
    width: 16px;
    height: 16px;
    color: #8a5700;
  }
  .rw-flipcue span {
    color: #8a5700;
  }
  .rw-flipcue[hidden] {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .rw-flipcue.is-in {
      animation: rw-cue-in 420ms ease-out 400ms both;
    }
  }
  @keyframes rw-cue-in {
    from { opacity: 0; transform: translate(-50%, 8px); }
    to { opacity: 1; transform: translate(-50%, 0); }
  }
  .rw-player[data-mode="walk"] .rw-caption-look .rw-didot {
    display: none;
  }
  .rw-player[data-mode="walk"] .rw-caption-look [data-rw-capword] {
    font-family: "Didot", "Bodoni 72", "Playfair Display", serif;
    font-style: italic;
    font-weight: 400;
    font-size: 2.6rem;
    letter-spacing: 0;
    text-transform: none;
    color: #fff;
  }
  .rw-caption-credit {
    margin-top: 0.4rem;
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
  }
  .rw-caption-credit a {
    pointer-events: auto;
    display: inline-block;
    padding: 0.35rem 0;
    font-weight: 700;
    color: #fff;
    text-decoration: underline;
    text-decoration-color: #ffbd59;
    text-underline-offset: 4px;
  }
  .rw-caption-credit[hidden] {
    display: none;
  }

  /* The runway track: a vertical foil hairline with a diamond per look. */
  .rw-track {
    position: absolute;
    z-index: 3;
    right: calc(env(safe-area-inset-right, 0px) + 2px);
    top: calc(env(safe-area-inset-top, 0px) + 126px);
    bottom: calc(env(safe-area-inset-bottom, 0px) + 116px);
    width: 44px;
    touch-action: none;
  }
  .rw-track ol {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .rw-track li {
    flex: 1 1 0;
    min-height: 0;
  }
  .rw-track-line {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    margin-left: -0.5px;
    background: linear-gradient(180deg, rgba(255, 189, 89, 0), #f4a833 8%, #fff3d8 50%, #f4a833 92%, rgba(255, 189, 89, 0));
    box-shadow: 0 0 3px rgba(0, 0, 0, 0.55);
    opacity: 0.85;
  }
  .rw-track-btn {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .rw-track-btn:focus-visible {
    outline: 2px solid #ffbd59;
    outline-offset: -2px;
    border-radius: 4px;
  }
  .rw-diamond {
    display: block;
    width: 7px;
    height: 7px;
    transform: rotate(45deg);
    border: 1.2px solid rgba(255, 189, 89, 0.9);
    background: rgba(5, 7, 12, 0.55);
    box-shadow: 0 0 0 1px rgba(5, 7, 12, 0.35);
    transition: transform 0.25s ease, background-color 0.25s ease, box-shadow 0.25s ease;
  }
  .rw-track-btn.is-past .rw-diamond {
    background: #ffbd59;
  }
  .rw-track-btn.is-current .rw-diamond {
    width: 11px;
    height: 11px;
    background: #fff3d8;
    border-color: #ffbd59;
    box-shadow:
      0 0 0 1.5px #ffbd59,
      0 0 12px 3px rgba(255, 189, 89, 0.75);
  }
  .rw-track-btn.is-preview .rw-diamond {
    transform: rotate(45deg) scale(1.5);
  }
  @media (hover: hover) {
    .rw-track-btn:hover .rw-diamond {
      transform: rotate(45deg) scale(1.35);
    }
  }

  .rw-chevrons {
    display: none;
  }

  .rw-skip {
    position: absolute;
    z-index: 6;
    top: calc(env(safe-area-inset-top, 0px) + 64px);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 6px;
  }
  .rw-skip-btn {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
    padding: 0;
  }
  .rw-skip-btn:focus-visible {
    position: static;
    width: auto;
    height: auto;
    clip: auto;
    clip-path: none;
    overflow: visible;
    padding: 10px 14px;
    border: 1px solid #ffbd59;
    border-radius: 3px;
    background: #05070c;
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    outline: none;
  }

  .rw-toast {
    position: absolute;
    z-index: 40;
    left: 50%;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 110px);
    transform: translate(-50%, 10px);
    padding: 10px 16px;
    border: 1px solid rgba(255, 189, 89, 0.7);
    border-radius: 3px;
    background: rgba(5, 7, 12, 0.92);
    color: #fff;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    max-width: calc(100% - 32px);
    overflow-wrap: anywhere;
    text-align: center;
  }
  .rw-toast.is-on {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  /* ---- Wide or landscape windows: a centered portrait column. ---- */
  @media (min-aspect-ratio: 4/5) {
    .rw-backdrop {
      display: block;
    }
    .rw-frame {
      inset: auto;
      left: 50%;
      top: 50%;
      height: calc(100% - 2 * clamp(10px, 3vh, 28px));
      aspect-ratio: 5 / 8;
      max-width: calc(100% - 190px);
      transform: translate(-50%, -50%);
    }
    .rw-player[data-mode="walk"] .rw-frame {
      aspect-ratio: 3 / 2;
    }
    .rw-player[data-mode="walk"] .rw-panel:not(.rw-panel--adj) .rw-img {
      object-fit: cover;
    }
    .rw-stage {
      box-shadow: 0 40px 120px -30px rgba(0, 0, 0, 0.9);
    }
    .rw-edge {
      display: block;
      position: absolute;
      inset: 0;
      border: 1px solid rgba(255, 189, 89, 0.55);
      pointer-events: none;
      z-index: 4;
    }
    .rw-top {
      padding: 12px 8px 0 14px;
    }
    .rw-scrim-top {
      height: 150px;
    }
    .rw-scrim-bottom {
      height: 190px;
    }
    .rw-caption {
      left: 22px;
      right: auto;
      max-width: calc(100% - 44px);
      bottom: 22px;
    }
    .rw-track {
      right: -58px;
      top: 4%;
      bottom: 4%;
    }
    .rw-toast {
      bottom: 90px;
    }
  }
  @media (min-aspect-ratio: 4/5) and (hover: hover) and (pointer: fine) {
    .rw-chevrons {
      display: flex;
      flex-direction: column;
      gap: 10px;
      position: absolute;
      left: -64px;
      top: 50%;
      transform: translateY(-50%);
    }
    .rw-chev {
      border: 1px solid rgba(255, 189, 89, 0.5);
      background: rgba(5, 7, 12, 0.5);
    }
    .rw-chev:hover {
      border-color: #ffbd59;
      background: rgba(255, 189, 89, 0.1);
    }
  }
  /* Phone held sideways: keep the chrome compact. */
  @media (min-aspect-ratio: 4/5) and (max-height: 520px) {
    .rw-caption-look .rw-didot {
      font-size: 2.2rem;
    }
    .rw-track {
      right: -52px;
    }
  }
  .rw-player[data-mode="sky"] .rw-frame {
    visibility: hidden;
  }
</style>

<script>
  type Credit = { name: string; instagram: string } | null;
  type Frame = {
    c: string;
    b: string;
    h: string;
    alt: string;
    el?: HTMLImageElement;
    state?: "idle" | "loading" | "ready" | "dead";
  };
  type Look = {
    n: number;
    num: string;
    hero: number;
    designer: Credit;
    frames: Frame[];
    back: Frame | null;
    bw: Frame | null;
  };
  type Data = {
    url: string;
    total: number;
    looks: Look[];
    finale: Frame[];
    bwCredit: { handle: string; url: string };
  };
  // The faces of a look, in flip order: the front (walk + close-up), the
  // back view, the second camera's black-and-white frame.
  type Face = "front" | "back" | "bw";

  // Timing and gesture thresholds (see the page report for the rationale).
  const WALK_MS = 900; // the walk-out beat
  const HOLD_MS = 3000; // hold on the front (the hero, always the last beat)
  const FINALE_MS = 550; // finale walk tempo, per frame
  const FINAL_BEAT_MS = 1100; // last finale frame, before the constellation
  const FLIP_MS = 520; // the card flip between faces (matches the CSS)
  const PUSH = 0.035; // push-in scale across a frame
  const FLASH_MS = 180;
  const SCRUB_PX = 28; // horizontal drag distance per frame
  const PRESS_MS = 260; // press-and-hold threshold
  const SLOP_PX = 10; // movement that decides tap vs drag, and its axis
  const SLIDE_MS = 360;
  const SWIPE_FRACTION = 0.18; // of stage height
  const SWIPE_VELOCITY = 0.45; // px per ms
  const LOAD_TIMEOUT_MS = 12000;
  const MAX_INFLIGHT = 4;

  const dataEl = document.getElementById("rw-data");
  const dlg = document.getElementById("rw-player") as HTMLDialogElement | null;
  if (dataEl && dlg) init(JSON.parse(dataEl.textContent || "{}") as Data, dlg);

  function init(data: Data, dlg: HTMLDialogElement) {
    const $ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = dlg) =>
      root.querySelector(sel) as T;
    const $$ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = document) =>
      Array.from(root.querySelectorAll(sel)) as T[];

    const frameEl = $("[data-rw-frame]");
    const stage = $("[data-rw-stage]");
    const reel = $("[data-rw-reel]");
    const curPanel = $("[data-rw-curpanel]");
    const flipEl = $("[data-rw-flip]");
    const cur = $("[data-rw-cur]");
    const backFace = $("[data-rw-backface]");
    const overFace = $("[data-rw-overface]");
    const cueText = $("[data-rw-cuetext]");
    const bwCredit = $("[data-rw-bwcredit]");
    const flipBtn = $<HTMLButtonElement>('[data-rw-act="flip"]');
    const flipCue = $("[data-rw-flipcue]");
    const captionEl = $("[data-rw-caption]");
    const capBeat = $("[data-rw-capbeat]");
    const beatWord = $("[data-rw-beatword]");
    const capHint = $("[data-rw-caphint]");
    const adj = $("[data-rw-adj]");
    const flashEl = $("[data-rw-flash]");
    const crowdEl = $("[data-rw-crowd]") as HTMLElement;
    const sweepEl = $("[data-rw-sweep]") as HTMLElement;
    const nextEl = $<HTMLButtonElement>("[data-rw-next]");
    const nextNum = $("[data-rw-nextnum]");
    const nextWord = $("[data-rw-nextword]");
    const shimmer = $("[data-rw-shimmer]");
    const bars = $("[data-rw-bars]");
    const tagWrap = $("[data-rw-tagwrap]");
    const tagWord = $("[data-rw-tagword]");
    const tagNum = $("[data-rw-tagnum]");
    const ofEl = $("[data-rw-of]");
    const pill = $("[data-rw-pill]");
    const capWord = $("[data-rw-capword]");
    const capNum = $("[data-rw-capnum]");
    const credit = $("[data-rw-credit]");
    const creditLink = $<HTMLAnchorElement>("[data-rw-creditlink]");
    const creditName = $("[data-rw-creditname]");
    const live = $("[data-rw-live]");
    const toastEl = $("[data-rw-toast]");
    const backdrop = $<HTMLImageElement>("[data-rw-backdrop]");
    const pauseBtn = $<HTMLButtonElement>('[data-rw-act="pause"]');
    const track = $("[data-rw-track]");
    const trackBtns = $$<HTMLButtonElement>("[data-rw-jump]", dlg);
    const sky = $("[data-rw-sky]");
    const skyX = $("[data-rw-x]");
    const skyTitle = $("#rw-sky-title");
    const teaserTpl = $<HTMLTemplateElement>("[data-rw-skyteaser]");

    const L = data.looks.length;
    const POS_WALK = L;
    const POS_SKY = L + 1;
    const reduceMQ = window.matchMedia("(prefers-reduced-motion: reduce)");
    let motionOK = !reduceMQ.matches;
    reduceMQ.addEventListener?.("change", (e) => (motionOK = !e.matches));

    // ---------------- state ----------------
    let isOpen = false;
    let pos = 0;
    let fi = 0;
    let elapsed = 0;
    let lastTs = 0;
    let raf = 0;
    let userPaused = false;
    let holdPaused = false;
    let gesturePaused = false;
    let hiddenPaused = false;
    let animating = false;
    let pendingPos = -1;
    let slideTimer = 0;
    let adjPos = -1;
    let shownEl: HTMLImageElement | null = null;
    let opener: HTMLElement | null = null;
    let useH = false;
    let savedY = 0;
    let scrubbing = false;
    let shimmerTimer = 0;
    let toastTimer = 0;
    let segs: { i: number; fill: HTMLElement }[] = [];
    let face: Face = "front"; // the face of the current look that is up
    let flipped = false; // face !== "front" (autoplay pauses)
    let pendingFlip = false; // a flip is waiting on its face's image
    let pendingFace: Face | null = null; // ...and this is the face it waits for
    let cueShown = ""; // the flip cue's current text (replays its entrance on change)

    const seqOf = (p: number): Frame[] =>
      p >= 0 && p < L ? data.looks[p].frames : p === POS_WALK ? data.finale : [];
    const heroOf = (p: number) => (p >= 0 && p < L ? data.looks[p].hero : -1);
    const backOf = (p: number): Frame | null => (p >= 0 && p < L ? data.looks[p].back : null);
    const bwOf = (p: number): Frame | null => (p >= 0 && p < L ? data.looks[p].bw : null);
    const faceFrame = (p: number, fc: Face): Frame | null =>
      fc === "back" ? backOf(p) : fc === "bw" ? bwOf(p) : null;
    // The faces this look can show, in flip order (a face whose image failed
    // to load drops out).
    const facesOf = (p: number): Face[] => {
      if (p < 0 || p >= L) return [];
      const out: Face[] = ["front"];
      for (const fc of ["back", "bw"] as Face[]) {
        const f = faceFrame(p, fc);
        if (f && f.state !== "dead") out.push(fc);
      }
      return out;
    };
    const hasBack = (p: number) => facesOf(p).length > 1; // anything to flip to
    // The face a flip turns to from the one that is up.
    const nextFace = (p: number): Face => {
      const fs = facesOf(p);
      const k = fs.indexOf(face);
      return fs[(k + 1) % fs.length] || "front";
    };
    const faceOf = (f: Frame): Face | null =>
      f === backOf(pos) ? "back" : f === bwOf(pos) ? "bw" : null;
    const isAlive = (f?: Frame) => !!f && f.state !== "dead";
    const nextAlive = (p: number, i: number) => {
      const s = seqOf(p);
      for (let j = i + 1; j < s.length; j++) if (isAlive(s[j])) return j;
      return -1;
    };
    const prevAlive = (p: number, i: number) => {
      const s = seqOf(p);
      for (let j = i - 1; j >= 0; j--) if (isAlive(s[j])) return j;
      return -1;
    };
    const firstAlive = (p: number) => nextAlive(p, -1);
    const lastAlive = (p: number) => prevAlive(p, seqOf(p).length);
    const durOf = (p: number, i: number) =>
      i === heroOf(p)
        ? HOLD_MS
        : p === POS_WALK
          ? i === lastAlive(p)
            ? FINAL_BEAT_MS
            : FINALE_MS
          : WALK_MS;
    const playing = () =>
      !userPaused && !holdPaused && !gesturePaused && !hiddenPaused && !animating && !flipped;

    // ---------------- loading ----------------
    const queue: Frame[] = [];
    let inflight = 0;

    function want(list: Frame[]) {
      queue.length = 0;
      for (const f of list) if (!f.state || f.state === "idle") queue.push(f);
      pump();
    }
    function pump() {
      while (inflight < MAX_INFLIGHT && queue.length) {
        const f = queue.shift()!;
        if (!f.state || f.state === "idle") startLoad(f);
      }
    }
    function startLoad(f: Frame) {
      f.state = "loading";
      inflight++;
      const img = new Image();
      img.decoding = "async";
      img.alt = f.alt;
      img.draggable = false;
      img.className = "rw-img";
      const primary = useH ? f.h : f.b;
      const srcs = primary === f.c ? [f.c] : [primary, f.c];
      let k = 0;
      let settled = false;
      let timer = 0;
      const settle = (ok: boolean) => {
        if (settled) return;
        settled = true;
        clearTimeout(timer);
        inflight--;
        if (ok) {
          f.el = img;
          f.state = "ready";
          onReady(f);
        } else {
          f.state = "dead";
          onDead(f);
        }
        pump();
      };
      const tryNext = () => {
        if (settled) return;
        clearTimeout(timer);
        if (k >= srcs.length) return settle(false);
        const src = srcs[k++];
        timer = window.setTimeout(tryNext, LOAD_TIMEOUT_MS);
        img.src = src;
      };
      img.onload = () => {
        if (settled) return;
        clearTimeout(timer);
        const d = typeof img.decode === "function" ? img.decode() : Promise.resolve();
        d.catch(() => {}).then(() => settle(img.naturalWidth > 0));
      };
      img.onerror = () => tryNext();
      tryNext();
    }

    function preloadAround() {
      const list: Frame[] = [];
      const s = seqOf(pos);
      // Current beat first, then the rest of the look, then its back view
      // and its black-and-white frame (so a flip never lands on an empty face).
      for (let j = fi; j < s.length; j++) list.push(s[j]);
      const back = backOf(pos);
      if (back) list.push(back);
      const bw = bwOf(pos);
      if (bw) list.push(bw);
      for (let j = 0; j < fi; j++) list.push(s[j]);
      if (pos + 1 <= POS_WALK) list.push(...seqOf(pos + 1).slice(0, 3));
      if (pos - 1 >= 0) list.push(...seqOf(pos - 1).slice(0, 1));
      want(list);
    }

    function onReady(f: Frame) {
      if (!isOpen) return;
      const fc = faceOf(f);
      if (fc) {
        if (pendingFlip && pendingFace === fc) setFace(fc);
        else updateBeatUi();
        return;
      }
      const s = seqOf(pos);
      if (s[fi] === f) showFrame(fi);
      if (adjPos >= 0 && adjPos < POS_SKY) {
        const a = seqOf(adjPos);
        if (a[firstAlive(adjPos)] === f && !adj.firstElementChild) fillAdj(adjPos);
      }
    }
    function onDead(f: Frame) {
      if (!isOpen) return;
      const fc = faceOf(f);
      if (fc) {
        // That face after all does not exist: the look behaves like one
        // without it (the flip order skips it).
        if (pendingFlip && pendingFace === fc) {
          pendingFlip = false;
          pendingFace = null;
          setLoading(false);
          if (face === "front") showFrame(fi, { flash: false });
          nudge();
        }
        updateBeatUi();
        return;
      }
      const s = seqOf(pos);
      const idx = s.indexOf(f);
      if (idx < 0) return;
      buildBars();
      if (firstAlive(pos) < 0) {
        // Every frame of this look failed: skip it.
        goPos(pos + 1, { animate: false });
        return;
      }
      if (idx === fi) {
        const j = nextAlive(pos, fi);
        if (j >= 0) showFrame(j);
        else goPos(pos + 1, { animate: false });
      } else {
        paintBars();
      }
    }

    // ---------------- display ----------------
    function setLoading(on: boolean) {
      clearTimeout(shimmerTimer);
      if (!on) {
        shimmer.hidden = true;
        return;
      }
      shimmerTimer = window.setTimeout(() => (shimmer.hidden = false), 140);
    }

    function flash() {
      if (!motionOK || !flashEl.animate) return;
      flashEl.animate(
        [{ opacity: 0 }, { opacity: 0.35, offset: 0.3 }, { opacity: 0 }],
        { duration: FLASH_MS, easing: "ease-out" },
      );
      crowdFlashes();
    }

    // The next-look peek: shown while the show holds on the hero frame.
    function showNext() {
      if (pos >= L || flipped) return;
      const last = pos === L - 1;
      nextWord.textContent = last ? "Up next" : "Next";
      nextNum.textContent = last ? "Finale" : data.looks[pos + 1].num;
      nextEl.classList.toggle("rw-next--word", last);
      nextEl.setAttribute("aria-label", last ? "Up next: the finale" : `Next: look ${pos + 2}`);
      if (nextEl.hidden) {
        nextEl.hidden = false;
        nextEl.classList.remove("is-in");
        void nextEl.offsetWidth;
        nextEl.classList.add("is-in");
      }
    }
    function hideNext() {
      nextEl.hidden = true;
      nextEl.classList.remove("is-in");
    }
    // The spotlight sweep when a look steps out.
    function sweep() {
      if (!motionOK) return;
      sweepEl.classList.remove("is-on");
      void sweepEl.offsetWidth;
      sweepEl.classList.add("is-on");
    }

    // A handful of phone flashes from the guests lining the runway, spread
    // across the hero hold. Deterministic per look (seeded by its number) so
    // the same look always sparkles the same way; skipped under reduced
    // motion and while the show is scrubbed or paused.
    let crowdTimers: number[] = [];
    function clearCrowd() {
      crowdTimers.forEach((id) => clearTimeout(id));
      crowdTimers = [];
      crowdEl.replaceChildren();
    }
    function crowdFlashes() {
      clearCrowd();
      if (!motionOK) return;
      let seed = (pos + 1) * 2654435761;
      const rnd = () => {
        seed = (seed + 0x6d2b79f5) >>> 0;
        let x = seed;
        x = Math.imul(x ^ (x >>> 15), x | 1);
        x ^= x + Math.imul(x ^ (x >>> 7), x | 61);
        return ((x ^ (x >>> 14)) >>> 0) / 4294967296;
      };
      const count = 4 + Math.floor(rnd() * 3);
      for (let k = 0; k < count; k++) {
        const left = rnd() < 0.5 ? 3 + rnd() * 27 : 70 + rnd() * 27;
        const top = 42 + rnd() * 40;
        const at = 120 + rnd() * (HOLD_MS - 700);
        const size = 0.7 + rnd() * 0.9;
        crowdTimers.push(
          window.setTimeout(() => {
            if (!isOpen || scrubbing || !playing()) return;
            const dot = document.createElement("span");
            dot.style.left = `${left.toFixed(1)}%`;
            dot.style.top = `${top.toFixed(1)}%`;
            crowdEl.appendChild(dot);
            const a = dot.animate(
              [
                { opacity: 0, transform: `scale(${(size * 0.4).toFixed(2)})` },
                { opacity: 0.95, transform: `scale(${size.toFixed(2)})`, offset: 0.25 },
                { opacity: 0, transform: `scale(${(size * 1.6).toFixed(2)})` },
              ],
              { duration: 170 + rnd() * 90, easing: "ease-out" },
            );
            a.onfinish = () => dot.remove();
          }, at),
        );
      }
    }

    function showFrame(i: number, opts: { flash?: boolean } = {}) {
      const s = seqOf(pos);
      const f = s[i];
      if (!f) return;
      const changed = i !== fi;
      fi = i;
      if (changed) elapsed = 0;
      if (f.state === "ready" && f.el) {
        const el = f.el;
        const landed = shownEl !== el;
        if (el.parentElement !== cur) cur.appendChild(el);
        if (shownEl && shownEl !== el) {
          shownEl.classList.remove("is-on");
          shownEl.style.transform = "";
        }
        el.classList.add("is-on");
        if (landed) {
          el.style.transform = "";
          elapsed = 0;
        }
        shownEl = el;
        const src = el.currentSrc || el.src;
        if (backdrop.getAttribute("src") !== src) backdrop.src = src;
        if (!pendingFlip) setLoading(false);
        if (landed && i === heroOf(pos) && !scrubbing && opts.flash !== false) flash();
        if (i === heroOf(pos) && !scrubbing && !flipped) showNext();
        else hideNext();
        // The front has landed: make sure its other faces are on the way.
        if (i === heroOf(pos)) ensureFaces();
      } else {
        setLoading(true);
        if (f.state !== "loading") preloadAround();
      }
      paintBars();
      updateBeatUi();
    }

    // ---------------- the flip (the faces of a look) ----------------
    // Put the look's back view and black-and-white frame at the head of the
    // load queue (back first: it is the next face).
    function ensureFaces() {
      for (const f of [bwOf(pos), backOf(pos)]) {
        if (!f || (f.state && f.state !== "idle")) continue;
        const k = queue.indexOf(f);
        if (k >= 0) queue.splice(k, 1);
        queue.unshift(f);
      }
      pump();
    }
    // Hang a face's image on one side of the card.
    function mountFace(side: HTMLElement, f: Frame) {
      if (!f.el) return;
      f.el.classList.add("is-on");
      f.el.style.transform = "";
      if (f.el.parentElement !== side || side.childElementCount !== 1) side.replaceChildren(f.el);
    }
    // Snap back to the front with no animation (look change, close).
    function resetFlip() {
      face = "front";
      flipped = false;
      pendingFlip = false;
      pendingFace = null;
      flipEl.classList.remove("is-animated", "is-flipped");
      backFace.replaceChildren();
      overFace.replaceChildren();
    }
    // A look with only a front: the tag gives a small shake, nothing else.
    function nudge() {
      if (!motionOK || !tagWrap.animate) return;
      tagWrap.animate(
        [
          { transform: "rotate(0deg)" },
          { transform: "rotate(7deg)", offset: 0.25 },
          { transform: "rotate(-5deg)", offset: 0.55 },
          { transform: "rotate(2deg)", offset: 0.8 },
          { transform: "rotate(0deg)" },
        ],
        { duration: 460, easing: "ease-out" },
      );
    }
    // Turn the card to `target`. Front to a reverse face turns 0 to 180
    // degrees; a reverse face back to the front turns 180 to 0; one reverse
    // face to the next first moves the outgoing image onto the front side's
    // cover layer while the card snaps to 0 (the same picture, no visible
    // change), then turns 0 to 180 onto the incoming one.
    function setFace(target: Face, opts: { instant?: boolean } = {}) {
      const wasPending = pendingFlip;
      pendingFlip = false;
      pendingFace = null;
      const f = target === "front" ? null : faceFrame(pos, target);
      if (target !== "front") {
        if (pos >= L || !f || f.state === "dead") {
          if (wasPending) setLoading(false);
          nudge();
          updateBeatUi();
          return;
        }
        if (f.state !== "ready" || !f.el) {
          // Wait for the image rather than turn over to an empty face.
          pendingFlip = true;
          pendingFace = target;
          ensureFaces();
          setLoading(true);
          updateBeatUi();
          return;
        }
        // The other faces belong to the close-up: land on it underneath.
        const h = heroOf(pos);
        if (face === "front" && fi !== h && isAlive(seqOf(pos)[h])) showFrame(h, { flash: false });
        setLoading(false);
      }
      if (target === face) {
        // Nothing to turn (e.g. a pending flip was cancelled): just refresh,
        // which also clears the loading shimmer.
        if (target === "front") showFrame(fi, { flash: false });
        else {
          setLoading(false);
          updateBeatUi();
        }
        return;
      }
      const from = face;
      const animate = motionOK && !opts.instant;
      if (target === "front") {
        overFace.replaceChildren();
        flipEl.classList.toggle("is-animated", animate);
        flipEl.classList.remove("is-flipped");
      } else if (from === "front") {
        overFace.replaceChildren();
        mountFace(backFace, f!);
        flipEl.classList.toggle("is-animated", animate);
        flipEl.classList.add("is-flipped");
      } else {
        const out = faceFrame(pos, from);
        if (animate && out && out.el) {
          flipEl.classList.remove("is-animated");
          mountFace(overFace, out);
          flipEl.classList.remove("is-flipped");
          void flipEl.offsetWidth;
        }
        mountFace(backFace, f!);
        flipEl.classList.toggle("is-animated", animate);
        flipEl.classList.add("is-flipped");
      }
      face = target;
      flipped = target !== "front";
      if (animate && curPanel.animate) {
        curPanel.animate(
          [{ transform: "scale(1)" }, { transform: "scale(0.94)", offset: 0.5 }, { transform: "scale(1)" }],
          { duration: FLIP_MS, easing: "ease-in-out" },
        );
      }
      const n = pos + 1;
      if (flipped) {
        hideNext();
        clearCrowd();
        const el = f!.el!;
        const src = el.currentSrc || el.src;
        if (backdrop.getAttribute("src") !== src) backdrop.src = src;
        announce(target === "bw" ? `Look ${n}, black and white` : `Look ${n}, the back`);
      } else {
        const src = shownEl ? shownEl.currentSrc || shownEl.src : "";
        if (src && backdrop.getAttribute("src") !== src) backdrop.src = src;
        showFrame(fi, { flash: false });
        announce(`Look ${n}, the front`);
      }
      updateBeatUi();
    }
    // Tap, the flip button, F and Enter: the next face in the cycle.
    function toggleFlip() {
      if (animating) finishSlide();
      if (pendingFlip) {
        // A second tap while a face is still loading cancels that flip.
        setFace(face);
        return;
      }
      if (pos >= L || !hasBack(pos)) {
        nudge();
        updateBeatUi();
        return;
      }
      setFace(nextFace(pos));
    }

    const beatName = () =>
      pos >= POS_SKY
        ? "sky"
        : pos === POS_WALK
          ? "finale"
          : flipped
            ? face
            : fi === heroOf(pos)
              ? "front"
              : "walk";

    // The caption's beat label, the flip button and the flip cue.
    function syncCapH() {
      frameEl.style.setProperty("--rw-cap-h", `${Math.round(captionEl.offsetHeight)}px`);
    }
    function updateBeatUi() {
      const inLook = pos >= 0 && pos < L;
      const beat = beatName();
      capBeat.hidden = !inLook;
      beatWord.textContent =
        beat === "walk"
          ? "Walking out"
          : beat === "back"
            ? "The back"
            : beat === "bw"
              ? "Black and white"
              : "The look";
      const back = inLook && hasBack(pos);
      // Every flip cue, hint and button label names the face a tap turns to.
      const nf: Face = back ? nextFace(pos) : "front";
      const tapText =
        nf === "back" ? "Tap to see the back" : nf === "bw" ? "Tap for black and white" : "Tap to turn back";
      if (!back && document.activeElement === flipBtn) dlg.focus({ preventScroll: true });
      flipBtn.hidden = !back;
      flipBtn.setAttribute("aria-pressed", String(flipped));
      flipBtn.setAttribute(
        "aria-label",
        nf === "back" ? "See the back" : nf === "bw" ? "See it in black and white" : "See the front",
      );
      bwCredit.hidden = !(inLook && face === "bw");
      const hero = inLook ? seqOf(pos)[heroOf(pos)] : undefined;
      const frontShown = beat === "front" && !!hero && hero.state === "ready" && shownEl === hero.el;
      const cueOn = back && (frontShown || flipped) && !scrubbing && !pendingFlip;
      // The caption hint says the same thing; it only shows while flipped
      // when the cue tag cannot (so the words never appear twice).
      capHint.textContent = tapText;
      capHint.hidden = !(inLook && flipped && !cueOn);
      if (cueOn && (flipCue.hidden || cueShown !== tapText)) {
        cueText.textContent = tapText;
        cueShown = tapText;
        flipCue.hidden = false;
        flipCue.classList.remove("is-in");
        void flipCue.offsetWidth;
        flipCue.classList.add("is-in");
      } else if (!cueOn && !flipCue.hidden) {
        flipCue.hidden = true;
        flipCue.classList.remove("is-in");
        cueShown = "";
      }
      syncCapH();
    }
    if (typeof ResizeObserver === "function") new ResizeObserver(syncCapH).observe(captionEl);

    function buildBars() {
      bars.replaceChildren();
      segs = [];
      const s = seqOf(pos);
      const hero = heroOf(pos);
      s.forEach((f, i) => {
        if (!isAlive(f)) return;
        const seg = document.createElement("span");
        seg.className = "rw-seg" + (i === hero ? " is-hero" : "");
        const fill = document.createElement("span");
        fill.className = "rw-seg-fill";
        seg.appendChild(fill);
        bars.appendChild(seg);
        segs.push({ i, fill });
      });
    }
    function paintBars() {
      for (const s of segs) s.fill.style.transform = `scaleX(${s.i < fi ? 1 : 0})`;
    }

    function updateChrome(swing: boolean) {
      const inLook = pos < L;
      if (inLook) {
        const look = data.looks[pos];
        tagWord.textContent = "Look";
        tagNum.textContent = look.num;
        tagNum.hidden = false;
        capWord.textContent = "Look";
        capNum.textContent = look.num;
        if (look.designer) {
          creditName.textContent = look.designer.name;
          creditLink.href = look.designer.instagram;
          credit.hidden = false;
        } else {
          credit.hidden = true;
        }
      } else {
        tagWord.textContent = "Finale";
        tagNum.textContent = "";
        tagNum.hidden = true;
        capWord.textContent = "Finale";
        capNum.textContent = "";
        credit.hidden = true;
      }
      ofEl.hidden = !inLook || isPausedVisible();
      updatePauseUi();
      updateBeatUi();
      trackBtns.forEach((b, k) => {
        const past = k < pos;
        const now = k === pos;
        b.classList.toggle("is-past", past);
        b.classList.toggle("is-current", now);
        if (now) b.setAttribute("aria-current", "step");
        else b.removeAttribute("aria-current");
      });
      if (swing && motionOK && tagWrap.animate) {
        tagWrap.animate(
          [
            { transform: "rotate(-18deg)" },
            { transform: "rotate(8deg)", offset: 0.42 },
            { transform: "rotate(-3.5deg)", offset: 0.68 },
            { transform: "rotate(1.2deg)", offset: 0.86 },
            { transform: "rotate(0deg)" },
          ],
          { duration: 520, easing: "cubic-bezier(.25,.8,.35,1)" },
        );
      }
    }

    const isPausedVisible = () => userPaused || holdPaused;
    function updatePauseUi() {
      pauseBtn.setAttribute("aria-pressed", String(userPaused));
      pauseBtn.setAttribute("aria-label", userPaused ? "Play" : "Pause");
      const showPill = isPausedVisible() && pos < POS_SKY;
      pill.hidden = !showPill;
      ofEl.hidden = pos >= L || showPill;
    }

    function announce(text: string) {
      live.textContent = text;
    }
    function syncHash() {
      const hash = pos < L ? `#look-${pos + 1}` : "#finale";
      if (location.hash !== hash) history.replaceState(history.state, "", hash);
    }

    // ---------------- sky (La Constelación) ----------------
    function showSky() {
      sky.hidden = false;
      sky.scrollTop = 0;
      frameEl.inert = true;
      skyX.classList.remove("is-assembling");
      void skyX.offsetWidth;
      skyX.classList.add("is-assembling");
      requestAnimationFrame(() => sky.classList.add("is-on"));
      if (!motionOK) sky.classList.add("is-on");
      skyTitle.focus({ preventScroll: true });
      clearTimeout(shimmerTimer);
      shimmer.hidden = true;
    }
    function hideSky() {
      sky.classList.remove("is-on");
      sky.hidden = true;
      frameEl.inert = false;
    }

    // ---------------- position changes ----------------
    function commit(np: number, dir = 1) {
      const prev = pos;
      if (np < POS_SKY && firstAlive(np) < 0) {
        // Nothing to show here (every frame failed): keep going.
        const skip = np + (dir >= 0 ? 1 : -1);
        if (skip >= 0 && skip <= POS_SKY) return commit(skip, dir);
      }
      pos = np;
      resetFlip();
      clearCrowd();
      hideNext();
      if (np < L && np !== prev) sweep();
      reel.style.transition = "none";
      reel.style.transform = "";
      adj.hidden = true;
      adj.replaceChildren();
      adj.classList.remove("is-walk");
      adjPos = -1;
      animating = false;
      pendingPos = -1;
      dlg.dataset.mode = np < L ? "look" : np === POS_WALK ? "walk" : "sky";
      if (np === POS_SKY) {
        cur.replaceChildren();
        shownEl = null;
        queue.length = 0;
        showSky();
        announce("La Constelación del Runway");
        syncHash();
        updateChrome(false);
        return;
      }
      if (prev === POS_SKY) hideSky();
      cur.replaceChildren();
      shownEl = null;
      fi = firstAlive(np);
      elapsed = 0;
      buildBars();
      updateChrome(prev !== np);
      preloadAround();
      showFrame(fi, { flash: false });
      syncHash();
      announce(np < L ? `Look ${np + 1} of ${L}` : "Finale");
    }

    function prepAdj(np: number, dir: number) {
      adj.replaceChildren();
      adj.hidden = false;
      adj.style.transform = `translateY(${dir * 100}%)`;
      adj.classList.toggle("is-walk", np === POS_WALK);
      adjPos = np;
      fillAdj(np);
    }
    function fillAdj(np: number) {
      if (np === POS_SKY) {
        adj.appendChild(teaserTpl.content.cloneNode(true));
        return;
      }
      const s = seqOf(np);
      const f = s[firstAlive(np)];
      if (f && f.state === "ready" && f.el) {
        const c = f.el.cloneNode() as HTMLImageElement;
        c.classList.add("is-on");
        c.style.transform = "";
        adj.replaceChildren(c);
      }
    }

    function slideTo(np: number, dir: number) {
      if (adjPos !== np) prepAdj(np, dir);
      animating = true;
      pendingPos = np;
      reel.style.transition = `transform ${SLIDE_MS}ms cubic-bezier(.2,.75,.2,1)`;
      reel.style.transform = `translateY(${-dir * 100}%)`;
      clearTimeout(slideTimer);
      slideTimer = window.setTimeout(finishSlide, SLIDE_MS + 20);
    }
    function finishSlide() {
      if (!animating) return;
      clearTimeout(slideTimer);
      const np = pendingPos;
      const dir = np >= pos ? 1 : -1;
      commit(np, dir);
    }

    function goPos(np: number, opts: { animate?: boolean } = {}) {
      if (animating) finishSlide();
      if (np < 0 || np > POS_SKY) return;
      if (np === pos) {
        // Same look again: restart its walk.
        if (np < POS_SKY) {
          if (flipped || pendingFlip) setFace("front", { instant: true });
          const f0 = firstAlive(np);
          if (f0 >= 0) showFrame(f0);
        }
        return;
      }
      const dir = np > pos ? 1 : -1;
      const canSlide =
        motionOK && opts.animate !== false && pos < POS_SKY && np < POS_SKY && Math.abs(np - pos) === 1;
      if (canSlide) slideTo(np, dir);
      else commit(np, dir);
    }

    // Relative moves resolve against where an in-flight slide is heading,
    // so rapid key presses or taps never get swallowed.
    function goRel(delta: number) {
      if (animating) finishSlide();
      goPos(pos + delta);
    }

    function stepNext() {
      if (animating) finishSlide();
      if (pos >= POS_SKY) return;
      if (flipped || pendingFlip) setFace("front", { instant: true });
      const j = nextAlive(pos, fi);
      if (j >= 0) showFrame(j);
      else goPos(pos + 1);
    }
    function stepPrev() {
      if (animating) finishSlide();
      if (pos >= POS_SKY) return;
      if (flipped || pendingFlip) setFace("front", { instant: true });
      const j = prevAlive(pos, fi);
      if (j >= 0) showFrame(j);
      else if (pos > 0) goPos(pos - 1);
      else showFrame(fi);
    }

    // ---------------- clock ----------------
    function tick(ts: number) {
      raf = requestAnimationFrame(tick);
      const dt = lastTs ? Math.min(100, ts - lastTs) : 0;
      lastTs = ts;
      if (!isOpen || pos >= POS_SKY) return;
      const f = seqOf(pos)[fi];
      const ready = !!f && f.state === "ready" && shownEl === f.el;
      const d = durOf(pos, fi);
      if (ready && playing()) {
        elapsed += dt;
        if (elapsed >= d) {
          elapsed = 0;
          const j = nextAlive(pos, fi);
          if (j >= 0) showFrame(j);
          else goPos(pos + 1);
          return;
        }
      }
      const p = ready ? Math.min(1, elapsed / d) : 0;
      if (shownEl && motionOK) shownEl.style.transform = `scale(${(1 + PUSH * p).toFixed(4)})`;
      const seg = segs.find((s) => s.i === fi);
      if (seg) seg.fill.style.transform = `scaleX(${p.toFixed(4)})`;
    }

    // ---------------- open / close ----------------
    function lockScroll() {
      savedY = window.scrollY;
      const b = document.body.style;
      b.position = "fixed";
      b.top = `-${savedY}px`;
      b.left = "0";
      b.right = "0";
      b.width = "100%";
      document.documentElement.classList.add("rw-locked");
    }
    function unlockScroll() {
      const b = document.body.style;
      b.position = "";
      b.top = "";
      b.left = "";
      b.right = "";
      b.width = "";
      const html = document.documentElement;
      html.classList.remove("rw-locked");
      const prevBehavior = html.style.scrollBehavior;
      html.style.scrollBehavior = "auto";
      window.scrollTo(0, savedY);
      html.style.scrollBehavior = prevBehavior;
    }

    function open(p: number, from: HTMLElement | null) {
      if (isOpen) {
        goPos(p, { animate: false });
        return;
      }
      opener = from;
      lockScroll();
      dlg.showModal();
      isOpen = true;
      dlg.focus({ preventScroll: true });
      useH = stage.getBoundingClientRect().height > 1000;
      userPaused = false;
      holdPaused = false;
      gesturePaused = false;
      hiddenPaused = document.hidden;
      pos = -1;
      commit(Math.max(0, Math.min(POS_SKY, p)));
      lastTs = 0;
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(tick);
    }

    function close(opts: { toLookbook?: boolean } = {}) {
      clearCrowd();
      hideNext();
      if (!isOpen) return;
      resetFlip();
      isOpen = false;
      cancelAnimationFrame(raf);
      clearTimeout(slideTimer);
      animating = false;
      queue.length = 0;
      hideSky();
      dlg.close();
      unlockScroll();
      cur.replaceChildren();
      adj.replaceChildren();
      shownEl = null;
      history.replaceState(history.state, "", location.pathname + location.search);
      const lastPos = pos;
      const card =
        document.querySelector<HTMLElement>(`[data-rw-card="${lastPos < L ? lastPos : "finale"}"]`);
      if (opts.toLookbook || !opener || !document.contains(opener)) {
        if (opts.toLookbook) document.getElementById("lookbook")?.scrollIntoView();
        else card?.scrollIntoView({ block: "center" });
        card?.focus({ preventScroll: true });
      } else {
        opener.focus({ preventScroll: true });
      }
      opener = null;
    }

    // ---------------- share + toast ----------------
    function toast(text: string) {
      toastEl.textContent = text;
      toastEl.classList.add("is-on");
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toastEl.classList.remove("is-on"), 2200);
    }
    async function copyText(text: string) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        const ta = document.createElement("textarea");
        ta.value = text;
        ta.setAttribute("readonly", "");
        ta.style.position = "fixed";
        ta.style.opacity = "0";
        dlg.appendChild(ta);
        ta.select();
        let ok = false;
        try {
          ok = document.execCommand("copy");
        } catch {
          ok = false;
        }
        ta.remove();
        return ok;
      }
    }
    // ---------------- save this look: a 1080x1920 story card ----------------
    // The current frame inside a gold corner-bracket frame on the gala navy,
    // the cream garment tag hung from the top, and the show's line at the
    // bottom. Flickr's CDN allows cross-origin canvas use. Shared as an image
    // file through the share sheet (Instagram Stories on a phone) or
    // downloaded where files cannot be shared.
    let savingCard = false;
    function loadImg(src: string) {
      return new Promise<HTMLImageElement>((resolve, reject) => {
        const im = new Image();
        im.crossOrigin = "anonymous";
        im.decoding = "async";
        im.onload = () => resolve(im);
        im.onerror = () => reject(new Error("image"));
        im.src = src;
      });
    }
    function roundRect(c: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
      c.beginPath();
      c.moveTo(x + r, y);
      c.arcTo(x + w, y, x + w, y + h, r);
      c.arcTo(x + w, y + h, x, y + h, r);
      c.arcTo(x, y + h, x, y, r);
      c.arcTo(x, y, x + w, y, r);
      c.closePath();
    }
    async function renderCard(): Promise<{ blob: Blob; name: string; title: string }> {
      const inLook = pos < L;
      const seq = seqOf(pos);
      // The frame on screen: the face that is up when the look is turned over.
      const up = flipped ? faceFrame(pos, face) : null;
      const onBw = !!up && up.state === "ready" && face === "bw";
      const f = up && up.state === "ready" ? up : seq[fi] || seq[0];
      const num = inLook ? data.looks[pos].num : "";
      const n = inLook ? pos + 1 : 0;
      const img = await loadImg(f.h || f.b);
      const W = 1080, H = 1920;
      const cv = document.createElement("canvas");
      cv.width = W;
      cv.height = H;
      const c = cv.getContext("2d")!;
      // Ground
      const g = c.createLinearGradient(0, 0, 0, H);
      g.addColorStop(0, "#05070c");
      g.addColorStop(0.25, "#0b1320");
      g.addColorStop(0.75, "#0d1522");
      g.addColorStop(1, "#05070c");
      c.fillStyle = g;
      c.fillRect(0, 0, W, H);
      const glow = c.createRadialGradient(W / 2, 250, 20, W / 2, 250, 620);
      glow.addColorStop(0, "rgba(255,189,89,0.16)");
      glow.addColorStop(1, "rgba(255,189,89,0)");
      c.fillStyle = glow;
      c.fillRect(0, 0, W, H);
      // Photo, cover-fit into the plate
      const px = 84, py = 252, pw = W - 168, ph = 1372;
      const s = Math.max(pw / img.naturalWidth, ph / img.naturalHeight);
      const dw = img.naturalWidth * s, dh = img.naturalHeight * s;
      c.save();
      c.beginPath();
      c.rect(px, py, pw, ph);
      c.clip();
      c.drawImage(img, px + (pw - dw) / 2, py + (ph - dh) * 0.35, dw, dh);
      c.restore();
      // Keyline + corner brackets
      c.strokeStyle = "rgba(255,189,89,0.55)";
      c.lineWidth = 2;
      c.strokeRect(px + 0.5, py + 0.5, pw - 1, ph - 1);
      c.strokeStyle = "#ffbd59";
      c.lineWidth = 5;
      const b = 44, o = 14;
      const corners: [number, number, number, number][] = [
        [px - o, py - o, 1, 1], [px + pw + o, py - o, -1, 1], [px - o, py + ph + o, 1, -1], [px + pw + o, py + ph + o, -1, -1],
      ];
      for (const [cx, cy, sx, sy] of corners) {
        c.beginPath();
        c.moveTo(cx, cy + sy * b);
        c.lineTo(cx, cy);
        c.lineTo(cx + sx * b, cy);
        c.stroke();
      }
      // The garment tag on its string
      c.strokeStyle = "#ffbd59";
      c.lineWidth = 2;
      c.beginPath();
      c.moveTo(W / 2, 0);
      c.lineTo(W / 2, 96);
      c.stroke();
      const tw = inLook ? 300 : 360, th = 176, tx = (W - tw) / 2, ty = 96;
      c.save();
      c.shadowColor = "rgba(0,0,0,0.6)";
      c.shadowBlur = 30;
      c.shadowOffsetY = 12;
      const tg = c.createLinearGradient(0, ty, 0, ty + th);
      tg.addColorStop(0, "#fffcf6");
      tg.addColorStop(0.55, "#f4ecdf");
      tg.addColorStop(1, "#efe3d0");
      c.fillStyle = tg;
      roundRect(c, tx, ty, tw, th, 12);
      c.fill();
      c.restore();
      c.strokeStyle = "rgba(255,189,89,0.7)";
      c.lineWidth = 2;
      roundRect(c, tx, ty, tw, th, 12);
      c.stroke();
      c.strokeStyle = "rgba(156,122,68,0.35)";
      c.lineWidth = 1.5;
      roundRect(c, tx + 8, ty + 8, tw - 16, th - 16, 7);
      c.stroke();
      // eyelet
      c.beginPath();
      c.arc(W / 2, ty + 26, 11, 0, Math.PI * 2);
      c.fillStyle = "#0b1320";
      c.fill();
      c.lineWidth = 4;
      c.strokeStyle = "#ffbd59";
      c.stroke();
      c.textAlign = "center";
      c.fillStyle = "#8a5700";
      c.font = "800 22px Rubik, 'Helvetica Neue', Arial, sans-serif";
      c.letterSpacing = "6px";
      c.fillText(inLook ? "LOOK" : "THE RUNWAY", W / 2, ty + 78);
      c.letterSpacing = "0px";
      c.fillStyle = "#1e1e1e";
      c.font = `italic 400 ${inLook ? 88 : 60}px Didot, 'Bodoni 72', 'Playfair Display', Georgia, serif`;
      c.fillText(inLook ? num : "Finale", W / 2, ty + (inLook ? 156 : 146));
      // Bottom lines
      const designer = inLook ? data.looks[pos].designer : null;
      let y = py + ph + 60;
      if (designer) {
        c.fillStyle = "rgba(255,255,255,0.92)";
        c.font = "italic 400 40px Didot, 'Bodoni 72', 'Playfair Display', Georgia, serif";
        c.fillText(`by ${designer.name}`, W / 2, y);
        y += 54;
      }
      if (onBw) {
        // The second photographer's frame carries their credit.
        c.fillStyle = "rgba(255,255,255,0.82)";
        c.font = "600 28px Rubik, 'Helvetica Neue', Arial, sans-serif";
        c.fillText(`Black and white by ${data.bwCredit.handle}`, W / 2, y - 6);
        y += 50;
      }
      c.fillStyle = "#ffbd59";
      c.font = "800 24px Rubik, 'Helvetica Neue', Arial, sans-serif";
      c.letterSpacing = "7px";
      c.fillText("THE RUNWAY · ANNUAL GALA 2026 · MCA CHICAGO", W / 2, y + 4);
      c.letterSpacing = "0px";
      const rule = c.createLinearGradient(W / 2 - 220, 0, W / 2 + 220, 0);
      rule.addColorStop(0, "rgba(255,189,89,0)");
      rule.addColorStop(0.5, "#ffbd59");
      rule.addColorStop(1, "rgba(255,189,89,0)");
      c.fillStyle = rule;
      c.fillRect(W / 2 - 220, y + 34, 440, 2);
      c.save();
      c.translate(W / 2, y + 35);
      c.rotate(Math.PI / 4);
      c.fillStyle = "#ffbd59";
      c.fillRect(-6, -6, 12, 12);
      c.restore();
      c.fillStyle = "rgba(255,255,255,0.72)";
      c.font = "600 28px Rubik, 'Helvetica Neue', Arial, sans-serif";
      c.fillText("latinasweatproject.com/gala/fashion-show", W / 2, y + 88);
      const blob = await new Promise<Blob | null>((r) => cv.toBlob(r, "image/jpeg", 0.9));
      if (!blob) throw new Error("blob");
      const name = n ? `the-runway-look-${num}.jpg` : "the-runway-finale.jpg";
      const title = n ? `The Runway · Look ${n}` : "The Runway · Finale";
      (window as any).__runwayLastCard = URL.createObjectURL(blob);
      return { blob, name, title };
    }
    async function saveCard() {
      if (savingCard) return;
      savingCard = true;
      const wasPaused = userPaused;
      userPaused = true;
      updatePauseUi();
      toast("Making your card");
      (window as any).trackConversion?.("gala_runway_save", { context: pos < L ? `look_${pos + 1}` : "finale" });
      try {
        const { blob, name, title } = await renderCard();
        const file = new File([blob], name, { type: "image/jpeg" });
        const nav = navigator as Navigator & { canShare?: (d: ShareData) => boolean };
        if (typeof nav.share === "function" && nav.canShare?.({ files: [file] })) {
          try {
            await nav.share({ files: [file], title });
            toast("Shared");
          } catch (e) {
            if ((e as Error)?.name !== "AbortError") throw e;
          }
        } else {
          const a = document.createElement("a");
          a.href = URL.createObjectURL(blob);
          a.download = name;
          dlg.appendChild(a);
          a.click();
          a.remove();
          setTimeout(() => URL.revokeObjectURL(a.href), 4000);
          toast("Saved to your downloads");
        }
      } catch {
        toast("Could not make the card. Try sharing the link instead.");
      } finally {
        savingCard = false;
        userPaused = wasPaused;
        updatePauseUi();
      }
    }

    async function share() {
      const n = pos < L ? pos + 1 : 0;
      const url = n ? `${data.url}#look-${n}` : `${data.url}#finale`;
      const title = n ? `The Runway · Look ${n}` : "The Runway · Finale";
      (window as any).trackConversion?.("gala_runway_share", { context: n ? `look_${n}` : "finale" });
      const nav = navigator as Navigator & { canShare?: (d: ShareData) => boolean };
      if (typeof nav.share === "function" && (!nav.canShare || nav.canShare({ title, url }))) {
        try {
          await nav.share({ title, url });
          return;
        } catch (err) {
          if ((err as DOMException)?.name === "AbortError") return;
        }
      }
      const ok = await copyText(url);
      toast(ok ? "Link copied" : url);
    }

    // ---------------- gestures on the stage ----------------
    let pid: number | null = null;
    let gx = 0;
    let gy = 0;
    let gMode: "pending" | "hold" | "scrub" | "swipe" | "none" = "none";
    let holdTimer = 0;
    let scrubFrom = 0;
    let swipeDir = 0;
    let samples: { t: number; y: number }[] = [];

    stage.addEventListener("contextmenu", (e) => e.preventDefault());
    stage.addEventListener("dragstart", (e) => e.preventDefault());

    stage.addEventListener("pointerdown", (e) => {
      if (!isOpen || pos >= POS_SKY) return;
      if (e.pointerType === "mouse" && e.button !== 0) return;
      if (pid !== null) return;
      if (animating) finishSlide();
      pid = e.pointerId;
      try {
        stage.setPointerCapture(e.pointerId);
      } catch {}
      gx = e.clientX;
      gy = e.clientY;
      gMode = "pending";
      samples = [{ t: e.timeStamp, y: e.clientY }];
      clearTimeout(holdTimer);
      holdTimer = window.setTimeout(() => {
        if (gMode === "pending") {
          gMode = "hold";
          holdPaused = true;
          if (flipped || pendingFlip) setFace("front");
          updatePauseUi();
        }
      }, PRESS_MS);
    });

    stage.addEventListener("pointermove", (e) => {
      if (e.pointerId !== pid) return;
      const dx = e.clientX - gx;
      const dy = e.clientY - gy;
      samples.push({ t: e.timeStamp, y: e.clientY });
      if (samples.length > 6) samples.shift();
      if (gMode === "pending" && Math.hypot(dx, dy) > SLOP_PX) {
        clearTimeout(holdTimer);
        if (Math.abs(dx) > Math.abs(dy)) {
          gMode = "scrub";
          scrubbing = true;
          if (flipped || pendingFlip) setFace("front");
          scrubFrom = fi;
        } else {
          gMode = "swipe";
          swipeDir = 0;
        }
        gesturePaused = true;
      }
      if (gMode === "scrub") {
        const steps = Math.trunc(dx / SCRUB_PX);
        let target = scrubFrom;
        const dirStep = steps > 0 ? 1 : -1;
        for (let n = 0; n < Math.abs(steps); n++) {
          const j = dirStep > 0 ? nextAlive(pos, target) : prevAlive(pos, target);
          if (j < 0) break;
          target = j;
        }
        if (target !== fi) {
          showFrame(target);
          if (shownEl) shownEl.style.transform = "";
        }
      } else if (gMode === "swipe") {
        const dir = dy < 0 ? 1 : -1;
        const np = pos + dir;
        const allowed = np >= 0 && np <= POS_SKY;
        let off = dy;
        if (!allowed) {
          off = dy * 0.25;
          if (adjPos !== -1) {
            adj.hidden = true;
            adj.replaceChildren();
            adjPos = -1;
          }
          swipeDir = 0;
        } else if (dir !== swipeDir || adjPos !== np) {
          swipeDir = dir;
          prepAdj(np, dir);
        }
        reel.style.transition = "none";
        reel.style.transform = `translateY(${off}px)`;
      }
    });

    function endGesture(e: PointerEvent, cancelled: boolean) {
      if (e.pointerId !== pid) return;
      pid = null;
      clearTimeout(holdTimer);
      const dx = e.clientX - gx;
      const dy = e.clientY - gy;
      const mode = gMode;
      gMode = "none";
      if (mode === "pending" && !cancelled) {
        // A tap turns the look over (or back); looks without a back view
        // only nudge their tag. Taps never step beats or change looks.
        toggleFlip();
      } else if (mode === "hold") {
        holdPaused = false;
        updatePauseUi();
      } else if (mode === "scrub") {
        scrubbing = false;
        gesturePaused = false;
        elapsed = 0;
        // The scrub may end on the close-up: bring back its peek and cue.
        showFrame(fi, { flash: false });
      } else if (mode === "swipe") {
        gesturePaused = false;
        const h = stage.clientHeight || 1;
        const dir = dy < 0 ? 1 : -1;
        const np = pos + dir;
        const first = samples[0];
        const last = samples[samples.length - 1];
        const v = first && last && last.t > first.t ? (last.y - first.y) / (last.t - first.t) : 0;
        const fast = Math.abs(v) > SWIPE_VELOCITY && Math.sign(v) === Math.sign(dy);
        const allowed = np >= 0 && np <= POS_SKY && adjPos === np;
        if (!cancelled && allowed && (Math.abs(dy) > h * SWIPE_FRACTION || fast)) {
          animating = true;
          pendingPos = np;
          const ms = motionOK ? SLIDE_MS * 0.8 : 120;
          reel.style.transition = `transform ${ms}ms cubic-bezier(.2,.75,.2,1)`;
          reel.style.transform = `translateY(${-dir * 100}%)`;
          clearTimeout(slideTimer);
          slideTimer = window.setTimeout(finishSlide, ms + 20);
        } else {
          reel.style.transition = `transform 220ms cubic-bezier(.2,.75,.2,1)`;
          reel.style.transform = "translateY(0)";
          window.setTimeout(() => {
            if (!animating && pid === null) {
              adj.hidden = true;
              adj.replaceChildren();
              adjPos = -1;
            }
          }, 240);
        }
      }
      void dx;
    }
    stage.addEventListener("pointerup", (e) => endGesture(e, false));
    stage.addEventListener("pointercancel", (e) => endGesture(e, true));

    // Track: tap a diamond, or slide a finger along the rail.
    trackBtns.forEach((b) =>
      b.addEventListener("click", () => {
        const k = Number(b.dataset.rwJump);
        if (k !== pos) goPos(k, { animate: false });
        else goPos(k);
      }),
    );
    let trackPid: number | null = null;
    let trackY0 = 0;
    let trackMoved = false;
    const trackIndexAt = (y: number) => {
      const r = track.getBoundingClientRect();
      const k = Math.floor(((y - r.top) / r.height) * L);
      return Math.max(0, Math.min(L - 1, k));
    };
    track.addEventListener("pointerdown", (e) => {
      if (e.pointerType === "mouse") return;
      trackPid = e.pointerId;
      trackY0 = e.clientY;
      trackMoved = false;
    });
    track.addEventListener("pointermove", (e) => {
      if (e.pointerId !== trackPid) return;
      if (!trackMoved && Math.abs(e.clientY - trackY0) > SLOP_PX) {
        trackMoved = true;
        try {
          track.setPointerCapture(e.pointerId);
        } catch {}
      }
      if (trackMoved) {
        const k = trackIndexAt(e.clientY);
        trackBtns.forEach((b, i) => b.classList.toggle("is-preview", i === k));
      }
    });
    const trackEnd = (e: PointerEvent) => {
      if (e.pointerId !== trackPid) return;
      trackPid = null;
      trackBtns.forEach((b) => b.classList.remove("is-preview"));
      if (trackMoved) {
        const k = trackIndexAt(e.clientY);
        goPos(k, { animate: false });
        trackMoved = false;
        // Swallow the click that follows a slide.
        const swallow = (ev: Event) => {
          ev.stopPropagation();
          ev.preventDefault();
        };
        track.addEventListener("click", swallow, { capture: true, once: true });
        window.setTimeout(() => track.removeEventListener("click", swallow, true), 350);
      }
    };
    track.addEventListener("pointerup", trackEnd);
    track.addEventListener("pointercancel", trackEnd);

    // Buttons.
    dlg.addEventListener("click", (e) => {
      const t = e.target as Element;
      const act = t.closest<HTMLElement>("[data-rw-act]")?.dataset.rwAct;
      if (act === "pause") {
        userPaused = !userPaused;
        updatePauseUi();
      } else if (act === "flip") toggleFlip();
      else if (act === "share") share();
      else if (act === "save") saveCard();
      else if (act === "prev-frame") stepPrev();
      else if (act === "next-frame") stepNext();
      else if (act === "prev-look") {
        if (pos >= POS_SKY) commit(L - 1, -1);
        else goRel(-1);
      } else if (act === "next-look") goRel(1);
      if (t.closest("[data-rw-close]")) close();
      const star = t.closest<HTMLElement>("[data-rw-star]");
      if (star) commit(Number(star.dataset.rwStar));
      if (t.closest("[data-rw-again]")) commit(0);
      if (t.closest("[data-rw-browse]")) close({ toLookbook: true });
    });

    // Star thumbnails load on first hover or focus.
    const loadTip = (e: Event) => {
      const img = (e.target as Element).closest?.("[data-rw-star]")?.querySelector<HTMLImageElement>("img[data-src]");
      if (img && !img.src) img.src = img.dataset.src || "";
    };
    sky.addEventListener("pointerover", loadTip);
    sky.addEventListener("focusin", loadTip);

    // Keyboard.
    const focusables = () =>
      Array.from(
        dlg.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'),
      ).filter((el) => el.getClientRects().length > 0 && !el.closest("[inert]") && !el.closest("[hidden]"));

    dlg.addEventListener("keydown", (e) => {
      if (!isOpen) return;
      const target = e.target as HTMLElement;
      const onControl = !!target.closest?.("button, a");
      if (e.key === "Tab") {
        const f = focusables();
        if (!f.length) return;
        const first = f[0];
        const last = f[f.length - 1];
        const active = document.activeElement;
        if (e.shiftKey && (active === first || active === dlg || !f.includes(active as HTMLElement))) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && (active === last || !f.includes(active as HTMLElement))) {
          e.preventDefault();
          first.focus();
        }
        return;
      }
      if (e.key === "Escape") {
        e.preventDefault();
        close();
        return;
      }
      if (e.key === "Home") {
        e.preventDefault();
        goPos(0, { animate: false });
        return;
      }
      if (pos >= POS_SKY) {
        // The constellation scrolls natively; only Up returns to the looks.
        if (e.key === "ArrowUp" && sky.scrollTop <= 0) {
          e.preventDefault();
          commit(L - 1, -1);
        }
        return;
      }
      switch (e.key) {
        case "ArrowRight":
          e.preventDefault();
          stepNext();
          break;
        case "ArrowLeft":
          e.preventDefault();
          stepPrev();
          break;
        case "ArrowDown":
        case "PageDown":
          e.preventDefault();
          goRel(1);
          break;
        case "ArrowUp":
        case "PageUp":
          e.preventDefault();
          goRel(-1);
          break;
        case "f":
        case "F":
          if (e.metaKey || e.ctrlKey || e.altKey) return;
          e.preventDefault();
          toggleFlip();
          break;
        case "Enter":
          if (onControl) return;
          e.preventDefault();
          toggleFlip();
          break;
        case " ":
        case "Spacebar":
          if (onControl) return;
          e.preventDefault();
          userPaused = !userPaused;
          updatePauseUi();
          break;
      }
    });
    dlg.addEventListener("cancel", (e) => {
      e.preventDefault();
      close();
    });

    document.addEventListener("visibilitychange", () => {
      hiddenPaused = document.hidden;
    });

    // ---------------- page wiring ----------------
    // Lookbook cards: links to the full photo without JS, buttons with it.
    $$<HTMLAnchorElement>("a[data-rw-card]").forEach((a) => {
      const btn = document.createElement("button");
      btn.type = "button";
      for (const attr of Array.from(a.attributes)) {
        if (attr.name !== "href") btn.setAttribute(attr.name, attr.value);
      }
      btn.append(...Array.from(a.childNodes));
      a.replaceWith(btn);
    });

    const posFromKey = (v: string | undefined) => {
      if (v === "finale") return POS_WALK;
      const n = Number(v);
      return Number.isInteger(n) && n >= 0 && n < L ? n : -1;
    };
    document.addEventListener("click", (e) => {
      const el = (e.target as Element).closest?.<HTMLElement>("[data-rw-open]");
      if (!el || dlg.contains(el)) return;
      const p = posFromKey(el.dataset.rwOpen);
      if (p < 0) return;
      e.preventDefault();
      open(p, el);
    });

    function fromHash() {
      const h = location.hash;
      const m = /^#look-(\d{1,3})$/.exec(h);
      if (m) {
        const n = Number(m[1]);
        if (n >= 1 && n <= L) {
          open(n - 1, null);
          return;
        }
        // Not a look: fall back to the cover.
        history.replaceState(history.state, "", location.pathname + location.search);
        window.scrollTo(0, 0);
        return;
      }
      if (h === "#finale") open(POS_WALK, null);
    }
    window.addEventListener("hashchange", () => {
      if (!isOpen) fromHash();
    });
    fromHash();

    // Debug/QA handle (read-only snapshot of the player state).
    (window as any).__runway = {
      state: () => ({
        isOpen,
        pos,
        fi,
        elapsed,
        userPaused,
        holdPaused,
        animating,
        flipped,
        face,
        beat: beatName(),
        mode: dlg.dataset.mode,
      }),
    };
  }
</script>
