---
// Sweat Fest '26 poster, drawn live as SVG in the retro-rainbow identity
// from the 2026 Canva kit. The actual flyer compositions live in
// src/data/sweatFestPoster.js, shared with the social-image render script
// (scripts/render-sweatfest-social.mjs) so the art has a single source.
import { sweatFest, sweatFestPalette as p } from "@/data/sweatFest";
import { buildPosterSvg } from "@/data/sweatFestPoster";

interface Props {
  variant?: "landscape" | "portrait" | "square";
  className?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
}

const { variant = "landscape", className = "" } = Astro.props;

const base = import.meta.env.BASE_URL;

const aspectClass =
  variant === "portrait"
    ? "aspect-[4/5]"
    : variant === "square"
      ? "aspect-square"
      : "aspect-video";

const alt = `Sweat Fest '26 poster: a retro rainbow arch over ${sweatFest.dateLabel}, ${sweatFest.venueLine}, ${sweatFest.timeLabel}. ${sweatFest.taglineSub}`;

const svg = buildPosterSvg(variant, `${base}logo.svg`);
---

<figure
  class:list={[
    "sf-poster group relative isolate overflow-hidden",
    aspectClass,
    className,
  ]}
  role="img"
  aria-label={alt}
  style={`background: ${p.cream};`}
>
  <div class="absolute inset-0 [&>svg]:h-full [&>svg]:w-full" set:html={svg} aria-hidden="true" />
</figure>
