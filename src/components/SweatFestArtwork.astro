---
// Sweat Fest poster, drawn live as SVG from the team's official logo lockups.
// The flyer compositions live in src/data/sweatFestPoster.js, shared with the
// social-image render script (scripts/render-sweatfest-social.mjs) so the art
// has a single source.
import { sweatFest, sweatFestPalette as p } from "@/data/sweatFest";
import { buildPosterSvg } from "@/data/sweatFestPoster";

interface Props {
  variant?: "landscape" | "portrait" | "square" | "lockup";
  className?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
}

const { variant = "landscape", className = "" } = Astro.props;

const aspectClass =
  variant === "portrait"
    ? "aspect-[4/5]"
    : variant === "square"
      ? "aspect-square"
      : "aspect-video";

// The lockup variant is just the logo (no fact chips), so its label should
// not claim details the artwork does not show.
const alt =
  variant === "lockup"
    ? "The checkerboard-bordered Sweat Fest logo, presented by Latina Sweat Project"
    : `Sweat Fest poster: the checkerboard-bordered Sweat Fest logo over ${sweatFest.dateLabel}, ${sweatFest.venueLine}, ${sweatFest.timeLabel}. ${sweatFest.taglineSub}`;

const svg = buildPosterSvg(variant);
---

<figure
  class:list={[
    "sf-poster group relative isolate overflow-hidden",
    aspectClass,
    className,
  ]}
  role="img"
  aria-label={alt}
  style={`background: ${p.honeydew};`}
>
  <div class="absolute inset-0 [&>svg]:h-full [&>svg]:w-full" set:html={svg} aria-hidden="true" />
</figure>
