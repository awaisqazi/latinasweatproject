---
// /links: the Holiday Gift Drive card (LSP's Community Impact Team, on until
// Sunday, December 13, 2026), between the Giving Tuesday card and the LSP
// Posadas card (date order: Dec 1, Dec 13, Dec 19). The /giftdrive identity
// on a phone: evergreen #123d2f, flyer cream text, ornament gold #e3c77e for
// the countdown only, Fraunces 560 for the title, Rubik for the rest; a
// small plain crop of the tree photo beside the title (not rotated, no
// shadow). Every visible string has an EN/ES pair; proper names stay
// (Holiday Gift Drive, Bethany House, Viator House of Hospitality).
// Live countdown and auto-off: src/lib/giftDrivePlacement.js. Toggle:
// showGiftDriveLinksCard in src/data/giftDrive.js.
import {
  giftDrive,
  giftDrivePlacementCopy as pc,
  giftDrivePhase,
  giftDriveCountdown,
  showGiftDriveLinksCard,
} from "@/data/giftDrive";

const nowMs = Date.now();
const show = showGiftDriveLinksCard && giftDrivePhase(nowMs) !== "off";
const c = giftDriveCountdown(nowMs);
const base = import.meta.env.BASE_URL;
const pageUrl = `${base}${giftDrive.pagePath}`;
const icsHref = `${base}${giftDrive.calendarFile}`;
const line = (count, tail) => (c ? (c.short ? count : `${count} · ${tail}`) : "");
---

{show && (
  <div
    id="giftdrive-card"
    class="gdl relative mb-8 scroll-mt-24 overflow-hidden rounded-2xl"
    style="animation: links-slide-up 0.5s ease backwards; animation-delay: 67ms;"
    data-gd-place
    data-gd-until={giftDrive.endsAt}
  >
    <div class="gdl-in">
      <div class="gdl-top">
        <h2 class="gdl-h">
          <span class="gdl-l">Holiday</span>
          <span class="gdl-l">Gift Drive</span>
        </h2>
        <a href={pageUrl} class="gdl-art" tabindex="-1" aria-hidden="true">
          <img
            src={`${base}${giftDrive.photo.webp320}`}
            alt=""
            width="320"
            height="427"
            decoding="async"
          />
        </a>
      </div>

      <p class="gdl-lead">
        <span class="lang-en">{pc.lead}</span>
        <span class="lang-es hidden">{pc.leadEs}</span>
      </p>
      <p class="gdl-count">
        <span class="lang-en" data-gd-countdown data-lang="en" data-gd-tail={pc.due}>{line(c?.en, pc.due)}</span>
        <span class="lang-es hidden" data-gd-countdown data-lang="es" data-gd-tail={pc.dueEs}>{line(c?.es, pc.dueEs)}</span>
      </p>
      <p class="gdl-muted">
        <span class="lang-en">{pc.who}</span>
        <span class="lang-es hidden">{pc.whoEs}</span>
      </p>
      <a
        href={pageUrl}
        class="gdl-btn"
        data-conversion-event="giftdrive_page_click"
        data-conversion-context="links_giftdrive_card"
      >
        <span>
          <span class="lang-en">{pc.cta}</span>
          <span class="lang-es hidden">{pc.ctaEs}</span>
        </span>
        <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
      <a
        href={icsHref}
        class="gdl-cal"
        download
        data-conversion-event="giftdrive_calendar_click"
        data-conversion-context="links_giftdrive_card"
      >
        <span class="lang-en">{pc.calendar}</span>
        <span class="lang-es hidden">{pc.calendarEs}</span>
      </a>
    </div>
  </div>
)}

<script>
  import { initGiftDrivePlacements } from "@/lib/giftDrivePlacement.js";
  initGiftDrivePlacements();
</script>

<style>
  .gdl {
    --ever: #123d2f;
    --cream: #fef8e6;
    --gold: #e3c77e;
    --muted: rgb(254 248 230 / 0.74);
    background: var(--ever);
    color: var(--cream);
    font-family: "Rubik", system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .gdl [hidden] { display: none !important; }
  :global(.lang-active-en) .gdl .lang-es,
  :global(.lang-active-es) .gdl .lang-en { display: none !important; }
  :global(.lang-active-es) .gdl .lang-es { display: inline; }
  .gdl-in { padding: 1.25rem 1rem 1.1rem; }
  .gdl-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .gdl-h {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 560;
    font-variation-settings: "opsz" 144;
    font-size: clamp(2.2rem, 10.5vw, 2.6rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .gdl-l { display: block; }
  .gdl-art {
    flex: none;
    display: block;
    width: 4.75rem;
    margin-top: 0.15rem;
  }
  .gdl-art img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 3px;
  }
  .gdl-lead {
    margin-top: 0.9rem;
    font-size: 1rem;
    line-height: 1.45;
  }
  .gdl-count {
    margin-top: 0.7rem;
    color: var(--gold);
    font-size: 0.98rem;
    font-weight: 700;
    line-height: 1.4;
  }
  .gdl-muted {
    margin-top: 0.35rem;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .gdl-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 48px;
    margin-top: 1.1rem;
    border-radius: 6px;
    padding: 0 1rem;
    background: var(--cream);
    color: var(--ever);
    font-size: 0.95rem;
    font-weight: 700;
    transition: background-color 150ms;
  }
  .gdl-btn:hover { background: #fff; }
  .gdl-cal {
    display: inline-block;
    margin-top: 0.85rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgb(254 248 230 / 0.45);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }
  .gdl-btn:focus-visible,
  .gdl-cal:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 2px;
  }
  @media (min-width: 640px) {
    .gdl-in { padding: 1.5rem 1.25rem 1.25rem; }
  }
</style>
