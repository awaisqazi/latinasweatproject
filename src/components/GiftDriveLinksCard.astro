---
// /links: the Holiday Gift Drive card (LSP's Community Impact Team, on until
// Sunday, December 13, 2026), between the Giving Tuesday card and the LSP
// Posadas card (date order: Dec 1, Dec 13, Dec 19). The /giftdrive identity
// on a phone, from the team's flyer: its cream paper #fef9e6 and ink
// #040501, its own title lockup as the heading
// (public/images/giftdrive/lockup.svg; the lettering is the flyer's, in
// English in both languages, so the alt names it), Rubik for the rest, and
// the one /giftdrive button (flyer green #04b17a, ink outline, hard ink
// offset). Every visible string has an EN/ES pair; proper names stay
// (Holiday Gift Drive, Bethany House, Viator House of Hospitality).
// Live countdown and auto-off: src/lib/giftDrivePlacement.js. Toggle:
// showGiftDriveLinksCard in src/data/giftDrive.js.
import {
  giftDrive,
  giftDrivePlacementCopy as pc,
  giftDrivePhase,
  giftDriveCountdown,
  showGiftDriveLinksCard,
} from "@/data/giftDrive";

const nowMs = Date.now();
const show = showGiftDriveLinksCard && giftDrivePhase(nowMs) !== "off";
const c = giftDriveCountdown(nowMs);
const base = import.meta.env.BASE_URL;
const pageUrl = `${base}${giftDrive.pagePath}`;
const icsHref = `${base}${giftDrive.calendarFile}`;
const line = (count, tail) => (c ? (c.short ? count : `${count} · ${tail}`) : "");
---

{show && (
  <div
    id="giftdrive-card"
    class="gdl relative mb-8 scroll-mt-24 overflow-hidden rounded-2xl"
    style="animation: links-slide-up 0.5s ease backwards; animation-delay: 67ms;"
    data-gd-place
    data-gd-until={giftDrive.endsAt}
  >
    <div class="gdl-in">
      <h2 class="gdl-h">
        <img
          src={`${base}images/giftdrive/lockup.svg`}
          alt="The Latina Sweat Project's Holiday Gift Drive"
          width="616"
          height="326"
          decoding="async"
        />
      </h2>

      <p class="gdl-lead">
        <span class="lang-en">{pc.lead}</span>
        <span class="lang-es hidden">{pc.leadEs}</span>
      </p>
      <p class="gdl-count">
        <span class="lang-en" data-gd-countdown data-lang="en" data-gd-tail={pc.due}>{line(c?.en, pc.due)}</span>
        <span class="lang-es hidden" data-gd-countdown data-lang="es" data-gd-tail={pc.dueEs}>{line(c?.es, pc.dueEs)}</span>
      </p>
      <p class="gdl-muted">
        <span class="lang-en">{pc.who}</span>
        <span class="lang-es hidden">{pc.whoEs}</span>
      </p>
      <a
        href={pageUrl}
        class="gdl-btn"
        data-conversion-event="giftdrive_page_click"
        data-conversion-context="links_giftdrive_card"
      >
        <span>
          <span class="lang-en">{pc.cta}</span>
          <span class="lang-es hidden">{pc.ctaEs}</span>
        </span>
        <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
      <a
        href={icsHref}
        class="gdl-cal"
        download
        data-conversion-event="giftdrive_calendar_click"
        data-conversion-context="links_giftdrive_card"
      >
        <span class="lang-en">{pc.calendar}</span>
        <span class="lang-es hidden">{pc.calendarEs}</span>
      </a>
    </div>
  </div>
)}

<script>
  import { initGiftDrivePlacements } from "@/lib/giftDrivePlacement.js";
  initGiftDrivePlacements();
</script>

<style>
  .gdl {
    --paper: #fef9e6;
    --ink: #040501;
    --green: #04b17a;
    --muted: rgb(4 5 1 / 0.74);
    background: var(--paper);
    color: var(--ink);
    font-family: "Rubik", system-ui, sans-serif;
  }
  .gdl [hidden] { display: none !important; }
  :global(.lang-active-en) .gdl .lang-es,
  :global(.lang-active-es) .gdl .lang-en { display: none !important; }
  :global(.lang-active-es) .gdl .lang-es { display: inline; }
  .gdl-in { padding: 1.25rem 1rem 1.15rem; }
  .gdl-h img {
    display: block;
    width: 100%;
    max-width: 22rem;
    height: auto;
    margin: 0 auto;
  }
  .gdl-lead {
    margin-top: 1rem;
    font-size: 1rem;
    line-height: 1.45;
  }
  .gdl-count {
    margin-top: 0.7rem;
    font-size: 0.98rem;
    font-weight: 700;
    line-height: 1.4;
  }
  .gdl-muted {
    margin-top: 0.35rem;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .gdl-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 48px;
    margin: 1.1rem 3px 0 0;
    border: 2.5px solid var(--ink);
    border-radius: 12px;
    padding: 0 1rem;
    background: var(--green);
    color: var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    font-size: 0.95rem;
    font-weight: 700;
    transition: transform 90ms, box-shadow 90ms;
  }
  .gdl-btn:active {
    transform: translate(3px, 3px);
    box-shadow: 0 0 0 var(--ink);
  }
  .gdl-cal {
    display: inline-block;
    margin-top: 0.95rem;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }
  .gdl-btn:focus-visible,
  .gdl-cal:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }
  @media (min-width: 640px) {
    .gdl-in { padding: 1.5rem 1.25rem 1.25rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .gdl-btn { transition: none; }
    .gdl-btn:active { transform: none; }
  }
</style>
